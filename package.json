{
  "name": "inmutalkey-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio público de InmutalKey (inmutalkey.com): Astro estático + Worker (Hono) con D1, R2, Turnstile y Access.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "marca": "node scripts/generar-marca.mjs",
    "capturas": "node scripts/procesar-capturas.mjs",
    "redes": "node scripts/optimizar-redes.mjs",
    "qr": "node scripts/generar-qr.mjs",
    "activos": "npm run marca && npm run capturas",
    "build:cloudflare": "npm run activos && astro build",
    "revisar": "node scripts/revisar-sitio.mjs",
    "test:worker": "vitest run tests/worker",
    "db:migrar": "wrangler d1 migrations apply inmutalkey-web --remote",
    "db:migrar:local": "wrangler d1 migrations apply inmutalkey-web --local",
    "dev:worker": "npm run build && wrangler dev",
    "og": "node scripts/generar-og.mjs"
  },
  "dependencies": {
    "astro": "5.18.2",
    "aws4fetch": "1.0.20",
    "hono": "4.13.14",
    "qrcode": "1.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20261015.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "jsqr": "1.4.0",
    "opentype.js": "2.0.0",
    "playwright": "1.64.1",
    "sharp": "0.34.5",
    "simple-icons": "16.35.0",
    "svgo": "4.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
