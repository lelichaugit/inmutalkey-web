{
  "name": "inmutalkey-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio público de InmutalKey (inmutalkey.com): Astro estático + Cloudflare Pages Functions + D1.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "marca": "node scripts/generar-marca.mjs",
    "vectorizar:llave": "python3 scripts/vectorizar-llave.py",
    "vectorizar": "python3 scripts/vectorizar-logo.py",
    "capturas": "node scripts/procesar-capturas.mjs",
    "redes": "node scripts/optimizar-redes.mjs",
    "qr": "node scripts/generar-qr.mjs",
    "activos": "npm run marca && npm run capturas",
    "build:cloudflare": "npm run activos && astro build"
  },
  "dependencies": {
    "astro": "5.18.2",
    "lenis": "1.3.26",
    "qrcode": "1.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20261015.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "jsqr": "1.4.0",
    "opentype.js": "2.0.0",
    "sharp": "0.34.5",
    "simple-icons": "16.35.0",
    "svgo": "4.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
