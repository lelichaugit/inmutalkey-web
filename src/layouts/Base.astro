---
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import Pie from '../components/Pie.astro';
import { correoContacto, FUNDADOR, REDES, redPorId } from '../data/socials';
import { sitio } from '../site.config';

interface Props {
  /** Título de la página (sin el sufijo de marca). En la portada se usa tal cual. */
  titulo: string;
  descripcion?: string;
  /** `false` para 404, /resena y páginas que no deben indexarse. */
  indexar?: boolean;
  /** Ruta de la imagen OG relativa al sitio. */
  imagenOg?: string;
  /** Portada: título sin el sufijo "· InmutalKey". */
  tituloCompleto?: boolean;
  /** Imagen a precargar (el LCP de la página), con su srcset en AVIF. */
  precarga?: { srcset: string; sizes: string };
}

const {
  titulo,
  descripcion = sitio.descripcion,
  indexar = true,
  imagenOg = '/og.png',
  tituloCompleto = false,
  precarga,
} = Astro.props;

const tituloFinal = tituloCompleto ? titulo : `${titulo} · ${sitio.nombre}`;
const canonica = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), sitio.url).href;
const og = new URL(imagenOg, sitio.url).href;

const correo = correoContacto();
const linkedin = redPorId('linkedin');
const idOrganizacion = `${sitio.url}/#organizacion`;
const idFundador = `${sitio.url}/#fundador`;

// LinkedIn es el perfil personal del fundador: va en `Person.sameAs`, no en `Organization.sameAs` (que declara
// "esta cuenta ES la organización"). La organización lo enlaza como `founder`.
// Sin precio ni calificaciones: no hay precios definitivos ni reseñas verificadas que lo respalden.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': idOrganizacion,
      name: sitio.nombre,
      url: sitio.url,
      logo: new URL('/icon-512.png', sitio.url).href,
      ...(correo ? { email: correo } : {}),
      sameAs: REDES.filter((r) => r.id !== 'linkedin').map((r) => r.url),
      founder: { '@id': idFundador },
    },
    {
      '@type': 'Person',
      '@id': idFundador,
      name: FUNDADOR.nombre,
      jobTitle: FUNDADOR.puesto,
      sameAs: [linkedin.url],
      worksFor: { '@id': idOrganizacion },
    },
    {
      '@type': 'SoftwareApplication',
      name: sitio.nombre,
      url: sitio.url,
      description: sitio.descripcion,
      applicationCategory: 'MedicalApplication',
      operatingSystem: 'Windows 10, Windows 11',
      inLanguage: sitio.idioma,
      image: new URL('/icon-512.png', sitio.url).href,
      softwareVersion: sitio.version.numero,
      publisher: { '@id': idOrganizacion },
    },
  ],
};
---

<!doctype html>
<html lang={sitio.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline src="/clases.js"></script>
    <title>{tituloFinal}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {!indexar && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />
    {precarga && <link rel="preload" as="image" type="image/avif" imagesrcset={precarga.srcset} imagesizes={precarga.sizes} fetchpriority="high" />}

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#EEF1F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#021A30" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={sitio.titulo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloFinal} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={og} />
    <meta name="apple-mobile-web-app-title" content={sitio.nombre} />
    <meta name="application-name" content={sitio.nombre} />

    {REDES.map((r) => <link rel="me" href={r.url} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Nav />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Pie />
    <script>
      import '../scripts/base';
    </script>
  </body>
</html>
