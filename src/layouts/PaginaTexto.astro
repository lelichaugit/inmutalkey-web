---
// Páginas interiores (registro, descarga, verificar, contacto, legales, reseña): cabecera serena sobre la aurora y
// una superficie de lectura. `amplio` = contenido a lo ancho (rejillas, tarjetas); si no, columna de prosa en una
// tarjeta de vidrio simulado. El texto se ve desde el primer pintado.
import Base from './Base.astro';

interface Props {
  titulo: string;
  descripcion: string;
  /** Texto corto sobre el título (micro en mayúsculas). */
  antetitulo?: string;
  /** Muestra la cinta "Versión preliminar en revisión legal". */
  borrador?: boolean;
  actualizado?: string;
  indexar?: boolean;
  /** Contenido a lo ancho del sitio en lugar de la columna de lectura con estilos de prosa. */
  amplio?: boolean;
  /** Columna estrecha (formularios y estados de una sola acción). */
  estrecho?: boolean;
}

const { titulo, descripcion, antetitulo, borrador = false, actualizado, indexar = true, amplio = false, estrecho = false } = Astro.props;
---

<Base titulo={titulo} descripcion={descripcion} indexar={indexar}>
  <header class="pagina-cabecera">
    <div class:list={[amplio ? 'contenedor' : 'pagina-estrecha']}>
      {antetitulo && <p class="antetitulo">{antetitulo}</p>}
      <h1>{titulo}</h1>
      <p class="texto-grande pagina-descripcion">{descripcion}</p>
      {
        (borrador || actualizado) && (
          <p class="pagina-meta">
            {borrador && <span class="pildora pildora-alerta">Versión preliminar · en revisión legal</span>}
            {actualizado && <span>Última actualización: {actualizado}</span>}
          </p>
        )
      }
    </div>
  </header>
  {
    amplio ? (
      <div class="contenedor pagina-cuerpo">
        <slot />
      </div>
    ) : estrecho ? (
      <div class="pagina-estrecha pagina-cuerpo">
        <slot />
      </div>
    ) : (
      <div class="pagina-estrecha pagina-cuerpo">
        <article class="tarjeta prosa pagina-prosa">
          <slot />
        </article>
      </div>
    )
  }
</Base>

<style>
  .pagina-cabecera {
    padding: calc(var(--altura-nav) + clamp(3.5rem, 7vw, 6.5rem)) 0 clamp(2rem, 4vw, 3rem);
  }

  .pagina-cabecera h1 {
    max-width: 20ch;
  }

  .pagina-descripcion {
    max-width: 40rem;
    margin-top: 1rem;
  }

  .pagina-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin-top: 1.25rem;
    color: var(--texto-2);
    font-size: 0.875rem;
  }

  .pagina-meta :global(.pildora-alerta) {
    border-color: var(--alerta-borde);
    background: var(--alerta-suave);
    color: var(--alerta);
  }

  .pagina-estrecha {
    width: min(100% - 2 * var(--medianil), 48rem);
    margin-inline: auto;
  }

  .pagina-cuerpo {
    padding-bottom: var(--seccion);
  }

  .pagina-prosa {
    max-width: none;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
</style>
