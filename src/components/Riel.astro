---
// Riel lateral de secciones (escritorio ancho, solo en la portada). Sus enlaces también alimentan el título de
// sección que aparece en la barra del celular (data-etiqueta). "Inicio" no lleva etiqueta: ahí se ve la marca.
const SECCIONES = [
  { id: 'inicio', texto: 'Inicio' },
  { id: 'integridad', texto: 'Cómo funciona', etiqueta: 'Cómo funciona' },
  { id: 'demo', texto: 'Pruébalo', etiqueta: 'Pruébalo' },
  { id: 'signos', texto: 'Signos vitales', etiqueta: 'Signos vitales' },
  { id: 'incluye', texto: 'Qué incluye', etiqueta: 'Qué incluye' },
  { id: 'pasos', texto: 'Cómo empezar', etiqueta: 'Cómo empezar' },
  { id: 'fundadores', texto: 'Fundadores', etiqueta: 'Fundadores' },
  { id: 'preguntas', texto: 'Preguntas', etiqueta: 'Preguntas' },
] as const;
---

<nav class="riel" aria-label="Secciones de la página">
  <ol>
    {
      SECCIONES.map((s) => (
        <li>
          <a href={`#${s.id}`} data-seccion={s.id} data-etiqueta={'etiqueta' in s ? s.etiqueta : undefined}>
            <span class="riel-texto">{s.texto}</span>
            <span class="riel-punto" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .riel {
    display: none;
  }

  @media (min-width: 1360px) and (hover: hover) {
    .riel {
      position: fixed;
      top: 50%;
      right: 18px;
      z-index: 45;
      display: block;
      transform: translateY(-50%);
    }
  }

  .riel ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .riel a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    height: 28px;
    padding-left: 12px;
    color: var(--texto-tenue);
    text-decoration: none;
  }

  .riel-punto {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.28);
    transition:
      height 0.45s var(--ease),
      background-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .riel-texto {
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(6 11 22 / 0.85);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(8px);
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease);
    pointer-events: none;
  }

  .riel a:hover .riel-texto,
  .riel a:focus-visible .riel-texto {
    opacity: 1;
    transform: none;
  }

  .riel a:hover .riel-punto {
    background: #fff;
  }

  .riel a[aria-current='true'] .riel-punto {
    height: 22px;
    background: var(--azul-vivo);
    box-shadow: 0 0 12px rgb(46 159 224 / 0.8);
  }

  .riel a[aria-current='true'] {
    color: #fff;
  }
</style>
