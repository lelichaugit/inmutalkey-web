} as const;

export type NombreIcono = keyof typeof ICONOS;

interface Props {
  nombre: NombreIcono;
  /** Nombre accesible. Sin él, el icono es decorativo. */
  titulo?: string;
  class?: string;
}

const { nombre, titulo, class: clase } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icono', clase]}
  role={titulo ? 'img' : undefined}
  aria-label={titulo}
  aria-hidden={titulo ? undefined : 'true'}
  focusable="false"
>
  {titulo && <title>{titulo}</title>}
  <Fragment set:html={ICONOS[nombre]} />
</svg>
