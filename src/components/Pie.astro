---
// Pie de todas las páginas. Abre con un trazo de electrocardiograma que se dibuja al entrar en vista (clip-path) y
// lleva el logo principal (la llave 3D blanca, Isotipo3D). Contacto desde Contacto.astro (solo lo definido) y redes
// desde SocialLinks (src/data/socials.ts).
import Contacto from './Contacto.astro';
import Isotipo3D from './Isotipo3D.astro';
import SocialLinks from './SocialLinks.astro';

const anio = new Date().getFullYear();
---

<footer class="pie fondo-negro">
  <div class="pie-traza" data-animar="aparecer" aria-hidden="true">
    <span class="pie-traza-dibujo">
      <span class="pie-traza-linea"></span>
      <svg class="pie-latido" viewBox="0 0 160 40" fill="none" focusable="false">
        <path d="M0 24h46l6-6 6 6h10l5 9 9-31 8 33 6-11h14l7-8 8 8h35" />
      </svg>
      <span class="pie-traza-linea pie-traza-larga"></span>
    </span>
  </div>

  <div class="contenedor pie-rejilla" data-escalonar>
    <div class="pie-marca" data-animar="subir">
      <a class="pie-logo" href="/" aria-label="InmutalKey, ir al inicio">
        <span class="pie-isotipo"><Isotipo3D sizes="24px" /></span>
        <span aria-hidden="true">InmutalKey</span>
      </a>
      <p class="tenue">Expediente clínico para tu consultorio. Tus notas, selladas y en tu computadora.</p>
      <p class="pie-estado">
        <span class="pie-pulso" aria-hidden="true"></span>
        <span>Sin internet · AES-256 · SHA-256 · Ed25519</span>
      </p>
    </div>

    <nav class="pie-col" aria-label="Producto" data-animar="subir">
      <h2 class="pie-titulo">Producto</h2>
      <ul>
        <li><a href="/#integridad">Cómo protege tus notas</a></li>
        <li><a href="/#incluye">Qué incluye</a></li>
        <li><a href="/#preguntas">Preguntas frecuentes</a></li>
        <li><a href="/verificar">Verificar el instalador</a></li>
      </ul>
    </nav>

    <nav class="pie-col" aria-label="Fundadores y legal" data-animar="subir">
      <h2 class="pie-titulo">Fundadores</h2>
      <ul>
        <li><a href="/#fundadores">Programa Fundadores</a></li>
        <li><a href="/resena">Deja tu reseña</a></li>
        <li><a href="/terminos-fundadores">Términos del programa</a></li>
        <li><a href="/privacidad">Aviso de privacidad</a></li>
      </ul>
    </nav>

    <div class="pie-col pie-contacto" data-animar="subir">
      <h2 class="pie-titulo">Contacto</h2>
      <Contacto variante="lista" incluir={['whatsapp', 'correo']} />
      <SocialLinks variant="footer" />
      <a class="pie-contacto-mas" href="/contacto">Todas las formas de contacto</a>
    </div>
  </div>

  <div class="contenedor pie-legal tenue">
    <p>© {anio} InmutalKey. Hecho en México.</p>
    <p>
      InmutalKey es un software independiente, diseñado para apoyar el cumplimiento de la <span class="sin-corte">NOM-004-SSA3-2012</span>. No está
      afiliado ni avalado por la Secretaría de Salud.
    </p>
  </div>
</footer>

<style>
  .pie {
    position: relative;
    padding-block: 0 calc(32px + env(safe-area-inset-bottom));
  }

  /* ── Trazo de ECG que separa el pie: línea fina con un latido; se dibuja de izquierda a derecha ── */

  .pie-traza {
    height: 40px;
    margin-bottom: clamp(36px, 5vw, 64px);
    color: rgb(46 159 224 / 0.55);
  }

  .pie-traza-dibujo {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .pie-traza-linea {
    flex: 1;
    height: 1px;
    margin-top: 8px;
    background: currentColor;
  }

  .pie-traza-larga {
    flex: 4;
    background: linear-gradient(90deg, currentColor, rgb(255 255 255 / 0.08) 70%);
  }

  .pie-latido {
    flex: none;
    width: 160px;
    height: 40px;
    overflow: visible;
  }

  .pie-latido path {
    stroke: var(--azul-vivo);
    stroke-width: 1.25;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 4px rgb(46 159 224 / 0.6));
  }

  /* El recorte va en un hijo: IntersectionObserver descuenta el clip-path del propio elemento observado (con el
     trazo recortado a 0 px nunca "entraría en vista"). */
  :global(.js) .pie-traza:not(.es-visible) {
    opacity: 1;
  }

  :global(.js) .pie-traza-dibujo {
    transition: clip-path 1.8s cubic-bezier(0.65, 0, 0.35, 1) 0.1s;
  }

  :global(.js) .pie-traza:not(.es-visible) .pie-traza-dibujo {
    clip-path: inset(0 100% 0 0);
  }

  /* ── Columnas ── */

  .pie-rejilla {
    display: grid;
    gap: 40px 24px;
    grid-template-columns: 1fr 1fr;
  }

  .pie-marca,
  .pie-contacto {
    grid-column: 1 / -1;
  }

  @media (min-width: 720px) {
    .pie-rejilla {
      grid-template-columns: 1fr 1fr 1.4fr;
    }

    .pie-contacto {
      grid-column: auto;
    }
  }

  @media (min-width: 1024px) {
    .pie-rejilla {
      grid-template-columns: 1.6fr 1fr 1fr 1.1fr;
    }

    .pie-marca {
      grid-column: auto;
    }
  }

  .pie-marca p:not(.pie-estado) {
    max-width: 34ch;
    margin-top: 1rem;
    font-size: 1rem;
  }

  .pie-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    color: #fff;
    font-family: var(--fuente-titulo);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  /* La llave toma el alto de su contenedor; el ancho sale de la proporción del render. */
  .pie-isotipo {
    display: block;
    width: calc(52px * 304 / 724);
    height: 52px;
    filter: drop-shadow(0 0 14px rgb(46 159 224 / 0.3));
  }

  /* Línea de estado: los datos técnicos, discretos, con un pulso lento. */
  .pie-marca .pie-estado {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 1.1rem;
    color: var(--texto-tenue);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .pie-pulso {
    position: relative;
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--azul-vivo);
  }

  .pie-pulso::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--azul-vivo);
    animation: pie-pulso 2.4s var(--ease) infinite;
  }

  @keyframes pie-pulso {
    0% {
      opacity: 0.7;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(3.2);
    }
  }

  .pie-titulo {
    margin-bottom: 0.9rem;
    color: #fff;
    font-family: var(--fuente-texto);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .pie-col ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pie-col li > a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--texto-tenue);
    font-size: 1rem;
    line-height: 1.3;
    text-decoration: none;
    transition: color 0.25s var(--ease);
  }

  /* Subrayado de 1 px que se traza al pasar el cursor. */
  .pie-col li > a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    height: 1px;
    background: var(--azul-vivo);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.4s var(--ease);
  }

  @media (hover: hover) {
    .pie-col li > a:hover {
      color: #fff;
    }

    .pie-col li > a:hover::after {
      transform: scaleX(1);
    }
  }

  .pie-contacto-mas {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.5rem;
    color: var(--texto-tenue);
    font-size: 0.9375rem;
    text-underline-offset: 3px;
    transition: color 0.2s var(--ease);
  }

  .pie-contacto-mas:hover {
    color: #fff;
  }

  .pie-legal {
    display: grid;
    gap: 0.5rem;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--linea-oscura);
    font-size: 0.9375rem;
  }

  .pie-legal p + p {
    margin-top: 0;
  }
</style>
