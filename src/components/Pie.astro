---
import { estaDefinido, sitio } from '../site.config';
import { enlaceWhatsApp, numeroVisible } from '../lib/whatsapp';
import Icono from './Icono.astro';
import Logo from './Logo.astro';

const whatsapp = enlaceWhatsApp(sitio.contacto.whatsapp, sitio.contacto.mensajeWhatsApp);
const telefono = numeroVisible(sitio.contacto.whatsapp);
const correo = estaDefinido(sitio.contacto.correo) ? sitio.contacto.correo : null;
const anio = new Date().getFullYear();
---

<footer class="pie fondo-negro">
  <div class="contenedor pie-rejilla">
    <div class="pie-marca">
      <a class="pie-logo" href="/" aria-label="InmutalKey, ir al inicio">
        <Logo titulo={null} />
        <span aria-hidden="true">InmutalKey</span>
      </a>
      <p class="tenue">Expediente clínico para tu consultorio. Tus notas, selladas y en tu computadora.</p>
    </div>

    <nav class="pie-col" aria-label="Producto">
      <h2 class="pie-titulo">Producto</h2>
      <ul>
        <li><a href="/#integridad">Cómo protege tus notas</a></li>
        <li><a href="/#incluye">Qué incluye</a></li>
        <li><a href="/#preguntas">Preguntas frecuentes</a></li>
        <li><a href="/verificar">Verificar el instalador</a></li>
      </ul>
    </nav>

    <nav class="pie-col" aria-label="Fundadores y legal">
      <h2 class="pie-titulo">Fundadores</h2>
      <ul>
        <li><a href="/#fundadores">Programa Fundadores</a></li>
        <li><a href="/resena">Deja tu reseña</a></li>
        <li><a href="/terminos-fundadores">Términos del programa</a></li>
        <li><a href="/privacidad">Aviso de privacidad</a></li>
      </ul>
    </nav>

    <div class="pie-col">
      <h2 class="pie-titulo">Contacto</h2>
      <ul>
        {
          whatsapp && (
            <li>
              <a class="pie-contacto" href={whatsapp} target="_blank" rel="noopener noreferrer">
                <Icono nombre="chat" />
                <span>WhatsApp{telefono && <span class="tenue sin-corte"> · {telefono}</span>}</span>
              </a>
            </li>
          )
        }
        {correo && (
          <li>
            <a href={`mailto:${correo}`}>{correo}</a>
          </li>
        )}
      </ul>
    </div>
  </div>

  <div class="contenedor pie-legal tenue">
    <p>© {anio} InmutalKey. Hecho en México.</p>
    <p>
      InmutalKey es un software independiente, diseñado para apoyar el cumplimiento de la <span class="sin-corte">NOM-004-SSA3-2012</span>. No está
      afiliado ni avalado por la Secretaría de Salud.
    </p>
  </div>
</footer>

<style>
  .pie {
    padding-block: clamp(56px, 7vw, 88px) 32px;
    border-top: 1px solid var(--linea-oscura);
  }

  .pie-rejilla {
    display: grid;
    gap: 40px 32px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .pie-rejilla {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .pie-rejilla {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }

  .pie-marca p {
    max-width: 34ch;
    margin-top: 1rem;
    font-size: 1rem;
  }

  .pie-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #fff;
    font-family: var(--fuente-titulo);
    font-size: 1.375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .pie-logo :global(.logo) {
    height: 2.4rem;
  }

  .pie-titulo {
    margin-bottom: 0.9rem;
    color: #fff;
    font-family: var(--fuente-texto);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .pie-col ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pie-col a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 40px;
    color: var(--texto-tenue);
    font-size: 1rem;
    text-decoration: none;
  }

  .pie-col a:hover {
    color: #fff;
  }

  .pie-contacto :global(.icono) {
    width: 1.25em;
    height: 1.25em;
  }

  .pie-legal {
    display: grid;
    gap: 0.5rem;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--linea-oscura);
    font-size: 0.9375rem;
  }

  .pie-legal p + p {
    margin-top: 0;
  }
</style>
