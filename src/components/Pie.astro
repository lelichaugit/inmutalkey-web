---
// Pie de todas las páginas (IDENTIDAD_MARCA §9.9): lámina Abismo, logo monocromo blanco, eslogan, aviso de privacidad y
// NOM-004. Contacto desde Contacto.astro (solo lo definido) y redes desde SocialLinks (src/data/socials.ts).
import { sitio } from '../site.config';
import Contacto from './Contacto.astro';
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';

const anio = new Date().getFullYear();
---

<footer class="pie tema-marino">
  <div class="contenedor-amplio pie-rejilla">
    <div class="pie-marca">
      <a class="pie-logo" href="/" aria-label="InmutalKey, ir al inicio">
        <Logo alto={2.5} variante="mono-blanco" />
      </a>
      <p class="pie-eslogan">Expediente Clínico Privado</p>
      <p class="pie-lema">Su expediente vive en su computadora. Cada nota queda sellada al firmarla.</p>
      <p class="pie-version">
        Versión vigente <a href="/verificar"><span class="cifras">{sitio.version.numero}</span> · {sitio.version.nombre}</a>
      </p>
    </div>

    <nav class="pie-col" aria-label="Producto">
      <h2 class="pie-titulo">Producto</h2>
      <ul>
        <li><a href="/#como-funciona">Cómo funciona</a></li>
        <li><a href="/#recetas">Recetas</a></li>
        <li><a href="/#seguridad">Seguridad, en claro</a></li>
        <li><a href="/#preguntas">Preguntas frecuentes</a></li>
        <li><a href="/verificar">Verificar el instalador</a></li>
      </ul>
    </nav>

    <nav class="pie-col" aria-label="Fundadores y legal">
      <h2 class="pie-titulo">Fundadores</h2>
      <ul>
        <li><a href="/fundadores">Solicitar acceso</a></li>
        <li><a href="/descarga">Descarga</a></li>
        <li><a href="/resena">Dejar una reseña</a></li>
        <li><a href="/terminos-fundadores">Términos del programa</a></li>
        <li><a href="/privacidad">Aviso de privacidad</a></li>
        <li><a href="/derechos">Derechos ARCO</a></li>
      </ul>
    </nav>

    <div class="pie-col">
      <h2 class="pie-titulo">Contacto</h2>
      <Contacto variante="lista" incluir={['whatsapp', 'correo']} />
      <SocialLinks variant="footer" class="pie-redes" />
      <a class="pie-mas" href="/contacto">Todas las formas de contacto</a>
    </div>
  </div>

  <div class="contenedor-amplio pie-legal">
    <p>© {anio} InmutalKey. Hecho en México.</p>
    <p>
      InmutalKey es un software independiente, diseñado para apoyar el cumplimiento de la
      <span class="sin-corte">NOM-004-SSA3-2012</span>. No está afiliado ni avalado por la Secretaría de Salud.
    </p>
  </div>
</footer>

<style>
  .pie {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0 calc(2rem + env(safe-area-inset-bottom));
    color: var(--texto);
    background:
      radial-gradient(50% 80% at 10% 0%, color-mix(in srgb, var(--marca-acero) 55%, transparent), transparent 70%),
      radial-gradient(40% 70% at 95% 100%, color-mix(in srgb, var(--luz-destello) 18%, transparent), transparent 70%),
      var(--marca-abismo);
  }

  .pie::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--luz-cielo) 45%, transparent), transparent);
  }

  .pie-rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }

  .pie-marca {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .pie-logo {
    justify-self: start;
    color: var(--texto);
    text-decoration: none;
    border-radius: var(--radio-sm);
  }

  .pie-eslogan {
    color: var(--texto);
    font-size: 1rem;
    font-weight: 500;
  }

  .pie-lema {
    max-width: 22rem;
    color: var(--texto-2);
    font-size: 0.9375rem;
  }

  .pie-version {
    color: var(--texto-2);
    font-size: 0.875rem;
  }

  .pie-version a {
    color: var(--primario);
  }

  .pie-titulo {
    margin: 0 0 1rem;
    color: var(--texto-2);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .pie-col ul {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pie-col ul a,
  .pie-mas {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    color: var(--texto);
    font-size: 0.9375rem;
    font-weight: 450;
    text-decoration: none;
  }

  .pie-col ul a:hover,
  .pie-mas:hover {
    color: var(--primario);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .pie-col :global(.pie-redes) {
    margin-top: 1rem;
  }

  .pie-mas {
    margin-top: 0.5rem;
    color: var(--primario);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .pie-legal {
    display: grid;
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--linea);
    color: var(--texto-2);
    font-size: 0.8125rem;
  }

  .sin-corte {
    white-space: nowrap;
  }

  @media (max-width: 60rem) {
    .pie-rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pie-marca {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 30rem) {
    .pie-rejilla {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
