---
// Redes de InmutalKey desde src/data/socials.ts (única fuente de verdad). Solo enlaces estáticos: sin widgets,
// iframes, SDK ni píxeles de ninguna red.
//   variant="footer" · fila compacta de íconos (pie global)
//   variant="cards"  · tarjetas con ícono grande, handle, propósito y acción (/contacto)
import { etiquetaAccesible, etiquetaConAccion, REDES, REL_PERFIL_PROPIO, REL_EXTERNO } from '../data/socials';
import IconoMarca from './IconoMarca.astro';

interface Props {
  variant: 'footer' | 'cards';
  class?: string;
}

const { variant, class: clase } = Astro.props;
---

{
  variant === 'footer' ? (
    <ul class:list={['redes', 'redes-pie', clase]} aria-label="Redes sociales de InmutalKey">
      {REDES.map((red) => (
        <li>
          <a
            class={`red red-${red.id}`}
            href={red.url}
            target="_blank"
            rel={red.propio ? REL_PERFIL_PROPIO : REL_EXTERNO}
            aria-label={etiquetaAccesible(red)}
          >
            <span class="red-sello">
              <IconoMarca nombre={red.icono} />
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <ul class:list={['redes', 'redes-tarjetas', clase]}>
      {REDES.map((red) => (
        <li>
          <a
            class={`red red-${red.id}`}
            href={red.url}
            target="_blank"
            rel={red.propio ? REL_PERFIL_PROPIO : REL_EXTERNO}
            aria-label={etiquetaConAccion(red)}
          >
            <span class="red-sello">
              <IconoMarca nombre={red.icono} />
            </span>
            <span class="red-nombre">{red.nombre}</span>
            <span class="red-handle">{red.handle}</span>
            <span class="red-proposito">{red.proposito}</span>
            <span class="red-accion" aria-hidden="true">
              {red.accion}
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path d="M7 17 17 7M8.5 7H17v8.5" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .redes {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .red {
    color: var(--texto);
    text-decoration: none;
  }

  .red-sello {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--cristal-borde);
    border-radius: var(--radio);
    background: var(--grad-tarjeta);
    color: var(--texto);
    box-shadow: var(--cristal-brillo), var(--elev-1);
    transition:
      border-color 160ms ease,
      box-shadow 200ms ease,
      color 160ms ease,
      transform 160ms var(--curva-cristal);
  }

  .red-sello :global(.icono-marca) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .red:hover .red-sello,
  .red:focus-visible .red-sello {
    color: var(--primario);
    border-color: color-mix(in srgb, var(--acento) 42%, var(--borde));
    box-shadow: var(--cristal-brillo), var(--elev-2), var(--halo-acento);
  }

  .red:active .red-sello {
    transform: scale(0.96);
  }

  .redes-pie {
    display: flex;
    gap: 0.5rem;
  }

  .redes-pie .red {
    display: inline-flex;
    border-radius: var(--radio);
  }

  .redes-tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }

  .redes-tarjetas li {
    display: flex;
  }

  .redes-tarjetas .red {
    display: grid;
    flex: 1;
    gap: 0.25rem;
    align-content: start;
    padding: 1.25rem;
    border: 1px solid var(--cristal-borde);
    border-radius: var(--radio-lg);
    background: var(--grad-tarjeta);
    box-shadow: var(--cristal-brillo), var(--elev-1);
    transition:
      transform 240ms var(--curva-cristal),
      box-shadow 240ms var(--curva-cristal),
      border-color 200ms ease;
  }

  .redes-tarjetas .red-sello {
    margin-bottom: 0.75rem;
    color: var(--sobre-primario);
    background: var(--grad-primario);
    border-color: transparent;
  }

  .red-nombre {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.018em;
  }

  .red-handle {
    color: var(--primario);
    font-weight: 560;
  }

  .red-proposito {
    color: var(--texto-2);
    font-size: 0.9375rem;
  }

  .red-accion {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.75rem;
    color: var(--primario);
    font-weight: 600;
  }

  .redes-tarjetas .red:hover,
  .redes-tarjetas .red:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--acento) 42%, var(--borde));
    box-shadow: var(--cristal-brillo), var(--elev-2), var(--halo-acento);
  }

  .redes-tarjetas .red:hover .red-sello {
    color: var(--sobre-primario);
  }
</style>
