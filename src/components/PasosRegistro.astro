---
// Indicador de avance del registro: Regístrese → Confirme → Instale. Mismo componente en /fundadores, la
// confirmación, gracias y /descarga, para que el médico siempre sepa en qué paso va y cuánto falta.
// Con Google el paso 2 se salta (el correo ya viene verificado): se marca como hecho al completar el registro.
import Icono from './Icono.astro';

interface Props {
  /** 1 = registro, 2 = confirmación, 3 = instalación. */
  actual: 1 | 2 | 3;
}

const { actual } = Astro.props;
const PASOS = ['Regístrese', 'Confirme su correo', 'Instale su prueba'] as const;
---

<ol class="pasos-registro" aria-label="Avance del registro">
  {
    PASOS.map((texto, i) => {
      const n = i + 1;
      const estado = n < actual ? 'hecho' : n === actual ? 'actual' : 'pendiente';
      return (
        <li class={`paso-registro ${estado}`} aria-current={estado === 'actual' ? 'step' : undefined}>
          <span class="paso-registro-marca" aria-hidden="true">
            {estado === 'hecho' ? <Icono nombre="check" /> : n}
          </span>
          <span class="paso-registro-texto">
            {texto}
            {estado === 'hecho' && <span class="visualmente-oculto"> (hecho)</span>}
          </span>
        </li>
      );
    })
  }
</ol>

<style>
  /* Selector de pasos con el lenguaje de `.control-vista` de la app: una píldora por paso, el actual con halo. */
  .pasos-registro.pasos-registro {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .paso-registro.paso-registro {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--cristal-borde);
    border-radius: var(--radio);
    background: color-mix(in srgb, var(--texto) 4%, transparent);
    color: var(--texto-2);
    font-size: 0.875rem;
    font-weight: 560;
  }

  .paso-registro.actual {
    border-color: color-mix(in srgb, var(--primario) 55%, transparent);
    background: var(--grad-tarjeta);
    color: var(--texto);
    box-shadow: var(--cristal-brillo), var(--elev-1), var(--halo-acento);
  }

  .paso-registro-marca {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.625rem;
    height: 1.625rem;
    border: 1px solid var(--borde-campo);
    border-radius: 50%;
    font-size: 0.8125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .actual .paso-registro-marca {
    border-color: transparent;
    background: var(--grad-primario);
    color: var(--sobre-primario);
  }

  .hecho .paso-registro-marca {
    border-color: var(--exito-borde);
    background: var(--exito-suave);
    color: var(--exito);
  }

  .paso-registro-marca :global(.icono) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .paso-registro-texto {
    min-width: 0;
    line-height: 1.25;
  }

  @media (max-width: 30rem) {
    .paso-registro.paso-registro {
      flex-direction: column;
      gap: 0.375rem;
      padding: 0.625rem 0.375rem;
      text-align: center;
      font-size: 0.8125rem;
    }
  }
</style>
