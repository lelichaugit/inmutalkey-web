---
// Chat de WhatsApp simulado en un teléfono (diseño actual de la app: cabecera clara, fondo de garabatos, burbujas con
// colita, hora y palomitas dentro de la burbuja). Sin JS se ve completo; con JS (src/scripts/chat.ts) la conversación
// se reproduce al entrar en vista: el médico teclea en la barra de abajo y envía (palomita → dos grises → azules),
// InmutalKey responde con "escribiendo…". No se usa el logo de WhatsApp: el avatar es la llave de InmutalKey.
// Si la conversación empieza con el médico, ese primer mensaje ya está enviado desde el inicio (.ya-enviado): el
// teléfono nunca se ve vacío y solo se reproducen las respuestas.
import Isotipo3D from './Isotipo3D.astro';

export interface Mensaje {
  readonly de: 'medico' | 'inmutalkey';
  readonly texto: string;
  readonly hora: string;
  /** Burbuja de archivo adjunto (nombre del archivo). */
  readonly archivo?: string;
  /** Segunda línea de la burbuja de archivo (tipo, tamaño…). */
  readonly detalleArchivo?: string;
}

interface Props {
  mensajes: readonly Mensaje[];
  etiqueta: string;
  class?: string;
}

const { mensajes, etiqueta, class: clase } = Astro.props;
const horaSistema = mensajes[0]?.hora ?? '10:00';

// id estable por instancia (puede haber dos chats en la página): hash corto de la etiqueta.
let h = 0;
for (const c of etiqueta) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const idFondo = `chat-fondo-${h.toString(36)}`;
---

<figure class:list={['telefono', clase]} data-chat>
  <div class="telefono-marco">
    <div class="telefono-pantalla" role="img" aria-label={etiqueta}>
      <svg class="chat-garabatos" aria-hidden="true" focusable="false">
        <defs>
          <pattern id={idFondo} width="96" height="96" patternUnits="userSpaceOnUse">
            <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 18a6 6 0 1 1 6 6h-6v-6Z"></path>
              <path d="M58 10l4 8 8 1-6 6 2 8-8-4-7 4 2-8-6-6 8-1Z"></path>
              <circle cx="80" cy="56" r="5"></circle>
              <path d="M20 62c4-6 10-6 14 0s10 6 14 0"></path>
              <path d="M66 78h14M73 71v14"></path>
              <path d="M8 86l6-6 6 6"></path>
              <path d="M44 40a4 4 0 0 1 8 0c0 4-4 6-4 9"></path>
            </g>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill={`url(#${idFondo})`}></rect>
      </svg>

      <div class="sistema" aria-hidden="true">
        <span class="sistema-hora">{horaSistema}</span>
        <span class="sistema-isla"></span>
        <span class="sistema-iconos">
          <svg viewBox="0 0 18 12"><path d="M1 9.5h2.4V12H1zM5.2 7h2.4v5H5.2zM9.4 4.4h2.4V12H9.4zM13.6 1.8H16V12h-2.4z"></path></svg>
          <svg viewBox="0 0 16 12" class="sistema-wifi"><path d="M8 11.2 5.6 8.6a3.4 3.4 0 0 1 4.8 0L8 11.2Zm-4.3-4.6L2 4.9a8.5 8.5 0 0 1 12 0l-1.7 1.7a6.1 6.1 0 0 0-8.6 0Z"></path></svg>
          <span class="sistema-bateria"><i></i></span>
        </span>
      </div>

      <div class="chat-cabecera" aria-hidden="true">
        <svg viewBox="0 0 12 20" class="chat-atras"><path d="M10 2 2 10l8 8"></path></svg>
        <span class="chat-avatar"><span class="chat-avatar-llave"><Isotipo3D sizes="24px" /></span></span>
        <span class="chat-contacto">
          <strong>InmutalKey</strong>
          <small data-chat-estado>en línea</small>
        </span>
        <span class="chat-acciones">
          <svg viewBox="0 0 24 24"><rect x="2.5" y="6" width="13" height="12" rx="2.5"></rect><path d="m15.5 10.5 6-3.5v10l-6-3.5"></path></svg>
          <svg viewBox="0 0 24 24"><path d="M6.6 3.5h2.6l1.5 4.2-2 1.5a11 11 0 0 0 6.1 6.1l1.5-2 4.2 1.5v2.6a2 2 0 0 1-2.1 2A16.5 16.5 0 0 1 4.6 5.6a2 2 0 0 1 2-2.1Z"></path></svg>
        </span>
      </div>

      <ol class="chat-mensajes" data-chat-mensajes aria-hidden="true">
        <li class="chat-dia"><span>Hoy</span></li>
        {
          mensajes.map((m, i) => (
            <li
              class:list={[
                'burbuja',
                `de-${m.de}`,
                { 'con-cola': i === 0 || mensajes[i - 1]?.de !== m.de, 'ya-enviado': i === 0 && m.de === 'medico' },
              ]}
              data-mensaje
            >
              {m.archivo && (
                <span class="burbuja-archivo">
                  <span class="archivo-icono">
                    <svg viewBox="0 0 24 24">
                      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" />
                      <path d="M14 3v5h5M12 11v6M9.5 14.5 12 17l2.5-2.5" />
                    </svg>
                  </span>
                  <span>
                    <strong>{m.archivo}</strong>
                    {m.detalleArchivo && <small>{m.detalleArchivo}</small>}
                  </span>
                </span>
              )}
              <span class="burbuja-texto">{m.texto}</span>
              <span class="burbuja-meta">
                {m.hora}
                {m.de === 'medico' && (
                  <svg viewBox="0 0 18 11" class="palomitas">
                    <path class="palomita-1" d="m1 5.8 3.2 3.2L11.2 1.5" />
                    <path class="palomita-2" d="m7.6 8.2.9.8 7.5-7.5" />
                  </svg>
                )}
              </span>
            </li>
          ))
        }
        <li class="burbuja de-inmutalkey con-cola escribiendo" data-escribiendo hidden>
          <i></i><i></i><i></i>
        </li>
      </ol>

      <div class="chat-entrada" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="chat-mas"><path d="M12 5v14M5 12h14"></path></svg>
        <span class="chat-campo">
          <span class="chat-escrito"><span data-chat-escrito></span></span>
          <span class="chat-placeholder">Mensaje</span>
        </span>
        <svg viewBox="0 0 24 24" class="chat-camara"><path d="M4 8.5A2 2 0 0 1 6 6.5h2l1.5-2h5l1.5 2h2a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8.5Z"></path><circle cx="12" cy="12.5" r="3.5"></circle></svg>
        <span class="chat-boton">
          <svg viewBox="0 0 24 24" class="ic-microfono"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5.8 11a6.2 6.2 0 0 0 12.4 0M12 17.3V21"></path></svg>
          <svg viewBox="0 0 24 24" class="ic-enviar"><path d="M5 12 3.8 4.6 20.5 12 3.8 19.4 5 12Zm0 0h7"></path></svg>
        </span>
      </div>
      <span class="telefono-barra-inicio" aria-hidden="true"></span>
    </div>
  </div>
  <figcaption>Conversación de ejemplo</figcaption>
</figure>

<style>
  /* Colores de la app (tema claro). Tipografía del sistema, como en el teléfono. */
  .telefono {
    --wa-fondo: #efeae2;
    --wa-saliente: #d9fdd3;
    --wa-entrante: #ffffff;
    --wa-texto: #111b21;
    --wa-tenue: #667781;
    --wa-azul: #53bdeb;
    --wa-verde: #00a884;
    --wa-barra: #f6f5f3;
    margin: 0;
    width: min(372px, 100%);
    margin-inline: auto;
  }

  .telefono-marco {
    padding: 9px;
    border-radius: 54px;
    background: linear-gradient(150deg, #3a4354 0%, #10151f 30%, #0b0f17 70%, #2b3343 100%);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.14),
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 50px 90px -30px rgb(0 0 0 / 0.85),
      0 0 80px -30px rgb(46 159 224 / 0.35);
  }

  .telefono-pantalla {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 640px;
    border-radius: 45px;
    background: var(--wa-fondo);
    overflow: hidden;
    isolation: isolate;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    color: var(--wa-texto);
    -webkit-font-smoothing: antialiased;
  }

  @media (max-width: 400px) {
    .telefono-marco {
      padding: 7px;
      border-radius: 48px;
    }

    .telefono-pantalla {
      border-radius: 41px;
    }
  }

  /* Celular: pantalla 9:16 (menos alta que la de un teléfono real) para que el teléfono quepa con aire en la vista. */
  @media (max-width: 599px) {
    .telefono {
      width: min(330px, 100%);
    }

    .telefono-pantalla {
      height: auto;
      aspect-ratio: 9 / 16;
      max-height: 560px;
    }
  }

  /* Conversación completa de una vez (sin JS o con movimiento reducido): el teléfono crece para que se lea entera,
     desde el primer mensaje; con la reproducción, los mensajes viejos suben y salen por arriba, como en la app. */
  :global(html:not(.js)) .telefono .telefono-pantalla {
    height: auto;
    min-height: 640px;
    max-height: none;
    aspect-ratio: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .telefono .telefono-pantalla {
      height: auto;
      min-height: 640px;
      max-height: none;
      aspect-ratio: auto;
    }
  }

  @media (max-width: 599px) {
    :global(html:not(.js)) .telefono .telefono-pantalla {
      min-height: 560px;
    }
  }

  @media (max-width: 599px) and (prefers-reduced-motion: reduce) {
    .telefono .telefono-pantalla {
      min-height: 560px;
    }
  }

  .chat-garabatos {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    color: #b8ab98;
    opacity: 0.35;
  }

  /* ── Barra del sistema ── */
  .sistema {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 46px;
    padding: 6px 26px 0 34px;
    background: var(--wa-barra);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .sistema-isla {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 98px;
    height: 28px;
    margin-left: -49px;
    border-radius: 20px;
    background: #000;
  }

  .sistema-iconos {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .sistema-iconos svg {
    width: 17px;
    height: 11px;
    fill: var(--wa-texto);
  }

  .sistema-iconos .sistema-wifi {
    width: 15px;
  }

  .sistema-bateria {
    position: relative;
    width: 24px;
    height: 11.5px;
    padding: 1.5px;
    border: 1px solid rgb(17 27 33 / 0.4);
    border-radius: 4px;
  }

  .sistema-bateria::after {
    content: '';
    position: absolute;
    top: 3px;
    right: -3.5px;
    width: 2px;
    height: 4px;
    border-radius: 0 1px 1px 0;
    background: rgb(17 27 33 / 0.4);
  }

  .sistema-bateria i {
    display: block;
    width: 78%;
    height: 100%;
    border-radius: 2px;
    background: var(--wa-texto);
  }

  /* ── Cabecera del chat ── */
  .chat-cabecera {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 14px 9px 10px;
    border-bottom: 1px solid rgb(0 0 0 / 0.07);
    background: var(--wa-barra);
  }

  .chat-atras {
    width: 12px;
    height: 20px;
    flex: none;
    margin: 0 2px;
    fill: none;
    stroke: var(--wa-texto);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chat-avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 35%, #173262, var(--navy) 70%);
    overflow: hidden;
  }

  .chat-avatar-llave {
    display: block;
    height: 30px;
  }

  .chat-contacto {
    display: grid;
    flex: 1;
    min-width: 0;
    line-height: 1.2;
  }

  .chat-contacto strong {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .chat-contacto small {
    color: var(--wa-tenue);
    font-size: 0.8125rem;
  }

  .chat-acciones {
    display: inline-flex;
    gap: 20px;
  }

  .chat-acciones svg {
    width: 23px;
    height: 23px;
    fill: none;
    stroke: var(--wa-texto);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  /* ── Mensajes ── */
  .chat-mensajes {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: 3px;
    min-height: 0;
    margin: 0;
    padding: 10px 14px 10px;
    list-style: none;
    overflow: hidden;
  }

  .chat-dia {
    align-self: center;
    margin-bottom: 8px;
    padding: 4px 12px;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 1px 0.5px rgb(11 20 26 / 0.13);
    color: var(--wa-tenue);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .burbuja {
    position: relative;
    max-width: 84%;
    padding: 6px 8px 7px 9px;
    border-radius: 9px;
    font-size: 0.96875rem;
    line-height: 1.32;
    box-shadow: 0 1px 0.5px rgb(11 20 26 / 0.13);
    overflow-wrap: anywhere;
  }

  .con-cola {
    margin-top: 8px;
  }

  .de-medico {
    align-self: flex-end;
    background: var(--wa-saliente);
  }

  .de-inmutalkey {
    align-self: flex-start;
    background: var(--wa-entrante);
  }

  /* La colita (solo la primera burbuja de cada turno), arriba, como en la app. */
  .con-cola.de-medico {
    border-top-right-radius: 0;
  }

  .con-cola.de-inmutalkey {
    border-top-left-radius: 0;
  }

  .con-cola::before {
    content: '';
    position: absolute;
    top: 0;
    width: 8px;
    height: 13px;
  }

  .con-cola.de-medico::before {
    right: -8px;
    background: var(--wa-saliente);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .con-cola.de-inmutalkey::before {
    left: -8px;
    background: var(--wa-entrante);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }

  .burbuja-texto {
    display: block;
  }

  /* Reserva al final del último renglón el lugar de la hora (y las palomitas), como en la app. */
  .burbuja-texto::after {
    content: '';
    display: inline-block;
    width: 3.4em;
  }

  .de-medico .burbuja-texto::after {
    width: 4.7em;
  }

  .burbuja-meta {
    position: absolute;
    right: 8px;
    bottom: 4px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--wa-tenue);
    font-size: 0.6875rem;
    line-height: 1;
  }

  .palomitas {
    width: 17px;
    height: 11px;
    fill: none;
    stroke: var(--wa-azul);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .burbuja-archivo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 -3px 6px -4px;
    padding: 10px;
    border-radius: 7px;
    background: rgb(0 0 0 / 0.045);
    line-height: 1.25;
  }

  .burbuja-archivo > span:last-child {
    display: grid;
    min-width: 0;
  }

  .burbuja-archivo strong {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .burbuja-archivo small {
    color: var(--wa-tenue);
    font-size: 0.75rem;
  }

  .archivo-icono {
    display: grid;
    place-items: center;
    width: 36px;
    height: 42px;
    flex: none;
    border-radius: 5px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  .archivo-icono svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--wa-verde);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Indicador "escribiendo" dentro del chat */
  .escribiendo {
    display: inline-flex;
    gap: 4px;
    padding: 12px 14px;
  }

  .escribiendo[hidden] {
    display: none;
  }

  .escribiendo i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #8696a0;
    animation: punto 1.2s infinite;
  }

  .escribiendo i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .escribiendo i:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes punto {
    0%,
    60%,
    100% {
      transform: none;
      opacity: 0.45;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }

  /* ── Con JS (y sin "reducir movimiento"): los mensajes esperan su turno y las palomitas avanzan ── */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .burbuja[data-mensaje]:not(.ya-enviado) {
      display: none;
    }

    :global(.js) .burbuja[data-mensaje].es-visible:not(.ya-enviado) {
      display: block;
      animation: llega 0.38s cubic-bezier(0.16, 1, 0.3, 1);
    }

    :global(.js) .burbuja[data-mensaje]:not(.es-leido) .palomitas {
      stroke: #8696a0;
    }

    /* El primero ya salió: dos palomitas grises hasta que InmutalKey lo lee. */
    :global(.js) .burbuja[data-mensaje]:not(.es-entregado):not(.ya-enviado) .palomita-2 {
      opacity: 0;
    }
  }

  .de-medico {
    transform-origin: 100% 100%;
  }

  .de-inmutalkey {
    transform-origin: 0 100%;
  }

  @keyframes llega {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
  }

  .palomitas path {
    transition:
      opacity 0.2s,
      stroke 0.3s;
  }

  /* ── Barra para escribir ── */
  .chat-entrada {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px 6px;
    background: var(--wa-barra);
    border-top: 1px solid rgb(0 0 0 / 0.06);
  }

  .chat-mas,
  .chat-camara,
  .chat-boton svg {
    width: 25px;
    height: 25px;
    flex: none;
    fill: none;
    stroke: var(--wa-texto);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chat-campo {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    height: 36px;
    padding: 0 12px;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 18px;
    background: #fff;
    overflow: hidden;
    font-size: 0.9375rem;
  }

  .chat-placeholder {
    position: absolute;
    left: 12px;
    color: #8696a0;
  }

  /* Lo que se teclea, alineado a la izquierda; si ya no cabe, se recorta por la izquierda y se ve el final, como al
     escribir (contenedor RTL + texto LTR aislado: lo que desborda sale por el lado inicial). Va en posición absoluta
     para que el renglón largo no ensanche el teléfono ni la rejilla que lo contiene. */
  .chat-escrito {
    position: absolute;
    inset: 0 12px;
    display: none;
    direction: rtl;
    text-align: left;
    line-height: 34px;
    white-space: nowrap;
    overflow: hidden;
  }

  .tecleando .chat-escrito {
    display: block;
  }

  .chat-escrito > span {
    direction: ltr;
    unicode-bidi: isolate;
  }

  .chat-escrito > span::after {
    content: '';
    display: inline-block;
    width: 1.5px;
    height: 1.15em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: #1a8cff;
    animation: cursor 1s steps(1) infinite;
  }

  @keyframes cursor {
    50% {
      opacity: 0;
    }
  }

  .tecleando .chat-placeholder {
    opacity: 0;
  }

  .chat-boton {
    position: relative;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 50%;
  }

  .chat-boton svg {
    grid-area: 1 / 1;
    transition:
      opacity 0.2s,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ic-enviar {
    opacity: 0;
    transform: scale(0.6);
  }

  .tecleando .chat-boton {
    background: var(--wa-verde);
  }

  .tecleando .chat-camara {
    display: none;
  }

  .tecleando .ic-microfono {
    opacity: 0;
    transform: scale(0.6);
  }

  .tecleando .ic-enviar {
    opacity: 1;
    transform: none;
    stroke: #fff;
    width: 19px;
    height: 19px;
  }

  .telefono-barra-inicio {
    display: block;
    width: 128px;
    height: 5px;
    margin: 8px auto 8px;
    border-radius: 3px;
    background: var(--wa-texto);
  }

