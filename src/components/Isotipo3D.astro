---
// El logo principal: la llave 3D con transparencia real (scripts/generar-marca.mjs, desde capturas/logomain-*) y, si
// se pide, su "plano técnico" (contorno vectorial alineado al píxel, scripts/vectorizar-llave.py) con un escáner.
//
// Variables que controla el padre (todas opcionales; sin ellas la llave se ve completa y quieta):
//   --materia   0 → 1  cuánto de la llave es sólido, de arriba hacia abajo. Debajo del escáner se ve el plano técnico.
//                      Registrada con @property en global.css: se puede animar con @keyframes.
//   --brillo    0 → 1  posición de la luz que recorre la llave (con `brillo`). Sin ella, la luz cruza una vez al cargar.
//   --reflejo   0 → 1  intensidad del reflejo en el "piso" (con `reflejo`; por omisión 0.3).
// La llave toma el ALTO de su contenedor (height) y calcula su ancho con la proporción del render.
import contorno from '../data/llave-contorno.json';
import marca from '../data/marca.json';
import Logo from './Logo.astro';

interface Props {
  /** Ancho con que se mostrará, para `sizes`. */
  sizes?: string;
  /** Solo el del hero: es el elemento más grande del primer pintado. */
  prioridad?: boolean;
  /** `null` = decorativo. */
  alt?: string | null;
  /** Luz que recorre la llave, recortada a su silueta. */
  brillo?: boolean;
  /** Plano técnico debajo del render + línea de escáner en el borde de `--materia`. */
  plano?: boolean;
  /** Reflejo tenue debajo, como sobre un piso pulido (misma imagen: no hay segunda descarga). */
  reflejo?: boolean;
  class?: string;
}

const {
  sizes = '200px',
  prioridad = false,
  alt = null,
  brillo = false,
  plano = false,
  reflejo = false,
  class: clase,
} = Astro.props;
const llave = marca.llave;
const anchos = llave.disponible && 'anchos' in llave ? llave.anchos : [];
const mayor = anchos.at(-1);
const srcset = (ext: string) => anchos.map((w) => `/brand/llave-3d-${w}.${ext} ${w}w`).join(', ');
const ancho = llave.disponible && 'ancho' in llave ? llave.ancho : 304;
const alto = llave.disponible && 'alto' in llave ? llave.alto : 724;
---

{
  llave.disponible && mayor !== undefined ? (
    <span class:list={['isotipo-3d', 'es-render', { 'con-plano': plano }, clase]} data-llave>
      {
        plano && (
          <svg class="llave-plano" viewBox={contorno.viewBox} aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" d={contorno.d} />
          </svg>
        )
      }
      <picture class="llave-render">
        <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
        <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
        <img
          src={`/brand/llave-3d-${mayor}.webp`}
          width={ancho}
          height={alto}
          alt={alt ?? ''}
          decoding="async"
          loading={prioridad ? 'eager' : 'lazy'}
          fetchpriority={prioridad ? 'high' : 'auto'}
          draggable="false"
        />
      </picture>
      {brillo && <span class="isotipo-brillo" aria-hidden="true" />}
      {
        reflejo && (
          <span class="llave-reflejo" aria-hidden="true">
            <picture>
              <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
              <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
              <img
                src={`/brand/llave-3d-${mayor}.webp`}
                width={ancho}
                height={alto}
                alt=""
                decoding="async"
                loading={prioridad ? 'eager' : 'lazy'}
                draggable="false"
              />
            </picture>
          </span>
        )
      }
      {
        plano && (
          <span class="llave-escaner" aria-hidden="true">
            <span />
          </span>
        )
      }
    </span>
  ) : (
    <span class:list={['isotipo-3d', 'es-plano', clase]}>
      <Logo variante="solido" titulo={alt} />
      {brillo && <span class="isotipo-brillo" aria-hidden="true" />}
    </span>
  )
}

<style>
  .isotipo-3d {
    display: block;
    position: relative;
    height: 100%;
    color: #fff;
  }

  .es-render {
    aspect-ratio: 304 / 724;
    width: auto;
  }

  .llave-render,
  .llave-render img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .llave-render img {
    user-select: none;
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
  }

  /* ── Plano técnico + escáner (solo con `plano`) ── */

  /* El render se descubre de arriba hacia abajo; debajo del escáner queda el plano técnico. */
  .con-plano .llave-render {
    clip-path: inset(0 0 calc((1 - var(--materia, 1)) * 100%) 0);
  }

  .llave-plano {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--azul-vivo);
    clip-path: inset(calc(var(--materia, 1) * 100%) 0 0 0);
    opacity: 0.9;
  }

  @media (hover: hover) and (pointer: fine) {
    .llave-plano {
      filter: drop-shadow(0 0 5px rgb(46 159 224 / 0.55));
    }
  }

  /* La línea del escáner viaja con --materia (transform: sin recalcular el layout) y solo se ve a medio camino. */
  .llave-escaner {
    position: absolute;
    inset: 0 -22%;
    transform: translate3d(0, calc(var(--materia, 1) * 100%), 0);
    opacity: clamp(0, calc(min(var(--materia, 1), 1 - var(--materia, 1)) * 14), 1);
    pointer-events: none;
  }

  .llave-escaner span {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--azul-vivo) 22%, #e8f6ff 50%, var(--azul-vivo) 78%, transparent);
    box-shadow:
      0 0 14px 2px rgb(46 159 224 / 0.75),
      0 0 42px 8px rgb(46 159 224 / 0.28);
    border-radius: 2px;
  }

  /* ── Reflejo ──
     Copia volteada bajo la llave. La máscara (en coordenadas sin voltear) deja ver solo el tercio cercano al "piso";
     con `plano`, el reflejo se materializa igual que la llave (el recorte también se voltea: físicamente correcto). */
  .llave-reflejo {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 100%;
    margin-top: 1.5%;
    transform: scaleY(-1);
    -webkit-mask-image: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.12) 18%, transparent 34%);
    mask-image: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.12) 18%, transparent 34%);
    opacity: var(--reflejo, 0.3);
    pointer-events: none;
  }

  .llave-reflejo picture,
  .llave-reflejo img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .con-plano .llave-reflejo picture {
    clip-path: inset(0 0 calc((1 - var(--materia, 1)) * 100%) 0);
  }

  /* ── Brillo ── */

  .isotipo-brillo {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 38%,
      rgb(150 210 255 / 0.45) 47%,
      rgb(255 255 255 / 0.9) 50%,
      rgb(150 210 255 / 0.45) 53%,
      transparent 62%
    );
    background-size: 260% 100%;
    background-position: calc(130% - var(--brillo, 1) * 170%) 0;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    opacity: 0.75;
    pointer-events: none;
    animation: brillo-entrada 2.6s cubic-bezier(0.16, 1, 0.3, 1) 0.6s backwards;
  }

  .es-render .isotipo-brillo {
    -webkit-mask-image: url('/brand/llave-silueta.webp');
    mask-image: url('/brand/llave-silueta.webp');
  }

  .con-plano .isotipo-brillo {
    clip-path: inset(0 0 calc((1 - var(--materia, 1)) * 100%) 0);
  }

  .es-plano .isotipo-brillo {
    -webkit-mask-image: url('/brand/logo-solido.svg');
    mask-image: url('/brand/logo-solido.svg');
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  @keyframes brillo-entrada {
    from {
      background-position: 180% 0;
    }
  }

  .es-plano :global(.logo) {
    height: 100%;
    filter: drop-shadow(0 0 28px rgb(46 159 224 / 0.35)) drop-shadow(0 18px 40px rgb(0 0 0 / 0.55));
  }

  @media (prefers-reduced-motion: reduce) {
    .isotipo-brillo {
      display: none;
    }
  }
</style>
