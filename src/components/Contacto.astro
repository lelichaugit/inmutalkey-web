---
// Datos de contacto (WhatsApp, correo y redes) desde src/site.config.ts y src/data/socials.ts. Solo aparece lo definido.
//   lista  · tipo + valor, uno por renglón (pie de página)
//   fila   · píldoras en línea que se acomodan solas (cierre, menú del celular)
import { correoContacto, REDES, REL_EXTERNO, REL_PERFIL_PROPIO, type IdRed } from '../data/socials';
import { enlaceWhatsApp, numeroVisible } from '../lib/whatsapp';
import { sitio } from '../site.config';
import Icono from './Icono.astro';
import IconoMarca from './IconoMarca.astro';

type Medio = 'whatsapp' | 'correo' | IdRed;

interface Props {
  variante?: 'lista' | 'fila';
  /** Mensaje prellenado de WhatsApp: distinto por sección para saber de dónde escribió el médico. */
  mensaje?: string;
  /** Fondo sobre el que va (cambia los colores). */
  tono?: 'oscuro' | 'claro';
  /** Qué medios mostrar (por omisión, todos los definidos). */
  incluir?: ReadonlyArray<Medio>;
  class?: string;
}

const {
  variante = 'lista',
  mensaje = sitio.contacto.mensajeWhatsApp,
  tono = 'oscuro',
  incluir = ['whatsapp', 'correo', 'instagram', 'x', 'linkedin'],
  class: clase,
} = Astro.props;
const whatsapp = incluir.includes('whatsapp') ? enlaceWhatsApp(sitio.contacto.whatsapp, mensaje) : null;
const telefono = numeroVisible(sitio.contacto.whatsapp);
const correo = incluir.includes('correo') ? correoContacto() : null;
const redes = REDES.filter((r) => incluir.includes(r.id));
---

<ul class:list={['contacto', `contacto-${variante}`, `contacto-${tono}`, clase]}>
  {
    whatsapp && telefono && (
      <li>
        <a href={whatsapp} target="_blank" rel={REL_EXTERNO}>
          <Icono nombre="chat" />
          <span class="contacto-texto">
            <span class="contacto-tipo">WhatsApp</span>
            <span class="contacto-valor sin-corte">{telefono}</span>
          </span>
        </a>
      </li>
    )
  }
  {
    correo && (
      <li>
        <a href={`mailto:${correo}`}>
          <Icono nombre="correo" />
          <span class="contacto-texto">
            <span class="contacto-tipo">Correo</span>
            <span class="contacto-valor">{correo}</span>
          </span>
        </a>
      </li>
    )
  }
  {
    redes.map((red) => (
      <li>
        <a href={red.url} target="_blank" rel={red.propio ? REL_PERFIL_PROPIO : REL_EXTERNO}>
          <IconoMarca nombre={red.icono} />
          <span class="contacto-texto">
            <span class="contacto-tipo">{red.nombre}</span>
            <span class="contacto-valor">{red.handle}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .contacto {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contacto a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    color: var(--texto);
    font-weight: 500;
    text-decoration: none;
  }

  .contacto a :global(.icono),
  .contacto a :global(.icono-marca) {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: var(--primario);
  }

  .contacto-texto {
    display: grid;
    min-width: 0;
  }

  .contacto-tipo {
    color: var(--texto-2);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .contacto-valor {
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }

  .contacto-lista {
    display: grid;
    gap: 0.25rem;
  }

  .contacto-lista a:hover .contacto-valor,
  .contacto-lista a:focus-visible .contacto-valor {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .contacto-fila {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .contacto-fila a {
    padding: 0.375rem 1rem 0.375rem 0.75rem;
    border: 1px solid var(--cristal-borde);
    border-radius: 999px;
    background: var(--grad-tarjeta);
    box-shadow: var(--cristal-brillo), var(--elev-1);
    transition:
      border-color 160ms ease,
      box-shadow 200ms ease,
      transform 160ms var(--curva-cristal);
  }

  .contacto-fila .contacto-texto {
    display: flex;
    gap: 0.375rem;
    align-items: baseline;
  }

  .contacto-fila .contacto-tipo {
    font-size: 0.8125rem;
  }

  .contacto-fila a:hover {
    border-color: color-mix(in srgb, var(--acento) 42%, var(--borde));
    box-shadow: var(--cristal-brillo), var(--elev-2), var(--halo-acento);
  }

  .contacto-fila a:active {
    transform: scale(0.97);
  }
</style>
