---
// Barra de navegación de cristal fija (equivale a `.barra-superior.topbar` de la app): logo, secciones, tema y CTA.
// Cristal real (backdrop-filter): es cromo. En celular, las secciones viven en un <details> (funciona sin JS).
import Icono from './Icono.astro';
import Logo from './Logo.astro';
import SelectorTema from './SelectorTema.astro';

const ENLACES = [
  { id: 'como-funciona', texto: 'Cómo funciona' },
  { id: 'recetas', texto: 'Recetas' },
  { id: 'seguridad', texto: 'Seguridad' },
  { id: 'fundadores', texto: 'Fundadores' },
  { id: 'preguntas', texto: 'Preguntas' },
] as const;
---

<header class="nav" data-nav>
  <div class="nav-barra">
    <a class="nav-marca" href="/" aria-label="InmutalKey, ir al inicio">
      <Logo alto={2} />
    </a>

    <nav class="nav-enlaces" aria-label="Principal">
      <ul>
        {ENLACES.map((e) => <li><a href={`/#${e.id}`} data-seccion={e.id}>{e.texto}</a></li>)}
      </ul>
    </nav>

    <div class="nav-acciones">
      <SelectorTema class="nav-tema" />
      <a class="boton boton-primario nav-cta" href="/fundadores">
        <span class="nav-cta-largo">Solicitar acceso Fundador</span><span class="nav-cta-corto">Acceso Fundador</span>
      </a>
      <details class="nav-menu" data-nav-menu>
        <summary aria-label="Menú">
          <Icono nombre="menu" class="nav-menu-abrir" />
          <Icono nombre="cerrar" class="nav-menu-cerrar" />
        </summary>
        <div class="nav-hoja cristal">
          <nav aria-label="Secciones">
            <ul>
              {ENLACES.map((e) => <li><a href={`/#${e.id}`}>{e.texto}<Icono nombre="flecha" /></a></li>)}
              <li><a href="/descarga">Descarga<Icono nombre="flecha" /></a></li>
              <li><a href="/contacto">Contacto<Icono nombre="flecha" /></a></li>
            </ul>
          </nav>
          <SelectorTema class="nav-hoja-tema" />
          <a class="boton boton-primario boton-grande" href="/fundadores">Solicitar acceso Fundador</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 0.625rem var(--medianil) 0;
    pointer-events: none;
  }

  .nav-barra {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(100%, var(--ancho-amplio));
    height: var(--altura-nav);
    margin-inline: auto;
    padding: 0 0.5rem 0 1rem;
    border: 1px solid var(--cristal-borde);
    border-radius: var(--radio-lg);
    background: linear-gradient(180deg, var(--cristal-denso), var(--cristal));
    box-shadow:
      var(--cristal-brillo),
      0 8px 24px -18px rgb(3 35 64 / 0.6);
    -webkit-backdrop-filter: var(--cristal-blur);
    backdrop-filter: var(--cristal-blur);
    transition:
      transform 420ms var(--curva-cristal),
      box-shadow 240ms ease;
  }

  .nav[data-scroll='si'] .nav-barra {
    box-shadow:
      var(--cristal-brillo),
      var(--elev-2);
  }

  /* Al bajar se retira; al subir vuelve (base.ts). Solo transform. */
  .nav[data-oculta='si'] .nav-barra {
    transform: translateY(calc(-100% - 1rem));
  }

  .nav-marca {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.25rem;
    margin-left: -0.25rem;
    color: var(--texto);
    text-decoration: none;
  }

  .nav-marca :global(.logo-simbolo) {
    transition: transform 900ms cubic-bezier(0.45, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  /* Guiño 3D al pasar el cursor (anticipa el giro, §2). */
  .nav-marca:hover :global(.logo-simbolo) {
    transform: perspective(220px) rotateY(-22deg) scale(1.04);
  }

  .nav-enlaces {
    margin-inline: auto;
  }

  .nav-enlaces ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-enlaces a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.875rem;
    border-radius: var(--radio-sm);
    color: var(--texto-2);
    font-size: 0.9375rem;
    font-weight: 560;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .nav-enlaces a:hover,
  .nav-enlaces a[aria-current='true'] {
    background: color-mix(in srgb, var(--texto) 6%, transparent);
    color: var(--texto);
  }

  .nav-acciones {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .nav-enlaces + .nav-acciones {
    margin-left: 0;
  }

  .nav-cta {
    min-height: 2.75rem;
    padding-inline: 1rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .nav-cta-corto {
    display: none;
  }

  .nav-menu {
    position: relative;
    display: none;
  }

  .nav-menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radio-sm);
    color: var(--texto);
    cursor: pointer;
    list-style: none;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-menu summary:hover {
    background: color-mix(in srgb, var(--texto) 6%, transparent);
  }

  .nav-menu :global(.nav-menu-cerrar),
  .nav-menu[open] :global(.nav-menu-abrir) {
    display: none;
  }

  .nav-menu[open] :global(.nav-menu-cerrar) {
    display: block;
  }

  .nav-hoja {
    position: absolute;
    top: calc(100% + 0.875rem);
    right: -0.5rem;
    display: grid;
    gap: 1rem;
    width: min(22rem, calc(100vw - 2 * var(--medianil)));
    padding: 0.75rem;
    border-radius: var(--radio-xl);
    /* Dentro de la barra (que ya es la raíz del desenfoque) el blur no alcanza la página: superficie casi opaca. */
    background: color-mix(in srgb, var(--superficie) 97%, transparent);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    animation: hoja-entrada 300ms var(--curva-cristal);
  }

  @keyframes hoja-entrada {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  .nav-hoja ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-hoja li + li {
    border-top: 1px solid var(--linea);
  }

  .nav-hoja a:not(.boton) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    padding: 0 0.75rem;
    border-radius: var(--radio-sm);
    color: var(--texto);
    font-size: 1.0625rem;
    font-weight: 560;
    text-decoration: none;
  }

  .nav-hoja a:not(.boton) :global(.icono) {
    color: var(--texto-2);
  }

  .nav-hoja > :global(.nav-hoja-tema) {
    justify-self: center;
  }

  @media (max-width: 68rem) {
    .nav-enlaces {
      display: none;
    }

    .nav-menu {
      display: block;
    }

    .nav-acciones > :global(.nav-tema) {
      display: none !important;
    }
  }

  @media (max-width: 30rem) {
    .nav-barra {
      padding-left: 0.75rem;
      gap: 0.5rem;
    }

    .nav-cta-largo {
      display: none;
    }

    .nav-cta-corto {
      display: inline;
    }

    .nav-cta {
      padding-inline: 0.75rem;
    }
  }

  @media (max-width: 23.5rem) {
    .nav-marca :global(.logo-nombre) {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav-barra {
      background: var(--superficie);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
