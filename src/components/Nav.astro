---
import { enlaceWhatsApp } from '../lib/whatsapp';
import { sitio } from '../site.config';
import Compartir from './Compartir.astro';
import Contacto from './Contacto.astro';
import Icono from './Icono.astro';
import Logo from './Logo.astro';

interface Props {
  /**
   * Portada: el isotipo de la barra espera a que el logo principal (render 3D del hero,
   * marcado con `data-isotipo-principal`) salga de la vista, como si se "acomodara" en la barra.
   */
  logoDiferido?: boolean;
}

const { logoDiferido = false } = Astro.props;
const prueba = enlaceWhatsApp(sitio.contacto.whatsapp, sitio.contacto.mensajes.prueba);

const ENLACES = [
  { id: 'integridad', texto: 'Cómo funciona' },
  { id: 'demo', texto: 'Pruébalo' },
  { id: 'incluye', texto: 'Qué incluye' },
  { id: 'fundadores', texto: 'Fundadores' },
  { id: 'preguntas', texto: 'Preguntas' },
] as const;
---

<header class="nav" data-nav data-logo={logoDiferido ? 'diferido' : 'visible'}>
  <div class="contenedor nav-fila">
    <a class="nav-marca" href="/" aria-label="InmutalKey, ir al inicio">
      <Logo titulo={null} class="nav-isotipo" />
      <span class="nav-titulos" aria-hidden="true">
        <span class="nav-nombre">InmutalKey</span>
        <span class="nav-capitulo" data-nav-capitulo></span>
      </span>
    </a>

    <nav class="nav-enlaces" aria-label="Principal">
      <ul>
        {ENLACES.map((e) => <li><a href={`/#${e.id}`} data-seccion={e.id} data-etiqueta={e.texto}>{e.texto}</a></li>)}
      </ul>
      <span class="nav-indicador" data-nav-indicador aria-hidden="true"></span>
    </nav>

    {
      prueba && (
        <a class="boton boton-primario boton-chico nav-cta" href={prueba} target="_blank" rel="noopener noreferrer">
          <Icono nombre="chat" />
          <span>
            Escríbenos<span class="nav-cta-largo"> por WhatsApp</span>
          </span>
        </a>
      )
    }

    <details class="nav-menu" data-nav-menu>
      <summary>
        <Icono nombre="menu" class="nav-menu-abrir" />
        <Icono nombre="cerrar" class="nav-menu-cerrar" />
        <span class="visualmente-oculto">Menú</span>
      </summary>
      <div class="nav-hoja" data-lenis-prevent>
        <nav aria-label="Menú">
          <ul>
            {ENLACES.map((e, i) => (
              <li>
                <a href={`/#${e.id}`} data-seccion={e.id}>
                  <span class="nav-hoja-num" aria-hidden="true">0{i + 1}</span>
                  {e.texto}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        {
          prueba && (
            <a class="boton boton-primario nav-hoja-cta" href={prueba} target="_blank" rel="noopener noreferrer">
              <Icono nombre="chat" /> Pide tus {sitio.licencia.diasPrueba} días de prueba
            </a>
          )
        }
        <Compartir variante="enlace" class="nav-hoja-compartir" />
        <Contacto variante="fila" incluir={['correo', 'instagram']} class="nav-hoja-contacto" />
        <p class="nav-hoja-pie">Sin internet · Diseñado para la NOM-004 · Windows 10 y 11</p>
      </div>
    </details>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--altura-nav);
    border-bottom: 1px solid transparent;
    view-transition-name: barra;
    transition:
      background-color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      transform 0.45s var(--ease);
  }

  /* Sin JS o con scroll: barra sólida translúcida. Arriba del todo: transparente sobre el hero. */
  .nav,
  :global(.js) .nav[data-scroll='si'] {
    background: rgb(6 11 22 / 0.78);
    border-bottom-color: var(--linea-oscura);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    backdrop-filter: blur(16px) saturate(150%);
  }

  /* Con el menú abierto, sin backdrop-filter ni transform: ambos harían de la barra el marco del panel fijo. */
  .nav:has(.nav-menu[open]),
  :global(.js) .nav:has(.nav-menu[open]) {
    background: var(--medianoche);
    border-bottom-color: var(--linea-oscura);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    transform: none;
  }

  :global(.js) .nav:not([data-scroll='si']):not(:has(.nav-menu[open])) {
    background: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Se esconde al bajar y regresa al subir: más espacio para leer. */
  :global(.js) .nav[data-oculta='si'] {
    transform: translateY(-100%);
  }

  .nav-fila {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.5vw, 32px);
    height: 100%;
  }

  .nav-marca {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    color: #fff;
    text-decoration: none;
    font-size: 2.25rem;
    border-radius: 8px;
  }

  /* Marca y título de sección comparten lugar: en móvil, dentro de una sección, se ve dónde estás. */
  .nav-titulos {
    display: grid;
    align-items: center;
  }

  .nav-nombre,
  .nav-capitulo {
    grid-area: 1 / 1;
    font-family: var(--fuente-titulo);
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    white-space: nowrap;
    transition:
      opacity 0.35s var(--ease),
      transform 0.45s var(--ease);
  }

  .nav-capitulo {
    color: var(--texto);
    font-size: 1.125rem;
    opacity: 0;
    transform: translateY(60%);
  }

  @media (max-width: 1079px) {
    :global(.js) .nav[data-capitulo='si'] .nav-nombre {
      opacity: 0;
      transform: translateY(-60%);
    }

    :global(.js) .nav[data-capitulo='si'] .nav-capitulo {
      opacity: 1;
      transform: none;
    }

    :global(.js) .nav-capitulo:global(.es-nuevo) {
      animation: capitulo-entra 0.45s var(--ease);
    }
  }

  @keyframes capitulo-entra {
    from {
      opacity: 0;
      transform: translateY(60%);
    }
  }

  .nav-marca :global(.nav-isotipo) {
    transition:
      opacity 0.5s var(--ease),
      transform 0.6s var(--ease);
  }

  :global(.js) .nav[data-logo='diferido'] .nav-marca :global(.nav-isotipo) {
    opacity: 0;
    transform: translateY(10px) scale(0.6);
  }

  /* ── Enlaces con indicador de sección ── */
  .nav-enlaces {
    position: relative;
  }

  .nav-enlaces ul,
  .nav-hoja ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-enlaces ul {
    display: flex;
    gap: 4px;
  }

  .nav-enlaces a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 999px;
    color: var(--texto-tenue);
    font-size: 0.975rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }

  .nav-enlaces a:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.05);
  }

  .nav-enlaces a[aria-current='true'] {
    color: #fff;
  }

  .nav-indicador {
    position: absolute;
    left: 0;
    bottom: -3px;
    width: var(--w, 0);
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--azul), var(--azul-vivo));
    box-shadow: 0 0 12px rgb(46 159 224 / 0.8);
    opacity: var(--o, 0);
    transform: translateX(var(--x, 0));
    transition:
      transform 0.5s var(--ease),
      width 0.5s var(--ease),
      opacity 0.3s var(--ease);
    pointer-events: none;
  }

  .nav-cta-largo {
    display: none;
  }

  /* ── Menú móvil: hoja a pantalla completa ── */
  .nav-menu summary {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--linea-oscura-fuerte);
    border-radius: 999px;
    cursor: pointer;
    list-style: none;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-menu summary :global(.icono) {
    width: 22px;
    height: 22px;
  }

  .nav-menu :global(.nav-menu-cerrar),
  .nav-menu[open] :global(.nav-menu-abrir) {
    display: none;
  }

  .nav-menu[open] :global(.nav-menu-cerrar) {
    display: block;
  }

  .nav-hoja {
    position: fixed;
    inset: var(--altura-nav) 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 28px var(--margen) calc(28px + env(safe-area-inset-bottom));
    background:
      radial-gradient(80% 50% at 100% 100%, rgb(1 120 176 / 0.35), transparent 70%),
      var(--medianoche);
    overflow-y: auto;
    animation: hoja 0.45s var(--ease);
  }

  @keyframes hoja {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  .nav-hoja li {
    border-bottom: 1px solid var(--linea-oscura);
    animation: hoja-enlace 0.5s var(--ease) backwards;
  }

  .nav-hoja li:nth-child(2) {
    animation-delay: 0.04s;
  }
  .nav-hoja li:nth-child(3) {
    animation-delay: 0.08s;
  }
  .nav-hoja li:nth-child(4) {
    animation-delay: 0.12s;
  }
  .nav-hoja li:nth-child(5) {
    animation-delay: 0.16s;
  }

  @keyframes hoja-enlace {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .nav-hoja a[data-seccion] {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 18px 0;
    font-family: var(--fuente-titulo);
    font-size: clamp(1.75rem, 7vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav-hoja a[aria-current='true'] {
    color: var(--azul-vivo);
  }

  .nav-hoja-num {
    font-family: var(--fuente-texto);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--texto-tenue);
  }

  .nav-hoja-cta {
    align-self: stretch;
  }

  .nav-hoja :global(.nav-hoja-compartir) {
    align-self: center;
  }

  .nav-hoja :global(.nav-hoja-contacto) {
    justify-content: center;
  }

  /* Celulares de pantalla baja: renglones más compactos para que botón, compartir y contacto quepan sin desplazar. */
  @media (max-height: 820px) {
    .nav-hoja {
      gap: 18px;
      padding-top: 12px;
    }

    .nav-hoja a[data-seccion] {
      padding: 11px 0;
      font-size: clamp(1.5rem, 6.4vw, 1.875rem);
    }

    .nav-hoja-pie {
      display: none;
    }
  }

  .nav-hoja-pie {
    margin-top: auto;
    color: var(--texto-tenue);
    font-size: 0.9375rem;
  }

  @media (max-width: 1079px) {
    .nav-enlaces {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .nav-nombre {
      font-size: 1.125rem;
    }
    .nav-capitulo {
      font-size: 1rem;
    }
    .nav-cta {
      padding-inline: 0.9em;
    }
  }

  @media (min-width: 1080px) {
    .nav-menu {
      display: none;
    }
  }

  @media (min-width: 1280px) {
    .nav-cta-largo {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-hoja,
    .nav-hoja li {
      animation: none;
    }
  }
</style>
