---
// "Compartir con un colega": en el teléfono abre la hoja nativa (WhatsApp, mensajes…) vía base.ts;
// sin Web Share API o sin JS, es un enlace de WhatsApp con el texto ya escrito.
import { sitio } from '../site.config';
import Icono from './Icono.astro';

interface Props {
  variante?: 'boton' | 'enlace';
  class?: string;
}

const { variante = 'boton', class: clase } = Astro.props;
const texto = `Mira InmutalKey: expediente clínico para consultorio, con notas selladas y sin internet. Se puede probar ${sitio.licencia.diasPrueba} días.`;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${texto} ${sitio.url}`)}`;
---

<a
  class:list={[variante === 'boton' ? 'boton boton-secundario' : 'compartir-enlace', clase]}
  href={whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  data-compartir
  data-titulo={sitio.nombre}
  data-texto={texto}
  data-url={sitio.url}
>
  <Icono nombre="compartir" />
  Compartir con un colega
</a>

<style>
  .compartir-enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    color: var(--texto-tenue);
    text-decoration: none;
  }

  .compartir-enlace:hover {
    color: #fff;
  }

  .compartir-enlace :global(.icono) {
    width: 1.2em;
    height: 1.2em;
  }
</style>
