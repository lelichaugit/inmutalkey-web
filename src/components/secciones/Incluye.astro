---
import { GRUPOS, PROXIMAMENTE } from '../../data/funciones';
import Icono from '../Icono.astro';
---

<section class="seccion fondo-claro fondo-cuadricula incluye" id="incluye" aria-labelledby="incluye-titulo">
  <div class="contenedor">
    <div class="entrada revelar">
      <h2 id="incluye-titulo">Todo lo que tu consultorio usa en un día</h2>
      <p class="texto-grande tenue">
        Un solo programa, sin módulos sueltos ni complementos para lo básico. Funciona en Windows 10 y 11.
      </p>
    </div>

    <div class="panel revelar">
      {
        GRUPOS.map((g) => (
          <section class="panel-grupo" aria-label={g.titulo}>
            <h3>{g.titulo}</h3>
            <ul>
              {g.funciones.map((f) => (
                <li>
                  <Icono nombre={f.icono} />
                  <span>
                    <strong>{f.titulo}</strong>
                    <span class="tenue">{f.detalle}</span>
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="pronto revelar">
      <h3>En camino</h3>
      <ul>
        {
          PROXIMAMENTE.map((f) => (
            <li class="pildora pildora-pronto">
              <Icono nombre={f.icono} />
              <span>
                <strong>{f.titulo}:</strong> {f.detalle}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    margin-top: clamp(36px, 5vw, 56px);
    border: 1px solid var(--linea-clara);
    border-radius: 20px;
    background: rgb(255 255 255 / 0.75);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    overflow: hidden;
  }

  @media (min-width: 760px) {
    .panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1180px) {
    .panel {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .panel-grupo {
    padding: 24px 22px 26px;
    border-bottom: 1px solid var(--linea-clara);
  }

  @media (min-width: 760px) {
    .panel-grupo {
      border-right: 1px solid var(--linea-clara);
    }
  }

  .panel-grupo h3 {
    margin-bottom: 14px;
    color: var(--azul);
    font-family: var(--fuente-texto);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .panel-grupo ul {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel-grupo li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 12px;
    align-items: start;
  }

  .panel-grupo li :global(.icono) {
    width: 22px;
    height: 22px;
    margin-top: 2px;
    color: var(--tinta);
  }

  .panel-grupo li > span {
    display: grid;
    gap: 2px;
  }

  .panel-grupo strong {
    font-size: 1rem;
  }

  .panel-grupo .tenue {
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .pronto {
    margin-top: 28px;
  }

  .pronto h3 {
    font-family: var(--fuente-texto);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--tinta-tenue);
  }

  .pronto ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .pronto .pildora {
    border-style: dashed;
    color: var(--tinta-tenue);
    background: transparent;
  }
</style>
