---
// Qué incluye. Un día en el consultorio contado en cinco momentos (agenda → consulta → receta → laboratorios →
// respaldo), cada uno con una miniatura de la pantalla:
//   · escritorio (≥ 1024 px, con movimiento): recorrido HORIZONTAL fijado; la pista se desliza con --p y un reloj
//     abajo marca la hora del día
//   · celular, iPad vertical, sin JS o con movimiento reducido: rejilla tipo bento con revelados (sin scroll
//     horizontal secuestrado en pantallas táctiles)
// Las miniaturas se animan al entrar en vista (clase .es-visible de base.ts); sin JS se ven terminadas.
// Rendimiento: el motor escribe --p/--e/--s solo en los [data-p] (las dos luces, el carril y las piezas del reloj),
// no en toda la escena; cada uno declara su --avance. data-sin-riel: el recorrido usa el borde derecho (≥ 1360 px).
// Debajo: la lista completa de funciones (src/data/funciones.ts) en un desplegable y el bloque "En camino".
import { GRUPOS, PROXIMAMENTE } from '../../data/funciones';
import Icono from '../Icono.astro';

const total = GRUPOS.reduce((n, g) => n + g.funciones.length, 0);

const MOMENTOS = [
  {
    hora: '08:00',
    corto: 'Agenda',
    titulo: 'Abres tu agenda',
    texto: 'Citas de hoy, próximas y pacientes de primera vez. La cita se marca atendida al firmar la nota.',
  },
  {
    hora: '09:30',
    corto: 'Consulta',
    titulo: 'Consulta y nota',
    texto: 'Signos vitales con IMC automático, diagnósticos CIE-10 y un semáforo que revisa 7 requisitos antes de firmar.',
  },
  {
    hora: '09:50',
    corto: 'Receta',
    titulo: 'Firmas y sale la receta',
    texto: 'La receta sale de la nota firmada, con folio y sello. Carta o media carta, con tus kits de tratamiento.',
  },
  {
    hora: '13:00',
    corto: 'Laboratorios',
    titulo: 'Laboratorios y gráficas',
    texto: 'Glucosa, HbA1c, creatinina, colesterol y triglicéridos, con su evolución en el tiempo.',
  },
  {
    hora: '19:30',
    corto: 'Respaldo',
    titulo: 'Respaldas al cerrar',
    texto:
      'Con un clic copias tu base (y, si quieres, a una USB) y el programa comprueba que la copia quedó idéntica. Sirve para recuperarla en esta misma computadora.',
  },
] as const;

const CITAS = [
  { hora: '08:30', nombre: 'Paciente de ejemplo', estado: 'Atendida', clase: 'hecha' },
  { hora: '09:30', nombre: 'Primera vez', estado: 'En atención', clase: 'ahora' },
  { hora: '10:15', nombre: 'Seguimiento', estado: 'Programada', clase: '' },
  { hora: '11:00', nombre: 'Control mensual', estado: 'Programada', clase: '' },
] as const;

// Glucosa en ayuno de ejemplo (mg/dL), seis consultas: puntos de la gráfica en un lienzo de 300 × 120.
const GLUCOSA = [148, 139, 131, 126, 118, 112];
const puntos = GLUCOSA.map((v, i) => ({ x: 14 + i * 54, y: 108 - ((v - 100) / 55) * 92 }));
const linea = puntos.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
const area = `M14,118 L${linea.replaceAll(' ', ' L')} L284,118 Z`;
---

<section class="seccion fondo-navy fondo-cuadricula incluye" id="incluye" aria-labelledby="incluye-titulo">
  <div class="dia" data-escena data-sin-riel>
    <div class="dia-escenario" data-escenario>
      <span class="dia-luz dia-luz-manana" aria-hidden="true" data-p></span>
      <span class="dia-luz dia-luz-tarde" aria-hidden="true" data-p></span>

      <div class="dia-pista">
        <!-- En escritorio, el carril (título + tarjetas) es lo que se desliza; el título es la primera "parada". -->
        <div class="dia-carril" data-p>
        <div class="dia-cabeza">
          <div class="entrada revelar">
            <h2 id="incluye-titulo">Todo lo que tu consultorio usa en un día</h2>
            <p class="texto-grande tenue">
              Un solo programa, sin módulos sueltos ni complementos para lo básico. Funciona en Windows 10 y 11.
            </p>
          </div>
        </div>

        <ol class="dia-tarjetas" aria-label="Un día en tu consultorio">
          {
            MOMENTOS.map((m, i) => (
              <li class:list={['dia-tarjeta', `momento-${i + 1}`]} data-animar="subir">
                <div class="tarjeta-texto">
                  <span class="tarjeta-hora">{m.hora}</span>
                  <h3>{m.titulo}</h3>
                  <p class="tenue">{m.texto}</p>
                </div>

                <div class="mock" aria-hidden="true">
                  {i === 0 && (
                    <div class="mock-agenda">
                      <div class="mock-cabeza">
                        <span>Hoy</span>
                        <span class="mono">4 citas</span>
                      </div>
                      <ul class="citas">
                        {CITAS.map((c) => (
                          <li class:list={['cita', c.clase && `cita-${c.clase}`]}>
                            <span class="mono cita-hora">{c.hora}</span>
                            <span class="cita-nombre">{c.nombre}</span>
                            <span class="cita-estado">
                              {c.clase === 'hecha' && <Icono nombre="check" />}
                              {c.estado}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {i === 1 && (
                    <div class="mock-nota">
                      <div class="mock-cabeza">
                        <span>Nota de evolución</span>
                        <span class="mono borrador">
                          <Icono nombre="reloj" /> hace 2 s
                        </span>
                      </div>
                      <dl class="campos">
                        <div>
                          <dt>Motivo</dt>
                          <dd>Dolor de garganta y fiebre</dd>
                        </div>
                        <div>
                          <dt>Signos</dt>
                          <dd>TA 120/80 · FC 88 · IMC 24.6</dd>
                        </div>
                        <div>
                          <dt>Dx</dt>
                          <dd>
                            <span class="mono">J02.9</span> Faringitis aguda
                          </dd>
                        </div>
                      </dl>
                      <div class="semaforo">
                        <span>Requisitos NOM-004</span>
                        <span class="luces">
                          <i /><i /><i /><i /><i /><i /><i />
                        </span>
                        <span class="mono">7/7</span>
                      </div>
                    </div>
                  )}

                  {i === 2 && (
                    <div class="mock-receta">
                      <div class="hoja">
                        <div class="hoja-cabeza">
                          <strong>Receta médica</strong>
                          <span class="mono">Folio: nota 12</span>
                        </div>
                        <p class="hoja-rx">
                          <strong>Paracetamol 500 mg</strong>
                          <span>1 tableta cada 8 h por 3 días</span>
                        </p>
                        <p class="hoja-rx">
                          <strong>Gargarismos con agua tibia</strong>
                          <span>3 veces al día</span>
                        </p>
                        <div class="hoja-pie">
                          <span>Sello de la nota</span>
                          <span class="mono">9f2c41e8…b07a</span>
                        </div>
                      </div>
                    </div>
                  )}

                  {i === 3 && (
                    <div class="mock-labs">
                      <div class="mock-cabeza">
                        <span>Glucosa en ayuno</span>
                        <span class="mono">mg/dL</span>
                      </div>
                      <svg class="grafica" viewBox="0 0 300 124">
                        <defs>
                          <linearGradient id="incluye-area" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" stop-color="#2e9fe0" stop-opacity="0.35" />
                            <stop offset="1" stop-color="#2e9fe0" stop-opacity="0" />
                          </linearGradient>
                        </defs>
                        <path class="grafica-guia" d="M0 30.5H300M0 62.5H300M0 94.5H300" />
                        <g class="grafica-trazo">
                          <path d={area} fill="url(#incluye-area)" />
                          <polyline points={linea} />
                          {puntos.map((p) => (
                            <circle cx={p.x} cy={p.y} r="3.5" />
                          ))}
                        </g>
                      </svg>
                      <div class="labs-datos">
                        <span>
                          <strong>112</strong> última
                        </span>
                        <span>
                          HbA1c <strong>6.1 %</strong>
                        </span>
                      </div>
                    </div>
                  )}

                  {i === 4 && (
                    <div class="mock-respaldo">
                      <div class="respaldo-ruta">
                        <Icono nombre="respaldo" />
                        <span class="mono">clinica.db</span>
                        <span class="respaldo-flecha" />
                        <Icono nombre="carpeta" />
                        <span class="mono">Respaldos</span>
                      </div>
                      <div class="respaldo-barra">
                        <i />
                      </div>
                      <div class="respaldo-ruta">
                        <Icono nombre="respaldo" />
                        <span class="mono">clinica.db</span>
                        <span class="respaldo-flecha" />
                        <Icono nombre="usb" />
                        <span class="mono">USB (E:)</span>
                      </div>
                      <div class="respaldo-barra respaldo-barra-2">
                        <i />
                      </div>
                      <div class="respaldo-ok">
                        <span class="respaldo-aro">
                          <Icono nombre="check" />
                        </span>
                        <span>
                          <strong>Copia comprobada</strong>
                          <small>idéntica · para esta computadora</small>
                        </span>
                      </div>
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
        </div>
      </div>

      <div class="contenedor dia-reloj" aria-hidden="true">
        <div class="reloj-linea">
          <i class="reloj-avance" data-p></i>
          <span class="reloj-cursor" data-p><i></i></span>
        </div>
        <ol class="reloj-horas" data-p>
          {
            MOMENTOS.map((m) => (
              <li>
                <span class="mono">{m.hora}</span>
                <span>{m.corto}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>

  <div class="contenedor incluye-resto">
    <details class="todas revelar">
      <summary>
        <span>Ver las {total} funciones</span>
        <span class="todas-signo" aria-hidden="true"><Icono nombre="mas" /></span>
      </summary>
      <div class="panel">
        {
          GRUPOS.map((g) => (
            <section class="panel-grupo" aria-label={g.titulo}>
              <h3>{g.titulo}</h3>
              <ul>
                {g.funciones.map((f) => (
                  <li>
                    <Icono nombre={f.icono} />
                    <span>
                      <strong>{f.titulo}</strong>
                      <span class="tenue">{f.detalle}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </details>

    <div class="pronto revelar">
      <h3>En camino</h3>
      <ul>
        {
          PROXIMAMENTE.map((f) => (
            <li class="pildora pildora-pronto">
              <Icono nombre={f.icono} />
              <span>
                <strong>{f.titulo}:</strong> {f.detalle}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .incluye {
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    padding-bottom: var(--seccion);
  }

  .mono {
    font-family: var(--mono);
    letter-spacing: 0.01em;
  }

  /* ───────────── Cabecera ───────────── */

  .dia-cabeza {
    width: min(100% - 2 * var(--margen), var(--ancho));
    margin-inline: auto;
  }

  .dia-cabeza .entrada {
    max-width: 60ch;
  }

  /* ───────────── Tarjetas (base: rejilla bento) ───────────── */

  .dia-luz,
  .dia-reloj {
    display: none;
  }

  .dia-tarjetas {
    display: grid;
    gap: 16px;
    margin: clamp(32px, 5vw, 56px) auto 0;
    padding: 0;
    width: min(100% - 2 * var(--margen), var(--ancho));
    list-style: none;
  }

  @media (min-width: 640px) {
    .dia-tarjetas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .momento-1 {
      grid-column: span 2;
    }
  }

  @media (min-width: 1024px) {
    .dia-tarjetas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .dia-tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 22px 20px 20px;
    border: 1px solid var(--linea-oscura-fuerte);
    border-radius: 24px;
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(46 159 224 / 0.1), transparent 60%),
      linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.02));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.06) inset,
      0 30px 60px -40px rgb(0 0 0 / 0.8);
    overflow: hidden;
    /* Rendimiento: el carril ([data-p]) recibe --p en cada cuadro y con él todas las tarjetas; las que están lejos de la
       vista no se recalculan ni se pintan. "auto" recuerda su alto real una vez vistas (sin saltos al volver). */
    content-visibility: auto;
    contain-intrinsic-block-size: auto 378px;
  }

  @media (min-width: 640px) {
    .momento-1 {
      flex-direction: row;
      align-items: center;
      contain-intrinsic-block-size: auto 208px;
    }

    .momento-1 .tarjeta-texto {
      flex: 0 1 40%;
    }

    .momento-1 .mock {
      flex: 1;
    }
  }

  .tarjeta-texto {
    display: grid;
    gap: 6px;
  }

  .tarjeta-hora {
    justify-self: start;
    padding: 3px 10px;
    border: 1px solid rgb(46 159 224 / 0.4);
    border-radius: 999px;
    color: var(--azul-vivo);
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  .tarjeta-texto h3 {
    margin-top: 6px;
    font-size: clamp(1.3125rem, 1.15rem + 0.5vw, 1.5rem);
  }

  .tarjeta-texto p {
    font-size: 1rem;
    line-height: 1.5;
  }

  /* ───────────── Miniaturas ───────────── */

  .mock {
    --ok: var(--esmeralda-vivo);
    position: relative;
    display: grid;
    align-content: center;
    min-height: 168px;
    padding: 14px;
    border: 1px solid var(--linea-oscura);
    border-radius: 16px;
    background: rgb(4 10 22 / 0.55);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .mock-cabeza {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    margin-bottom: 10px;
    color: var(--texto);
    font-weight: 600;
  }

  .mock-cabeza .mono {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--texto-tenue);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .mock-cabeza :global(.icono) {
    width: 13px;
    height: 13px;
  }

  /* Las miniaturas se arman al entrar en vista; sin JS (sin .js) ya están completas. */
  .cita,
  .luces i,
  .hoja,
  .grafica-trazo,
  .respaldo-barra i,
  .respaldo-ok {
    transition:
      opacity 0.7s var(--ease),
      transform 0.8s var(--ease),
      clip-path 1.4s var(--ease);
  }

  /* ── 1 · Agenda ── */
  .citas {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cita {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.04);
    color: var(--texto-tenue);
  }

  .cita:nth-child(2) { transition-delay: 0.1s; }
  .cita:nth-child(3) { transition-delay: 0.2s; }
  .cita:nth-child(4) { transition-delay: 0.3s; }

  :global(.js) .dia-tarjeta:not(.es-visible) .cita {
    opacity: 0;
    transform: translate3d(-14px, 0, 0);
  }

  .cita-hora {
    font-size: 0.75rem;
  }

  .cita-nombre {
    overflow: hidden;
    color: var(--texto);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .cita-estado {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .cita-estado :global(.icono) {
    width: 13px;
    height: 13px;
  }

  .cita-hecha .cita-nombre {
    color: var(--texto-tenue);
  }

  .cita-ahora {
    background: rgb(46 159 224 / 0.14);
    box-shadow: inset 2px 0 0 var(--azul-vivo);
  }

  .cita-ahora .cita-estado {
    color: var(--azul-vivo);
    font-weight: 600;
  }

  /* ── 2 · Nota y semáforo ── */
  .borrador {
    color: var(--texto-tenue);
  }

  .campos {
    display: grid;
    gap: 6px;
    margin: 0 0 12px;
  }

  .campos div {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.04);
  }

  .campos dt {
    color: var(--texto-tenue);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .campos dd {
    margin: 0;
    color: var(--texto);
  }

  .campos .mono {
    color: var(--azul-vivo);
  }

  .semaforo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--texto-tenue);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .luces {
    display: flex;
    gap: 5px;
    margin-left: auto;
  }

  .luces i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 8px rgb(47 209 154 / 0.6);
  }

  .luces i:nth-child(2) { transition-delay: 0.12s; }
  .luces i:nth-child(3) { transition-delay: 0.24s; }
  .luces i:nth-child(4) { transition-delay: 0.36s; }
  .luces i:nth-child(5) { transition-delay: 0.48s; }
  .luces i:nth-child(6) { transition-delay: 0.6s; }
  .luces i:nth-child(7) { transition-delay: 0.72s; }

  :global(.js) .dia-tarjeta:not(.es-visible) .luces i {
    opacity: 0.18;
    transform: scale(0.7);
  }

  .semaforo .mono {
    color: var(--ok);
  }

  /* ── 3 · Receta ── */
  .hoja {
    display: grid;
    gap: 8px;
    padding: 14px 14px 12px;
    border-radius: 10px;
    background: #f4f7fb;
    color: var(--tinta);
    box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.9);
  }

  :global(.js) .dia-tarjeta:not(.es-visible) .hoja {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
  }

  .hoja-cabeza {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--linea-clara);
  }

  .hoja-cabeza .mono,
  .hoja-pie {
    color: var(--tinta-tenue);
    font-size: 0.75rem;
  }

  .hoja-rx {
    display: grid;
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .hoja-rx span {
    color: var(--tinta-tenue);
  }

  .hoja-pie {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding-top: 6px;
    border-top: 1px solid var(--linea-clara);
  }

  /* ── 4 · Laboratorios ── */
  .grafica {
    width: 100%;
    height: auto;
    max-height: 150px;
    overflow: visible;
  }

  .grafica-guia {
    stroke: rgb(255 255 255 / 0.08);
    stroke-width: 1;
  }

  .grafica-trazo {
    clip-path: inset(-6px 0 -6px 0);
    transition-delay: 0.15s;
  }

  :global(.js) .dia-tarjeta:not(.es-visible) .grafica-trazo {
    clip-path: inset(-6px 100% -6px 0);
  }

  .grafica polyline {
    fill: none;
    stroke: var(--azul-vivo);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .grafica circle {
    fill: #0b1830;
    stroke: var(--azul-vivo);
    stroke-width: 2;
  }

  .labs-datos {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    color: var(--texto-tenue);
    font-size: 0.8125rem;
  }

  .labs-datos strong {
    color: var(--texto);
    font-family: var(--fuente-titulo);
    font-size: 1.0625rem;
  }

  /* ── 5 · Respaldo ── */
  .mock-respaldo {
    display: grid;
    gap: 10px;
  }

  .respaldo-barra + .respaldo-ruta {
    margin-top: 6px;
  }

  .respaldo-ok {
    margin-top: 8px;
  }

  .respaldo-ruta {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--texto);
    font-size: 0.8125rem;
  }

  .respaldo-ruta :global(.icono) {
    width: 18px;
    height: 18px;
    color: var(--azul-vivo);
  }

  .respaldo-flecha {
    flex: 1;
    min-width: 16px;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--azul-vivo) 0 3px, transparent 3px 6px);
    opacity: 0.7;
  }

  .respaldo-barra {
    height: 6px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.08);
    overflow: hidden;
  }

  .respaldo-barra i {
    display: block;
    height: 100%;
    border-radius: inherit;
