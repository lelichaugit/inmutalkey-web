---
// Hero (IDENTIDAD_MARCA §9.1): lámina de aurora Marino con el logo plata que gira 360° sobre su eje vertical UNA vez al
// cargar (rotateY, 900 ms, curva de marca, impulso de escala y destello de brillo a la mitad: solo transform/opacity),
// titular, subtítulo, dos llamados, pruebas verificables y la maqueta de la app sobre un panel de cristal.
// Sin JS o con «reducir movimiento»: todo visible y quieto desde el primer pintado.
import { sitio } from '../../site.config';
import Icono from '../Icono.astro';
import MockupApp from '../MockupApp.astro';

const PRUEBAS = [
  { icono: 'sin-wifi', texto: 'Funciona sin internet' },
  { icono: 'sello', texto: 'Notas firmadas e inalterables' },
  { icono: 'usb', texto: 'Respaldos cifrados en su USB' },
  { icono: 'media-hoja', texto: 'Recetas en media hoja o Carta' },
] as const;

const srcset = '/brand/logo-plata-280.avif 100w, /brand/logo-plata-420.avif 150w, /brand/logo-plata-560.avif 200w';
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero-lamina lamina tema-marino cuadricula" aria-hidden="true"></div>
  <div class="contenedor hero-texto tema-marino">
    <div class="hero-logo" aria-hidden="true">
      <picture>
        <source type="image/avif" srcset={srcset} sizes="(min-width: 1921px) 3vw, 57px" />
        <img
          src="/brand/logo-plata-280.webp"
          srcset="/brand/logo-plata-280.webp 100w, /brand/logo-plata-420.webp 150w, /brand/logo-plata-560.webp 200w"
          sizes="(min-width: 1921px) 3vw, 57px"
          alt=""
          width="100"
          height="280"
        />
      </picture>
      <picture class="hero-logo-brillo">
        <source type="image/avif" srcset={srcset} sizes="(min-width: 1921px) 3vw, 57px" />
        <img src="/brand/logo-plata-280.webp" alt="" width="100" height="280" decoding="async" />
      </picture>
    </div>
    <p class="hero-eslogan">Expediente Clínico Privado</p>
    <h1 id="hero-titulo">Su expediente clínico, sellado y en sus manos.</h1>
    <p class="hero-sub">
      Expediente Clínico Privado conforme a la NOM-004. Sin nube, sin suscripciones a ciegas, sin que nadie más vea a sus
      pacientes.
    </p>
    <div class="acciones hero-acciones">
      <a class="boton boton-primario boton-grande" href="/fundadores">Solicitar acceso Fundador</a>
      <a class="boton boton-grande hero-secundario" href="#como-funciona">Ver cómo funciona <Icono nombre="flecha" /></a>
    </div>
    <ul class="hero-pruebas">
      {PRUEBAS.map((p) => <li><Icono nombre={p.icono} />{p.texto}</li>)}
    </ul>
  </div>

  <div class="contenedor-amplio hero-maqueta">
    <div class="hero-cristal cristal">
      <MockupApp variante="directorio" />
    </div>
    <p class="hero-version">
      <span class="pildora"><Icono nombre="check" /> Versión <span class="cifras">{sitio.version.numero}</span> · {sitio.version.nombre}</span>
      <span>Windows 10 y 11 · {sitio.licencia.diasPrueba} días de prueba completos</span>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--altura-nav) + clamp(3rem, 7vw, 6rem));
  }

  /* La lámina cubre el texto y la mitad de la maqueta: la maqueta «flota» entre la noche Marino y la página. */
  .hero-lamina {
    position: absolute;
    inset: 0 0 clamp(9rem, 22vw, 22rem);
    z-index: -1;
    border-radius: 0 0 clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem);
  }

  .hero-texto {
    display: grid;
    justify-items: center;
    text-align: center;
    background: none;
  }

  .hero-logo {
    position: relative;
    width: 3.6rem;
    aspect-ratio: 100 / 280;
    margin-bottom: 1.5rem;
  }

  /* Sombra tintada como halo radial (sin filter: un drop-shadow inflaría el área del logo y lo volvería el LCP). */
  .hero-logo::before {
    content: '';
    position: absolute;
    inset: 12% -70% -14%;
    z-index: -1;
    background: radial-gradient(50% 46% at 50% 60%, rgb(0 4 12 / 0.55), transparent 72%);
  }

  .hero-logo picture,
  .hero-logo img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-logo-brillo {
    position: absolute !important;
    inset: 0;
    opacity: 0;
  }

  .hero-logo-brillo img {
    filter: brightness(1.7) contrast(1.05);
  }

  :global(.movimiento) .hero-logo picture:first-child {
    animation: logo-giro 900ms cubic-bezier(0.45, 0, 0.2, 1) 120ms both;
  }

  :global(.movimiento) .hero-logo-brillo {
    animation:
      logo-giro 900ms cubic-bezier(0.45, 0, 0.2, 1) 120ms both,
      logo-destello 900ms ease-in-out 120ms both;
  }

  @keyframes logo-giro {
    from {
      transform: perspective(1100px) rotateY(0deg) scale(1);
    }
    50% {
      transform: perspective(1100px) rotateY(180deg) scale(1.12);
    }
    to {
      transform: perspective(1100px) rotateY(360deg) scale(1);
    }
  }

  @keyframes logo-destello {
    0%,
    30% {
      opacity: 0;
    }
    50% {
      opacity: 0.85;
    }
    72%,
    100% {
      opacity: 0;
    }
  }

  .hero-eslogan {
    margin-bottom: 1rem;
    color: var(--primario);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 15ch;
    font-size: clamp(2.5rem, 1.4rem + 4.4vw, 4.5rem);
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .hero-sub {
    max-width: 40rem;
    margin-top: 1.5rem;
    color: var(--texto-2);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
    line-height: 1.55;
  }

  .hero-acciones {
    justify-content: center;
    margin-top: 2.25rem;
  }

  .hero-secundario :global(.icono) {
    transition: transform 200ms var(--curva-cristal);
  }

  .hero-secundario:hover :global(.icono) {
    transform: translateX(3px);
  }

  .hero-pruebas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--texto-2);
    font-size: 0.9375rem;
  }

  .hero-pruebas li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-pruebas :global(.icono) {
    color: var(--primario);
  }

  .hero-maqueta {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  /* Panel de cristal real (1 de 2 por vista). */
  .hero-cristal {
    padding: clamp(0.5rem, 1.2vw, 1rem);
    border-radius: clamp(1.25rem, 2.4vw, 2rem);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.14), color-mix(in srgb, var(--superficie) 72%, transparent));
  }

  .hero-cristal :global(.mockup-pie) {
    margin-bottom: 0.25rem;
  }

  .hero-version {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1.5rem;
    color: var(--texto-2);
    font-size: 0.875rem;
  }

  @media (max-width: 40rem) {
    .hero-logo {
      width: 2.75rem;
      margin-bottom: 1rem;
    }

    .hero-pruebas {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      text-align: left;
      gap: 0.75rem 1rem;
    }

    .hero-pruebas li {
      align-items: flex-start;
    }

    .hero-acciones {
      display: grid;
      width: 100%;
    }
  }
</style>
