---
import { enlaceWhatsApp } from '../../lib/whatsapp';
import { sitio } from '../../site.config';
import Icono from '../Icono.astro';
import Isotipo3D from '../Isotipo3D.astro';

const prueba = enlaceWhatsApp(sitio.contacto.whatsapp, sitio.contacto.mensajes.prueba);
---

<section class="hero fondo-oscuro fondo-cuadricula" id="inicio" data-progreso-scroll aria-labelledby="hero-titulo">
  <div class="hero-luz" aria-hidden="true"></div>

  <div class="contenedor hero-rejilla">
    <div class="hero-texto">
      <p class="pildora hero-pildora">
        <Icono nombre="estetoscopio" />
        Expediente clínico para consultorio privado
      </p>
      <h1 id="hero-titulo">Tus notas clínicas, selladas y en tu computadora.</h1>
      <p class="texto-grande tenue hero-sub">
        Cada nota que firmas queda sellada: nadie puede cambiarla sin que se note. Diseñado para la
        <span class="sin-corte">NOM-004</span>, funciona sin internet y tus expedientes nunca salen de tu consultorio.
      </p>
      <div class="hero-acciones">
        {
          prueba && (
            <a class="boton boton-primario" href={prueba} target="_blank" rel="noopener noreferrer">
              <Icono nombre="chat" />
              Pide tus {sitio.licencia.diasPrueba} días de prueba
            </a>
          )
        }
        <a class="boton boton-secundario" href="#demo">
          <Icono nombre="play" />
          Pruébalo aquí mismo
        </a>
      </div>
      <ul class="hero-confianza">
        <li><Icono nombre="check" />Prueba completa de {sitio.licencia.diasPrueba} días</li>
        <li><Icono nombre="check" />Windows 10 y 11</li>
        <li><Icono nombre="check" />Licencia vitalicia</li>
      </ul>
    </div>

    <div class="hero-llave" data-isotipo-principal>
      <div class="hero-llave-scroll">
        <div class="hero-llave-flotar">
          <span class="hero-llave-halo" aria-hidden="true"></span>
          <Isotipo3D
            prioridad
            brillo
            sizes="(min-width: 960px) 260px, 100px"
            alt="Isotipo de InmutalKey: una llave con la vara de Asclepio"
            class="hero-isotipo"
          />
        </div>
      </div>
      <span class="hero-llave-reflejo" aria-hidden="true"></span>
    </div>
  </div>

  <a class="hero-bajar" href="#integridad">
    <span>Mira cómo funciona</span>
    <span class="hero-bajar-linea" aria-hidden="true"></span>
  </a>
</section>

<style>
  /*
   * Capas de la llave (de fuera hacia dentro):
   *   .hero-llave         alto y lugar en la rejilla; NO crea contexto de apilamiento (ni transform ni perspective)
   *   .hero-llave-scroll  lo que hace el scroll (--s) + `mix-blend-mode: screen` para TODO el grupo
   *   .hero-llave-flotar  entrada al cargar y respiración en reposo
   *   .hero-isotipo       el render (o el logo plano de respaldo) y su brillo
   * El render es blanco sobre negro puro. Cualquier transform/opacity en un ancestro aísla la mezcla y el negro se
   * vería como un recuadro; por eso la mezcla vive en la capa exterior, cuyo contexto es la sección (isolation).
   */
  .hero {
    /* Avance de salida del hero (0 → 1), lo pone base.ts. Sin JS vale 0: todo quieto y completo. */
    --s: var(--salida, 0);
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 100svh;
    margin-top: calc(-1 * var(--altura-nav));
    padding-top: calc(var(--altura-nav) + clamp(12px, 4vw, 48px));
    padding-bottom: clamp(48px, 9vw, 112px);
    overflow-x: clip;
  }

  .hero-luz {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(55% 60% at 78% 62%, rgb(1 120 176 / 0.28), transparent 70%),
      radial-gradient(70% 55% at 100% 110%, rgb(46 159 224 / 0.32), transparent 70%);
    /* Se funde con la sección siguiente (mismo fondo) en lugar de cortarse en el borde. */
    -webkit-mask-image: linear-gradient(#000 62%, transparent);
    mask-image: linear-gradient(#000 62%, transparent);
    pointer-events: none;
  }

  .hero-rejilla {
    display: grid;
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
  }

  /* ── Texto ── */

  .hero-texto {
    max-width: 640px;
  }

  .hero-texto > * + * {
    margin-top: clamp(1rem, 0.75rem + 1vw, 1.4rem);
  }

  .hero-pildora {
    color: var(--texto-tenue);
  }

  #hero-titulo {
    font-size: clamp(2.125rem, 1.3rem + 3.9vw, 4.5rem);
  }

  .hero-sub {
    max-width: 56ch;
  }

  .hero-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 0.25rem;
  }

  .hero-confianza {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--texto-tenue);
    font-size: 0.975rem;
  }

  .hero-confianza li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }

  .hero-confianza :global(.icono) {
    width: 1.15em;
    height: 1.15em;
    color: var(--azul-vivo);
  }

  /* Entrada al cargar: solo CSS (no espera a JS ni a IntersectionObserver) y termina antes de 0.7 s.
     El titular no se anima: es visible desde el primer pintado. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-pildora,
    .hero-sub,
    .hero-acciones,
    .hero-confianza {
      animation: hero-entrar 0.5s var(--ease) backwards;
    }

    .hero-sub {
      animation-delay: 0.06s;
    }

    .hero-acciones {
      animation-delay: 0.12s;
    }

    .hero-confianza {
      animation-delay: 0.2s;
    }
  }

  @keyframes hero-entrar {
    from {
      opacity: 0;
      transform: translate3d(0, 14px, 0);
    }
  }

  /* ── La llave ── */

  /* Altura explícita en cada capa: las alturas en % no se resuelven dentro de la rejilla y el SVG usaría su tamaño propio. */
  .hero-llave {
    --alto-llave: clamp(150px, 27svh, 290px);
    /* Celular: la llave está arriba y sale pronto de la vista, así que el giro es sutil y se apaga rápido.
       Escritorio: recorrido más amplio (ver media query). */
    --giro: 20deg;
    --inclinar: -3deg;
    --alejar: 0.4;
    --bajar: 16vh;
    --apagar: 4;
    /* Cuánto avanza la luz por unidad de --s: cruza la llave mientras todavía se ve. */
    --barrido: 500%;
    position: relative;
    display: grid;
    place-items: center;
    height: var(--alto-llave);
    order: -1;
  }

  /* Capa 1: el scroll. Baja más lento que la página, gira en 3D, se aleja y se apaga; al salir de vista el isotipo
     plano aparece en la barra (base.ts, data-isotipo-principal). */
  .hero-llave-scroll {
    height: var(--alto-llave);
    transform: perspective(1100px) translate3d(0, calc(var(--s) * var(--bajar)), 0)
      rotateY(calc(var(--s) * var(--giro))) rotateZ(calc(var(--s) * var(--inclinar)))
      scale(calc(1 - var(--s) * var(--alejar)));
    opacity: clamp(0, calc(1 - var(--s) * var(--apagar)), 1);
    mix-blend-mode: screen;
    will-change: transform, opacity;
  }

  /* Capa 2: entrada y respiración en reposo. */
  .hero-llave-flotar {
    position: relative;
    height: var(--alto-llave);
    animation:
      llave-entrada 1s var(--ease) backwards,
      llave-flotar 7s ease-in-out 1s infinite;
  }

  /* Sin z-index: el render se mezcla con el halo dentro del grupo. */
  .hero-llave :global(.hero-isotipo) {
    position: relative;
    height: var(--alto-llave);
  }

  /* Halo azul detrás de la llave: degradado ya difuso, sin filter (más barato en celulares). */
  .hero-llave-halo {
    position: absolute;
    inset: 4% -46%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(46 159 224 / 0.34),
      rgb(1 120 176 / 0.14) 52%,
      rgb(1 120 176 / 0.04) 78%,
      transparent
    );
    opacity: calc(0.8 + var(--s) * 0.6);
    animation: halo-latido 7s ease-in-out infinite;
  }

  /* Reflejo en el "piso": una línea de luz que se abre con la entrada y se estrecha al bajar. */
  .hero-llave-reflejo {
    position: absolute;
    left: 50%;
    bottom: -4%;
    width: min(70%, calc(var(--alto-llave) * 0.9));
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(46 159 224 / 0.7), transparent);
    transform: translateX(-50%) scaleX(calc(1 - var(--s) * 0.8));
    opacity: clamp(0, calc(0.9 - var(--s) * var(--apagar)), 0.9);
    pointer-events: none;
    animation: reflejo-entrada 1.2s var(--ease) 0.2s backwards;
  }

  /* La luz que recorre la llave (el brillo lo dibuja Isotipo3D, recortado a la silueta). En reposo queda justo a la
     derecha de la llave: la entrada de Isotipo3D (desde 180 %) la hace cruzar de izquierda a derecha al cargar, y al
     bajar regresa de derecha a izquierda con el scroll. */
  .hero-llave :global(.isotipo-brillo) {
    background-position: calc(-5% + var(--s) * var(--barrido)) 0;
  }

  @keyframes llave-entrada {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0) scale(0.94);
      filter: blur(8px);
    }
  }

  @keyframes llave-flotar {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -2.5%, 0);
    }
  }

  @keyframes halo-latido {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.06);
    }
  }

  @keyframes reflejo-entrada {
    from {
      opacity: 0;
      transform: translateX(-50%) scaleX(0);
    }
  }

  .hero-bajar {
    position: absolute;
    left: 50%;
    bottom: 20px;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--texto-tenue);
    font-size: 0.875rem;
    text-decoration: none;
    transform: translateX(-50%);
    opacity: clamp(0, calc(1 - var(--s) * 4), 1);
  }

  .hero-bajar:hover {
    color: var(--texto);
  }

  .hero-bajar-linea {
    width: 1px;
    height: 40px;
    background: linear-gradient(var(--azul-vivo), transparent);
    transform-origin: top;
    animation: bajar 2.2s var(--ease) infinite;
  }

  @keyframes bajar {
    0% {
      transform: scaleY(0);
      opacity: 1;
    }
    70% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  /* ── Celular ── */

  @media (max-width: 479px) {
    /* La píldora cabe en una línea de 360 a 430 px. */
    .hero-pildora {
      font-size: clamp(0.8125rem, 3.6vw, 0.9375rem);
    }

    .hero-acciones {
      flex-direction: column;
    }

    .hero-acciones .boton {
      width: 100%;
    }
  }

  /* Pantallas bajas (celular): la píldora cede su lugar para que titular, subtítulo y botón quepan sin desplazarse. */
  @media (max-width: 959px) and (max-height: 780px) {
    .hero-pildora {
      display: none;
    }
  }

  @media (max-width: 959px) and (max-height: 680px) {
    .hero-llave {
      --alto-llave: clamp(120px, 23svh, 180px);
    }

    #hero-titulo {
      font-size: clamp(1.875rem, 1.2rem + 3.4vw, 2.5rem);
    }

    .hero-texto > * + * {
      margin-top: 0.875rem;
    }
  }

  /* Celular acostado: la llave se reduce; el texto manda. */
  @media (max-width: 959px) and (max-height: 500px) and (orientation: landscape) {
    .hero-llave {
      --alto-llave: 110px;
    }
  }

  /* ── Escritorio ── */

  @media (min-width: 960px) {
    .hero-rejilla {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }

    .hero-texto {
      transform: translate3d(0, calc(var(--s) * -48px), 0);
      opacity: clamp(0, calc(1 - var(--s) * 1.4), 1);
    }

    .hero-llave {
      --alto-llave: min(66svh, 620px);
      --giro: 28deg;
      --inclinar: -5deg;
      --alejar: 0.3;
      --bajar: 12vh;
      --apagar: 1.6;
      --barrido: 250%;
      order: 0;
    }

    .hero-bajar {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-texto,
    .hero-llave-scroll {
      transform: none;
      opacity: 1;
    }

    .hero-llave-reflejo {
      transform: translateX(-50%);
      opacity: 0.9;
    }

    .hero-llave-flotar,
    .hero-llave-halo,
    .hero-llave-reflejo,
    .hero-bajar-linea {
      animation: none;
    }
  }
</style>
