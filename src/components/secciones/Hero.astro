---
// Portada. La llave (Isotipo3D) es la protagonista del sitio: aquí se presenta, en "Cómo funciona" sella la nota y
// vuelve en el cierre (CtaFinal).
//
// Intro al cargar (solo CSS, ≤ 1.8 s, no espera al scroll): la llave aparece como plano técnico azul, el escáner baja
// materializando el render sólido (--materia 0 → 1) y una luz la recorre. El texto se ve desde el primer pintado.
//
// Escena fijada (scroll.ts, solo con .movimiento): el texto sube y se desvanece, la llave viaja al centro con un giro
// 3D sutil y los aros del visor se abren; aparece la frase y, al final, la llave se hunde y se atenúa (≤ 40 %) mientras
// Problema sube como lámina sobre el final del hero y la cubre (ver Problema.astro). Sin JS o con movimiento reducido
// no se fija: se ve la portada completa y quieta, con la frase debajo.
//
// Rendimiento: el motor escribe --p/--e/--s solo en los [data-p] (texto, llave, frase, "Mira cómo funciona"); cada uno
// declara sus propios tramos. data-paso y .alcanzo-N siguen en la raíz: con ellos, lo que ya no se ve en un tramo
// (visor, anotaciones, el plano de la intro) sale del árbol y no se recalcula en cada cuadro.
import { enlaceWhatsApp } from '../../lib/whatsapp';
import { sitio } from '../../site.config';
import Icono from '../Icono.astro';
import Isotipo3D from '../Isotipo3D.astro';

const prueba = enlaceWhatsApp(sitio.contacto.whatsapp, sitio.contacto.mensajes.prueba);
const dias = sitio.licencia.diasPrueba;
---

<section class="hero" id="inicio" data-escena data-escena-marcas="0.22 0.3 0.8" data-hero aria-labelledby="hero-titulo">
  <div class="hero-escenario" data-escenario>
    <div class="hero-fondo" aria-hidden="true"></div>
    <span class="hero-sonda" data-hero-sonda aria-hidden="true"></span>

    <div class="hero-rejilla">
      <p class="pildora hero-pildora hero-t" data-p>
        <Icono nombre="estetoscopio" />
        Expediente clínico para consultorio privado
      </p>
      <h1 id="hero-titulo" class="hero-titulo hero-t" data-p>
        Tus notas clínicas, selladas y en{'\u00a0'}tu{'\u00a0'}computadora.
      </h1>
      <p class="hero-sub hero-t" data-p>
        Cada nota que firmas queda sellada: nadie puede cambiarla sin que se note. InmutalKey está diseñado para la
        <span class="sin-corte">NOM-004</span> y funciona sin internet.
      </p>
      <div class="hero-acciones hero-t" data-p>
        {
          prueba && (
            <a class="boton boton-primario" href={prueba} target="_blank" rel="noopener noreferrer">
              <Icono nombre="chat" />
              Pide tus {dias} días de prueba
            </a>
          )
        }
        <a class="boton boton-secundario" href="#demo">
          <Icono nombre="play" />
          Pruébalo aquí mismo
        </a>
      </div>
      <ul class="hero-confianza hero-t" data-p>
        <li><Icono nombre="check" />Prueba completa de {dias} días</li>
        <li><Icono nombre="check" />Windows 10 y 11</li>
        <li><Icono nombre="check" />Licencia vitalicia</li>
      </ul>

      <div class="hero-llave" data-isotipo-principal data-hero-llave>
        <div class="hero-llave-mov" data-p>
          <span class="hero-foco" aria-hidden="true"></span>
          <span class="hero-aros" aria-hidden="true">
            <svg viewBox="0 0 200 200" fill="none" focusable="false">
              <circle class="aro aro-exterior" cx="100" cy="100" r="99" pathLength="100"></circle>
              <circle class="aro aro-marcas" cx="100" cy="100" r="92"></circle>
              <circle class="aro aro-interior" cx="100" cy="100" r="78" pathLength="100"></circle>
              <path class="aro aro-arco" d="M 100 1 A 99 99 0 0 1 185.7 50.5" pathLength="100"></path>
              <path class="aro aro-arco" d="M 100 199 A 99 99 0 0 1 14.3 149.5" pathLength="100"></path>
            </svg>
          </span>
          <span class="hero-piso" aria-hidden="true"></span>
          <div class="hero-llave-giro">
            <Isotipo3D
              prioridad
              brillo
              plano
              reflejo
              sizes="(min-width: 960px) 320px, (min-width: 600px) 260px, 180px"
              alt="Isotipo de InmutalKey: una llave con la vara de Asclepio"
              class="hero-isotipo"
            />
          </div>
          <span class="hero-visor" aria-hidden="true">
            <span class="hero-etiqueta hero-etiqueta-a"><b>Firma</b> · Ed25519</span>
            <span class="hero-etiqueta hero-etiqueta-b"><b>Sello</b> · SHA-256</span>
          </span>
          <span class="hero-nota hero-nota-firma" aria-hidden="true">
            <span class="hero-nota-texto"><b>Firma</b> Ed25519</span>
            <span class="hero-nota-linea"></span>
          </span>
          <span class="hero-nota hero-nota-sello" aria-hidden="true">
            <span class="hero-nota-linea"></span>
            <span class="hero-nota-texto"><b>Sello</b> SHA-256</span>
          </span>
        </div>
      </div>
    </div>

    <p class="hero-frase" data-p>
      <span class="hero-frase-a">Una llave única para tu consultorio.</span>
      <span class="hero-frase-b">Con ella se sella cada nota que firmas.</span>
    </p>

    <a class="hero-bajar" href="#integridad" data-p>
      <span>Mira cómo funciona</span>
      <span class="hero-bajar-linea" aria-hidden="true"></span>
    </a>
  </div>
</section>

<script>
  // La escena la mueve el motor (scroll.ts). Aquí solo se mide lo que el CSS no puede saber y se escribe con CSSOM:
  //  · --dx / --dy: cuánto viaja la llave desde su lugar en la rejilla hasta el centro de la ventana con la escena fija
  //    (el centro vertical lo fija el CSS en --centro-y, entre la barra y el borde inferior).
  //  · --alto-esc: alto real del escenario. Si el contenido no cabe en una pantalla (celular bajo, letra grande), el
  //    escenario se fija por su borde inferior en lugar de recortarse.
  //  · La intro (plano → escáner) espera al render si aún no llega, para no "materializar" un hueco (máx. 2.5 s).
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) iniciarHero(hero);

  function iniciarHero(hero: HTMLElement): void {
    const escenario = hero.querySelector<HTMLElement>('[data-escenario]');
    const llave = hero.querySelector<HTMLElement>('[data-hero-llave]');
    const sonda = hero.querySelector<HTMLElement>('[data-hero-sonda]');
    if (!escenario || !llave) return;

    // Terminada la intro, el plano técnico y el escáner ya no se ven (la llave es sólida): fuera del árbol, no se
    // recalculan en cada cuadro de la escena.
    const giro = llave.querySelector<HTMLElement>('.hero-llave-giro');
    giro?.addEventListener('animationend', (ev) => {
      if (ev.target === giro && ev.animationName === 'hero-materia') hero.classList.add('hero-intro-lista');
    });

    const render = llave.querySelector<HTMLImageElement>('.llave-render img');
    if (render && !render.complete) {
      hero.classList.add('hero-esperando');
      const listo = (): void => hero.classList.remove('hero-esperando');
      render.addEventListener('load', listo, { once: true });
      render.addEventListener('error', listo, { once: true });
      window.setTimeout(listo, 2500);
    }

    const escritos = new Map<string, string>();
    const escribir = (nombre: string, valor: string): void => {
      if (escritos.get(nombre) === valor) return;
      escritos.set(nombre, valor);
      hero.style.setProperty(nombre, valor);
    };

    const medir = (): void => {
      const estilo = getComputedStyle(hero);
      const barra = Number.parseFloat(estilo.getPropertyValue('--altura-nav')) || 72;
      const centroY = Number.parseFloat(estilo.getPropertyValue('--centro-y')) || 0.5;
      // 100svh real (en iOS, innerHeight cambia al ocultarse la barra de Safari; el escenario usa svh).
      const pantalla = sonda?.offsetHeight || window.innerHeight;
      const alto = escenario.offsetHeight;
      escribir('--alto-esc', `${alto}px`);

      // Rectángulos sin transform de por medio (ni la llave ni sus ancestros hasta el escenario se transforman).
      const e = escenario.getBoundingClientRect();
      const l = llave.getBoundingClientRect();
      const arriba = Math.min(0, pantalla - alto);
      const destinoX = escenario.clientWidth / 2;
      const destinoY = barra + (pantalla - barra) * centroY - arriba;
      escribir('--dx', `${Math.round(destinoX - (l.left - e.left + l.width / 2))}px`);
      escribir('--dy', `${Math.round(destinoY - (l.top - e.top + l.height / 2))}px`);
    };

    let pendiente = false;
    const pedir = (): void => {
      if (pendiente) return;
      pendiente = true;
      window.requestAnimationFrame(() => {
        pendiente = false;
        medir();
      });
    };
    if ('ResizeObserver' in window) new ResizeObserver(pedir).observe(escenario);
    window.addEventListener('resize', pedir, { passive: true });
    window.addEventListener('load', pedir, { once: true });
    void document.fonts?.ready.then(pedir);
    medir();
  }
</script>

<style>
  /*
   * Capas de la llave (de fuera hacia dentro), un transform por capa:
   *   .hero-llave        lugar en la rejilla (alto explícito; la llave toma el alto de su contenedor)
   *   .hero-llave-mov    escena: viaja al centro, crece y al final se encoge y baja
   *   .hero-aros         visor circular: se abre con el scroll
   *   .hero-llave-giro   giro 3D sutil (rotateY ≤ 12°) + intro (--materia por @keyframes)
   * Todo lo que depende de --p vive bajo .movimiento: sin JS o con movimiento reducido la portada se ve quieta.
   */
  .hero {
    --nav: var(--altura-nav);
    /* Celular: escena corta. Escritorio: ver media query. */
    --largo: 1.6;
    --alto-llave: clamp(200px, 36svh, 420px);
    --crece: 1.32;
    /* Celular: la llave al centro queda un poco abajo; arriba, bajo la barra, va la frase. */
    --centro-y: 0.48;
    /* Cuándo empieza a viajar la llave (tramo A): en celular, cuando los botones ya se apagaron. */
    --ta-desde: 0.07;
    /* Al final se hunde hacia la lámina de Problema: como máximo un 40 % del camino al borde inferior. */
    --baja: calc((100svh - var(--nav)) * (1 - var(--centro-y)) * 0.4);
    --aros-reposo: 0;
    --reflejo-reposo: 0;
    --reflejo-centro: 0.3;
    position: relative;
    margin-top: calc(-1 * var(--nav));
    background: var(--medianoche);
    color: var(--texto);
  }

  .hero-escenario {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: calc(var(--nav) + 12px) 0 max(20px, env(safe-area-inset-bottom));
    overflow: hidden;
    overflow: clip;
  }

  .hero-sonda {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 100vh;
    height: 100svh;
    visibility: hidden;
    pointer-events: none;
  }

  /* Negro con luz azul tenue y cuadrícula de instrumento; abajo se funde con la sección siguiente. */
  .hero-fondo {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 45% at 50% 38%, rgb(1 120 176 / 0.16), transparent 72%),
      linear-gradient(180deg, #02050b 0%, #030814 62%, var(--medianoche) 100%);
    pointer-events: none;
  }

  .hero-fondo::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 62% 45%, #000 10%, transparent 72%);
    mask-image: radial-gradient(ellipse 70% 60% at 62% 45%, #000 10%, transparent 72%);
  }

  /* ── Rejilla: celular primero ── */

  .hero-rejilla {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'pill pill'
      'titulo llave'
      'sub llave'
      'acciones acciones'
      'confianza confianza';
    column-gap: 12px;
    align-items: center;
    width: min(100% - 2 * var(--margen), 1320px);
    margin-inline: auto;
  }

  .hero-pildora {
    grid-area: pill;
    justify-self: start;
    margin-bottom: 14px;
    color: var(--texto-tenue);
    font-size: clamp(0.8125rem, 3.5vw, 0.9375rem);
  }

  .hero-titulo {
    grid-area: titulo;
    align-self: end;
    font-size: clamp(1.75rem, 0.95rem + 4vw, 3.4rem);
    line-height: 1.06;
  }

  .hero-sub {
    grid-area: sub;
    align-self: start;
    margin-top: 12px;
    max-width: 52ch;
    color: var(--texto-tenue);
    font-size: 1rem;
    line-height: 1.55;
  }

  .hero-acciones {
    grid-area: acciones;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    margin-top: 22px;
  }

  .hero-confianza {
    grid-area: confianza;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    color: var(--texto-tenue);
    font-size: 1rem;
  }

  .hero-confianza li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }

  .hero-confianza :global(.icono) {
    width: 1.15em;
    height: 1.15em;
    color: var(--azul-vivo);
  }

  /* Celular: el titular a todo lo ancho (junto a la llave, "en tu computadora." no cabía y se encimaba con ella) y
     el párrafo junto a la llave. */
  @media (max-width: 559px) {
    .hero-rejilla {
      grid-template-areas:
        'pill pill'
        'titulo titulo'
        'sub llave'
        'acciones acciones'
        'confianza confianza';
      align-items: start;
    }

    .hero-titulo {
      align-self: auto;
    }

    .hero-sub,
    .hero-llave {
      margin-top: 14px;
    }

    .hero-acciones .boton {
      width: 100%;
    }

    .hero-acciones .boton-secundario {
      min-height: 48px;
    }
  }

  /* ── La llave ── */

  .hero-llave {
    grid-area: llave;
    position: relative;
    justify-self: end;
    width: calc(var(--alto-llave) * 304 / 724);
    height: var(--alto-llave);
    pointer-events: none;
  }

  .hero-llave-mov,
  .hero-llave-giro {
    position: absolute;
    inset: 0;
  }

  .hero-llave-giro {
    z-index: 2;
  }

  .hero-llave :global(.hero-isotipo) {
    --reflejo: var(--reflejo-reposo);
  }

  /* Foco de luz azul detrás: degradado ya difuso (sin filter: más barato en celulares). */
  .hero-foco {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(var(--alto-llave) * 1.3);
    height: calc(var(--alto-llave) * 1.3);
    margin: calc(var(--alto-llave) * -0.65) 0 0 calc(var(--alto-llave) * -0.65);
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(46 159 224 / 0.3),
      rgb(1 120 176 / 0.13) 45%,
      rgb(1 120 176 / 0.04) 72%,
      transparent
    );
    opacity: 0.75;
  }

  /* Visor circular: aros finos y marcas de graduación. */
  .hero-aros {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: calc(var(--alto-llave) * 0.8);
    height: calc(var(--alto-llave) * 0.8);
    margin: calc(var(--alto-llave) * -0.4) 0 0 calc(var(--alto-llave) * -0.4);
    opacity: var(--aros-reposo);
  }

  .hero-aros svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .aro {
    vector-effect: non-scaling-stroke;
    stroke-width: 1;
  }

  .aro-exterior {
    stroke: rgb(255 255 255 / 0.14);
  }

  .aro-interior {
    stroke: rgb(46 159 224 / 0.22);
    stroke-dasharray: 2 3;
  }

  .aro-marcas {
    vector-effect: none;
    stroke: rgb(46 159 224 / 0.38);
    stroke-width: 2.4;
    stroke-dasharray: 0.6 4.22;
  }

  .aro-arco {
    stroke: var(--azul-vivo);
    stroke-linecap: round;
    opacity: 0.8;
  }

  /* El "piso": una línea de luz bajo la llave (el reflejo lo dibuja Isotipo3D). */
  .hero-piso {
    position: absolute;
    top: 100.5%;
    left: 50%;
    z-index: 1;
    width: calc(var(--alto-llave) * 0.95);
    height: 1px;
    margin-left: calc(var(--alto-llave) * -0.475);
    background: linear-gradient(90deg, transparent, rgb(46 159 224 / 0.55) 30%, rgb(200 235 255 / 0.7) 50%, rgb(46 159 224 / 0.55) 70%, transparent);
    opacity: var(--reflejo-reposo);
  }

  .hero-piso::after {
    content: '';
    position: absolute;
    left: 15%;
    right: 15%;
    top: -14px;
    height: 28px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(46 159 224 / 0.28), transparent);
  }

  /* Esquinas tipo visor alrededor de la llave. */
  .hero-visor {
    --c: rgb(255 255 255 / 0.5);
    --l: 14px;
    --g: 1.5px;
    position: absolute;
    inset: -5% -10%;
    z-index: 3;
    background:
      linear-gradient(var(--c) 0 0) top left / var(--l) var(--g),
      linear-gradient(var(--c) 0 0) top left / var(--g) var(--l),
      linear-gradient(var(--c) 0 0) top right / var(--l) var(--g),
      linear-gradient(var(--c) 0 0) top right / var(--g) var(--l),
      linear-gradient(var(--c) 0 0) bottom left / var(--l) var(--g),
      linear-gradient(var(--c) 0 0) bottom left / var(--g) var(--l),
      linear-gradient(var(--c) 0 0) bottom right / var(--l) var(--g),
      linear-gradient(var(--c) 0 0) bottom right / var(--g) var(--l);
    background-repeat: no-repeat;
  }

  .hero-etiqueta,
  .hero-nota-texto {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--azul-vivo);
  }

  .hero-etiqueta {
    position: absolute;
    display: none;
  }

  .hero-etiqueta b {
    color: var(--texto-tenue);
    font-weight: 500;
    text-transform: uppercase;
  }

  .hero-etiqueta-a {
    bottom: 100%;
    left: 0;
    margin-bottom: 8px;
  }

  .hero-etiqueta-b {
    top: 100%;
    right: 0;
    margin-top: 8px;
  }

  /* Anotaciones del plano: aparecen con la llave al centro (solo en la escena). */
  .hero-nota {
    position: absolute;
    z-index: 3;
    display: none;
    align-items: center;
    gap: 6px;
  }

  .hero-nota-texto {
    display: grid;
    color: var(--texto);
    text-align: right;
  }

  .hero-nota-texto b {
    color: var(--texto-tenue);
    font-weight: 500;
    text-transform: uppercase;
  }

  .hero-nota-linea {
    position: relative;
    width: clamp(14px, 4vw, 26px);
    height: 1px;
    background: var(--azul-vivo);
  }

  .hero-nota-linea::after {
    content: '';
    position: absolute;
    top: -2px;
    right: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--azul-vivo);
    box-shadow: 0 0 8px var(--azul-vivo);
  }

  /* Cabeza hexagonal: a la izquierda. Paletón: a la derecha. */
  .hero-nota-firma {
    top: 16.5%;
    right: 86%;
    transform-origin: right center;
  }

  .hero-nota-sello {
    top: 84%;
    left: 74%;
    transform-origin: left center;
  }

  .hero-nota-sello .hero-nota-texto {
    text-align: left;
  }

  .hero-nota-sello .hero-nota-linea::after {
    left: -2px;
    right: auto;
  }

  /* ── Frase (sin escena: debajo de la portada, como pie) ── */

  .hero-frase {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.2em;
    width: min(100% - 2 * var(--margen), var(--ancho));
    margin: 40px auto 0;
    padding-top: 22px;
    border-top: 1px solid var(--linea-oscura);
    color: var(--texto);
    font-family: var(--fuente-titulo);
    font-size: var(--h3);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.012em;
    text-align: center;
    text-wrap: balance;
  }

  .hero-frase-b {
    color: var(--texto-tenue);
  }

  .hero-bajar {
    position: absolute;
    left: 50%;
    bottom: 18px;
    z-index: 1;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--texto-tenue);
    font-size: 0.875rem;
    text-decoration: none;
    transform: translateX(-50%);
  }

  .hero-bajar:hover {
    color: var(--texto);
  }

  .hero-bajar-linea {
    width: 1px;
    height: 40px;
    background: linear-gradient(var(--azul-vivo), transparent);
    transform-origin: top;
    animation: hero-bajar 2.2s var(--ease) infinite;
  }

  @keyframes hero-bajar {
    0% {
      transform: scaleY(0);
      opacity: 1;
    }
    70% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  /* ── Tableta vertical ── */

