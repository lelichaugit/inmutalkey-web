---
// Cierre: la llave vuelve (sujetalibros del relato que abre el hero). Al entrar en vista se materializa con el escáner
// (plano técnico → render sólido → brillo); mientras cruza la ventana, sube un poco y sus aros se abren
// (data-progreso-scroll). Sin JS o con movimiento reducido: la llave sólida y quieta.
import { enlaceWhatsApp } from '../../lib/whatsapp';
import { sitio } from '../../site.config';
import Icono from '../Icono.astro';
import Isotipo3D from '../Isotipo3D.astro';

const prueba = enlaceWhatsApp(sitio.contacto.whatsapp, sitio.contacto.mensajes.prueba);
const dias = sitio.licencia.diasPrueba;
---

<section class="cta" aria-labelledby="cta-titulo" data-progreso-scroll data-sin-flotante>
  <div class="cta-fondo" aria-hidden="true"></div>

  <div class="contenedor cta-caja">
    <div class="cta-llave" data-animar="aparecer" aria-hidden="true">
      <div class="cta-llave-flota">
        <span class="cta-foco"></span>
        <span class="cta-aros">
          <svg viewBox="0 0 200 200" fill="none" focusable="false">
            <circle class="aro aro-exterior" cx="100" cy="100" r="99" pathLength="100"></circle>
            <circle class="aro aro-marcas" cx="100" cy="100" r="92"></circle>
            <path class="aro aro-arco" d="M 100 1 A 99 99 0 0 1 185.7 50.5" pathLength="100"></path>
            <path class="aro aro-arco" d="M 100 199 A 99 99 0 0 1 14.3 149.5" pathLength="100"></path>
          </svg>
        </span>
        <span class="cta-piso"></span>
        <div class="cta-llave-giro">
          <Isotipo3D sizes="(min-width: 768px) 140px, 110px" brillo plano reflejo class="cta-isotipo" />
        </div>
        <span class="cta-visor">
          <span class="cta-etiqueta cta-etiqueta-a">Ed25519</span>
          <span class="cta-etiqueta cta-etiqueta-b">SHA-256</span>
        </span>
      </div>
    </div>

    <h2 id="cta-titulo" class="cta-titulo" data-animar="titulo">Tu próxima nota puede quedar sellada hoy</h2>
    <p class="texto-grande tenue cta-texto" data-animar="subir" data-retraso="2">
      {dias} días completos para probarlo en tu consultorio. Te acompañamos desde el primer mensaje.
    </p>
    <div class="cta-acciones" data-animar="subir" data-retraso="3">
      {
        prueba && (
          <a class="boton boton-primario cta-whatsapp" href={prueba} target="_blank" rel="noopener noreferrer">
            <Icono nombre="chat" /> Pide tu prueba por WhatsApp
          </a>
        )
      }
      <a class="boton boton-secundario" href="#demo"><Icono nombre="play" /> Pruébalo aquí mismo</a>
    </div>
  </div>
</section>

<style>
  .cta {
    --alto-llave: clamp(190px, 30svh, 320px);
    position: relative;
    isolation: isolate;
    padding-block: clamp(72px, 9vw + 32px, 160px) clamp(80px, 10vw + 32px, 168px);
    overflow-x: clip;
    color: var(--texto);
    text-align: center;
  }

  /* Foco de luz desde arriba, cuadrícula tenue alrededor de la llave; abajo se funde con el pie (negro). */
  .cta-fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(46% 38% at 50% 26%, rgb(1 120 176 / 0.22), transparent 72%),
      linear-gradient(180deg, var(--medianoche) 0%, #03070f 55%, var(--negro) 100%);
    pointer-events: none;
  }

  .cta-fondo::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 55% 45% at 50% 30%, #000 10%, transparent 72%);
    mask-image: radial-gradient(ellipse 55% 45% at 50% 30%, #000 10%, transparent 72%);
  }

  .cta-caja {
    display: grid;
    justify-items: center;
    max-width: 820px;
  }

  /* ── La llave ── */

  .cta-llave {
    position: relative;
    width: calc(var(--alto-llave) * 304 / 724);
    height: var(--alto-llave);
    margin-bottom: calc(var(--alto-llave) * 0.22 + 20px);
  }

  .cta-llave-flota,
  .cta-llave-giro {
    position: absolute;
    inset: 0;
  }

  .cta-llave-giro {
    z-index: 2;
  }

  .cta-llave :global(.cta-isotipo) {
    --reflejo: 0.26;
  }

  .cta-foco {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(var(--alto-llave) * 1.5);
    height: calc(var(--alto-llave) * 1.5);
    margin: calc(var(--alto-llave) * -0.75) 0 0 calc(var(--alto-llave) * -0.75);
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(46 159 224 / 0.32),
      rgb(1 120 176 / 0.13) 45%,
      rgb(1 120 176 / 0.04) 72%,
      transparent
    );
  }

  .cta-aros {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: calc(var(--alto-llave) * 0.86);
    height: calc(var(--alto-llave) * 0.86);
    margin: calc(var(--alto-llave) * -0.43) 0 0 calc(var(--alto-llave) * -0.43);
    opacity: 0.85;
  }

  .cta-aros svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .aro {
    vector-effect: non-scaling-stroke;
    stroke-width: 1;
  }

  .aro-exterior {
    stroke: rgb(255 255 255 / 0.14);
  }

  .aro-marcas {
    vector-effect: none;
    stroke: rgb(46 159 224 / 0.38);
    stroke-width: 2.4;
    stroke-dasharray: 0.6 4.22;
  }

  .aro-arco {
    stroke: var(--azul-vivo);
    stroke-linecap: round;
    opacity: 0.8;
  }

  .cta-piso {
    position: absolute;
    top: 100.5%;
    left: 50%;
    z-index: 1;
    width: calc(var(--alto-llave) * 1.1);
    height: 1px;
    margin-left: calc(var(--alto-llave) * -0.55);
    background: linear-gradient(90deg, transparent, rgb(46 159 224 / 0.55) 30%, rgb(200 235 255 / 0.7) 50%, rgb(46 159 224 / 0.55) 70%, transparent);
  }

  .cta-piso::after {
    content: '';
    position: absolute;
    left: 15%;
    right: 15%;
    top: -14px;
    height: 28px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(46 159 224 / 0.28), transparent);
  }

  .cta-visor {
    --c: rgb(255 255 255 / 0.5);
    --l: 14px;
    --g: 1.5px;
    position: absolute;
    inset: -6% -24%;
    z-index: 3;
    background:
      linear-gradient(var(--c) 0 0) top left / var(--l) var(--g),
      linear-gradient(var(--c) 0 0) top left / var(--g) var(--l),
      linear-gradient(var(--c) 0 0) top right / var(--l) var(--g),
      linear-gradient(var(--c) 0 0) top right / var(--g) var(--l),
      linear-gradient(var(--c) 0 0) bottom left / var(--l) var(--g),
      linear-gradient(var(--c) 0 0) bottom left / var(--g) var(--l),
      linear-gradient(var(--c) 0 0) bottom right / var(--l) var(--g),
      linear-gradient(var(--c) 0 0) bottom right / var(--g) var(--l);
    background-repeat: no-repeat;
  }

  .cta-etiqueta {
    position: absolute;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--azul-vivo);
  }

  .cta-etiqueta-a {
    bottom: 100%;
    left: 0;
    margin-bottom: 8px;
  }

  .cta-etiqueta-b {
    top: 100%;
    right: 0;
    margin-top: 8px;
  }

  /* ── Texto ── */

  .cta-titulo {
    max-width: 16ch;
  }

  .cta-texto {
    max-width: 46ch;
    margin-top: 18px;
  }

  .cta-acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 34px;
  }

  .cta-whatsapp {
    min-height: 60px;
    padding-inline: 1.1em;
    font-size: 1.0625rem;
  }

  @media (min-width: 560px) {
    .cta-whatsapp {
      padding-inline: 1.8em;
      font-size: 1.1875rem;
    }
  }

  @media (max-width: 559px) {
    .cta-acciones {
      width: 100%;
    }

    .cta-acciones .boton {
      width: 100%;
    }
  }

  /* ── Materialización al entrar en vista (base.ts pone .es-visible; data-animar="aparecer") ── */

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .cta-llave:not(.es-visible) .cta-llave-giro {
      --materia: 0;
    }

    /* La luz espera a que la llave sea sólida (sin esto, cruzaría al cargar la página, fuera de vista). */
    :global(.js) .cta-llave:not(.es-visible) :global(.isotipo-brillo) {
      animation: none;
    }

    .cta-llave:global(.es-visible) :global(.isotipo-brillo) {
      animation-delay: 1.3s;
      animation-duration: 1s;
    }

    .cta-llave:global(.es-visible) .cta-llave-giro {
      animation: cta-materia 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.3s backwards;
    }

    :global(.js) .cta-llave:not(.es-visible) .cta-visor,
    :global(.js) .cta-llave:not(.es-visible) .cta-piso {
      opacity: 0;
    }

    .cta-llave:global(.es-visible) .cta-visor {
      animation: cta-enfoca 0.9s var(--ease) 0.1s backwards;
    }

    .cta-llave:global(.es-visible) .cta-piso {
      transform-origin: center;
      animation: cta-piso 0.7s var(--ease) 1.2s backwards;
    }

    .cta-llave:global(.es-visible) .aro-exterior,
    .cta-llave:global(.es-visible) .aro-arco {
      stroke-dasharray: 100 100;
      animation: cta-traza 1.4s var(--ease) 0.15s backwards;
    }
  }

  @keyframes cta-materia {
    from {
      --materia: 0;
    }
    to {
      --materia: 1;
    }
  }

  @keyframes cta-enfoca {
    from {
      opacity: 0;
      transform: scale(1.14);
    }
  }

  @keyframes cta-traza {
    from {
      stroke-dashoffset: 100;
    }
  }

  @keyframes cta-piso {
    from {
      opacity: 0;
      transform: scaleX(0);
    }
  }

  /* Mientras cruza la ventana: la llave sube un poco más lento que la página y los aros se abren. */
  :global(.movimiento) .cta-llave-flota {
    transform: translate3d(0, calc((0.5 - var(--p, 0.5)) * 56px), 0);
  }

  :global(.movimiento) .cta-aros {
    transform: scale(calc(0.9 + var(--p, 0.5) * 0.2));
  }
</style>
