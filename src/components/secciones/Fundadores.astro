---
// Programa Fundadores (IDENTIDAD_MARCA §9.6): beta privada, prueba de 30 días a cambio de una reseña verificada,
// licencia vitalicia a precio especial y soporte personalizado. Precio y lugares salen de site.config.ts; si no están
// definidos no se inventan. El cupo en vivo lo pinta formularios.ts desde /api/fundadores/cupo (oculto sin dato).
import { estaDefinido, sitio } from '../../site.config';
import Icono from '../Icono.astro';

const { precios, licencia } = sitio;
const precio = estaDefinido(precios.fundadores) ? `$${precios.fundadores.toLocaleString('es-MX')} ${precios.moneda}` : null;

const BENEFICIOS = [
  { icono: 'llave', titulo: 'Acceso a la beta privada', texto: `${licencia.diasPrueba} días con todas las funciones, sin tarjeta.` },
  { icono: 'firma', titulo: 'Su reseña, verificada', texto: 'A cambio de la prueba, nos cuenta qué le sirvió y qué no. La publicamos solo con su autorización.' },
  { icono: 'sello', titulo: 'Licencia vitalicia', texto: precio ? `A precio de fundador: ${precio}. Se paga una vez.` : 'A precio especial de fundador. Se paga una vez y se activa sin internet.' },
  { icono: 'chat', titulo: 'Soporte personalizado', texto: 'Lo atiende el mismo equipo que desarrolla InmutalKey, por WhatsApp o correo.' },
] as const;
---

<section class="seccion fundadores" id="fundadores" aria-labelledby="fundadores-titulo">
  <div class="contenedor">
    <div class="fundadores-panel tarjeta">
      <div class="fundadores-texto">
        <p class="antetitulo">Programa Fundadores</p>
        <h2 id="fundadores-titulo">Sea de los primeros médicos en sellar su expediente.</h2>
        <p class="texto-grande">
          Un grupo pequeño de médicos usa InmutalKey antes que nadie y decide con nosotros qué mejora primero.
        </p>
        <p class="pildora fundadores-cupo" data-cupo hidden></p>
        <div class="acciones">
          <a class="boton boton-primario boton-grande" href="/fundadores">Solicitar acceso Fundador</a>
          <a class="boton boton-grande" href="/terminos-fundadores">Ver los términos</a>
        </div>
      </div>
      <ul class="beneficios" data-escalonar>
        {
          BENEFICIOS.map((b) => (
            <li class="revelar">
              <span class="sello">
                <Icono nombre={b.icono} />
              </span>
              <div>
                <h3>{b.titulo}</h3>
                <p>{b.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .fundadores-panel {
    position: relative;
    overflow: clip;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: clamp(1.75rem, 5vw, 4rem);
    border-radius: var(--radio-xl);
    box-shadow: var(--cristal-brillo), var(--elev-2);
  }

  .fundadores-panel::before {
    content: '';
    position: absolute;
    inset: -40% auto auto -20%;
    z-index: 0;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--aurora-2) 22%, transparent), transparent);
    pointer-events: none;
  }

  .fundadores-texto,
  .beneficios {
    position: relative;
  }

  .fundadores-texto {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .fundadores-cupo {
    justify-self: start;
  }

  .fundadores-texto .acciones {
    margin-top: 0.75rem;
  }

  .beneficios {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .beneficios li {
    display: flex;
    gap: 1rem;
  }

  .beneficios h3 {
    margin: 0.125rem 0 0.25rem;
  }

  .beneficios p {
    color: var(--texto-2);
  }

  @media (max-width: 60rem) {
    .fundadores-panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
