---
// La ilustración de la escena central (decorativa: el texto real de cada paso vive en Integridad.astro). Hilo visual
// del sitio: la MISMA llave del hero baja, gira como en una cerradura y sella la nota.
//
// Todo se deriva de --p (0 → 1), que el motor de scroll pone en la escena fijada de Integridad.astro, y de --e
// (entrada). Sin JS o con movimiento reducido, var(--p, 1) deja el estado final: nota sellada, encadenada y con su
// addendum. Guion (tramos de --p; las marcas de Integridad.astro caen en los cortes):
//   1 Escribir    0.00–0.18  cabecera con --e; filas S/O/A/P una por una (clip-path + cursor); signos vitales
//   2 Semáforo    0.18–0.38  la hoja sube; 7 requisitos se encienden; rojo → ámbar → verde; la hoja baja
//   3 Firmar      0.38–0.62  la nota baja a su lugar; la llave baja (de plano a sólida), gira, el anillo se dibuja,
//                            la huella se calcula (escáner) y la nota se encadena con las anteriores
//   4 Alteración  0.62–0.80  un cursor cambia el medicamento por fuera de la app: la huella ya no coincide → rojo
//   5 Addendum    0.80–1.00  la nota original (intacta) sube y se agrega el addendum enlazado a su huella
// La huella que "se decodifica" (data-huella) la anima escenas.ts al llegar a su paso; el HTML ya trae la final.
//
// Geometría: una maqueta de 28 × 24 em. Su font-size sale del tamaño del visor (container queries), así que la
// escena se escala completa, como una ilustración vectorial, del celular de 360 px al escritorio.
import { requisitos, type DatosNota } from '../../lib/semaforo';
import Icono from '../Icono.astro';
import Isotipo3D from '../Isotipo3D.astro';

// Las etiquetas del semáforo salen de la misma lógica que la app (src/lib/semaforo.ts), en el build.
const NOTA_VACIA: DatosNota = {
  motivo: '',
  evolucion: '',
  taSistolica: '',
  taDiastolica: '',
  fc: '',
  fr: '',
  temperatura: '',
  peso: '',
  talla: '',
  omisionSignos: '',
  exploracion: '',
  diagnostico: '',
  cie10: '',
  pronostico: '',
  plan: '',
};
const REQUISITOS = requisitos(NOTA_VACIA).map((r) => r.etiqueta);

// Huellas de ejemplo (SHA-256 reales de textos de prueba), abreviadas como en la app.
const HUELLA = { anterior: '35d2e1…2f0bd3', actual: 'b31c88b0…25eae6', alterada: '002f7968…21b31c' };

interface Fila {
  letra: string;
  etiqueta: string;
  valor?: string;
  signos?: readonly string[];
  alterado?: string;
}

const FILAS: readonly Fila[] = [
  { letra: 'S', etiqueta: 'Motivo', valor: 'Dolor de garganta y fiebre' },
  { letra: '', etiqueta: 'Evolución', valor: '2 días, sin mejoría' },
  { letra: 'O', etiqueta: 'Signos', signos: ['TA 120/80', 'FC 88', 'T 38.2 °C'] },
  { letra: '', etiqueta: 'Exploración', valor: 'Faringe hiperémica' },
  { letra: 'A', etiqueta: 'Diagnóstico', valor: 'J02.9 Faringitis aguda' },
  { letra: '', etiqueta: 'Pronóstico', valor: 'Favorable' },
  { letra: 'P', etiqueta: 'Plan', valor: 'Paracetamol 500 mg c/8 h', alterado: 'Ibuprofeno 400 mg c/8 h' },
];
---

<div class="maqueta">
  <span class="mq-halo"></span>
  <div class="mq-mover">
    {/* Notas anteriores del mismo paciente: la cadena */}
    <div class="mq-mazo">
      <div class="tira tira-a">
        <span class="tira-nodo"></span>
        <span class="tira-titulo">Nota 10 · 12 sep</span>
        <span class="tira-huella"><Icono nombre="check" />bd12c0…d6790b</span>
      </div>
      <div class="tira tira-b">
        <span class="tira-nodo"></span>
        <span class="tira-titulo">Nota 11 · 3 oct</span>
        <span class="tira-huella"><Icono nombre="check" />{HUELLA.anterior}</span>
      </div>
    </div>
    {/* Eslabones: nota 10 → 11 → la de hoy (hash previo → hash actual). Por encima de la tarjeta. */}
    <span class="eslabon eslabon-1"></span>
    <span class="eslabon eslabon-2"></span>
    <span class="eslabon eslabon-roto"></span>

    <article class="mq-nota">
      <header class="nota-cabecera">
        <span class="nota-nodo"></span>
        <strong class="nota-titulo">Nota de evolución</strong>
        <span class="nota-paciente">Paciente de ejemplo · Exp. 0042</span>
        <span class="nota-estado">
          <span class="estado-borrador"><i></i>Borrador</span>
          <span class="estado-sellada">Sellada 10:14</span>
          <span class="estado-alterada">Alterada</span>
        </span>
      </header>

      <div class="nota-filas">
        {
          FILAS.map((f) => (
            <div class:list={['fila', { 'fila-grupo': f.letra !== '', 'fila-alterable': f.alterado }]}>
              <span class="fila-letra">{f.letra}</span>
              <span class="fila-etiqueta">{f.etiqueta}</span>
              {f.signos ? (
                <span class="fila-signos">
                  {f.signos.map((s) => (
                    <span class="chip">{s}</span>
                  ))}
                </span>
              ) : (
                <span class="fila-caja">
                  <span class="fila-valor">{f.valor}</span>
                  {f.alterado && (
                    <>
                      <span class="fila-seleccion" />
                      <span class="fila-alterado">{f.alterado}</span>
                    </>
                  )}
                  <span class="fila-cursor" />
                </span>
              )}
            </div>
          ))
        }
      </div>

      <footer class="nota-pie">
        <p class="pie-borrador"><i></i>Borrador guardado hace 2 s</p>
        <div class="pie-sello">
          <span class="pie-etiqueta">Anterior</span>
          <span class="pie-hash">{HUELLA.anterior}</span>
          <span class="pie-etiqueta">Huella</span>
          <span class="pie-hash pie-actual">
            <span class="hash-bien" data-huella={HUELLA.actual} data-huella-paso="3">{HUELLA.actual}</span>
            <span class="hash-mal">≠ <span data-huella={HUELLA.alterada} data-huella-paso="4">{HUELLA.alterada}</span></span>
          </span>
          <span class="pie-firma"><Icono nombre="check" />Ed25519</span>
        </div>
      </footer>

      <div class="nota-escaner"></div>
      <div class="nota-borde-rojo"></div>

      {/* Semáforo NOM-004: la hoja que sube sobre la nota antes de firmar */}
      <div class="semaforo">
        <div class="semaforo-cabecera">
          <span class="luces">
            <i class="luz luz-roja"></i>
            <i class="luz luz-ambar"></i>
            <i class="luz luz-verde"></i>
          </span>
          <strong>Semáforo NOM-004</strong>
          <span class="semaforo-estado">
            <span class="se-rojo">Incompleta</span>
            <span class="se-ambar">Casi lista</span>
            <span class="se-verde">Lista para firmar</span>
          </span>
        </div>
        <ul class="requisitos">
          {
            REQUISITOS.map((r) => (
              <li class="req">
                <span class="req-marca">
                  <Icono nombre="check" />
                </span>
                {r}
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    {/* El sello (fuera de la tarjeta para que la llave no se recorte) y la llave que lo cierra */}
    <div class="mq-sello">
      <svg class="sello-svg" viewBox="0 0 48 48">
        <circle class="s-base" cx="24" cy="24" r="21"></circle>
        <circle class="s-disco" cx="24" cy="24" r="17"></circle>
        <path class="s-cerradura" d="M24 14.5a4.2 4.2 0 0 1 2.3 7.7L27.6 31h-7.2l1.3-8.8a4.2 4.2 0 0 1 2.3-7.7z"></path>
        <path class="s-anillo" d="M24 3a21 21 0 1 1 0 42a21 21 0 1 1 0-42" pathLength="1"></path>
        <path class="s-anillo s-anillo-rojo" d="M24 3a21 21 0 1 1 0 42a21 21 0 1 1 0-42" pathLength="1"></path>
        <path class="s-palomita" d="M15.5 24.5l6 6L33 18.5" pathLength="1"></path>
        <path class="s-cruz" d="M18 18l12 12M30 18L18 30"></path>
      </svg>
      <span class="sello-onda"></span>
      <div class="mq-llave">
        <div class="mq-llave-giro">
          <Isotipo3D sizes="64px" plano brillo />
        </div>
      </div>
    </div>

    {/* Paso 4: alguien edita el archivo por fuera de InmutalKey */}
    <div class="mq-cursor">
      <svg viewBox="0 0 24 24"><path d="M5 2.5v17.2l4.6-4.4 3 6.6 3-1.4-3-6.4h6.3z"></path></svg>
      <span>fuera de la app</span>
    </div>
    <p class="mq-alerta"><Icono nombre="alerta" />Alteración detectada · auditoría de integridad</p>
  </div>

  <span class="mq-enlace"></span>
  <article class="mq-addendum">
    <header>
      <strong>Addendum 1 · Corrección de captura</strong>
      <span class="addendum-sello"><Icono nombre="check" />Sellado</span>
    </header>
    <p>
      <span>Temperatura: 38.4 °C</span>
      <span class="addendum-enlace">↳ {HUELLA.actual}</span>
    </p>
  </article>
</div>

<style>
  /* ── Línea de tiempo: avance local (0 → 1) de cada tramo de --p ── */
  .maqueta {
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --verde: var(--esmeralda);
    --verde-vivo: var(--esmeralda-vivo);
    --rojo: var(--error-claro);
    --rojo-vivo: var(--error);
    --papel: #f8fafc;
    --papel-tinta: #0f172a;
    --papel-tenue: #64748b;
    --papel-linea: #e2e8f0;

    --t-entra: clamp(0, (var(--e, 1) - 0.15) / 0.6, 1);
    --t-cabecera: clamp(0, (var(--e, 1) - 0.45) / 0.5, 1);
    /* 1 · Escribir */
    --t-borrador: clamp(0, (var(--p, 1) - 0.1) / 0.03, 1);
    /* 2 · Semáforo */
    --t-hoja: min(clamp(0, (var(--p, 1) - 0.18) / 0.035, 1), 1 - clamp(0, (var(--p, 1) - 0.355) / 0.035, 1));
    /* 3 · Firmar */
    --t-baja: clamp(0, (var(--p, 1) - 0.37) / 0.05, 1);
    --t-llave: clamp(0, (var(--p, 1) - 0.4) / 0.07, 1);
    --t-giro: clamp(0, (var(--p, 1) - 0.47) / 0.035, 1);
    --t-anillo: clamp(0, (var(--p, 1) - 0.495) / 0.05, 1);
    --t-escaner: clamp(0, (var(--p, 1) - 0.5) / 0.05, 1);
    --t-palomita: clamp(0, (var(--p, 1) - 0.54) / 0.02, 1);
    --t-onda: clamp(0, (var(--p, 1) - 0.545) / 0.05, 1);
    --t-retiro: clamp(0, (var(--p, 1) - 0.56) / 0.045, 1);
    --t-mazo: clamp(0, (var(--p, 1) - 0.57) / 0.035, 1);
    --t-eslabon: clamp(0, (var(--p, 1) - 0.59) / 0.03, 1);
    /* 4 · Alteración (todo vuelve en 0.79–0.82: la original nunca cambió dentro de la app) */
    --t-vuelta: clamp(0, (var(--p, 1) - 0.79) / 0.03, 1);
    --t-cursor: min(clamp(0, (var(--p, 1) - 0.63) / 0.04, 1), 1 - var(--t-vuelta));
    --t-seleccion: min(clamp(0, (var(--p, 1) - 0.67) / 0.02, 1), 1 - clamp(0, (var(--p, 1) - 0.71) / 0.015, 1));
    --t-cambio: min(clamp(0, (var(--p, 1) - 0.69) / 0.02, 1), 1 - var(--t-vuelta));
    --t-rojo: min(clamp(0, (var(--p, 1) - 0.71) / 0.03, 1), 1 - var(--t-vuelta));
    /* 5 · Addendum */
    --t-sube: clamp(0, (var(--p, 1) - 0.82) / 0.05, 1);
    --t-addendum: clamp(0, (var(--p, 1) - 0.86) / 0.06, 1);
    --t-enlace: clamp(0, (var(--p, 1) - 0.9) / 0.04, 1);
    --t-sello-add: clamp(0, (var(--p, 1) - 0.93) / 0.03, 1);

    position: relative;
    width: 28em;
    height: 24em;
    /* Respaldo para navegadores sin container queries; el resto toma el tamaño del visor. */
    font-size: 12px;
    font-size: min(100cqw / 28.6, 100cqh / 24.4, 19px);
    line-height: 1.35;
    color: var(--papel-tinta);
    transform: scale(calc(0.94 + var(--t-entra) * 0.06));
    opacity: calc(0.25 + var(--t-entra) * 0.75);
  }

  /* Destello esmeralda detrás de la nota en el instante del sello. */
  .mq-halo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30em;
    height: 26em;
    margin: -13em 0 0 -15em;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(47 209 154 / 0.32), rgb(47 209 154 / 0.08) 55%, transparent 75%);
    transform: scale(calc(0.7 + var(--t-onda) * 0.5));
    opacity: calc(min(var(--t-onda) * 6, 1) * (1 - var(--t-onda)));
    pointer-events: none;
  }

  /* ── La nota y lo que se mueve con ella ── */
  /* Pasos 1–2 arriba; en el 3 baja para dejar sitio a la llave; en el 5 sube para el addendum. */
  .mq-mover {
    position: absolute;
    left: 1em;
    top: 5.6em;
    width: 26em;
    height: 16.8em;
    transform: translate3d(0, calc((1 - var(--t-baja)) * -2em - var(--t-sube) * 4.6em - var(--t-rojo) * 1.1em), 0);
  }

  .mq-nota {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    overflow: clip;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 1em;
    background: var(--papel);
    box-shadow:
      0 0 0 1px rgb(13 27 53 / 0.06),
      0 2.4em 4em -1.6em rgb(0 0 0 / 0.85),
      0 0 5em -1em rgb(46 159 224 / 0.25);
  }

  .nota-cabecera {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: center;
    height: 2.9em;
    padding: 0 5.6em 0 2.4em;
    border-bottom: 1px solid var(--papel-linea);
    clip-path: inset(0 calc((1 - var(--t-cabecera)) * 100%) 0 0);
  }

  .nota-nodo,
  .tira-nodo {
    position: absolute;
    width: 0.56em;
    height: 0.56em;
    border: 1.5px solid var(--verde);
    border-radius: 50%;
    background: var(--papel);
  }

  .nota-nodo {
    left: 1.22em;
    top: 0.63em;
    border-color: #94a3b8;
  }

  .nota-titulo {
    font-family: var(--fuente-titulo);
    font-size: 1.08em;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nota-paciente {
    grid-column: 1 / -1;
    color: var(--papel-tenue);
    font-size: 0.8em;
  }

  .nota-estado {
    display: grid;
    grid-row: 1;
    grid-column: 2;
    justify-items: end;
    font-size: 0.78em;
    font-weight: 600;
  }

  .nota-estado > span {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    white-space: nowrap;
  }

  .estado-borrador {
    color: var(--azul);
    opacity: calc(1 - var(--t-anillo) * 3);
  }

  .estado-borrador i,
  .pie-borrador i {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: currentColor;
  }

  .estado-sellada {
    color: var(--verde);
    opacity: calc((var(--t-anillo) - 0.6) * 2.5 - var(--t-rojo));
  }

  .estado-alterada {
    color: var(--rojo);
    opacity: var(--t-rojo);
  }

  /* ── Filas S/O/A/P: se escriben una por una ── */
  .nota-filas {
    display: grid;
    grid-auto-rows: 1.5em;
    padding: 0.45em 1.2em 0;
  }

  .fila {
    --t: clamp(0, (var(--p, 1) - var(--a, 0)) / 0.02, 1);
    display: grid;
    grid-template-columns: 1.3em 5.9em minmax(0, 1fr);
    align-items: center;
  }

  .fila:nth-child(1) { --a: 0.012; }
  .fila:nth-child(2) { --a: 0.033; }
  .fila:nth-child(3) { --a: 0.054; }
  .fila:nth-child(4) { --a: 0.078; }
  .fila:nth-child(5) { --a: 0.099; }
  .fila:nth-child(6) { --a: 0.12; }
  .fila:nth-child(7) { --a: 0.141; }

  .fila-grupo:not(:first-child) {
    border-top: 1px dashed var(--papel-linea);
  }

  .fila-letra {
    font-family: var(--fuente-titulo);
    font-weight: 700;
    color: var(--azul);
    opacity: var(--t);
  }

  .fila-etiqueta {
    color: var(--papel-tenue);
    font-size: 0.8em;
    font-weight: 600;
    opacity: calc(0.3 + var(--t) * 0.7);
  }

  .fila-caja {
    position: relative;
    justify-self: start;
    max-width: 100%;
    white-space: nowrap;
  }

  .fila-valor {
    display: block;
    line-height: 1.5;
    clip-path: inset(0 calc((1 - var(--t)) * 100%) 0 0);
  }

  .fila-alterable .fila-valor {
    opacity: calc(1 - var(--t-cambio));
  }

  /* Cursor de escritura: recorre el ancho del texto (transform, no `left`) y solo se ve a medio escribir. */
  .fila-cursor {
    position: absolute;
    inset: 0;
    transform: translate3d(calc(var(--t) * 100%), 0, 0);
    opacity: calc(min(var(--t), 1 - var(--t)) * 30);
    pointer-events: none;
  }

  :global(html:not(.movimiento)) .fila-cursor {
    display: none;
  }

  .fila-cursor::before {
    content: '';
    position: absolute;
    left: 0.06em;
    top: 12%;
    bottom: 12%;
    width: 0.11em;
    border-radius: 1px;
    background: var(--azul);
  }

  .fila-signos {
    display: flex;
    gap: 0.35em;
  }

  .chip {
    --tc: clamp(0, (var(--p, 1) - var(--a, 0) - var(--j, 0) * 0.006) / 0.008, 1);
    padding: 0.08em 0.5em;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 0.82em;
    font-weight: 600;
    white-space: nowrap;
    transform: scale(calc(0.7 + var(--tc) * 0.3));
    opacity: var(--tc);
  }

  .chip:nth-child(2) { --j: 1; }
  .chip:nth-child(3) { --j: 2; }

  /* Paso 4: el medicamento cambia por fuera de la app. */
  .fila-seleccion {
    position: absolute;
    inset: 0.05em -0.15em;
    border-radius: 0.2em;
    background: rgb(1 120 176 / 0.22);
    transform-origin: 0 50%;
    transform: scaleX(var(--t-seleccion));
    opacity: var(--t-seleccion);
  }

  .fila-alterado {
    position: absolute;
    left: 0;
    top: 0;
    line-height: 1.5;
    color: var(--rojo);
    font-weight: 600;
    clip-path: inset(0 calc((1 - var(--t-cambio)) * 100%) 0 0);
  }

  /* ── Pie: borrador → huella encadenada y firma ── */
  .nota-pie {
    position: absolute;
    inset: auto 0 0;
    height: 2.9em;
    padding: 0 1.2em;
    border-top: 1px solid var(--papel-linea);
    background: #f1f5f9;
  }

  .pie-borrador {
    position: absolute;
    inset: 0 1.2em;
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    color: var(--azul);
    font-size: 0.8em;
    font-weight: 600;
    opacity: calc(var(--t-borrador) - var(--t-anillo) * 3);
  }

  .pie-sello {
    position: absolute;
    inset: 0 1.2em;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: 1fr 1fr;
    align-items: center;
    column-gap: 0.7em;
    padding-block: 0.3em;
    opacity: var(--t-palomita);
  }

  .pie-etiqueta {
    color: var(--papel-tenue);
    font-size: 0.72em;
    font-weight: 600;
  }

  .pie-hash {
    font-family: var(--mono);
    font-size: 0.76em;
    color: #475569;
    white-space: nowrap;
  }

  .pie-actual {
    display: grid;
    color: var(--verde);
    font-weight: 700;
  }

  .pie-actual > span {
    grid-area: 1 / 1;
  }

  .hash-bien {
    opacity: calc(1 - var(--t-rojo));
  }

  .hash-mal {
    color: var(--rojo);
    opacity: var(--t-rojo);
  }

  .pie-firma {
    grid-row: 1 / -1;
    grid-column: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.2em 0.6em;
    border: 1px solid rgb(10 139 105 / 0.3);
    border-radius: 999px;
    background: rgb(10 139 105 / 0.08);
    color: var(--verde);
    font-family: var(--mono);
    font-size: 0.72em;
    font-weight: 700;
  }

  .pie-firma :global(.icono),
  .tira-huella :global(.icono),
  .addendum-sello :global(.icono) {
    width: 1.1em;
