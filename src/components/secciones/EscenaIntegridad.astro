---
// Escenario de la historia de integridad. El hilo visual del sitio: la MISMA llave del hero baja y sella la nota.
// Estados por clases acumulativas `alcanzo-N` (1–5) + `data-paso` exacto:
//   1 escribir · 2 la llave sella · 3 cadena con las notas anteriores · 4 alteración externa detectada · 5 addendum
// `paso={0}` + `dinamica` = el escenario pegajoso que escenas.ts va moviendo; con un número fijo = copia estática
// (sin JS o con movimiento reducido).
import Icono from '../Icono.astro';
import Isotipo3D from '../Isotipo3D.astro';

interface Props {
  paso: 0 | 1 | 2 | 3 | 4 | 5;
  dinamica?: boolean;
}

const { paso, dinamica = false } = Astro.props;
const clases = Array.from({ length: paso }, (_, i) => `alcanzo-${i + 1}`);
---

<div
  class:list={['escena', ...clases]}
  data-paso={paso}
  data-escena-dinamica={dinamica ? '' : undefined}
  aria-hidden="true"
>
  <div class="escena-panel">
    <div class="previa previa-1">
      <span class="previa-titulo">Nota 1</span>
      <span class="previa-fecha">3 de marzo</span>
      <span class="previa-sello"><Icono nombre="check" /> Sellada</span>
      <span class="previa-huella">huella 4a7e…</span>
    </div>
    <div class="previa previa-2">
      <span class="previa-titulo">Nota 2</span>
      <span class="previa-fecha">17 de abril</span>
      <span class="previa-sello"><Icono nombre="check" /> Sellada</span>
      <span class="previa-huella">huella c19b…</span>
    </div>

    <svg class="eslabones" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path class="eslabon eslabon-1" d="M20 25 V 33" pathLength="1"></path>
      <path class="eslabon eslabon-2" d="M37 42 C 40 42, 40 30, 44 30" pathLength="1"></path>
    </svg>

    <article class="nota">
      <header class="nota-cabecera">
        <strong>Nota de evolución</strong>
        <span>Paciente de ejemplo · Hoy 14:32</span>
      </header>
      <dl class="nota-campos">
        <div class="campo">
          <dt>Motivo</dt>
          <dd>Dolor de garganta y fiebre de 2 días</dd>
        </div>
        <div class="campo">
          <dt>Signos</dt>
          <dd>TA 120/80 · FC 88 · T 38.2 °C</dd>
        </div>
        <div class="campo campo-dx">
          <dt>Diagnóstico</dt>
          <dd>
            <span class="dx-original">J02.9 Faringitis aguda</span>
            <span class="dx-alterado">J03.9 Amigdalitis aguda</span>
          </dd>
        </div>
        <div class="campo">
          <dt>Plan</dt>
          <dd>Paracetamol 500 mg cada 8 h por 3 días</dd>
        </div>
      </dl>
      <p class="nota-borrador"><Icono nombre="reloj" /> Borrador guardado hace 2 s</p>
      <p class="nota-sello"><span class="nota-sello-aro"><Icono nombre="check" /></span> Sellada · huella 9f2c…</p>
      <p class="nota-alerta"><Icono nombre="alerta" /> La huella ya no coincide: alterada por fuera</p>
    </article>

    <article class="addendum">
      <strong>Addendum 1 · Corrección de captura</strong>
      <span>Temperatura correcta: 38.4 °C</span>
      <span class="previa-sello"><Icono nombre="check" /> Sellado · la nota original no cambia</span>
    </article>

    <div class="escena-llave">
      <Isotipo3D sizes="160px" />
    </div>
    <span class="onda"></span>
  </div>
</div>

<style>
  .escena {
    container-type: inline-size;
    width: 100%;
    max-width: 580px;
    margin-inline: auto;
    --verde: var(--esmeralda-vivo);
    --rojo: #ff6b6b;
    --t: 0.9s;
  }

  .escena-panel {
    position: relative;
    aspect-ratio: 1 / 0.92;
    border: 1px solid var(--linea-oscura-fuerte);
    border-radius: 22px;
    background:
      radial-gradient(80% 60% at 70% 20%, rgb(46 159 224 / 0.12), transparent 70%),
      linear-gradient(var(--linea-oscura) 1px, transparent 1px) 0 0 / 8.33% 8.33%,
      linear-gradient(90deg, var(--linea-oscura) 1px, transparent 1px) 0 0 / 8.33% 8.33%,
      var(--medianoche-2);
    overflow: hidden;
    font-size: clamp(9px, 2.55cqi, 14.5px);
    line-height: 1.35;
  }

  /* ── Notas anteriores (cadena) ── */
  .previa {
    position: absolute;
    left: 5%;
    width: 31%;
    display: grid;
    gap: 0.25em;
    padding: 0.8em 0.9em;
    border: 1px solid var(--linea-oscura-fuerte);
    border-radius: 0.9em;
    background: rgb(255 255 255 / 0.04);
    color: var(--texto-tenue);
    opacity: 0.35;
    transform: translateX(-8%);
    transition:
      opacity var(--t) var(--ease),
      transform var(--t) var(--ease),
      border-color var(--t) var(--ease);
  }

  .previa-1 {
    top: 9%;
  }

  .previa-2 {
    top: 36%;
  }

  .previa-titulo {
    color: var(--texto);
    font-weight: 600;
  }

  .previa-sello {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: var(--verde);
    font-weight: 600;
  }

  .previa-sello :global(.icono) {
    width: 1.1em;
    height: 1.1em;
  }

  .previa-huella {
    font-size: 0.85em;
    opacity: 0.8;
  }

  .alcanzo-3 .previa {
    opacity: 1;
    transform: none;
    border-color: rgb(47 209 154 / 0.35);
  }

  .alcanzo-3 .previa-2 {
    transition-delay: 0.15s;
  }

  /* ── Eslabones ── */
  .eslabones {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .eslabon {
    fill: none;
    stroke: var(--verde);
    stroke-width: 0.7;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    vector-effect: non-scaling-stroke;
    transition: stroke-dashoffset 0.8s var(--ease);
  }

  .eslabon {
    stroke-width: 2.5px;
  }

  .alcanzo-3 .eslabon-1 {
    stroke-dashoffset: 0;
    transition-delay: 0.35s;
  }

  .alcanzo-3 .eslabon-2 {
    stroke-dashoffset: 0;
    transition-delay: 0.75s;
  }

  .escena[data-paso='4'] .eslabon-2 {
    stroke: var(--rojo);
    stroke-dasharray: 0.08 0.06;
    stroke-dashoffset: 0;
  }

  /* ── La nota de hoy ── */
  .nota {
    position: absolute;
    top: 8%;
    right: 5%;
    width: 53%;
    padding: 1em 1.1em 1.2em;
    border: 1px solid var(--linea-oscura-fuerte);
    border-radius: 1em;
    background: #f8fafc;
    color: #0f172a;
    box-shadow: 0 2em 4em -1.5em rgb(0 0 0 / 0.7);
    transition:
      border-color var(--t) var(--ease),
      box-shadow var(--t) var(--ease),
      transform var(--t) var(--ease);
  }

  .nota-cabecera {
    display: grid;
    gap: 0.1em;
    padding-bottom: 0.6em;
    margin-bottom: 0.6em;
    border-bottom: 1px solid #e2e8f0;
  }

  .nota-cabecera strong {
    font-size: 1.1em;
  }

  .nota-cabecera span {
    color: #475569;
    font-size: 0.85em;
  }

  .nota-campos {
    display: grid;
    gap: 0.55em;
    margin: 0;
  }

  .campo dt {
    color: #64748b;
    font-size: 0.78em;
    font-weight: 600;
  }

  .campo dd {
    position: relative;
    margin: 0.1em 0 0;
    min-height: 1.35em;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.7s steps(18, end);
  }

  .alcanzo-1 .campo dd {
    clip-path: inset(0 0 0 0);
  }

  .alcanzo-1 .campo:nth-child(2) dd {
    transition-delay: 0.45s;
  }

  .alcanzo-1 .campo:nth-child(3) dd {
    transition-delay: 0.9s;
  }

  .alcanzo-1 .campo:nth-child(4) dd {
    transition-delay: 1.35s;
  }

  .dx-alterado {
    position: absolute;
    left: 0;
    top: 0;
    color: var(--error-claro);
    font-weight: 600;
    opacity: 0;
    transform: translateY(-0.4em);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  .dx-original {
    transition: opacity 0.3s;
  }

  .escena[data-paso='4'] .dx-original {
    opacity: 0;
  }

  .escena[data-paso='4'] .dx-alterado {
    opacity: 1;
    transform: none;
  }

  .nota-borrador,
  .nota-sello,
  .nota-alerta {
    position: absolute;
    left: 1.1em;
    right: 1.1em;
    bottom: -1.1em;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    width: max-content;
    max-width: calc(100% - 2.2em);
    padding: 0.35em 0.75em;
    border-radius: 999px;
    font-size: 0.85em;
    font-weight: 600;
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }

  .nota-borrador :global(.icono),
  .nota-alerta :global(.icono) {
    width: 1.2em;
    height: 1.2em;
  }

  .nota-borrador {
    background: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
    opacity: 0;
  }

  .alcanzo-1 .nota-borrador {
    opacity: 1;
    transition-delay: 1.8s;
  }

  .alcanzo-2 .nota-borrador {
    opacity: 0;
    transform: translateY(0.5em);
    transition-delay: 0s;
  }

  .nota-sello {
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
    opacity: 0;
    transform: scale(0.85);
  }

  .nota-sello-aro {
    display: grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    background: #047857;
    color: #fff;
  }

  .nota-sello-aro :global(.icono) {
    width: 1em;
    height: 1em;
    stroke-width: 2.5;
  }

  .alcanzo-2 .nota-sello {
    opacity: 1;
    transform: none;
    transition-delay: 0.75s;
  }

  .alcanzo-2 .nota {
    border-color: rgb(47 209 154 / 0.65);
    box-shadow:
      0 0 0 4px rgb(47 209 154 / 0.14),
      0 2em 4em -1.5em rgb(0 0 0 / 0.7);
    transition-delay: 0.6s;
  }

  .nota-alerta {
    background: #fef2f2;
    color: var(--error-claro);
    border: 1px solid #fecaca;
    opacity: 0;
  }

  .escena[data-paso='4'] .nota-alerta {
    opacity: 1;
  }

  .escena[data-paso='4'] .nota-sello {
    opacity: 0;
  }

  .escena[data-paso='4'] .nota {
    border-color: var(--rojo);
    box-shadow:
      0 0 0 4px rgb(255 107 107 / 0.18),
      0 2em 4em -1.5em rgb(0 0 0 / 0.7);
    animation: temblor 0.5s 0.2s;
  }

  @keyframes temblor {
    20%,
    60% {
      transform: translateX(-0.4em);
    }
    40%,
    80% {
      transform: translateX(0.4em);
    }
  }

  /* ── Addendum ── */
  .addendum {
    position: absolute;
    right: 5%;
    bottom: 6%;
    width: 53%;
    display: grid;
    gap: 0.3em;
    padding: 0.8em 1.1em;
    border: 1px solid rgb(47 209 154 / 0.5);
    border-left: 4px solid var(--verde);
    border-radius: 0.9em;
    background: rgb(10 139 105 / 0.12);
    color: var(--texto);
    opacity: 0;
    transform: translateY(1.2em);
    transition:
      opacity var(--t) var(--ease),
      transform var(--t) var(--ease);
  }

  .alcanzo-5 .addendum {
    opacity: 1;
    transform: none;
  }

  /* ── La llave ── */
  /* En reposo abajo a la izquierda; viaja a la nota para sellarla y regresa. */
  .escena-llave {
    position: absolute;
    z-index: 3;
    left: 13cqi;
    top: 52cqi;
    height: 34cqi;
    transform-origin: 50% 92%;
    opacity: 0.95;
    transform: rotate(-24deg);
    transition:
      transform 1.1s var(--ease),
      opacity 0.6s var(--ease),
      filter 0.6s var(--ease);
    filter: drop-shadow(0 1.2em 1.6em rgb(0 0 0 / 0.6));
  }

  /* Baja sobre la nota y la sella (con un pequeño "golpe"). */
  .alcanzo-2 .escena-llave {
    transform: translate(27cqi, -29cqi) rotate(0deg) scale(0.78);
    animation: sellar 0.5s 0.75s var(--ease);
  }

  @keyframes sellar {
    40% {
      scale: 0.9;
    }
    100% {
      scale: 1;
    }
  }

  /* Ya sellada, se retira a la esquina: queda a la vista, en reposo. */
  .alcanzo-3 .escena-llave {
    transform: translate(-2cqi, 3cqi) rotate(-24deg) scale(0.82);
    opacity: 0.85;
    animation: none;
  }

  .escena[data-paso='4'] .escena-llave {
    filter: drop-shadow(0 0 1.4em rgb(255 107 107 / 0.55));
  }

  .onda {
    position: absolute;
    z-index: 2;
    left: 40cqi;
    top: 48cqi;
    width: 18cqi;
    aspect-ratio: 1;
    border: 2px solid var(--verde);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  .alcanzo-2:not(.alcanzo-3) .onda {
    animation: onda 1.1s 0.85s var(--ease);
  }

  @keyframes onda {
    from {
      opacity: 0.9;
      transform: scale(0.4);
    }
    to {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .escena * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
