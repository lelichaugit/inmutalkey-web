---
// La ilustración de la escena central (decorativa: el texto real de cada paso vive en Integridad.astro). Hilo visual
// del sitio: la MISMA llave del hero entra grande, gira en el candado y sella la nota.
//
// Rendimiento (docs/ANIMACIONES.md, "Destinos [data-p]"): el motor escribe --p SOLO en los elementos con `data-p`, y
// cada uno declara aquí sus tramos (--ig-*, registrados como <number>). Lo que no es destino corta la herencia de --p,
// así que en cada cuadro solo se recalculan ~25 elementos (antes, los ~260 de la maqueta). Los grupos (filas,
// requisitos, candado) tienen un solo destino y un envoltorio; sus tramos se heredan como números, que no cambian
// mientras el tramo está completo. Los cambios de estado (Sellada, Alterada, la lupa de la huella) van por pasos
// (data-paso / .alcanzo-N en la raíz) con una transición. Sin JS o con movimiento reducido, var(--p, 1) deja el estado
// final: nota sellada, encadenada y con su addendum.
//
// Guion (tramos de --p; las marcas 0.18 0.38 0.565 0.62 0.71 0.8 0.86 de Integridad.astro caen en los cortes):
//   1 Escribir    0.00–0.18  filas S/O/A/P una por una (clip-path + cursor); signos vitales
//   2 Semáforo    0.18–0.38  la hoja sube; 7 requisitos se encienden; rojo → ámbar → verde; la hoja baja
//   3 Firmar      0.38–0.62  acercamiento: la tarjeta se reduce y oscurece, el candado viene al centro y crece, la llave
//                            entra grande (de plano a sólida), gira, el anillo se cierra con un destello verde; vuelve a
//                            escala, la huella aparece (marca 0.565) y la nota se encadena con las anteriores
//   4 Detectar    0.62–0.80  un cursor entra desde fuera de la tarjeta y cambia el medicamento (0.63–0.71) y se va; en
//                            0.71 la lupa muestra la huella guardada ≠ la de hoy; todo vuelve en 0.79–0.82 (la original
//                            nunca cambió en la app)
//   5 Addendum    0.80–1.00  la nota original (intacta) sube y se agrega el addendum enlazado a su huella
// La huella que "se decodifica" (data-huella) la anima escenas.ts al llegar a su paso; el HTML ya trae la final.
//
// Geometría: una maqueta en em (28 × 24 en el visor ancho; 22.6 × 18.8 en el angosto, sin carril lateral ni notas
// anteriores, para que la letra base suba a ~14 px en celular). Su font-size sale del tamaño del visor (container
// queries), así que la escena se escala completa, como una ilustración vectorial.
import { requisitos, type DatosNota } from '../../lib/semaforo';
import Icono from '../Icono.astro';
import Isotipo3D from '../Isotipo3D.astro';

// Las etiquetas del semáforo salen de la misma lógica que la app (src/lib/semaforo.ts), en el build.
const NOTA_VACIA: DatosNota = {
  motivo: '',
  evolucion: '',
  taSistolica: '',
  taDiastolica: '',
  fc: '',
  fr: '',
  temperatura: '',
  peso: '',
  talla: '',
  omisionSignos: '',
  exploracion: '',
  diagnostico: '',
  cie10: '',
  pronostico: '',
  plan: '',
};
const REQUISITOS = requisitos(NOTA_VACIA).map((r) => r.etiqueta);

// Datos de ejemplo, los mismos en todo el sitio: María Fernanda López, Exp. EXP-2026-000128, nota n.º 12 de las 10:14.
// Huellas abreviadas como en la app; las notas 10 y 11 tienen las suyas (la 11 es la "Anterior" de la de hoy).
const HUELLA = {
  nota10: 'bd12c0e7…d679',
  anterior: '35d2e1a4…f0bd',
  actual: '9f2c41e8…b07a',
  alterada: '002f7968…21b3',
};

interface Fila {
  letra: string;
  etiqueta: string;
  valor?: string;
  signos?: readonly string[];
  alterado?: string;
}

const FILAS: readonly Fila[] = [
  { letra: 'S', etiqueta: 'Motivo', valor: 'Dolor de garganta y fiebre' },
  { letra: '', etiqueta: 'Evolución', valor: '2 días, sin mejoría' },
  { letra: 'O', etiqueta: 'Signos', signos: ['TA 120/80', 'FC 88', 'T 38.2 °C'] },
  { letra: '', etiqueta: 'Exploración', valor: 'Faringe hiperémica' },
  { letra: 'A', etiqueta: 'Diagnóstico', valor: 'J02.9 Faringitis aguda' },
  { letra: '', etiqueta: 'Pronóstico', valor: 'Favorable' },
  { letra: 'P', etiqueta: 'Plan', valor: 'Paracetamol 500 mg c/8 h', alterado: 'Ibuprofeno 400 mg c/8 h' },
];
---

<div class="maqueta" data-animar="escala">
  <div class="mq-mover" data-p>
    <div class="mover">
      {/* Notas anteriores del mismo paciente: la cadena (solo en el visor ancho; aparece por pasos) */}
      <div class="mq-mazo">
        <div class="tira tira-a">
          <span class="tira-nodo"></span>
          <span class="tira-titulo">Nota 10 · 12 sep</span>
          <span class="tira-huella"><Icono nombre="check" />{HUELLA.nota10}</span>
        </div>
        <div class="tira tira-b">
          <span class="tira-nodo"></span>
          <span class="tira-titulo">Nota 11 · 3 oct</span>
          <span class="tira-huella"><Icono nombre="check" />{HUELLA.anterior}</span>
        </div>
      </div>
      {/* Eslabones: nota 10 → 11 → la de hoy (huella anterior → huella actual). Por encima de la tarjeta. */}
      <span class="eslabones"></span>
      <span class="eslabon-roto"></span>

      <article class="mq-nota">
        <header class="nota-cabecera">
          <span class="nota-nodo"></span>
          <strong class="nota-titulo">Nota de evolución</strong>
          <span class="nota-paciente">María Fernanda López · n.º 12</span>
          <span class="nota-estado">
            <span class="estado-borrador"><i></i>Borrador</span>
            <span class="estado-sellada">Sellada 10:14</span>
            <span class="estado-alterada">Alterada</span>
          </span>
        </header>

        {/* Un solo destino para la escritura (--ig-escribe se hereda como número); .filas corta la herencia de --p */}
        <div class="nota-filas" data-p>
          <div class="filas">
            {
              FILAS.map((f, i) => (
                <div class:list={['fila', `fila-${i + 1}`, { 'fila-grupo': f.letra !== '', 'fila-plan': f.alterado }]}>
                  <span class="fila-letra">{f.letra}</span>
                  <span class="fila-etiqueta">{f.etiqueta}</span>
                  {f.signos ? (
                    <span class="fila-signos">
                      {f.signos.map((s) => (
                        <span class="chip">{s}</span>
                      ))}
                    </span>
                  ) : (
                    f.alterado ? (
                      <span class="fila-caja" data-p>
                        <span class="caja">
                          <span class="fila-valor">{f.valor}</span>
                          <span class="fila-seleccion" />
                          <span class="fila-alterado">{f.alterado}</span>
                          <span class="fila-cursor" />
                        </span>
                      </span>
                    ) : (
                      <span class="fila-caja">
                        <span class="fila-valor">{f.valor}</span>
                        <span class="fila-cursor" />
                      </span>
                    )
                  )}
                </div>
              ))
            }
          </div>
        </div>

        <footer class="nota-pie">
          <p class="pie-borrador"><i></i>Borrador guardado hace 2 s</p>
          <div class="pie-sello">
            <span class="pie-etiqueta">Anterior</span>
            <span class="pie-hash">{HUELLA.anterior}</span>
            <span class="pie-etiqueta">Huella</span>
            <span class="pie-hash pie-actual" data-huella={HUELLA.actual} data-huella-paso="3">{HUELLA.actual}</span>
            <span class="pie-firma"><Icono nombre="check" />Firmada<span class="pie-firma-tec"> · Ed25519</span></span>
          </div>
        </footer>

        <div class="nota-escaner"></div>
        <div class="nota-borde-rojo"></div>

        {/* Semáforo NOM-004: la hoja que sube sobre la nota antes de firmar */}
        <div class="semaforo" data-p>
          <div class="semaforo-in">
            <div class="semaforo-cabecera">
              <span class="luces">
                <i class="luz luz-roja"></i>
                <i class="luz luz-ambar"></i>
                <i class="luz luz-verde"></i>
              </span>
              <strong>Semáforo NOM-004</strong>
              <span class="semaforo-estado">
                <span class="se-rojo">Incompleta</span>
                <span class="se-ambar">Casi lista</span>
                <span class="se-verde">Lista para firmar</span>
              </span>
            </div>
            <ul class="requisitos">
              {
                REQUISITOS.map((r) => (
                  <li class="req">
                    <span class="req-marca">
                      <Icono nombre="check" />
                    </span>
                    {r}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </article>

      {/* El acercamiento del sellado oscurece la tarjeta */}
      <span class="nota-velo" data-p></span>

      {/* El candado de la nota: en el sellado viene al centro, grande, y la llave se apoya en él */}
      <div class="mq-sello" data-p>
        <div class="sello">
          <span class="sello-luz"></span>
          <svg class="sello-svg" viewBox="0 0 48 48">
            <circle class="s-base" cx="24" cy="24" r="21"></circle>
            <circle class="s-disco" cx="24" cy="24" r="17"></circle>
            <path class="s-cerradura" d="M24 14.5a4.2 4.2 0 0 1 2.3 7.7L27.6 31h-7.2l1.3-8.8a4.2 4.2 0 0 1 2.3-7.7z"></path>
            <path class="s-anillo" d="M24 3a21 21 0 1 1 0 42a21 21 0 1 1 0-42" pathLength="1"></path>
            <path class="s-anillo-rojo" d="M24 3a21 21 0 1 1 0 42a21 21 0 1 1 0-42" pathLength="1"></path>
            <path class="s-palomita" d="M15.5 24.5l6 6L33 18.5" pathLength="1"></path>
            <path class="s-cruz" d="M18 18l12 12M30 18L18 30"></path>
          </svg>
          <span class="sello-onda"></span>
        </div>
      </div>

      {/* Paso 4: alguien edita el archivo por fuera de InmutalKey */}
      <div class="mq-cursor" data-p>
        <div class="cursor">
          <svg viewBox="0 0 24 24"><path d="M5 2.5v17.2l4.6-4.4 3 6.6 3-1.4-3-6.4h6.3z"></path></svg>
          <span class="cursor-etiqueta"><b>fuera de la app</b></span>
        </div>
      </div>
    </div>
  </div>

  {/* …y la revisión de integridad lo marca: la fila de la huella, de cerca (cambia por paso: sin --p) */}
  <div class="mq-lupa">
    <p class="lupa-titulo">
      <Icono nombre="alerta" />Alteración detectada<span class="lupa-sub"> · revisión de integridad</span>
    </p>
    <p class="lupa-huellas">
      <span class="lupa-bien">{HUELLA.actual}</span>
      <b>≠</b>
      <span class="lupa-mal" data-huella={HUELLA.alterada} data-huella-paso="5">{HUELLA.alterada}</span>
    </p>
  </div>

  {/* La llave: entra desde arriba del visor y su punta se pierde en el candado (la zona recorta en el centro). */}
  <div class="mq-llave-zona">
    <div class="mq-llave" data-p>
      <Isotipo3D sizes="(min-width: 960px) 240px, 160px" plano brillo />
    </div>
  </div>

  {/* Paso 5: el addendum, enlazado a la huella de la nota (aparece por paso, cuando la nota ya subió) */}
  <span class="mq-enlace"></span>
  <article class="mq-addendum">
    <header>
      <strong>Addendum<span class="addendum-num"> 1</span> · Corrección de captura</strong>
      <span class="addendum-sello"><Icono nombre="check" /><span class="addendum-sello-texto">Sellado</span></span>
    </header>
    <p>
      <span>Temperatura: 38.4 °C</span>
      <span class="addendum-enlace">↳ {HUELLA.actual}</span>
    </p>
  </article>
</div>

<style>
  /* ───────── Tramos ─────────
     Avance local (0 → 1) de cada tramo de --p, registrado como <number>: completo (0 o 1), da el mismo número cuadro
     tras cuadro y el navegador no baja a los hijos. `inherits: false` = solo lo usa quien lo declara. */
  @property --ig-baja { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --ig-rojo { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --ig-sube { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --ig-zoom { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --ig-llave { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --ig-giro { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --ig-retiro { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --ig-hoja { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --ig-cursor { syntax: '<number>'; inherits: false; initial-value: 0; }
  /* Heredados: un destino por grupo; cada nivel que ya no los necesita los corta (ver "Cortes"). */
  @property --ig-escribe { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --ig-fila { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --ig-revisa { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --ig-luz3 { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --ig-luz7 { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --ig-req { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --ig-anillo { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --ig-palomita { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --ig-destello { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --ig-seleccion { syntax: '<number>'; inherits: true; initial-value: 0; }
  @property --ig-cambio { syntax: '<number>'; inherits: true; initial-value: 0; }
  /* Geometría ya calculada (px) en la maqueta: un solo valor que sustituir, no una cadena de calc() en cada cuadro. */
  @property --ig-nota-h { syntax: '<length>'; inherits: true; initial-value: 0px; }
  @property --ig-foco-y { syntax: '<length>'; inherits: true; initial-value: 0px; }
  @property --ig-llave-h { syntax: '<length>'; inherits: true; initial-value: 0px; }
  @property --ig-sello-dx { syntax: '<length>'; inherits: true; initial-value: 0px; }
  @property --ig-sello-dy { syntax: '<length>'; inherits: true; initial-value: 0px; }

  /* Cada tramo, en el destino que lo usa. */
  .mq-mover {
    --ig-baja: clamp(0, (var(--p, 1) - 0.37) / 0.04, 1);
    --ig-rojo: min(clamp(0, (var(--p, 1) - 0.71) / 0.03, 1), 1 - clamp(0, (var(--p, 1) - 0.79) / 0.03, 1));
  }

  .mq-mover {
    --ig-sube: clamp(0, (var(--p, 1) - 0.8) / 0.05, 1);
  }

  /* Acercamiento del sellado: entra en 0.41–0.45 y sale en 0.525–0.565 (antes de que aparezcan "Sellada" y la huella). */
  .mq-mover,
  .nota-velo,
  .mq-sello {
    --ig-zoom: min(clamp(0, (var(--p, 1) - 0.41) / 0.04, 1), 1 - clamp(0, (var(--p, 1) - 0.525) / 0.04, 1));
  }

  .mq-llave {
    --ig-llave: clamp(0, (var(--p, 1) - 0.41) / 0.05, 1);
    --ig-giro: clamp(0, (var(--p, 1) - 0.46) / 0.03, 1);
    --ig-retiro: clamp(0, (var(--p, 1) - 0.505) / 0.04, 1);
  }

  .mq-sello {
    --ig-anillo: clamp(0, (var(--p, 1) - 0.475) / 0.03, 1);
    --ig-destello: clamp(0, (var(--p, 1) - 0.495) / 0.05, 1);
    --ig-palomita: clamp(0, (var(--p, 1) - 0.515) / 0.025, 1);
  }

  .semaforo {
    --ig-hoja: min(clamp(0, (var(--p, 1) - 0.18) / 0.035, 1), 1 - clamp(0, (var(--p, 1) - 0.355) / 0.035, 1));
    /* 0.222–0.342: requisitos uno por uno y las luces (rojo → ámbar en 0.262, → verde en 0.33). */
    --ig-revisa: clamp(0, (var(--p, 1) - 0.222) / 0.12, 1);
  }

  .nota-filas {
    /* 0.012–0.162: las 7 filas, una cada 0.021. */
    --ig-escribe: clamp(0, (var(--p, 1) - 0.012) / 0.15, 1);
  }

  /* El cursor entra en 0.63–0.67 y se va en 0.715–0.74: la lupa y el texto alterado quedan a la vista. */
  .mq-cursor {
    --ig-cursor: min(clamp(0, (var(--p, 1) - 0.63) / 0.04, 1), 1 - clamp(0, (var(--p, 1) - 0.715) / 0.025, 1));
  }

  /* La caja del plan (fila P): selección 0.67–0.71 y el cambio de medicamento 0.69–0.71 (vuelve en 0.79–0.82). */
  .fila-plan .fila-caja {
    --ig-seleccion: min(clamp(0, (var(--p, 1) - 0.67) / 0.02, 1), 1 - clamp(0, (var(--p, 1) - 0.71) / 0.015, 1));
    --ig-cambio: min(clamp(0, (var(--p, 1) - 0.69) / 0.02, 1), 1 - clamp(0, (var(--p, 1) - 0.79) / 0.03, 1));
  }

  /* ── Cortes de herencia ──
     Lo que no es destino no recibe --p/--e/--s de su padre: cuando el motor escribe --p en un destino, solo se
     recalculan él y sus hijos directos (que quedan iguales y no siguen bajando). Todo lo que usa --p lleva data-p. */
  .maqueta :global(:not([data-p])) {
    --p: initial;
    --e: initial;
    --s: initial;
  }

  /* Igual con los tramos de grupo: el nivel que deriva el suyo deja de pasar el del grupo. */
  .fila > *,
  .semaforo-cabecera > *,
  .req > * {
    --ig-escribe: initial;
    --ig-revisa: initial;
  }

  /* ───────── La maqueta ───────── */
  .maqueta {
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --verde: #08755a; /* esmeralda oscurecido: ≥ 4.5:1 sobre el papel */
    --verde-vivo: var(--esmeralda-vivo);
    --rojo: var(--error-claro);
    --rojo-vivo: var(--error);
    --papel: #f8fafc;
    --papel-tinta: #0f172a;
    --papel-tenue: #5b6b80;
    --papel-linea: #e2e8f0;
    --etiqueta: max(0.8em, 11px);

    /* Geometría (em de la maqueta). Solo la usan elementos con el font-size de la maqueta. */
    --mq-w: 28em;
    --mq-h: 24em;
    --mv-x: 1em;
    --mv-top: 5.6em;
    --cab-h: 2.9em;
    --filas-pad: 0.45em;
    --fila-h: 1.5em;
    --filas-fin: 0em;
    --pie-h: 2.9em;
    --sello: 3.4em;
    --sello-r: 0.85em;
    --sello-t: -0.3em;
    /* Escala propia del candado en el acercamiento (el mover lo reduce a 0.9: queda ×2.4). */
    --sello-zoom: 2.67;
    --dy-baja: 2em;
    --dy-rojo: 2.3em;
    --dy-sube: 4.6em;
    --hueco: 0.8em;

    --ig-nota-h: calc(var(--cab-h) + var(--filas-pad) + 7 * var(--fila-h) + var(--filas-fin) + var(--pie-h));
    /* Centro de la nota en el sellado (el mover ya bajó): ahí se encuentran el candado y la llave. */
    --ig-foco-y: calc(var(--mv-top) + var(--ig-nota-h) / 2);
    /* Del rincón al foco: el candado viaja al centro de la nota. */
    --ig-sello-dx: calc(var(--mv-x) + var(--sello-r) + var(--sello) / 2 - var(--mq-w) / 2);
    --ig-sello-dy: calc(var(--ig-nota-h) / 2 - var(--sello-t) - var(--sello) / 2);
    /* La llave mide ~45 % del alto del visor, sin que su cabeza suba más allá del borde superior del área. */
    --ig-llave-h: min(45cqh, calc(((100cqh - var(--mq-h)) / 2 + var(--ig-foco-y)) / 0.83));

    position: relative;
    width: var(--mq-w);
    height: var(--mq-h);
    /* Respaldo para navegadores sin container queries; el resto toma el tamaño del visor. */
    font-size: 12px;
    font-size: min(100cqw / 28.6, 100cqh / 24.4, 19px);
    line-height: 1.35;
    color: var(--papel-tinta);
  }

  /* ── El mover: la nota y lo que se mueve con ella ──
     Pasos 1–2 más arriba (visor ancho); en el 3 baja para dejar sitio a las notas anteriores y se reduce durante el
     acercamiento; en el 4 sube para la lupa y en el 5 para el addendum. */
  .mq-mover {
    position: absolute;
    left: var(--mv-x);
    right: var(--mv-x);
    top: var(--mv-top);
    height: var(--ig-nota-h);
    transform: translate3d(
        0,
        calc((var(--ig-baja) - 1) * var(--dy-baja) - var(--ig-sube) * var(--dy-sube) - var(--ig-rojo) * var(--dy-rojo)),
        0
      )
      scale(calc(1 - var(--ig-zoom) * 0.1));
  }

  .mover {
    position: absolute;
    inset: 0;
  }

  .mq-nota {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    overflow: clip;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 1em;
    background: var(--papel);
    box-shadow:
      0 0 0 1px rgb(13 27 53 / 0.06),
      0 2.4em 4em -1.6em rgb(0 0 0 / 0.85),
      0 0 5em -1em rgb(46 159 224 / 0.25);
  }

  .nota-velo {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: 1em;
    background: #050a14;
    opacity: calc(var(--ig-zoom) * 0.62);
    pointer-events: none;
  }

  .nota-cabecera {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: center;
    column-gap: 0.6em;
    height: var(--cab-h);
    padding: 0 calc(var(--sello) + var(--sello-r) + 0.4em) 0 2.4em;
    border-bottom: 1px solid var(--papel-linea);
  }

  .nota-nodo,
  .tira-nodo {
    position: absolute;
    width: 0.56em;
    height: 0.56em;
    border: 1.5px solid var(--verde);
    border-radius: 50%;
    background: var(--papel);
  }

  .nota-nodo {
    left: 1.22em;
    top: 0.63em;
    border-color: #94a3b8;
  }

  .nota-titulo {
    font-family: var(--fuente-titulo);
    font-size: 1.08em;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .nota-paciente {
    grid-column: 1 / -1;
    color: var(--papel-tenue);
    font-size: var(--etiqueta);
    white-space: nowrap;
  }

  .nota-estado {
    display: grid;
    grid-row: 1;
    grid-column: 2;
    justify-items: end;
    font-size: var(--etiqueta);
    font-weight: 600;
  }

  .nota-estado > span {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }

  .estado-borrador {
    color: var(--azul);
  }

  .estado-borrador i,
  .pie-borrador i {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: currentColor;
  }

  .estado-sellada {
    color: var(--verde);
  }

  .estado-alterada {
    color: var(--rojo);
  }

  /* Estados de la nota: cambian por pasos (data-paso / .alcanzo-N en la raíz), con transición. Sin escena: sellada. */
  .nota-estado > .estado-sellada,
  :global(.movimiento .historia:not(.alcanzo-3)) .estado-borrador,
  :global(.historia[data-paso='5']) .estado-alterada {
    opacity: 1;
  }

  :global(.movimiento .historia:not(.alcanzo-3)) .estado-sellada,
  :global(.historia[data-paso='5']) .nota-estado > .estado-sellada {
    opacity: 0;
  }

  /* ── Filas S/O/A/P: se escriben una por una ── */
  .filas {
    display: grid;
    grid-auto-rows: var(--fila-h);
    padding: var(--filas-pad) 1.2em 0;
  }

  .fila {
    /* Avance de la fila (0 → 1 en 0.02 de --p), derivado del número heredado --ig-escribe. */
    --ig-fila: clamp(0, (var(--ig-escribe) * 0.15 + 0.012 - var(--a)) / 0.02, 1);
    display: grid;
    grid-template-columns: 1.3em 5.9em minmax(0, 1fr);
    align-items: center;
    min-width: 0;
  }

  .fila-1 { --a: 0.012; }
  .fila-2 { --a: 0.033; }
  .fila-3 { --a: 0.054; }
  .fila-4 { --a: 0.078; }
  .fila-5 { --a: 0.099; }
  .fila-6 { --a: 0.12; }
  .fila-7 { --a: 0.141; }

  .fila-grupo:not(:first-child) {
    border-top: 1px dashed var(--papel-linea);
  }

  .fila-letra {
    font-family: var(--fuente-titulo);
    font-weight: 700;
    color: var(--azul);
    opacity: var(--ig-fila);
  }

  .fila-etiqueta {
    color: var(--papel-tenue);
    font-size: var(--etiqueta);
    font-weight: 600;
    opacity: calc(0.45 + var(--ig-fila) * 0.55);
  }

  .fila-caja,
  .caja {
    position: relative;
    justify-self: start;
    max-width: 100%;
    white-space: nowrap;
  }

  .caja {
    display: block;
  }

  .fila-valor {
    display: block;
    line-height: 1.5;
    clip-path: inset(0 calc((1 - var(--ig-fila)) * 100%) 0 0);
  }

  .fila-plan .fila-valor {
    opacity: calc(1 - var(--ig-cambio));
  }

  /* Cursor de escritura: recorre el ancho del texto (transform, no `left`) y solo se ve a medio escribir. */
  .fila-cursor {
    position: absolute;
    inset: 0;
    transform: translate3d(calc(var(--ig-fila) * 100%), 0, 0);
    opacity: calc(min(var(--ig-fila), 1 - var(--ig-fila)) * 30);
    pointer-events: none;
  }

  :global(html:not(.movimiento)) .fila-cursor {
    display: none;
  }

  .fila-cursor::before {
    content: '';
    position: absolute;
    left: 0.06em;
    top: 12%;
    bottom: 12%;
    width: 0.11em;
    border-radius: 1px;
    background: var(--azul);
  }

  .fila-signos {
    display: flex;
    gap: 0.35em;
    min-width: 0;
  }

  .chip {
    --tc: clamp(0, (var(--ig-fila) - var(--j, 0) * 0.3) / 0.4, 1);
    padding: 0.06em 0.5em;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: var(--etiqueta);
    font-weight: 600;
    white-space: nowrap;
    transform: scale(calc(0.7 + var(--tc) * 0.3));
    opacity: var(--tc);
  }

  .chip:nth-child(2) { --j: 1; }
  .chip:nth-child(3) { --j: 2; }

  /* Paso 4: el medicamento cambia por fuera de la app. */
  .fila-seleccion {
    position: absolute;
    inset: 0.05em -0.15em;
    border-radius: 0.2em;
    background: rgb(1 120 176 / 0.22);
    transform-origin: 0 50%;
    transform: scaleX(var(--ig-seleccion));
    opacity: var(--ig-seleccion);
  }

  .fila-alterado {
    position: absolute;
    left: 0;
    top: 0;
    line-height: 1.5;
    color: var(--rojo);
    font-weight: 600;
    clip-path: inset(0 calc((1 - var(--ig-cambio)) * 100%) 0 0);
  }

  /* ── Pie: borrador → huella encadenada y firma ── */
  .nota-pie {
    position: absolute;
    inset: auto 0 0;
    height: var(--pie-h);
    border-top: 1px solid var(--papel-linea);
    background: #f1f5f9;
  }

  .pie-borrador,
  .pie-sello {
    position: absolute;
    inset: 0;
    padding-inline: 1.2em;
    transition: opacity 0.4s var(--ease);
  }

  .pie-borrador {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    color: var(--azul);
    font-size: var(--etiqueta);
    font-weight: 600;
    opacity: 0;
  }

  .pie-sello {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: 1fr 1fr;
    align-items: center;
    column-gap: 0.7em;
    padding-block: 0.15em;
  }

  /* La huella aparece al sellar (paso 3, mientras escenas.ts la "decodifica"). Sin escena: sellada. */
  :global(.movimiento .historia:not(.alcanzo-3)) .pie-borrador {
    opacity: 1;
  }

  :global(.movimiento .historia:not(.alcanzo-3)) .pie-sello {
    opacity: 0;
  }

  .pie-etiqueta {
    color: var(--papel-tenue);
    font-size: var(--etiqueta);
    font-weight: 600;
  }

  .pie-hash {
    overflow: hidden;
    font-family: var(--mono);
    font-size: var(--etiqueta);
    color: #475569;
    white-space: nowrap;
  }

  .pie-actual {
    color: var(--verde);
    font-weight: 700;
  }

  .pie-firma {
    grid-row: 1 / -1;
    grid-column: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.2em 0.6em;
    border: 1px solid rgb(8 117 90 / 0.35);
    border-radius: 999px;
    background: rgb(8 117 90 / 0.08);
    color: var(--verde);
    font-size: var(--etiqueta);
    font-weight: 700;
    white-space: nowrap;
  }

  .pie-firma :global(.icono),
  .tira-huella :global(.icono),
  .addendum-sello :global(.icono) {
    width: 1.1em;
    height: 1.1em;
    stroke-width: 2.5;
  }

  /* Escáner: la huella se calcula sobre TODO lo escrito. Una pasada al quedar sellada (paso 3). */
  .nota-escaner {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--azul-vivo) 20%, #dff2ff 50%, var(--azul-vivo) 80%, transparent);
    box-shadow: 0 0 1em 0.2em rgb(46 159 224 / 0.45);
    opacity: 0;
    pointer-events: none;
  }

  :global(.movimiento .historia.alcanzo-3:not(.alcanzo-4)) .nota-escaner {
    animation: escaner 0.9s var(--ease) 0.15s both;
  }

  @keyframes escaner {
    from {
      transform: translate3d(0, 0, 0);
      opacity: 1;
    }

    85% {
      opacity: 1;
    }

    to {
      transform: translate3d(0, var(--ig-nota-h), 0);
      opacity: 0;
    }
  }

  .nota-borde-rojo {
    position: absolute;
    inset: 0;
    z-index: 4;
    border: 2px solid var(--rojo-vivo);
    border-radius: inherit;
    box-shadow: inset 0 0 2.4em rgb(255 107 107 / 0.18);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
    pointer-events: none;
  }

  /* ── Semáforo ── */
  .semaforo {
    position: absolute;
    inset: var(--cab-h) 0 0;
    z-index: 5;
    padding: 0.55em 1.2em 0.7em;
    border-top: 1px solid rgb(46 159 224 / 0.45);
    border-radius: 0.9em 0.9em 0 0;
    background:
      linear-gradient(rgb(46 159 224 / 0.08), transparent 40%),
      #0b1830;
    color: var(--texto);
    box-shadow: 0 -1.2em 2.4em -1em rgb(0 0 0 / 0.5);
    transform: translate3d(0, calc((1 - var(--ig-hoja)) * 104%), 0);
  }

  .semaforo-cabecera {
    /* Luces: rojo → ámbar en 0.262 y → verde en 0.33 (derivado de --ig-revisa, 0.222–0.342). */
    --ig-luz3: clamp(0, var(--ig-revisa) * 15 - 5, 1);
    --ig-luz7: clamp(0, var(--ig-revisa) * 15 - 13.5, 1);
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding-bottom: 0.5em;
    margin-bottom: 0.3em;
    border-bottom: 1px solid var(--linea-oscura);
    font-size: 0.92em;
    white-space: nowrap;
  }

  .luces {
    display: inline-flex;
    gap: 0.3em;
    padding: 0.25em 0.4em;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.35);
  }

  .luz {
    position: relative;
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
  }

  .luz::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0.6em var(--c);
    opacity: var(--o);
  }

  .luz-roja { --c: var(--rojo-vivo); --o: calc(1 - var(--ig-luz3)); }
  .luz-ambar { --c: #f3c969; --o: min(var(--ig-luz3), 1 - var(--ig-luz7)); }
  .luz-verde { --c: var(--verde-vivo); --o: var(--ig-luz7); }

  .semaforo-estado {
    display: grid;
    margin-left: auto;
    font-size: max(0.88em, 11px);
    font-weight: 600;
  }

  .semaforo-estado > span {
    grid-area: 1 / 1;
    justify-self: end;
  }

  .se-rojo { color: var(--rojo-vivo); opacity: calc(1 - var(--ig-luz3)); }
  .se-ambar { color: #f3c969; opacity: min(var(--ig-luz3), 1 - var(--ig-luz7)); }
  .se-verde { color: var(--verde-vivo); opacity: var(--ig-luz7); }

  .requisitos {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .req {
    --ig-req: clamp(0, (var(--ig-revisa) * 0.12 + 0.222 - var(--a)) / 0.012, 1);
    display: flex;
    align-items: center;
    gap: 0.6em;
    min-height: 1.5em;
    font-size: 0.9em;
    line-height: 1.25;
    color: rgb(238 243 249 / calc(0.5 + var(--ig-req) * 0.5));
  }

  .req:nth-child(1) { --a: 0.222; }
  .req:nth-child(2) { --a: 0.239; }
  .req:nth-child(3) { --a: 0.256; }
  .req:nth-child(4) { --a: 0.273; }
  .req:nth-child(5) { --a: 0.29; }
  .req:nth-child(6) { --a: 0.307; }
  .req:nth-child(7) { --a: 0.324; }

  .req-marca {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 1.15em;
    height: 1.15em;
    border: 1px solid var(--linea-oscura-fuerte);
    border-radius: 50%;
  }

  .req-marca::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    background: var(--verde-vivo);
    transform: scale(calc(0.4 + var(--ig-req) * 0.6));
    opacity: var(--ig-req);
  }

  .req-marca :global(.icono) {
    position: relative;
    width: 0.8em;
    height: 0.8em;
    color: var(--medianoche);
    stroke-width: 3;
    opacity: var(--ig-req);
  }

  /* ── El candado (sello) ──
     En reposo, en la esquina de la nota. En el sellado viaja al centro de la nota y crece (--ig-zoom); la llave se
     apoya en él, el anillo se cierra y un destello verde lo confirma. */
  .mq-sello {
    position: absolute;
    z-index: 3;
    right: var(--sello-r);
    top: var(--sello-t);
    width: var(--sello);
    height: var(--sello);
    transform: translate3d(calc(var(--ig-zoom) * var(--ig-sello-dx)), calc(var(--ig-zoom) * var(--ig-sello-dy)), 0)
      scale(calc(1 + var(--ig-zoom) * (var(--sello-zoom) - 1)));
  }

  .sello {
    position: absolute;
    inset: 0;
  }

  .sello-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .s-base {
    fill: var(--papel);
    stroke: #94a3b8;
    stroke-width: 1.2;
    stroke-dasharray: 2.2 2.6;
  }

  .s-disco {
    fill: rgb(8 117 90 / 0.12);
    opacity: var(--ig-anillo);
  }

  .s-cerradura {
    fill: #64748b;
    opacity: calc(1 - var(--ig-palomita));
  }

  /* Trazos que se dibujan: con pathLength="1", 1px = el trazo completo (en px y no sin unidad, que no todos los
     navegadores aceptan dentro de calc()). */
  .s-anillo,
  .s-anillo-rojo {
    fill: none;
    stroke-width: 2.6;
    stroke-linecap: round;
  }

  .s-anillo {
    stroke: var(--verde);
    stroke-dasharray: 1px;
    stroke-dashoffset: calc((1 - var(--ig-anillo)) * 1px);
    /* Sin esto, el trazo vacío con remate redondo deja un punto. */
    opacity: min(var(--ig-anillo) * 20, 1);
  }

  .s-anillo-rojo {
    stroke: var(--rojo);
    stroke-dasharray: 0.05px 0.035px;
  }

  .s-palomita {
    fill: none;
    stroke: var(--verde);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1px;
    stroke-dashoffset: calc((1 - var(--ig-palomita)) * 1px);
    opacity: min(var(--ig-palomita) * 20, 1);
    /* La alteración la apaga por paso (stroke-opacity, para no pisar la opacidad ligada al scroll). */
    transition: stroke-opacity 0.35s var(--ease);
  }

  .s-cruz {
    fill: none;
    stroke: var(--rojo);
    stroke-width: 3.2;
    stroke-linecap: round;
  }

  .s-anillo-rojo,
  .s-cruz {
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }

  /* Destello verde al cerrarse el anillo: luz difusa (gradiente, sin filtros) y una onda. */
  .sello-luz {
    position: absolute;
    inset: -70%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(47 209 154 / 0.55), rgb(47 209 154 / 0.14) 55%, transparent 75%);
    transform: scale(calc(0.6 + var(--ig-destello) * 0.6));
    opacity: calc(min(var(--ig-destello) * 6, 1) * (1 - var(--ig-destello)));
    pointer-events: none;
  }

  .sello-onda {
    position: absolute;
    inset: 0;
    border: 2px solid var(--verde-vivo);
    border-radius: 50%;
    transform: scale(calc(1 + var(--ig-destello) * 1.5));
    opacity: calc(min(var(--ig-destello) * 8, 1) * (1 - var(--ig-destello)));
    pointer-events: none;
  }

  /* ── La llave ──
     Zona que termina en el centro del candado (foco): la punta que entra en la cerradura se recorta ahí. La llave baja
     desde fuera del visor como plano técnico y se vuelve sólida (--materia), gira como en una cerradura y, sellada la
     nota, se retira hacia arriba. Un solo transform (traslado + giro). */
  .mq-llave-zona {
    /* Del borde superior del área del visor (debajo de la barra de estado) al foco. */
    --zona-top: calc((var(--mq-h) - 100cqh) / 2);
    position: absolute;
    z-index: 4;
    left: 0;
    right: 0;
    top: var(--zona-top);
    height: calc(var(--ig-foco-y) - var(--zona-top));
    overflow: hidden;
    overflow: clip;
    pointer-events: none;
  }

  :global(html:not(.movimiento)) .mq-llave-zona {
    display: none;
  }

  .mq-llave {
    --materia: clamp(0, (var(--ig-llave) - 0.1) / 0.8, 1);
    --brillo: var(--ig-giro);
    position: absolute;
    left: 50%;
    bottom: 0;
    width: calc(var(--ig-llave-h) * 0.42);
    height: var(--ig-llave-h);
    margin-left: calc(var(--ig-llave-h) * -0.21);
    transform: translate3d(
        0,
        calc((1 - var(--ig-llave)) * -100cqh + var(--ig-llave) * 0.17 * var(--ig-llave-h) - var(--ig-retiro) * 100cqh),
        0
      )
      perspective(calc(var(--ig-llave-h) * 3)) rotateY(calc((var(--ig-giro) - var(--ig-retiro)) * 45deg));
    opacity: calc(min(var(--ig-llave) * 4, 1) * (1 - var(--ig-retiro)));
  }

  /* Regla 12 (docs/ANIMACIONES.md): nada de filter en algo que cambia cada cuadro. */
  .mq-llave :global(.llave-plano) {
    filter: none;
  }

  /* ── La cadena: notas anteriores detrás de la de hoy (visor ancho) ── */
  /* Aparece al quedar sellada (paso 3) y se retira con la corrección (paso 6). Sin escena: visible. */
  .mq-mazo {
    position: absolute;
    inset: 0;
    z-index: 1;
    transition:
      opacity 0.45s var(--ease) 0.25s,
      transform 0.6s var(--ease) 0.25s;
  }

  :global(.movimiento .historia:not(.alcanzo-3)) .mq-mazo {
    opacity: 0;
    transform: translate3d(0, 1.8em, 0);
  }

  :global(.historia.alcanzo-6) .mq-mazo,
  :global(.historia.alcanzo-6) .eslabones {
    opacity: 0;
    transition-delay: 0s;
  }

  .tira {
    position: absolute;
    display: flex;
    align-items: flex-start;
    gap: 0.6em;
    height: 4.2em;
    padding: 0.55em 1em 0;
    border: 1px solid rgb(47 209 154 / 0.3);
    border-radius: 0.9em;
    background: #e9eef5;
    color: #334155;
  }

  .tira-a {
    left: 0.9em;
    right: 0.9em;
    top: -4.2em;
    background: #dde5ef;
  }

  .tira-b {
    left: 0.45em;
    right: 0.45em;
    top: -2.2em;
  }

  /* Los nodos de las tres notas quedan alineados en x = 1.5em para que los eslabones sean rectos. */
  .tira-nodo {
    position: relative;
    flex: none;
    margin-top: 0.3em;
  }

  .tira-a .tira-nodo {
    margin-left: -0.68em;
  }

  .tira-b .tira-nodo {
    margin-left: -0.23em;
  }

  .tira-titulo {
    font-size: var(--etiqueta);
    font-weight: 600;
  }

  .tira-huella {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    margin-left: auto;
    color: var(--verde);
    font-family: var(--mono);
    font-size: var(--etiqueta);
    font-weight: 700;
  }

  /* Eslabones (uno solo, con un hueco en el nodo de la nota 11): de la 10 a la 11 y de la 11 a la de hoy. Se dibujan
     de arriba hacia abajo; en el paso 5 se desvanecen con el mazo. */
  .eslabones,
  .eslabon-roto {
    position: absolute;
    z-index: 4;
  }

  .eslabones {
    left: calc(1.5em - 0.75px);
    top: -2.82em;
    width: 1.5px;
    height: 3.45em;
    background: linear-gradient(var(--verde) 1.44em, transparent 1.44em 2em, var(--verde) 2em);
    transform-origin: 50% 0;
    transition:
      transform 0.6s var(--ease),
      opacity 0.35s var(--ease);
  }

