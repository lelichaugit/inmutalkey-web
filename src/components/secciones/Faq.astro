---
// Preguntas frecuentes (IDENTIDAD_MARCA §9.8). <details> nativo: funciona sin JS, con teclado y con lectores de
// pantalla. Respuestas en src/data/faq.ts (verificadas contra la app v0.4.0).
import { PREGUNTAS } from '../../data/faq';
import Icono from '../Icono.astro';
---

<section class="seccion faq" id="preguntas" aria-labelledby="faq-titulo">
  <div class="contenedor faq-rejilla">
    <div class="seccion-cabecera faq-cabecera">
      <p class="antetitulo">Preguntas frecuentes</p>
      <h2 id="faq-titulo">Lo que los médicos nos preguntan.</h2>
      <p>¿No encuentra su duda? <a href="#contacto">Escríbanos</a>: le responde una persona del equipo.</p>
    </div>
    <div class="faq-lista">
      {
        PREGUNTAS.map((p) => (
          <details class="faq-item" id={`faq-${p.id}`}>
            <summary>
              <span>{p.pregunta}</span>
              <Icono nombre="mas" class="faq-signo" />
            </summary>
            <div class="faq-respuesta">
              {p.respuesta.map((parrafo) => <p>{parrafo}</p>)}
              {p.enlace && (
                <p>
                  <a href={p.enlace.href}>{p.enlace.texto}</a>
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-rejilla {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .faq-cabecera {
    position: sticky;
    top: calc(var(--altura-nav) + 2.5rem);
  }

  .faq-lista {
    border-top: 1px solid var(--linea);
  }

  .faq-item {
    border-bottom: 1px solid var(--linea);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 1rem 0.5rem;
    color: var(--texto);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radio-sm);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover {
    color: var(--primario);
  }

  .faq-item :global(.faq-signo) {
    color: var(--primario);
    transition: transform 260ms var(--curva-cristal);
  }

  .faq-item[open] :global(.faq-signo) {
    transform: rotate(45deg);
  }

  .faq-respuesta {
    display: grid;
    gap: 0.75rem;
    padding: 0 0.5rem 1.5rem;
    color: var(--texto-2);
  }

  .faq-item[open] .faq-respuesta {
    animation: faq-entrada 300ms var(--curva-cristal);
  }

  @keyframes faq-entrada {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (max-width: 60rem) {
    .faq-rejilla {
      grid-template-columns: minmax(0, 1fr);
    }

    .faq-cabecera {
      position: static;
    }
  }
</style>
