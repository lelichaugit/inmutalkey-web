---
// Reseñas. Producción: solo verificadas (en build) — la Fase C añade las aprobadas en D1 desde /api/resenas.
// Desarrollo y preview con SHOW_EXAMPLE_REVIEWS=true: las 10 de ejemplo, con la cinta "Ejemplo ilustrativo"
// y `data-resena-ejemplo` (el guardian detiene un build de producción que las contenga).
//
// Movimiento: dos filas que corren en sentidos opuestos ligadas al scroll (data-progreso-scroll → --p): cada fila
// recorre de un extremo al otro mientras la sección cruza la ventana, así todas las tarjetas pasan por la vista.
// Sin JS o con movimiento reducido: filas quietas que se deslizan con el dedo o el trackpad (scroll propio, con
// imán). Lenis nunca está activo en ese caso (solo se carga con movimiento), por eso no hace falta data-lenis-prevent.
import ejemplos from '../../data/resenas.json';
import { detectarEntorno, quiereEjemplos } from '../../lib/entorno';
import { resenasPublicables, type Resena } from '../../lib/resenas';
import Icono from '../Icono.astro';

const entorno = detectarEntorno(process.env, { servidorDev: import.meta.env.DEV });
const resenas = resenasPublicables(ejemplos, { incluirEjemplos: quiereEjemplos(entorno, process.env) });
const mitad = Math.ceil(resenas.length / 2);
const filas: Resena[][] = resenas.length > 4 ? [resenas.slice(0, mitad), resenas.slice(mitad)] : [resenas];
const ejemplo = resenas.some((r) => r.esEjemplo);
---

{
  resenas.length > 0 && (
    <section class="seccion fondo-oscuro resenas" aria-labelledby="resenas-titulo" data-progreso-scroll>
      <div class="contenedor">
        <div class="entrada resenas-cabecera">
          <p class="resenas-mono" data-animar="subir" aria-hidden="true">
            {ejemplo ? 'Maqueta · reseñas de ejemplo' : 'Reseñas revisadas una por una'}
          </p>
          <h2 id="resenas-titulo" data-animar="titulo">
            Lo que dicen los médicos fundadores
          </h2>
        </div>
      </div>
      <div class="resenas-filas">
        {filas.map((fila, f) => (
          <div class:list={['resenas-fila', { 'es-inversa': f === 1 }]} data-animar="aparecer" data-retraso={f === 1 ? '2' : '1'}>
            <ul class="resenas-pista">
              {fila.map((r) => (
                <li class="resena" data-resena-ejemplo={r.esEjemplo ? '' : undefined}>
                  <div class="resena-cabeza">
                    {r.esEjemplo ? (
                      <span class="pildora pildora-ejemplo">Ejemplo ilustrativo</span>
                    ) : (
                      <span class="pildora pildora-verificado">
                        <Icono nombre="check" /> Reseña verificada
                      </span>
                    )}
                    <span class="estrellas" role="img" aria-label={`${r.estrellas} de 5 estrellas`}>
                      {'★'.repeat(r.estrellas)}
                      <span class="estrellas-vacias">{'★'.repeat(5 - r.estrellas)}</span>
                    </span>
                  </div>
                  <blockquote>{r.texto}</blockquote>
                  <p class="resena-autor">
                    <strong>{r.nombre}</strong>
                    <span>{r.especialidad}</span>
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .resenas {
    padding-block: clamp(72px, 8vw, 120px);
    overflow-x: clip;
  }

  .resenas-mono {
    color: var(--azul-vivo);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .resenas-cabecera h2 {
    max-width: 18ch;
  }

  .resenas-filas {
    display: grid;
    gap: 18px;
    margin-top: clamp(32px, 4vw, 52px);
  }

  /* Cada fila es un contenedor: 100cqw = su ancho visible, para saber cuánto debe recorrer la pista. */
  .resenas-fila {
    container-type: inline-size;
  }

  .resenas-pista {
    display: flex;
    gap: 18px;
    width: max-content;
    margin: 0 auto;
    padding: 4px var(--margen);
    list-style: none;
  }

  /* ── Con movimiento: la pista se desplaza con el scroll (de un extremo al otro; quieta si cabe completa) ── */
  :global(.movimiento) .resenas-filas {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  :global(.movimiento) .resenas-pista {
    --t: clamp(0, (var(--p, 0.5) - 0.13) / 0.62, 1);
    --recorrido: min(0px, 100cqw - 100%);
    transform: translate3d(calc(var(--recorrido) * var(--t)), 0, 0);
    will-change: transform;
  }

  :global(.movimiento) .es-inversa .resenas-pista {
    transform: translate3d(calc(var(--recorrido) * (1 - var(--t))), 0, 0);
  }

  /* ── Sin movimiento (sin JS o "reducir movimiento"): filas que se deslizan con el dedo, con imán ── */
  :global(html:not(.movimiento)) .resenas-fila {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--margen);
    scrollbar-width: thin;
  }

  :global(html:not(.movimiento)) .resenas-pista {
    margin: 0;
  }

  :global(html:not(.movimiento)) .resena {
    scroll-snap-align: start;
  }

  /* ── Tarjeta ── */

  .resena {
    position: relative;
    display: grid;
    align-content: start;
    gap: 14px;
    width: min(380px, 80vw);
    padding: 22px 24px 24px;
    border: 1px solid var(--linea-oscura);
    border-radius: 20px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.045), rgb(255 255 255 / 0.015));
  }

  /* Filo de luz arriba: el mismo lenguaje de líneas de 1 px del resto del sitio. */
  .resena::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 24px;
    right: 24px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(46 159 224 / 0.6), transparent);
  }

  .resena-cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }

  .resena .pildora {
    font-size: 0.8125rem;
  }

  .estrellas {
    color: #f3c969;
    font-size: 0.95rem;
    letter-spacing: 0.15em;
  }

  .estrellas-vacias {
    color: rgb(255 255 255 / 0.18);
  }

  blockquote {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (max-width: 559px) {
    .resena {
      width: min(340px, 78vw);
      padding: 20px;
    }

    blockquote {
      font-size: 1rem;
    }
  }

  .resena-autor {
    display: grid;
    gap: 2px;
    padding-top: 14px;
    border-top: 1px solid var(--linea-oscura);
    font-size: 1rem;
    line-height: 1.35;
  }

  .resena-autor span {
    color: var(--texto-tenue);
  }
</style>
