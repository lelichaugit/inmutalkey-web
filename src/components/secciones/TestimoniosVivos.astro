---
// Testimonios aprobados en el panel (/admin), con consentimiento del médico. La banda nace oculta y solo aparece si
// GET /api/testimonios trae alguno (src/scripts/formularios.ts los pinta con textContent). Sin JS no se ve: no hay
// nada que mostrar sin consultar la base. Nunca hay testimonios de ejemplo en producción.
---

<section class="seccion testimonios-vivos" aria-labelledby="testimonios-titulo" data-testimonios-vivos hidden>
  <div class="contenedor">
    <div class="seccion-cabecera">
      <p class="antetitulo">Médicos fundadores</p>
      <h2 id="testimonios-titulo">Lo que dicen quienes ya lo usan.</h2>
      <p>Publicados con su autorización.</p>
    </div>
    <ul class="testimonios-lista" data-lista></ul>
  </div>
</section>

<style>
  .testimonios-vivos[hidden] {
    display: none;
  }

  .testimonios-lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .testimonios-lista :global(.testimonio) {
    display: grid;
    gap: 1rem;
    align-content: space-between;
    padding: 1.5rem;
    border: 1px solid var(--cristal-borde);
    border-radius: var(--radio-lg);
    background: var(--grad-tarjeta);
    box-shadow: var(--cristal-brillo), var(--elev-1);
  }

  .testimonios-lista :global(blockquote) {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .testimonios-lista :global(.testimonio-autor) {
    display: grid;
    gap: 2px;
    margin: 0;
  }

  .testimonios-lista :global(.testimonio-autor span) {
    color: var(--texto-2);
    font-size: 0.875rem;
  }
</style>
