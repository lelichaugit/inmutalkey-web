---
import Icono from '../Icono.astro';

const PUNTOS = [
  { icono: 'candado', texto: 'Tus expedientes viven cifrados en tu computadora y solo se abren con tu contraseña.' },
  { icono: 'sin-wifi', texto: 'Funciona sin internet, también para firmar e imprimir.' },
  { icono: 'ojo', texto: 'InmutalKey no envía datos a nadie. Ni siquiera a nosotros.' },
  { icono: 'usb', texto: 'Respaldas cuando quieras, a la USB o disco que tú elijas.' },
] as const;
---

<section class="seccion fondo-negro zero" aria-labelledby="zero-titulo" data-progreso-scroll>
  <div class="contenedor zero-rejilla">
    <div class="zero-escena" aria-hidden="true">
      <svg viewBox="0 0 420 360" class="zero-svg">
        <defs>
          <linearGradient id="zero-pantalla" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0d1f3f"></stop>
            <stop offset="1" stop-color="#060b16"></stop>
          </linearGradient>
          <radialGradient id="zero-halo" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="#2e9fe0" stop-opacity="0.45"></stop>
            <stop offset="1" stop-color="#2e9fe0" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <!-- nube tachada -->
        <g class="zero-nube">
          <path d="M150 78h120a30 30 0 0 0 5-59.6A48 48 0 0 0 183 12a36 36 0 0 0-33 66Z" fill="none" stroke="#a9b6c8" stroke-width="2.5" stroke-linejoin="round"></path>
          <path d="M136 6l170 92" stroke="#ff6b6b" stroke-width="3" stroke-linecap="round"></path>
        </g>
        <!-- camino que no llega -->
        <path class="zero-camino" d="M210 205V110" stroke="#2e9fe0" stroke-width="2" stroke-dasharray="4 7" fill="none"></path>
        <circle class="zero-paquete" cx="210" cy="200" r="5" fill="#2e9fe0"></circle>
        <circle class="zero-paquete zero-paquete-2" cx="210" cy="200" r="5" fill="#2e9fe0"></circle>
        <!-- computadora -->
        <circle cx="210" cy="262" r="120" fill="url(#zero-halo)"></circle>
        <rect x="104" y="196" width="212" height="132" rx="12" fill="url(#zero-pantalla)" stroke="#33415a" stroke-width="2"></rect>
        <rect x="84" y="328" width="252" height="14" rx="7" fill="#1b2638"></rect>
        <!-- bóveda -->
        <g class="zero-boveda">
          <rect x="170" y="226" width="80" height="72" rx="10" fill="none" stroke="#2fd19a" stroke-width="2.5"></rect>
          <circle cx="210" cy="262" r="16" fill="none" stroke="#2fd19a" stroke-width="2.5"></circle>
          <path d="M210 250v24M198 262h24" stroke="#2fd19a" stroke-width="2.5" stroke-linecap="round"></path>
        </g>
      </svg>
    </div>

    <div class="entrada revelar">
      <h2 id="zero-titulo">Tus expedientes no se van a ninguna nube</h2>
      <p class="texto-grande tenue">Se quedan en tu consultorio, cifrados. Tú tienes la llave.</p>
      <ul class="zero-puntos">
        {
          PUNTOS.map((p) => (
            <li>
              <Icono nombre={p.icono} />
              <span>{p.texto}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .zero-rejilla {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  @media (min-width: 960px) {
    .zero-rejilla {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }

  .zero-escena {
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }

  .zero-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* La nube se aleja y se apaga con el scroll; los datos intentan subir y regresan. */
  .zero-nube {
    transform: translateY(calc((var(--p, 0.5) - 0.5) * -30px));
    opacity: calc(1.15 - var(--p, 0.5) * 0.6);
  }

  .zero-paquete {
    animation: paquete 3.2s var(--ease) infinite;
  }

  .zero-paquete-2 {
    animation-delay: 1.6s;
  }

  @keyframes paquete {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    50% {
      transform: translateY(-80px);
      opacity: 1;
    }
    60% {
      transform: translateY(-80px);
      opacity: 0.2;
    }
    100% {
      transform: translateY(0);
      opacity: 0;
    }
  }

  .zero-boveda {
    filter: drop-shadow(0 0 10px rgb(47 209 154 / 0.45));
  }

  .zero-puntos {
    display: grid;
    gap: 14px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .zero-puntos li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 12px;
    align-items: start;
  }

  .zero-puntos :global(.icono) {
    width: 24px;
    height: 24px;
    color: var(--azul-vivo);
  }

  @media (prefers-reduced-motion: reduce) {
    .zero-paquete {
      animation: none;
      opacity: 0;
    }
    .zero-nube {
      transform: none;
    }
  }
</style>
