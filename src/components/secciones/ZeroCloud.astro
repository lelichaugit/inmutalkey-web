---
// La bóveda: escena fijada negra (estilo página de privacidad de Apple). Tres actos ligados a --p:
//   1 · la nota entra a clinica.db y se cifra ante tus ojos (la clave sale de tu contraseña con Argon2id)
//   2 · las líneas hacia la nube se cortan y el Wi‑Fi se apaga, pero el programa sigue sellando notas
//   3 · la ventana se retira y aparece la llave: "Tú tienes la llave"
// Sin JS o con movimiento reducido no se fija: los tres actos se leen apilados y el visual queda en su estado final.
// Debajo, una ficha corta con lo verificable (respaldo incluido). Verdad: no hay recuperación de contraseña.
import Icono from '../Icono.astro';
import Isotipo3D from '../Isotipo3D.astro';
import type { NombreIcono } from '../../lib/iconos';

/** La misma nota que se selló en "Cómo funciona": ahora se guarda cifrada. */
const NOTA = [
  'Nota de evolución · Hoy 14:32',
  'Motivo: dolor de garganta y fiebre',
  'TA 120/80 · FC 88 · T 38.2 °C',
  'Dx: J02.9 Faringitis aguda',
  'Plan: paracetamol 500 mg c/8 h',
] as const;

// Texto cifrado de muestra (determinista, para que el build sea reproducible). Más largo que el renglón: llena el
// ancho de la ventana, como un bloque cifrado.
const ALFABETO = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
function cifrado(texto: string, semilla: number): string {
  let s = semilla;
  let salida = '';
  for (let i = 0; i < texto.length; i++) {
    s = (s * 16807) % 2147483647;
    salida += ALFABETO.charAt(s % 64);
  }
  return salida;
}
const CIFRA = NOTA.map((renglon, i) => cifrado(renglon + renglon, 7919 * (i + 3)));

const FICHA: readonly { icono: NombreIcono; titulo: string; texto: string; dato: string }[] = [
  {
    icono: 'candado',
    titulo: 'Cifrado en tu equipo',
    texto: 'Tus expedientes viven cifrados en tu computadora y solo se abren con tu contraseña.',
    dato: 'AES-256 · SQLCipher · Argon2id',
  },
  {
    icono: 'sin-wifi',
    titulo: 'Funciona sin internet',
    texto: 'Firmas, imprimes, buscas y respaldas igual con el Wi‑Fi apagado.',
    dato: 'Sin servidores',
  },
  {
    icono: 'ojo',
    titulo: 'Sin telemetría',
    texto: 'InmutalKey no envía datos a nadie. Ni siquiera a nosotros.',
    dato: 'Telemetría: ninguna',
  },
  {
    icono: 'usb',
    titulo: 'Respaldos donde tú decidas',
    texto: 'Copia tu base a la USB o disco que elijas, y el programa comprueba que la copia quedó idéntica.',
    dato: 'Copia verificada · SHA-256',
  },
];
---

<section class="zero fondo-negro" aria-labelledby="zero-titulo">
  <div class="zero-escena" data-escena>
    <div class="zero-escenario" data-escenario>
      <div class="contenedor zero-rejilla">
        <div class="zero-actos">
          <div class="zero-acto acto-1">
            <h2 id="zero-titulo">Tus expedientes no se van a ninguna nube.</h2>
            <p class="texto-grande tenue">
              Se guardan cifrados en tu computadora. Sin tu contraseña, lo que escribiste es ilegible.
            </p>
          </div>
          <div class="zero-acto acto-2">
            <p class="zero-titular">Sin internet. <span class="sin-corte">Sin telemetría.</span></p>
            <p class="texto-grande tenue">
              InmutalKey no envía datos a nadie, ni siquiera a nosotros. Con el Wi‑Fi apagado firmas, imprimes y
              respaldas igual.
            </p>
          </div>
          <div class="zero-acto acto-3">
            <p class="zero-titular zero-luz"><span>Tú</span> <span>tienes</span> <span>la</span> <span>llave.</span></p>
            <p class="texto-grande tenue">
              Solo tu contraseña abre tus expedientes. Nadie más la tiene, ni nosotros: guárdala bien.
            </p>
          </div>
        </div>

        <div class="zero-lienzo" aria-hidden="true">
          <div class="zv">
            <div class="zv-entrada">
              <span class="zv-halo"></span>

              <!-- La nube y las líneas que se cortan -->
              <div class="zv-nube">
                <svg viewBox="0 0 24 24" class="zv-nube-icono">
                  <path d="M7.25 18.25h10.5a3.75 3.75 0 0 0 .7-7.43 6 6 0 0 0-11.5-1.3A4.4 4.4 0 0 0 7.25 18.25Z"></path>
                  <path class="zv-nube-tacha" d="M3.5 3.5l17 17"></path>
                </svg>
                <span class="zv-etiqueta zv-nube-estado">
                  <span class="zv-e1">Nube</span>
                  <span class="zv-e2">Sin conexión</span>
                </span>
              </div>
              <div class="zv-enlaces">
                <span class="zv-enlace"><i></i><i></i></span>
                <span class="zv-enlace"><i></i><i></i></span>
                <span class="zv-enlace"><i></i><i></i></span>
              </div>

              <!-- clinica.db: la nota se cifra -->
              <div class="zv-ventana">
                <div class="zv-barra">
                  <span class="zv-archivo">
                    <Icono nombre="respaldo" />
                    clinica.db
                  </span>
                  <span class="zv-estado">
                    <svg viewBox="0 0 24 24" class="zv-wifi">
                      <path class="zv-arco zv-arco-3" d="M2.6 9.4a13.5 13.5 0 0 1 18.8 0"></path>
                      <path class="zv-arco zv-arco-2" d="M5.6 12.6a9.2 9.2 0 0 1 12.8 0"></path>
                      <path class="zv-arco zv-arco-1" d="M8.7 15.8a4.6 4.6 0 0 1 6.6 0"></path>
                      <path class="zv-arco-punto" d="M12 19.3h.01"></path>
                      <path class="zv-wifi-tacha" d="M4 4l16 16"></path>
                    </svg>
                    <svg viewBox="0 0 24 24" class="zv-candado">
                      <path class="zv-arco-candado" d="M8 10.5V7.75a4 4 0 0 1 8 0v2.75"></path>
                      <rect x="5" y="10.5" width="14" height="9.75" rx="2.25"></rect>
                      <path d="M12 14.4v2.2"></path>
                    </svg>
                  </span>
                </div>

                <div class="zv-nota">
                  <div class="zv-capa zv-plano">
                    {NOTA.map((r) => <span>{r}</span>)}
                  </div>
                  <div class="zv-capa zv-cifra">
                    {CIFRA.map((r) => <span>{r}</span>)}
                  </div>
                  <span class="zv-barrido"><i></i></span>
                  <span class="zv-aviso">
                    <span class="zv-aviso-aro"><Icono nombre="check" /></span>
                    <span>
                      <strong>Nota sellada</strong>
                      <small>sin conexión</small>
                    </span>
                  </span>
                </div>

                <div class="zv-pie">
                  <span class="zv-etiqueta">AES-256 · SQLCipher</span>
                  <span class="zv-avance"><i></i></span>
                  <span class="zv-etiqueta zv-pie-estado">
                    <span class="zv-e1">Cifrando…</span>
                    <span class="zv-e2">Cifrada</span>
                  </span>
                </div>
              </div>

              <!-- De dónde sale la clave -->
              <div class="zv-clave">
                <span class="zv-ficha"><span class="zv-puntos">••••••••</span></span>
                <span class="zv-flecha"></span>
                <span class="zv-ficha zv-ficha-proceso">Argon2id</span>
                <span class="zv-flecha"></span>
                <span class="zv-ficha"><Icono nombre="llave" /> clave</span>
              </div>

              <!-- Acto 3: la llave -->
              <div class="zv-llave">
                <div class="zv-llave-mover">
                  <Isotipo3D sizes="(min-width: 960px) 180px, 120px" brillo />
                </div>
                <span class="zv-etiqueta zv-llave-pie">clinica.db · en tu computadora</span>
              </div>

              <span class="zv-esquinas"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="contenedor zero-ficha" data-escalonar>
    {
      FICHA.map((f) => (
        <div class="ficha-celda" data-animar="subir">
          <Icono nombre={f.icono} />
          <h3>{f.titulo}</h3>
          <p class="tenue">{f.texto}</p>
          <span class="ficha-dato">{f.dato}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  /*
   * Tramos (todos con var(--p, 1): sin JS o con movimiento reducido se ve el estado final)
   *   --t0  0.00–0.07  aparece la derivación de la clave (contraseña → Argon2id → clave)
   *   --t1  0.06–0.32  barrido de cifrado (texto legible → cifrado)
   *   --t2  0.38–0.56  se cortan las líneas a la nube y se apaga el Wi‑Fi
   *   --t4  0.54–0.62  aviso "Nota sellada · sin conexión": el programa sigue trabajando
   *   --t3  0.68–0.86  la ventana se retira y llega la llave
   *   --tl  0.74–0.94  "Tú tienes la llave" se ilumina palabra por palabra
   * Un transform por elemento: los efectos que se combinan van en envoltorios anidados.
   */
  .zero {
    position: relative;
    isolation: isolate;
    padding-bottom: var(--seccion);
  }

  /* ───────────── Escena ───────────── */

  /* Los tramos se calculan aquí: --p vive en el elemento [data-escena]. */
  .zero-escena {
    --largo: 2.2;
    --p0: var(--p, 1);
    --t0: clamp(0, var(--p0) / 0.07, 1);
    --t1: clamp(0, (var(--p0) - 0.06) / 0.26, 1);
    --t2: clamp(0, (var(--p0) - 0.38) / 0.18, 1);
    --t4: clamp(0, (var(--p0) - 0.54) / 0.08, 1);
    --t3: clamp(0, (var(--p0) - 0.68) / 0.18, 1);
    --tl: clamp(0, (var(--p0) - 0.72) / 0.18, 1);
    --cerrado: clamp(0, (var(--p0) - 0.3) / 0.04, 1);
  }

  @media (min-width: 960px) {
    .zero-escena {
      --largo: 2.6;
    }
  }

  /* Sin fijar (sin JS / movimiento reducido): flujo normal con aire arriba. */
  .zero-escenario {
    padding-top: var(--seccion);
  }

  :global(.movimiento) .zero-escenario {
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--altura-nav) + clamp(8px, 2svh, 24px));
    /* Abajo: el botón flotante de WhatsApp del celular no tapa el visual. */
    padding-bottom: calc(76px + env(safe-area-inset-bottom));
  }

  @media (min-width: 1080px) {
    :global(.movimiento) .zero-escenario {
      padding-bottom: clamp(24px, 4svh, 48px);
    }
  }

  .zero-rejilla {
    display: grid;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }

  :global(.movimiento) .zero-rejilla {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2.6svh, 28px);
    min-height: 0;
    flex: 1;
  }

  @media (min-width: 960px) {
    .zero-rejilla,
    :global(.movimiento) .zero-rejilla {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      grid-template-rows: minmax(0, 1fr);
      gap: clamp(32px, 5vw, 72px);
    }
  }

  /* ── Actos de texto: con movimiento comparten celda y se relevan; sin él, se leen apilados ── */

  .zero-actos {
    display: grid;
    gap: clamp(40px, 6vw, 64px);
  }

  :global(.movimiento) .zero-actos {
    gap: 0;
    align-self: center;
  }

  :global(.movimiento) .zero-acto {
    grid-area: 1 / 1;
  }

  .zero-acto > * + * {
    margin-top: clamp(0.75rem, 0.6rem + 0.6vw, 1.15rem);
  }

  .zero-acto h2,
  .zero-titular {
    max-width: 15ch;
    font-family: var(--fuente-titulo);
    font-size: var(--h2);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .zero-acto .texto-grande {
    max-width: 36ch;
  }

  @media (max-width: 959px) {
    :global(.movimiento) .zero-acto {
      text-align: center;
    }

    :global(.movimiento) .zero-acto > * {
      margin-inline: auto;
    }
  }

  /* El celular cuida la altura: titular y párrafo un poco más compactos dentro de la escena. */
  @media (max-width: 599px) {
    :global(.movimiento) .zero-acto h2,
    :global(.movimiento) .zero-titular {
      font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2rem);
    }

    :global(.movimiento) .zero-acto .texto-grande {
      font-size: 1.0625rem;
      line-height: 1.5;
    }
  }

  .zero-luz {
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 4.5rem);
  }

  .zero-luz span {
    display: inline-block;
  }

  :global(.movimiento) .acto-1 {
    --a: calc(1 - clamp(0, (var(--p0) - 0.29) / 0.06, 1));
    opacity: var(--a);
    transform: translate3d(0, calc((1 - var(--a)) * -18px), 0);
  }

  :global(.movimiento) .acto-2 {
    --entra: clamp(0, (var(--p0) - 0.35) / 0.06, 1);
    --sale: clamp(0, (var(--p0) - 0.63) / 0.06, 1);
    opacity: calc(var(--entra) - var(--sale));
    transform: translate3d(0, calc((1 - var(--entra)) * 22px - var(--sale) * 18px), 0);
  }

  :global(.movimiento) .acto-3 {
    --a: clamp(0, (var(--p0) - 0.69) / 0.06, 1);
    opacity: var(--a);
    transform: translate3d(0, calc((1 - var(--a)) * 22px), 0);
  }

  /* "Tú tienes la llave": cada palabra pasa de tenue a plena, en orden. */
  .zero-luz span:nth-child(1) { --w: 0; }
  .zero-luz span:nth-child(2) { --w: 1; }
  .zero-luz span:nth-child(3) { --w: 2; }
  .zero-luz span:nth-child(4) { --w: 3; }

  :global(.movimiento) .zero-luz span {
    opacity: clamp(0.18, calc(var(--tl) * 6 - var(--w) - 1), 1);
  }

  /* ───────────── Visual ───────────── */

  .zero-lienzo {
    display: grid;
    place-items: center;
    min-height: 0;
  }

  /* Con movimiento el visual ocupa el alto que deja el texto y conserva su proporción (contenedor de tamaño). */
  :global(.movimiento) .zero-lienzo {
    flex: 1 1 0;
    width: 100%;
    container-type: size;
  }

  @media (min-width: 960px) {
    :global(.movimiento) .zero-lienzo {
      height: 100%;
    }
  }

  .zv {
    width: min(100%, 540px);
    aspect-ratio: 1 / 1.02;
    container-type: inline-size;
  }

  :global(.movimiento) .zv {
    width: min(100cqw, 98cqh, 580px);
  }

  .zv-entrada {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 4% 6%;
    font-size: clamp(10.5px, 3.3cqi, 15px);
    line-height: 1.35;
  }

  /* Al asomar la escena, el visual sube y crece un poco (--e: 0 → 1 hasta fijarse). */
  :global(.movimiento) .zv-entrada {
    opacity: calc(0.25 + var(--e, 1) * 0.75);
    transform: translate3d(0, calc((1 - var(--e, 1)) * 48px), 0) scale(calc(0.94 + var(--e, 1) * 0.06));
  }

  .zv-halo {
    position: absolute;
    inset: 4% 0 0;
    background: radial-gradient(48% 42% at 50% 56%, rgb(1 120 176 / 0.26), transparent 72%);
    pointer-events: none;
  }

  /* Esquinas de visor y cuadrícula tenue */
  .zv-esquinas {
    position: absolute;
    inset: 0;
    --c: rgb(255 255 255 / 0.32);
    --l: clamp(12px, 5cqi, 22px);
    background:
      linear-gradient(var(--c), var(--c)) top left / var(--l) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) top left / 1px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) top right / var(--l) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) top right / 1px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) bottom left / var(--l) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) bottom left / 1px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) bottom right / var(--l) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) bottom right / 1px var(--l) no-repeat;
    pointer-events: none;
  }

  .zv-entrada::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 8.333% 8.333%;
    -webkit-mask-image: radial-gradient(closest-side, #000 40%, transparent);
    mask-image: radial-gradient(closest-side, #000 40%, transparent);
    pointer-events: none;
  }

  .zv-etiqueta {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.82em;
    letter-spacing: 0.02em;
    color: var(--texto-tenue);
    white-space: nowrap;
  }

  /* Etiquetas que cambian de texto: las dos versiones en la misma celda. */
  .zv-nube-estado,
  .zv-pie-estado {
    display: inline-grid;
    justify-items: center;
  }

  .zv-pie-estado {
    justify-items: end;
  }

  .zv-e1,
  .zv-e2 {
    grid-area: 1 / 1;
  }

  /* ── Nube y enlaces ── */

  .zv-nube {
    position: relative;
    width: 30%;
    display: grid;
    justify-items: center;
    gap: 0.2em;
    opacity: calc(1 - var(--t2) * 0.55 - var(--t3) * 0.3);
  }

  .zv-nube-icono {
    width: 46%;
    height: auto;
    fill: none;
    stroke: var(--texto-tenue);
    stroke-width: 1.1;
    stroke-linejoin: round;
    overflow: visible;
  }

  .zv-nube-tacha {
    stroke: var(--texto);
    stroke-linecap: round;
    transform-box: view-box;
    transform-origin: 3.5px 3.5px;
    transform: scale(var(--t2));
  }

  /* Relevo sin encimarse: una se va antes de que llegue la otra. */
  .zv-nube-estado .zv-e1 {
    opacity: calc(1 - clamp(0, var(--t2) * 3, 1));
  }

  .zv-nube-estado .zv-e2 {
    opacity: clamp(0, var(--t2) * 3 - 1.4, 1);
    color: var(--texto);
  }

  .zv-enlaces {
    width: 46%;
    height: 3.2em;
    margin-top: 0.5em;
    display: flex;
    justify-content: space-between;
  }

  .zv-enlace {
    display: grid;
    grid-template-rows: 1fr 1fr;
    width: 1px;
  }

  /* Cada línea son dos mitades punteadas: al cortarse, cada una se retrae hacia su extremo. */
  .zv-enlace i {
    background: repeating-linear-gradient(var(--azul-vivo) 0 3px, transparent 3px 7px);
    opacity: 0.75;
  }

  .zv-enlace i:first-child {
    transform-origin: 50% 0;
    transform: scaleY(calc(1 - var(--t2) * 0.82));
  }

  .zv-enlace i:last-child {
    transform-origin: 50% 100%;
    transform: scaleY(calc(1 - var(--t2) * 0.82));
  }

  .zv-enlace:nth-child(1) {
    opacity: calc(1 - var(--t2) * 0.6);
  }

  .zv-enlace:nth-child(3) {
    opacity: calc(1 - var(--t2) * 0.6);
  }

  /* ── Ventana clinica.db ── */

  .zv-ventana {
    position: relative;
    width: 100%;
    display: grid;
    border: 1px solid var(--linea-oscura-fuerte);
    border-radius: 0.9em;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.05), transparent 40%),
      #070d1a;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.6),
      0 30px 60px -30px rgb(0 0 0 / 0.9),
      0 0 60px -20px rgb(46 159 224 / 0.25);
    overflow: hidden;
  }

  /* Acto 3: la ventana se retira para dejar paso a la llave (sin movimiento se ve así, el cuadro final). */
  .zv-ventana {
    opacity: calc(1 - var(--t3) * 0.78);
    transform: scale(calc(1 - var(--t3) * 0.06));
  }

  .zv-barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6em;
    padding: 0.6em 0.85em;
    border-bottom: 1px solid var(--linea-oscura);
    background: rgb(255 255 255 / 0.025);
  }

  .zv-archivo {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.86em;
    color: var(--texto);
  }

  .zv-archivo :global(.icono) {
    width: 1.25em;
    height: 1.25em;
    color: var(--azul-vivo);
  }

  .zv-estado {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
  }

  .zv-wifi,
  .zv-candado {
    width: 1.35em;
    height: 1.35em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  .zv-wifi {
    color: var(--texto);
  }

  /* El Wi‑Fi se apaga de afuera hacia adentro y queda tachado. */
  .zv-arco-3 {
