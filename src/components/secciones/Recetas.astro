---
// Recetas que siempre se emiten (IDENTIDAD_MARCA §9.4). Formatos reales de la app v0.4.0 (src/formatoHoja.ts):
// media hoja (2 copias con línea de corte), Carta vertical y Carta horizontal. El contenido nunca bloquea la emisión:
// si no cabe en media hoja, pasa solo a Carta vertical y se avisa. Las hojas se dibujan con CSS (papel blanco y tinta
// Marino, con el monocromo grabado que la app usa en lo impreso).
import Icono from '../Icono.astro';

const FORMATOS = [
  { id: 'media', icono: 'media-hoja', titulo: 'Media hoja', texto: 'Dos copias en una hoja Carta, con línea de corte: una para el paciente y otra para la farmacia o su archivo.' },
  { id: 'vertical', icono: 'hoja', titulo: 'Carta vertical', texto: 'Una copia por hoja. Si el tratamiento es largo, el texto continúa en otra hoja sin recortarse.' },
  { id: 'horizontal', icono: 'hoja-horizontal', titulo: 'Carta horizontal', texto: 'Hoja apaisada, cómoda para muchas líneas de tratamiento o indicaciones detalladas.' },
] as const;
---

<section class="seccion recetas" id="recetas" aria-labelledby="recetas-titulo">
  <div class="contenedor">
    <div class="seccion-cabecera centrada">
      <p class="antetitulo">Recetas e indicaciones</p>
      <h2 id="recetas-titulo">Recetas que siempre se emiten.</h2>
      <p>
        Cada receta lleva folio, número de expediente y el sello de la nota firmada. Usted elige el formato; el contenido
        nunca lo detiene.
      </p>
    </div>

    <ul class="formatos" data-escalonar>
      {
        FORMATOS.map((f) => (
          <li class="tarjeta tarjeta-viva formato revelar">
            <div class:list={['hoja-escena', `hoja-${f.id}`]} aria-hidden="true">
              <div class="hoja">
                {(f.id === 'media' ? [1, 2] : [1]).map(() => (
                  <div class="copia">
                    <div class="membrete">
                      <img src="/brand/logo-mono.svg" alt="" width="10" height="27" loading="lazy" decoding="async" />
                      <span>
                        <b />
                        <i />
                      </span>
                      <em>Folio 0248</em>
                    </div>
                    <span class="renglon largo" />
                    <span class="renglon" />
                    <span class="renglon medio" />
                    {f.id !== 'media' && <span class="renglon largo" />}
                    {f.id !== 'media' && <span class="renglon" />}
                    <span class="sello-hoja" />
                  </div>
                ))}
              </div>
            </div>
            <h3>
              <Icono nombre={f.icono} /> {f.titulo}
            </h3>
            <p>{f.texto}</p>
          </li>
        ))
      }
    </ul>

    <p class="aviso recetas-aviso revelar">
      <span><Icono nombre="impresora" /></span>
      <span>
        <strong>Nunca se bloquea.</strong> Si lo que escribió no cabe en media hoja, el documento pasa solo a Carta vertical
        y se le avisa: «Se imprimirá completo en hoja Carta vertical». Usted puede elegir horizontal.
      </span>
    </p>
  </div>
</section>

<style>
  .formatos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .formato {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    padding: 1rem 1rem 1.5rem;
  }

  .formato h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.75rem 0.5rem 0;
    font-size: 1.1875rem;
  }

  .formato h3 :global(.icono) {
    color: var(--primario);
  }

  .formato p {
    margin: 0 0.5rem;
    color: var(--texto-2);
  }

  /* ── Escena con la hoja (papel siempre blanco, tinta Marino) ── */
  .hoja-escena {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radio);
    background:
      radial-gradient(70% 70% at 30% 20%, color-mix(in srgb, var(--aurora-2) 30%, transparent), transparent 70%),
      color-mix(in srgb, var(--primario) 7%, var(--fondo));
  }

  .hoja {
    display: grid;
    width: 46%;
    aspect-ratio: 8.5 / 11;
    padding: 6%;
    border-radius: 3px;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(3 35 64 / 0.12),
      0 18px 30px -16px rgb(3 35 64 / 0.45);
    transform: rotate(-2deg);
    transition: transform 400ms var(--curva-cristal);
  }

  .formato:hover .hoja {
    transform: rotate(0deg) translateY(-3px);
  }

  .hoja-horizontal .hoja {
    width: 62%;
    aspect-ratio: 11 / 8.5;
    transform: rotate(1.5deg);
  }

  .hoja-media .hoja {
    grid-template-rows: 1fr 1fr;
  }

  .copia {
    display: grid;
    align-content: start;
    gap: 7%;
    min-height: 0;
  }

  .hoja-media .copia + .copia {
    padding-top: 9%;
    border-top: 1px dashed #8aa0b6;
  }

  .hoja-media .copia {
    gap: 9%;
  }

  .membrete {
    display: flex;
    align-items: center;
    gap: 6%;
    padding-bottom: 5%;
    border-bottom: 1.5px solid #043259;
  }

  .membrete img {
    width: auto;
    height: 1.6rem;
  }

  .hoja-media .membrete img {
    height: 1.1rem;
  }

  .membrete span {
    display: grid;
    flex: 1;
    gap: 3px;
  }

  .membrete b,
  .membrete i,
  .renglon {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: #c6d2de;
  }

  .membrete b {
    width: 70%;
    background: #043259;
  }

  .membrete i {
    width: 45%;
  }

  .membrete em {
    color: #043259;
    font-family: var(--mono);
    font-size: 0.5rem;
    font-style: normal;
    white-space: nowrap;
  }

  .renglon {
    width: 82%;
  }

  .renglon.largo {
    width: 96%;
  }

  .renglon.medio {
    width: 58%;
  }

  .sello-hoja {
    justify-self: end;
    width: 34%;
    height: 6px;
    border-radius: 2px;
    background: repeating-linear-gradient(90deg, #224d73 0 3px, transparent 3px 5px);
    opacity: 0.7;
  }

  .recetas-aviso {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    max-width: 48rem;
    margin: 2rem auto 0;
  }

  .recetas-aviso > span:first-child {
    flex: none;
  }

  .recetas-aviso :global(.icono) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--info);
    margin-top: 0.125rem;
  }
</style>
