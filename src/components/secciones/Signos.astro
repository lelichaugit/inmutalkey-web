---
// Monitor de signos: peso, talla y SpO₂ editables; IMC en vivo con la clasificación OMS; SpO₂ fuera de rango en rojo.
// Mismas reglas que la app (src/lib/imc.ts). Lógica en src/scripts/signos.ts.
//
// Movimiento (solo con .movimiento): los trazos de ECG y pletismografía se dibujan ligados al scroll (--p del
// monitor, data-progreso-scroll, escrito solo en las dos franjas [data-p]) y después un hueco de barrido los recorre a
// 72 lpm (solo mientras el monitor está a la vista: signos.ts pone .en-vista); las cifras cuentan al verse
// (data-contar) y el IMC se calcula a la vista (signos.ts). Sin JS o con movimiento reducido: monitor completo y quieto.
import { calcularImc, clasificarImc, ETIQUETA_IMC } from '../../lib/imc';
import { trazoEcg, trazoPleth } from '../../scripts/signos';
import Icono from '../Icono.astro';

const PESO = 70;
const TALLA = 170;
const imc = calcularImc(PESO, TALLA) ?? 0;

// Trazos de referencia (franja de escritorio); signos.ts los rehace al tamaño real de cada pantalla.
const ANCHO = 520;
const ALTO = 76;
const ecg = trazoEcg(ANCHO, ALTO);
const pleth = trazoPleth(ANCHO, ALTO);
const SIGLAS = ['TA', 'FC', 'FR', 'Temp', 'SpO₂', 'Glucemia', 'Peso', 'Talla'];
---

<section class="seccion fondo-oscuro fondo-cuadricula signos-seccion" id="signos" data-signos data-sin-flotante aria-labelledby="signos-titulo">
  <div class="contenedor signos-rejilla">
    <div class="signos-texto">
      <p class="signos-etiqueta" data-animar="aparecer"><span class="signos-siglas">{SIGLAS.map((s) => <span>{s}</span>)}</span></p>
      <h2 id="signos-titulo" data-animar="titulo">Signos vitales sin calculadora</h2>
      <p class="texto-grande tenue" data-animar="subir" data-retraso="2">
        Escribe el peso y la talla y el IMC aparece al instante con su clasificación. Si un valor es imposible, el
        programa te avisa antes de firmar.
      </p>
      <p class="signos-pista" data-animar="subir" data-retraso="3">
        <Icono nombre="editar" /> Pruébalo: cambia los números del monitor.
      </p>
    </div>

    <div class="monitor-entrada" data-animar="subir">
      <div class="monitor" role="group" aria-label="Monitor de signos de un paciente de ejemplo" data-monitor data-progreso-scroll data-progreso-hasta="0.5">
        <header class="monitor-cabecera">
          <span class="monitor-paciente">
            <Icono nombre="usuario" />
            <span><strong>Paciente de ejemplo</strong><small>34 años</small></span>
          </span>
          <span class="monitor-vivo"><i></i> En consulta</span>
        </header>

        <div class="ondas">
          <div class="onda onda-ecg" data-p>
            <span class="onda-etiqueta" aria-hidden="true">II</span>
            <svg viewBox={`0 0 ${ANCHO} ${ALTO}`} preserveAspectRatio="xMinYMid slice" aria-hidden="true" focusable="false" data-onda="ecg">
              <path pathLength="1" d={ecg}></path>
            </svg>
          </div>
          <div class="numerico numerico-fc">
            <small>
              FC
              <svg class="latido" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.6-7.5 10.2-7.5 10.2z"></path>
              </svg>
            </small>
            <strong data-contar="72">72</strong>
            <small>lpm</small>
          </div>

          <div class="onda onda-pleth" data-p>
            <span class="onda-etiqueta" aria-hidden="true">Pleth</span>
            <svg viewBox={`0 0 ${ANCHO} ${ALTO}`} preserveAspectRatio="xMinYMid slice" aria-hidden="true" focusable="false" data-onda="pleth">
              <path pathLength="1" d={pleth}></path>
            </svg>
          </div>
          <label class="numerico numerico-spo2" data-lectura-spo2>
            <small>SpO₂</small>
            <input name="spo2" value="97" inputmode="numeric" autocomplete="off" aria-describedby="signos-spo2-error" />
            <small>%</small>
          </label>
        </div>
        <p class="lectura-error" id="signos-spo2-error" data-error-spo2 hidden></p>

        <div class="monitor-lecturas">
          <div class="lectura">
            <small>TA</small>
            <strong><span data-contar="120">120</span>/<span data-contar="80">80</span></strong>
            <small>mmHg</small>
          </div>
          <div class="lectura">
            <small>FR</small>
            <strong data-contar="16">16</strong>
            <small>rpm</small>
          </div>
          <div class="lectura">
            <small>Temp</small>
            <strong data-contar="36.6">36.6</strong>
            <small>°C</small>
          </div>
        </div>

        <div class="monitor-imc" data-imc-zona>
          <label class="campo-monitor">
            <small>Peso (kg)</small>
            <input name="peso" value={PESO} inputmode="decimal" autocomplete="off" />
          </label>
          <label class="campo-monitor">
            <small>Talla (cm)</small>
            <input name="talla" value={TALLA} inputmode="decimal" autocomplete="off" />
          </label>
          <div class="imc-resultado" aria-live="polite" data-imc-resultado>
            <small>IMC</small>
            <strong data-imc-valor>{imc.toFixed(1)}</strong>
            <span data-imc-texto>{ETIQUETA_IMC[clasificarImc(imc)]}</span>
            <span class="imc-formula" data-imc-formula>{PESO} kg ÷ ({(TALLA / 100).toFixed(2)} m)²</span>
          </div>
        </div>

        <div class="gauge" aria-hidden="true">
          <div class="gauge-barra">
            <span class="zona zona-bajo"></span>
            <span class="zona zona-normal"></span>
            <span class="zona zona-sobre"></span>
            <span class="zona zona-obesidad"></span>
          </div>
          <span class="gauge-pista" data-gauge-marca></span>
          <div class="gauge-etiquetas">
            <span>18.5</span><span>25</span><span>30</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .signos-seccion {
    overflow-x: clip;
  }

  .signos-rejilla {
    display: grid;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }

  @media (min-width: 960px) {
    .signos-rejilla {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .signos-texto {
    display: grid;
    gap: 1.1rem;
    max-width: 34rem;
  }

  .signos-texto > * {
    margin: 0;
  }

  .signos-etiqueta {
    color: var(--azul-vivo);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    /* Recorta el separador con que empieza cada renglón (ver abajo): ningún "·" queda colgando. */
    overflow: hidden;
  }

  /* Cada sigla lleva su separador delante; el margen negativo saca del recuadro el del inicio de cada renglón. */
  .signos-siglas {
    display: flex;
    flex-wrap: wrap;
    margin-left: -1.6em;
  }

  .signos-siglas > span {
    white-space: nowrap;
  }

  .signos-siglas > span::before {
    content: '·';
    content: '·' / '';
    display: inline-block;
    width: 1.6em;
    text-align: center;
  }

  .signos-pista {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: var(--texto-tenue);
  }

  .signos-pista :global(.icono) {
    width: 1.15em;
    height: 1.15em;
    color: var(--azul-vivo);
  }

  /* ═════════════ El monitor ═════════════ */

  .monitor {
    --verde-monitor: #34d399;
    --cian: #67e8f9;
    --fondo-monitor: #030811;
    position: relative;
    padding: clamp(14px, 2.6vw, 22px);
    border: 1px solid var(--linea-oscura-fuerte);
    border-radius: 22px;
    background:
      radial-gradient(90% 60% at 15% 0%, rgb(46 159 224 / 0.1), transparent 70%),
      var(--fondo-monitor);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 40px 80px -30px rgb(0 0 0 / 0.85),
      0 0 0 6px rgb(255 255 255 / 0.015);
  }

  /* Esquinas de visor, como el resto de las piezas técnicas del sitio. */
  .monitor::before,
  .monitor::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    border: 0 solid rgb(46 159 224 / 0.6);
    pointer-events: none;
  }

  .monitor::before {
    top: -9px;
    left: -9px;
    border-width: 1px 0 0 1px;
  }

  .monitor::after {
    right: -9px;
    bottom: -9px;
    border-width: 0 1px 1px 0;
  }

  .monitor-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .monitor-paciente {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .monitor-paciente > span {
    display: grid;
    line-height: 1.25;
  }

  .monitor-paciente strong {
    font-size: 1rem;
    font-weight: 600;
  }

  .monitor-paciente small {
    color: var(--texto-tenue);
    font-size: 0.875rem;
  }

  .monitor-paciente :global(.icono) {
    flex: none;
    width: 34px;
    height: 34px;
    padding: 7px;
    border: 1px solid var(--linea-oscura-fuerte);
    border-radius: 50%;
    color: var(--texto-tenue);
  }

  .monitor-vivo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    padding: 4px 12px;
    border: 1px solid rgb(52 211 153 / 0.3);
    border-radius: 999px;
    color: var(--verde-monitor);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .monitor-vivo i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--verde-monitor);
    box-shadow: 0 0 10px var(--verde-monitor);
  }

  :global(.movimiento) .monitor-vivo i {
    animation: vivo 1.2s ease-in-out infinite;
  }

  @keyframes vivo {
    50% {
      opacity: 0.35;
    }
  }

  /* ── Ondas: franjas con cuadrícula fina y su cifra a la derecha, como un monitor de cabecera ── */
  .ondas {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(84px, 18%, 128px);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 14px;
    overflow: hidden;
    background:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(rgb(255 255 255 / 0.022) 1px, transparent 1px) 0 0 / 8px 8px,
      linear-gradient(90deg, rgb(255 255 255 / 0.022) 1px, transparent 1px) 0 0 / 8px 8px,
      #02060d;
  }

  /* Destinos [data-p] del monitor: scroll.ts escribe --p solo en las dos franjas (0 al asomar por abajo; tope 0.5 con
     data-progreso-hasta, cuando las dos ondas ya están completas). Tramos: ECG y luego pletismografía. */
  .onda {
    --d1: clamp(0, (var(--p, 1) - 0.06) / 0.34, 1);
    --d2: clamp(0, (var(--p, 1) - 0.12) / 0.34, 1);
    position: relative;
    overflow: hidden;
    padding: 10px 0 6px;
  }

  .onda-ecg {
    --color: var(--verde-monitor);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }

  .onda-pleth {
    --color: var(--cian);
  }

  .onda svg {
    display: block;
    width: 100%;
    height: 76px;
    overflow: hidden;
  }

  .onda path {
    fill: none;
    stroke: var(--color);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 3px var(--color));
  }

  .onda-etiqueta {
    position: absolute;
    top: 6px;
    left: 10px;
    color: var(--color);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    opacity: 0.85;
  }

  /* Se dibujan con el scroll (pathLength = 1: el guion mide toda la onda y el desfase lo descubre de izquierda a
     derecha). Sin .movimiento, la onda está completa. */
  :global(.movimiento) .onda-ecg path {
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc(1 - var(--d1));
  }

  :global(.movimiento) .onda-pleth path {
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc(1 - var(--d2));
  }

  /* Barrido: el hueco que avanza delante del trazo, como en un monitor de cabecera, a la velocidad de los latidos
     (signos.ts pone --barrido). Es una máscara del trazo del doble de ancho (la cuadrícula sigue a la vista): el hueco
     de 20 px termina a la mitad y recorre la franja de izquierda a derecha. Solo se abre cuando las dos ondas ya están
     dibujadas (--hueco). */
  :global(.movimiento) .onda svg {
    --hueco: clamp(0, (var(--d2) - 0.96) * 30, 1);
    --mascara: linear-gradient(
      90deg,
      #000 calc(50% - 26px),
      rgb(0 0 0 / calc(1 - var(--hueco))) calc(50% - 20px) 50%,
      #000 calc(50% + 2px)
    );
    -webkit-mask-image: var(--mascara);
    mask-image: var(--mascara);
    -webkit-mask-size: 200% 100%;
    mask-size: 200% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: barrido var(--barrido, 3.3s) linear infinite;
  }

  /* Fuera de vista, nada corre (el barrido recalcula el estilo en cada cuadro). signos.ts alterna .en-vista. */
  :global(.movimiento) .signos-seccion:not(.en-vista) .onda svg,
  :global(.movimiento) .signos-seccion:not(.en-vista) .latido,
  :global(.movimiento) .signos-seccion:not(.en-vista) .monitor-vivo i {
    animation-play-state: paused;
  }

  @keyframes barrido {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
  }

  .numerico {
    display: grid;
    align-content: center;
    justify-items: end;
    gap: 0;
    padding: 8px 14px;
    border-left: 1px solid rgb(255 255 255 / 0.06);
    line-height: 1;
  }

  .numerico-fc {
    color: var(--verde-monitor);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }

  .numerico-spo2 {
    color: var(--cian);
    cursor: text;
  }

  .numerico small {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    opacity: 0.85;
  }

  .numerico strong,
  .numerico input {
    font-family: var(--fuente-titulo);
    font-size: clamp(2.1rem, 1.6rem + 1.6vw, 2.9rem);
    font-weight: 600;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    color: inherit;
  }

  .numerico input {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 0;
    border: 0;
    border-bottom: 1px dashed color-mix(in srgb, currentColor 45%, transparent);
    background: transparent;
    text-align: right;
  }

  .latido {
    width: 13px;
    height: 13px;
    fill: currentColor;
  }

  :global(.movimiento) .latido {
    animation: latido 0.833s var(--ease) infinite;
  }

  @keyframes latido {
    0%,
    100% {
      transform: scale(1);
    }
    14% {
      transform: scale(1.32);
    }
    32% {
      transform: scale(0.96);
    }
  }

  .numerico-spo2.es-invalido {
    background: rgb(255 107 107 / 0.1);
    color: var(--error);
  }

  .lectura-error {
    margin: 10px 0 0;
    padding: 8px 12px;
    border-radius: 10px;
    background: rgb(255 107 107 / 0.1);
    color: var(--error);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .lectura-error[hidden] {
    display: none;
  }

  /* ── Lecturas y campos ── */
  .monitor-lecturas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 10px;
  }

  .lectura,
  .campo-monitor,
  .imc-resultado {
    display: grid;
    align-content: start;
    gap: 2px;
    min-width: 0;
    padding: 12px 14px;
    border: 1px solid var(--linea-oscura);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.02);
  }

  .lectura small,
  .campo-monitor small,
  .imc-resultado small {
    color: var(--texto-tenue);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .lectura strong {
    font-family: var(--fuente-titulo);
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.9rem);
    font-weight: 600;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .monitor-imc {
    display: grid;
    grid-template-columns: 1fr 1fr 1.35fr;
    gap: 10px;
    margin-top: 10px;
  }

  .campo-monitor {
    cursor: text;
  }

  .campo-monitor input {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 0;
    border: 0;
    border-bottom: 1px dashed rgb(255 255 255 / 0.25);
    background: transparent;
    color: var(--texto);
    font-family: var(--fuente-titulo);
    font-size: 1.6rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* El anillo de foco es el global (:focus-visible); además, la línea de captura se vuelve sólida. */
  .numerico input:focus,
  .campo-monitor input:focus {
    border-bottom-color: var(--azul-vivo);
    border-bottom-style: solid;
  }

  .imc-resultado {
    border-color: rgb(46 159 224 / 0.4);
    background: rgb(46 159 224 / 0.08);
    transition:
      box-shadow 0.8s var(--ease),
      border-color 0.8s var(--ease);
  }

  .imc-resultado.es-calculado {
    border-color: var(--azul-vivo);
    box-shadow:
      0 0 0 4px rgb(46 159 224 / 0.16),
      0 0 40px -6px rgb(46 159 224 / 0.6);
  }

  .imc-resultado strong {
    font-family: var(--fuente-titulo);
    font-size: 2.1rem;
    font-weight: 600;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  .imc-resultado > span {
    color: var(--azul-vivo);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .imc-resultado .imc-formula {
    margin-top: 4px;
    color: var(--texto-tenue);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 400;
    white-space: nowrap;
  }

  /* ── Escala del IMC (OMS): la marca se mueve con transform, no con left ── */
  .gauge {
    position: relative;
    margin-top: 18px;
    padding-top: 6px;
  }

  .gauge-barra {
    display: grid;
    grid-template-columns: 3.5fr 6.5fr 5fr 15fr;
    gap: 3px;
    height: 8px;
  }

  .zona {
    border-radius: 4px;
  }

  .zona-bajo {
    background: #60a5fa;
  }
  .zona-normal {
    background: #34d399;
  }
  .zona-sobre {
    background: #fbbf24;
  }
  .zona-obesidad {
    background: linear-gradient(90deg, #fb923c, #ef4444);
  }

  /* Pista del ancho de la escala: translateX(--pos × 100 %) lleva su borde izquierdo (la marca) al IMC. Sin JS:
     posición del IMC de ejemplo (24.2 → (24.2 − 15) / 30). */
  .gauge-pista {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 20px;
    transform: translate3d(calc(var(--pos, 0.307) * 100%), 0, 0);
    transition: transform 0.6s var(--ease);
    pointer-events: none;
  }

  .gauge-pista::before {
    content: '';
    position: absolute;
    top: 0;
    left: -2px;
    width: 4px;
    height: 20px;
    border-radius: 2px;
    background: #fff;
    box-shadow: 0 0 0 3px rgb(3 8 17 / 0.85);
  }

  /* Mientras el peso "se captura", la marca sigue al IMC cuadro a cuadro. */
  :global(.es-capturando) .gauge-pista {
    transition: none;
  }

  .gauge-etiquetas {
    position: relative;
    height: 1.4em;
    margin-top: 8px;
    color: var(--texto-tenue);
    font-size: 0.8125rem;
  }

  .gauge-etiquetas span {
    position: absolute;
    transform: translateX(-50%);
  }

  .gauge-etiquetas span:nth-child(1) {
    left: 11.7%;
  }
  .gauge-etiquetas span:nth-child(2) {
    left: 33.3%;
  }
  .gauge-etiquetas span:nth-child(3) {
    left: 50%;
  }

  /* ── Celular ── */
  @media (max-width: 399px) {
    .monitor-paciente :global(.icono) {
      display: none;
    }
  }

  @media (max-width: 559px) {
    .monitor-paciente strong {
      font-size: 0.9375rem;
    }

    .monitor-vivo {
      padding: 3px 10px;
      font-size: 0.8125rem;
    }

    .ondas {
      grid-template-columns: minmax(0, 1fr) 92px;
    }

    .onda svg {
      height: 60px;
    }

    .numerico {
      padding: 6px 10px;
    }

    .monitor-lecturas {
      gap: 8px;
    }

    .lectura {
      padding: 10px 10px;
    }

    .monitor-imc {
      grid-template-columns: 1fr 1fr;
