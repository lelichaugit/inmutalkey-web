---
// Cómo empezar: cuatro pasos sobre una línea de tiempo que se DIBUJA con el scroll (scaleY con el --p que el motor
// pone en la lista con data-progreso-scroll) y pasos que se encienden en orden. Al lado, la conversación de WhatsApp
// simulada (ChatSimulado + chat.ts). Sin JS o con movimiento reducido: línea completa y todos los pasos encendidos.
import { enlaceWhatsApp } from '../../lib/whatsapp';
import { sitio } from '../../site.config';
import ChatSimulado, { type Mensaje } from '../ChatSimulado.astro';
import Icono from '../Icono.astro';

const dias = sitio.licencia.diasPrueba;
const prueba = enlaceWhatsApp(sitio.contacto.whatsapp, sitio.contacto.mensajes.prueba);

const PASOS = [
  {
    titulo: 'Escríbenos por WhatsApp',
    texto: 'Te responde una persona del equipo y te envía el instalador.',
    dato: 'Una conversación, sin formularios',
  },
  {
    titulo: 'Instálalo en tu computadora',
    texto: 'Verificas que el archivo es el original, creas tu contraseña y capturas los datos de tu consultorio.',
    dato: 'Huella SHA-256 del instalador',
  },
  {
    titulo: `Úsalo ${dias} días completos`,
    texto: 'Todas las funciones, con tus pacientes reales o en modo demostración.',
    dato: 'Modo demostración en una base aparte',
  },
  {
    titulo: 'Activa tu licencia vitalicia',
    texto: 'Si te convence, la activas y sigues trabajando sin perder nada de lo capturado.',
    dato: 'Licencia offline, ligada a tu equipo',
  },
] as const;

const CHAT: readonly Mensaje[] = [
  { de: 'medico', hora: '10:02', texto: sitio.contacto.mensajes.prueba },
  { de: 'inmutalkey', hora: '10:03', texto: '¡Hola, doctora! Con gusto. ¿Su computadora tiene Windows 10 u 11?' },
  { de: 'medico', hora: '10:04', texto: 'Windows 11.' },
  {
    de: 'inmutalkey',
    hora: '10:05',
    texto: `Perfecto. Le envío el instalador y su huella para que verifique que es el original. La prueba dura ${dias} días, con todas las funciones.`,
    archivo: 'Instalador de InmutalKey',
    detalleArchivo: 'Windows 10 y 11',
  },
  { de: 'medico', hora: '10:21', texto: 'Ya quedó instalado. ¿Puedo practicar sin pacientes reales?' },
  { de: 'inmutalkey', hora: '10:22', texto: 'Sí: active el modo demostración. Usa una base aparte que puede borrar cuando quiera.' },
];
---

<section class="seccion fondo-oscuro pasos" id="pasos" aria-labelledby="pasos-titulo">
  <span class="pasos-luz" aria-hidden="true"></span>
  <div class="contenedor pasos-rejilla">
    <div class="pasos-texto">
      <div class="entrada">
        <h2 id="pasos-titulo" data-animar="titulo">Empezar toma una conversación</h2>
        <p class="texto-grande tenue" data-animar="subir" data-retraso="2">
          Sin formularios largos ni tarjeta de crédito. Así es de principio a fin:
        </p>
      </div>

      <ol class="pasos-lista" data-progreso-scroll>
        {
          PASOS.map((p, i) => (
            <li class="paso">
              <span class="paso-numero" aria-hidden="true">
                <span class="paso-numero-luz" />
                <span class="paso-numero-cifra">{i + 1}</span>
              </span>
              <span class="paso-cuerpo">
                <strong>{p.titulo}</strong>
                <span class="tenue">{p.texto}</span>
                <span class="paso-dato">{p.dato}</span>
              </span>
            </li>
          ))
        }
      </ol>

      {
        prueba && (
          <a class="boton boton-primario" href={prueba} target="_blank" rel="noopener noreferrer" data-animar="subir">
            <Icono nombre="chat" /> Empezar por WhatsApp
          </a>
        )
      }
    </div>

    <div class="pasos-chat" data-animar="subir">
      <ChatSimulado mensajes={CHAT} etiqueta="Conversación de ejemplo: una doctora pide la prueba por WhatsApp y recibe el instalador." />
    </div>
  </div>
</section>

<style>
  /*
   * Línea de tiempo. El motor pone en la lista --p (0 cuando asoma por abajo, 1 cuando sale por arriba).
   *   --linea  0.10–0.65 de --p → la línea crece de arriba abajo (scaleY)
   *   paso k   se enciende cuando la línea llega a su altura (k / 3)
   * Solo con .movimiento: con movimiento reducido el motor también da --p, pero aquí todo queda encendido.
   */
  .pasos {
    overflow-x: clip;
  }

  .pasos-luz {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(45% 40% at 85% 55%, rgb(1 120 176 / 0.18), transparent 70%);
    pointer-events: none;
  }

  .pasos-rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(48px, 7vw, 88px);
    align-items: center;
  }

  @media (min-width: 960px) {
    .pasos-rejilla {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }

  .pasos-lista {
    --linea: 1;
    position: relative;
    display: grid;
    gap: clamp(26px, 3.5vw, 36px);
    margin: clamp(32px, 4vw, 44px) 0 clamp(32px, 4vw, 44px);
    padding: 0;
    list-style: none;
  }

  :global(.movimiento) .pasos-lista {
    --linea: clamp(0, (var(--p, 1) - 0.1) / 0.55, 1);
  }

  /* El riel (::before, tenue) y el trazo azul que se dibuja (::after). Van del centro del primer número al del
     último; son seudoelementos para no sumar renglones a la lista. */
  .pasos-lista::before,
  .pasos-lista::after {
    content: '';
    position: absolute;
    left: 23px;
    top: 24px;
    bottom: 24px;
    width: 2px;
    border-radius: 2px;
  }

  .pasos-lista::before {
    background: rgb(255 255 255 / 0.08);
  }

  .pasos-lista::after {
    background: linear-gradient(var(--azul-vivo), var(--azul) 85%, rgb(46 159 224 / 0.4));
    box-shadow: 0 0 12px rgb(46 159 224 / 0.55);
    transform-origin: 50% 0;
    transform: scaleY(var(--linea));
  }

  /* Pasos: --k = 0…3 */
  .paso:nth-child(1) { --k: 0; }
  .paso:nth-child(2) { --k: 1; }
  .paso:nth-child(3) { --k: 2; }
  .paso:nth-child(4) { --k: 3; }

  .paso {
    --on: clamp(0, (var(--linea) * 3 - var(--k) + 0.2) * 5, 1);
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    align-items: start;
  }

  .paso-numero {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 50%;
    background: var(--medianoche);
  }

  /* El encendido: un disco azul con halo que crece sobre el número (transform + opacity). */
  .paso-numero-luz {
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 35%, #3aa8e8, var(--azul) 75%);
    box-shadow:
      0 0 0 5px rgb(46 159 224 / 0.14),
      0 0 24px rgb(46 159 224 / 0.6);
    opacity: var(--on);
    transform: scale(calc(0.6 + var(--on) * 0.4));
  }

  .paso-numero-cifra {
    position: relative;
    color: #fff;
    font-family: var(--fuente-titulo);
    font-size: 1.1875rem;
    font-weight: 600;
    opacity: calc(0.55 + var(--on) * 0.45);
  }

  .paso-cuerpo {
    display: grid;
    gap: 5px;
    padding-top: 9px;
    opacity: calc(0.4 + var(--on) * 0.6);
    transform: translate3d(calc((1 - var(--on)) * 10px), 0, 0);
  }

  .paso-cuerpo strong {
    font-family: var(--fuente-titulo);
    font-size: clamp(1.1875rem, 1.1rem + 0.35vw, 1.375rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .paso-cuerpo .tenue {
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .paso-dato {
    margin-top: 4px;
    color: var(--azul-vivo);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }

  .pasos-chat {
    position: relative;
  }

  /* Halo detrás del teléfono */
  .pasos-chat::before {
    content: '';
    position: absolute;
    inset: 12% 6%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(46 159 224 / 0.22), transparent);
    filter: blur(10px);
    pointer-events: none;
  }

  @media (max-width: 959px) {
    .pasos-texto .boton {
      width: 100%;
    }
  }

  @media (min-width: 480px) and (max-width: 959px) {
    .pasos-texto .boton {
      width: auto;
    }
  }
</style>
