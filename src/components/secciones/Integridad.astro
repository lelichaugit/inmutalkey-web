---
// "Así protege InmutalKey cada nota que firmas": la escena central del sitio, fijada estilo Apple con el motor de
// scroll (data-escena + --p). La ilustración vive en EscenaIntegridad.astro; aquí, el escenario, el visor y el texto
// real de cada paso (contenido accesible: sin JS o con movimiento reducido se ve como lista + estado final).
//
// Marcas de la escena (data-paso 0–5) → paso del relato:
//   0 escribir · 1 semáforo · 2 firmar · 3 sellada (la huella se decodifica) · 4 alteración · 5 addendum
// Celular: el visor arriba y el paso en curso abajo, dentro del mismo marco, sin tapar la nota; queda libre la franja
// del botón flotante de WhatsApp. Escritorio e iPad horizontal: el texto a la izquierda y el visor a la derecha.
import Icono from '../Icono.astro';
import EscenaIntegridad from './EscenaIntegridad.astro';

// "NOM‑004" lleva guion que no se parte (U+2011): en celular no queda "NOM-" al final de una línea.
const PASOS = [
  {
    corto: 'Escribir',
    titulo: 'Escribes tu nota como siempre.',
    texto: 'Motivo, signos vitales, exploración, diagnóstico y plan. Mientras escribes, el borrador se guarda solo cada 3 segundos.',
  },
  {
    corto: 'Revisar',
    titulo: 'Un semáforo la revisa.',
    texto: 'Antes de firmar, comprueba 7 requisitos de la NOM‑004. Si falta algo, te dice qué; en verde, está lista.',
  },
  {
    corto: 'Firmar',
    titulo: 'Al firmar, la llave la sella.',
    texto:
      'InmutalKey le saca una huella única, la encadena con la nota anterior y la firma con una llave que solo vive en tu computadora. Ya no se puede modificar ni borrar.',
  },
  {
    corto: 'Alterar',
    titulo: 'Si alguien la altera, se nota.',
    texto:
      'Si alguien cambiara el archivo de la base por fuera del programa, la huella ya no coincidiría y la auditoría de integridad lo señalaría.',
  },
  {
    corto: 'Corregir',
    titulo: '¿Error? Agrega un addendum.',
    texto:
      'Se suma con su motivo (corrección de captura, aclaración, resultado tardío…), fecha, hora y firma, enlazado a la huella de la nota. La original queda intacta.',
  },
] as const;

const ESTADOS = ['Borrador', 'Revisión NOM-004', 'Firmando', 'Sellada', 'Alteración detectada', 'Addendum sellado'] as const;
---

<section class="seccion fondo-negro integridad" id="integridad" aria-labelledby="integridad-titulo">
  <div class="contenedor">
    <div class="entrada">
      <h2 id="integridad-titulo" data-animar="titulo">Así protege InmutalKey cada nota que firmas</h2>
      <p class="texto-grande tenue" data-animar="subir" data-retraso="3">
        Sin tecnicismos: escribes, firmas y la nota queda sellada. Esto es lo que pasa por dentro.
      </p>
    </div>
  </div>

  <div class="historia" data-escena data-escena-marcas="0.18 0.38 0.55 0.62 0.8" data-historia>
    <div class="escenario" data-escenario>
      <div class="contenedor rejilla">
        <div class="visor-marco" aria-hidden="true">
          <span class="esquina esquina-ai"></span>
          <span class="esquina esquina-ad"></span>
          <span class="esquina esquina-bi"></span>
          <span class="esquina esquina-bd"></span>
          <div class="hud hud-arriba">
            <span class="hud-estados">
              {
                ESTADOS.map((e, i) => (
                  <span class:list={['estado', `estado-${i}`]}>
                    <i />
                    {e}
                  </span>
                ))
              }
            </span>
            <span class="hud-exp">Exp. 0042<span class="hud-exp-nota"> · Nota 12</span></span>
          </div>
          <div class="hud hud-abajo">
            <span>SHA-256 · encadenado por paciente</span>
            <span class="hud-bloqueo">Ed25519 · UPDATE ✕ · DELETE ✕</span>
          </div>
        </div>

        <div class="visor-area" aria-hidden="true">
          <EscenaIntegridad />
        </div>

        <div class="relato">
          <div class="progreso" aria-hidden="true">
            {
              PASOS.map((p) => (
                <span class="segmento">
                  <i />
                  <b>{p.corto}</b>
                </span>
              ))
            }
          </div>
          <ol class="pasos">
            {
              PASOS.map((p, i) => (
                <li class="paso">
                  <span class="paso-num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3>{p.titulo}</h3>
                  <p>{p.texto}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>

  <div class="contenedor">
    <details class="tecnico" data-animar="subir">
      <summary>
        <Icono nombre="computadora" />
        Detalles técnicos para tu área de sistemas
      </summary>
      <ul>
        <li>Huella SHA-256 sobre un JSON canónico <code>{'{v, hashPrevio, datos}'}</code>: cada nota incluye la huella de la anterior del mismo paciente.</li>
        <li>Firma Ed25519 de cada huella; la llave privada vive en el llavero del sistema operativo, no en la base de datos.</li>
        <li>Triggers y un autorizador de SQLite niegan UPDATE y DELETE en notas, addendums, antecedentes y bitácora.</li>
        <li>Los addendums se enlazan a la huella de la nota que corrigen. La bitácora de accesos también es una cadena.</li>
        <li>Base cifrada con SQLCipher; la clave se deriva de tu contraseña con Argon2id.</li>
      </ul>
    </details>
  </div>
</section>

<style>
  /* ───────── Base (sin JS o con movimiento reducido): los 5 pasos como lista y el visor en su estado final ───────── */

  .historia {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .rejilla {
    display: grid;
    grid-template-areas: 'relato' 'visor';
    gap: 32px;
  }

  .visor-marco,
  .visor-area {
    grid-area: visor;
  }

  /* El marco no tiene contenido en flujo: siempre estira la celda del visor. */
  .visor-marco {
    align-self: stretch;
  }

  .relato {
    grid-area: relato;
  }

  @media (min-width: 960px) {
    .rejilla {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      grid-template-areas: 'relato visor';
      align-items: center;
      gap: clamp(40px, 5vw, 72px);
    }
  }

  /* El visor: marco de instrumento con cuadrícula, esquinas de mira y una luz azul. */
  .visor-marco {
    position: relative;
    border: 1px solid var(--linea-oscura-fuerte);
    border-radius: 24px;
    background:
      radial-gradient(70% 50% at 78% 14%, rgb(46 159 224 / 0.16), transparent 70%),
      radial-gradient(55% 45% at 12% 100%, rgb(1 120 176 / 0.12), transparent 70%),
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 28px 28px,
      #050a14;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 40px 80px -48px rgb(1 120 176 / 0.5);
  }

  .esquina {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 0 solid rgb(46 159 224 / 0.75);
  }

  .esquina-ai { top: 10px; left: 10px; border-top-width: 1.5px; border-left-width: 1.5px; border-top-left-radius: 6px; }
  .esquina-ad { top: 10px; right: 10px; border-top-width: 1.5px; border-right-width: 1.5px; border-top-right-radius: 6px; }
  .esquina-bi { bottom: 10px; left: 10px; border-bottom-width: 1.5px; border-left-width: 1.5px; border-bottom-left-radius: 6px; }
  .esquina-bd { bottom: 10px; right: 10px; border-bottom-width: 1.5px; border-right-width: 1.5px; border-bottom-right-radius: 6px; }

  .hud {
    position: absolute;
    left: 34px;
    right: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    line-height: 1.3;
    color: var(--texto-tenue);
    white-space: nowrap;
  }

  .hud-arriba {
    top: 12px;
  }

  .hud-abajo {
    bottom: 12px;
    opacity: 0.75;
  }

  /* En pantallas angostas no cabe junto: se omite (es decorativo). */
  @media (max-width: 599px) {
    .hud-abajo {
      display: none;
    }
  }

  /* El expediente cede su lugar a la llave mientras baja, sella y se retira (marcas 2 y 3). */
  .hud-exp {
    transition: opacity 0.35s var(--ease);
  }

  .historia[data-paso='2'] .hud-exp,
  .historia[data-paso='3'] .hud-exp {
    opacity: 0;
  }

  @media (max-width: 419px) {
    .hud-exp-nota {
      display: none;
    }
  }

  .hud-estados {
    display: inline-grid;
    justify-items: start;
  }

  .estado {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: var(--azul-vivo);
    background: rgb(5 10 20 / 0.7);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }

  .estado i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
  }

  .estado-3,
  .estado-5 {
    color: var(--esmeralda-vivo);
  }

  .estado-4 {
    color: var(--error);
  }

  /* Sin escena (sin JS o movimiento reducido) el visor muestra el estado final. */
  :global(html:not(.movimiento)) .estado-5,
  :global(.movimiento) .historia:not([data-paso]) .estado-0,
  .historia[data-paso='0'] .estado-0,
  .historia[data-paso='1'] .estado-1,
  .historia[data-paso='2'] .estado-2,
  .historia[data-paso='3'] .estado-3,
  .historia[data-paso='4'] .estado-4,
  .historia[data-paso='5'] .estado-5 {
    opacity: 1;
  }

  .hud-bloqueo {
    color: var(--esmeralda-vivo);
    opacity: clamp(0, (var(--p, 1) - 0.54) / 0.03, 1);
  }

  /* El área de la maqueta: su tamaño decide la escala de toda la ilustración (container queries). */
  .visor-area {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 0.92;
    min-width: 0;
    padding: 46px 12px 40px;
    container-type: size;
    /* La llave entra desde fuera del visor: se recorta en su borde. */
    overflow: hidden;
    overflow: clip;
  }

  /* ── El relato: los 5 pasos ── */
  .progreso {
    display: none;
  }

  .pasos {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paso {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    column-gap: 16px;
    align-items: start;
  }

  .paso-num {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(46 159 224 / 0.45);
    border-radius: 50%;
    color: var(--azul-vivo);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .paso h3 {
    padding-top: 8px;
    font-size: var(--h3);
  }

  .paso p {
    margin-top: 6px;
    color: var(--texto-tenue);
  }

  /* ───────── Con movimiento: escena fijada ───────── */

  :global(.movimiento) .historia {
    --largo: 3;
    --reserva: calc(78px + env(safe-area-inset-bottom, 0px));
    margin-top: clamp(16px, 4vw, 40px);
  }

  /* El visor estira su celda: con `container-type: size` no tiene alto propio. */
  :global(.movimiento) .rejilla {
    height: 100%;
    align-items: stretch;
    grid-template-areas: none;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto var(--reserva);
    gap: 0;
    padding-top: calc(var(--altura-nav) - 6px);
  }

  :global(.movimiento) .visor-marco {
    grid-area: 1 / 1 / 3 / 2;
    border-radius: 22px;
  }

  :global(.movimiento) .visor-area {
    grid-area: 1 / 1 / 2 / 2;
    aspect-ratio: auto;
    min-height: 0;
    padding: 40px 8px 4px;
  }

  :global(.movimiento) .hud-abajo {
    display: none;
  }

  :global(.movimiento) .relato {
    grid-area: 2 / 1 / 3 / 2;
    z-index: 1;
    padding: 12px 20px 22px;
    border-top: 1px solid var(--linea-oscura);
  }

  /* Progreso: un segmento por paso, lleno según --p. */
  :global(.movimiento) .progreso {
    display: flex;
    gap: 6px;
  }

  .segmento {
    --t: clamp(0, (var(--p, 1) - var(--a)) / (var(--b) - var(--a)), 1);
    position: relative;
    flex: 1;
    display: grid;
    gap: 8px;
  }

  .segmento:nth-child(1) { --a: 0; --b: 0.18; }
  .segmento:nth-child(2) { --a: 0.18; --b: 0.38; }
  .segmento:nth-child(3) { --a: 0.38; --b: 0.62; }
  .segmento:nth-child(4) { --a: 0.62; --b: 0.8; }
  .segmento:nth-child(5) { --a: 0.8; --b: 1; }

  .segmento::before,
  .segmento i {
    grid-area: 1 / 1;
    height: 2px;
    border-radius: 2px;
  }

  .segmento::before {
    content: '';
    background: var(--linea-oscura-fuerte);
  }

  .segmento i {
    background: var(--azul-vivo);
    box-shadow: 0 0 8px rgb(46 159 224 / 0.6);
    transform-origin: 0 50%;
    transform: scaleX(var(--t));
  }

  .segmento b {
    display: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--texto-tenue);
    opacity: calc(0.45 + min(var(--t) * 20, 1) * 0.55);
  }

  /* Los 5 textos ocupan la misma celda (el alto no salta) y solo se ve el del paso en curso. */
  :global(.movimiento) .pasos {
    gap: 0;
    margin-top: 10px;
  }

  :global(.movimiento) .paso {
    grid-area: 1 / 1;
    display: block;
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    transition:
      opacity 0.35s var(--ease),
      transform 0.6s var(--ease);
  }

  :global(.movimiento) .historia:not([data-paso]) .paso:nth-child(1),
  :global(.movimiento) .historia[data-paso='0'] .paso:nth-child(1),
  :global(.movimiento) .historia[data-paso='1'] .paso:nth-child(2),
  :global(.movimiento) .historia[data-paso='2'] .paso:nth-child(3),
  :global(.movimiento) .historia[data-paso='3'] .paso:nth-child(3),
  :global(.movimiento) .historia[data-paso='4'] .paso:nth-child(4),
  :global(.movimiento) .historia[data-paso='5'] .paso:nth-child(5) {
    opacity: 1;
    transform: none;
    transition-delay: 0.15s;
  }

  :global(.movimiento) .paso-num {
    display: block;
    width: auto;
    height: auto;
    border: 0;
    font-size: 0.75rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
  }

  :global(.movimiento) .paso h3 {
    padding-top: 2px;
    font-size: 1.25rem;
  }

  :global(.movimiento) .paso p {
    margin-top: 4px;
    font-size: 1rem;
    line-height: 1.5;
  }

  @media (min-width: 600px) {
    :global(.movimiento) .relato {
      padding: 16px 28px 22px;
    }

    :global(.movimiento) .paso h3 {
      font-size: 1.5rem;
    }

    :global(.movimiento) .paso p {
      font-size: 1.0625rem;
    }

    :global(.movimiento) .segmento b {
      display: block;
    }
  }

  /* Escritorio, iPad horizontal y celulares acostados: texto a la izquierda, visor a la derecha. */
  @media (min-width: 1024px), (orientation: landscape) and (min-width: 600px) and (max-height: 560px) {
    :global(.movimiento) .historia {
      --largo: 4;
    }

    :global(.movimiento) .rejilla {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      grid-template-rows: minmax(0, 1fr);
      column-gap: clamp(28px, 4vw, 64px);
      padding-block: calc(var(--altura-nav) + 12px) 24px;
    }

    :global(.movimiento) .visor-marco,
    :global(.movimiento) .visor-area {
      grid-area: 1 / 2 / 2 / 3;
    }

    :global(.movimiento) .visor-area {
      padding: 48px 20px 40px;
    }

    :global(.movimiento) .hud-abajo {
      display: flex;
    }

    :global(.movimiento) .relato {
      grid-area: 1 / 1 / 2 / 2;
      align-self: center;
      padding: 0;
      border: 0;
    }

    :global(.movimiento) .pasos {
      margin-top: clamp(20px, 3vh, 36px);
    }

    :global(.movimiento) .paso-num {
      font-size: 0.8125rem;
    }

    :global(.movimiento) .paso h3 {
      margin-top: 8px;
      font-size: clamp(1.75rem, 1rem + 1.5vw, 2.5rem);
      line-height: 1.12;
    }

    :global(.movimiento) .paso p {
      margin-top: 14px;
      max-width: 30rem;
      font-size: 1.125rem;
      line-height: 1.6;
    }
  }

  /* iPad horizontal y laptops angostas: el botón flotante de WhatsApp sigue visible; el visor termina antes. */
  @media (min-width: 1024px) and (max-width: 1079px) {
    :global(.movimiento) .rejilla {
      padding-bottom: calc(84px + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (orientation: landscape) and (max-height: 560px) {
    :global(.movimiento) .rejilla {
      padding-block: 64px 12px;
    }

    :global(.movimiento) .paso h3 {
      font-size: 1.25rem;
    }

    :global(.movimiento) .paso p {
      font-size: 1rem;
    }
  }

  /* ── Detalles técnicos ── */
  .tecnico {
    margin-top: clamp(40px, 6vw, 72px);
    border: 1px solid var(--linea-oscura);
    border-radius: var(--radio);
    background: rgb(255 255 255 / 0.02);
  }

  .tecnico summary {
    display: flex;
    align-items: center;
    gap: 0.6em;
    min-height: 56px;
    padding: 0 20px;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }

  .tecnico summary::-webkit-details-marker {
    display: none;
  }

  .tecnico summary :global(.icono) {
    width: 1.3em;
    height: 1.3em;
    color: var(--azul-vivo);
  }

  .tecnico summary::after {
    content: '+';
    margin-left: auto;
    font-size: 1.4rem;
    color: var(--texto-tenue);
  }

  .tecnico[open] summary::after {
    content: '−';
  }

  .tecnico ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0 24px 24px 44px;
    color: var(--texto-tenue);
    font-size: 1rem;
  }

  .tecnico code {
    font-family: inherit;
    color: var(--texto);
  }
</style>
