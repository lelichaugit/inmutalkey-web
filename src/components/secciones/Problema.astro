---
// El problema: un documento editable frente a una nota sellada. Escena fijada corta (motor de scroll, --p): el .docx
// se modifica solo ante tus ojos —se selecciona, se tacha y se reescribe el tratamiento, "Modificado hoy 23:41 · sin
// aviso"— mientras la nota sellada rechaza el mismo intento (rebota y muestra el candado). Cierre: en la editable,
// "¿Quién lo cambió? No hay forma de saberlo" en rojo; en la sellada, "Coincide" late en verde. Sin JS o con movimiento
// reducido, var(--p, 1) deja ambos documentos en su estado final y la escena no se fija.
//
// Tramos de --p:  selección 0.05–0.12 · tachado 0.12–0.18 · escritura 0.18–0.30 · "Modificado" 0.30–0.34
//                 intento sobre la sellada 0.36–0.46 · marca 0.5 (.alcanzo-1): rechazo, rebote y candado
//                 cierre: duda en rojo 0.54–0.64 · "Coincide" 0.64–0.72 + marca 0.68 (.alcanzo-2): late
// Rendimiento: el motor escribe --p solo en los [data-p] (cuadrícula, tratamiento, pies, intento); cada uno declara sus
// tramos. Los documentos entran con data-animar (por tiempo), no con --e: así su subárbol no se recalcula cada cuadro.
// Lámina: cuando sigue directo al hero, la sección sube sobre su final (ver Hero.astro).
// Datos de ejemplo: los mismos del simulador (María Fernanda López, EXP-2026-000128, nota n.º 12, huella 9f2c41e8…b07a).
// Lo visual es decorativo (aria-hidden); el mensaje vive en el titular, el párrafo que se ilumina y la lista.
import Icono from '../Icono.astro';

const PROBLEMAS = [
  {
    icono: 'editar',
    titulo: 'Corregir a mano deja tachaduras.',
    texto: 'Un tachón o una capa de corrector dejan la nota en duda, y lo que decía antes ya no se puede leer.',
  },
  {
    icono: 'nota',
    titulo: 'El papel se pierde, se moja y no aparece.',
    texto: 'Buscar el expediente correcto quita tiempo de consulta. La letra a mano, además, no siempre se entiende.',
  },
  {
    icono: 'nube',
    titulo: 'Los sistemas en la nube dependen de internet.',
    texto: 'Si se cae la conexión, no consultas. Y tus expedientes viven en servidores que no controlas.',
  },
] as const;
---

<section class="seccion fondo-claro problema" aria-labelledby="problema-titulo">
  <div class="contenedor">
    <div class="entrada">
      <h2 id="problema-titulo" data-animar="titulo">Tus expedientes merecen algo más firme que un documento editable</h2>
      <p class="texto-grande tenue" data-animar="subir" data-retraso="3">
        Un archivo de Word se puede abrir y cambiar a cualquier hora, sin dejar rastro. Mira la diferencia.
      </p>
    </div>
  </div>

  <div class="duelo" data-escena data-escena-marcas="0.5 0.68">
    <div class="duelo-escenario" data-escenario>
      <span class="duelo-cuadricula" data-p aria-hidden="true"></span>
      <div class="contenedor duelo-rejilla" aria-hidden="true">
        <p class="duelo-rotulo">Mismo intento, dos resultados</p>

        <figure class="lado lado-editable" data-animar="aparecer">
          <figcaption class="lado-titulo"><Icono nombre="editar" /> Archivo editable</figcaption>
          <div class="doc doc-editable">
            <div class="doc-barra">
              <span class="doc-puntos"><i></i><i></i><i></i></span>
              <span class="doc-archivo">nota_paciente_final_v3.docx</span>
            </div>
            <div class="doc-cuerpo">
              <p class="doc-linea"><span class="doc-campo">Paciente</span>María Fernanda López</p>
              <p class="doc-linea"><span class="doc-campo">Dx</span>J02.9 Faringitis aguda</p>
              <p class="doc-linea">
                <span class="doc-campo">Tx</span>
                <span class="tx" data-p>
                  <span class="tx-viejo">
                    <span class="tx-seleccion"></span>
                    <span class="tx-texto">Paracetamol 500 mg</span>
                    <span class="tx-tacha"></span>
                  </span>
                  <span class="tx-nuevo">
                    <span class="tx-nuevo-texto">Ibuprofeno 400 mg</span>
                    <span class="tx-cursor"></span>
                  </span>
                </span>
              </p>
            </div>
            <p class="doc-pie doc-pie-editable" data-p>
              <span class="pie-antes">Guardado hoy 10:14</span>
              <span class="pie-despues"><Icono nombre="alerta" /> Modificado hoy 23:41 · sin aviso</span>
            </p>
            <p class="doc-duda" data-p>¿Quién lo cambió? No hay forma de saberlo.</p>
          </div>
          <p class="lado-nota">Cualquiera que lo abra puede cambiarlo.</p>
        </figure>

        <figure class="lado lado-sellado" data-animar="aparecer" data-retraso="1">
          <figcaption class="lado-titulo"><Icono nombre="sello" /> Nota sellada en InmutalKey</figcaption>
          <div class="doc doc-sellada">
            <div class="sellada-cabecera">
              <strong>Nota de evolución n.º 12</strong>
              <span class="sellada-chip"><Icono nombre="candado" /> Sellada 10:14</span>
            </div>
            <div class="doc-cuerpo">
              <p class="doc-linea"><span class="doc-campo">Paciente</span>María Fernanda López</p>
              <p class="doc-linea"><span class="doc-campo">Exp.</span>EXP-2026-000128</p>
              <p class="doc-linea"><span class="doc-campo">Dx</span>J02.9 Faringitis aguda</p>
              <p class="doc-linea">
                <span class="doc-campo">Tx</span>
                <span class="intento" data-p>
                  <span class="intento-seleccion"></span>
                  <span class="intento-texto">Paracetamol 500 mg</span>
                  <span class="intento-cursor"></span>
                </span>
              </p>
              <p class="doc-linea rechazo-linea">
                <span class="rechazo"><Icono nombre="candado" /> Firmada: no se puede modificar</span>
              </p>
            </div>
            <p class="doc-pie doc-pie-sello">
              <span class="pie-hash"><b>Huella</b> 9f2c41e8…b07a</span>
              <span class="pie-coincide" data-p><Icono nombre="check" /> Coincide</span>
            </p>
          </div>
          <p class="lado-nota">Firmada, ya no se puede modificar.</p>
        </figure>
      </div>
    </div>
  </div>

  <div class="contenedor">
    <p class="problema-luz" data-texto-luz>
      La <span class="sin-corte">NOM-004</span> pide notas sin enmendaduras ni tachaduras. Con un archivo editable,
      cumplirlo depende de la buena fe. Con una nota sellada, no hay forma de cambiarla sin que se note.
    </p>

    <ul class="problemas" data-escalonar>
      {
        PROBLEMAS.map((p) => (
          <li data-animar="subir">
            <span class="problema-icono">
              <Icono nombre={p.icono} />
            </span>
            <h3>{p.titulo}</h3>
            <p class="tenue">{p.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .problema {
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --ambar: #b45309;
    --rojo: #c0262d;
  }

  /* ── Lámina: cuando sigue directo al hero (en producción Reseñas no renderiza nada), la sección es una hoja clara
     con las esquinas superiores redondas que sube sobre el final del hero (patrón apple.com/iphone). Con la escena del
     hero, además se encima a sus últimos 22svh: la llave termina de irse debajo de ella y nunca queda un cuadro vacío.
     Sin escena (sin JS o movimiento reducido) no se encima: el hero no se fija y taparía su frase.
     Entre los dos puede quedar el <script> del hero (Astro lo deja junto a su componente). ── */
  :global(#inicio) + .problema,
  :global(#inicio) + :global(script) + .problema {
    z-index: 2;
    /* Menos aire arriba: el titular asoma en cuanto la lámina sube. */
    padding-top: clamp(56px, 4vw + 32px, 96px);
    border-radius: 28px 28px 0 0;
    box-shadow:
      0 -1px 0 rgb(255 255 255 / 0.55),
      0 -22px 48px -18px rgb(0 0 0 / 0.75);
  }

  :global(.movimiento) :global(#inicio) + .problema,
  :global(.movimiento) :global(#inicio) + :global(script) + .problema {
    margin-top: -22vh;
    margin-top: -22svh;
  }

  /* ── El duelo: estado final por omisión (var(--p, 1)); con movimiento, escena fijada corta ── */
  .duelo {
    margin-top: clamp(40px, 6vw, 64px);
  }

  :global(.movimiento) .duelo {
    --largo: 1.8;
    margin-top: 0;
  }

  @media (min-width: 860px) {
    :global(.movimiento) .duelo {
      --largo: 2.1;
    }
  }

  /* Fija: centrada entre la barra de navegación y la franja del botón flotante de WhatsApp (celular y tableta). */
  :global(.movimiento) .duelo-escenario {
    display: grid;
    align-content: center;
    padding-top: var(--altura-nav);
    padding-bottom: calc(76px + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 1080px) {
    :global(.movimiento) .duelo-escenario {
      padding-bottom: 16px;
    }
  }

  .duelo-escenario {
    position: relative;
    isolation: isolate;
  }

  /* Cuadrícula de instrumento detrás de los documentos; se desliza más lento que ellos (profundidad). */
  .duelo-cuadricula {
    position: absolute;
    inset: -60px 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--linea-clara) 1px, transparent 1px),
      linear-gradient(90deg, var(--linea-clara) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center;
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 15%, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 15%, transparent 75%);
    opacity: 0.7;
    transform: translate3d(0, calc((0.5 - var(--p, 0.5)) * 48px), 0);
    pointer-events: none;
  }

  /* Rótulo sobre los dos documentos (en celular ocupa el hueco bajo la barra). */
  .duelo-rotulo {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 2px;
    color: var(--tinta-tenue);
    font-family: var(--fuente-titulo);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }

  .duelo-rotulo::before,
  .duelo-rotulo::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(13 27 53 / 0.2));
  }

  .duelo-rotulo::after {
    background: linear-gradient(90deg, rgb(13 27 53 / 0.2), transparent);
  }

  @media (min-width: 860px) {
    .duelo-rotulo {
      margin-bottom: 6px;
      font-size: 1.1875rem;
    }
  }

  .duelo-rejilla {
    display: grid;
    gap: 20px;
    max-width: 1160px;
  }

  /* Tableta vertical: apilados, a un ancho cómodo de leer. */
  @media (min-width: 600px) and (max-width: 859px) {
    .duelo-rejilla {
      max-width: 560px;
    }

    .doc {
      font-size: 1.0625rem;
    }
  }

  /* Escritorio: lado a lado, del mismo alto, con una línea fina entre los dos. */
  @media (min-width: 860px) {
    .duelo-rejilla {
      position: relative;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px clamp(40px, 5vw, 72px);
    }

    .duelo-rejilla::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 18%;
      bottom: 8%;
      width: 1px;
      background: linear-gradient(transparent, rgb(13 27 53 / 0.18), transparent);
    }
  }

  /* Celular y tableta bajos (la escena fija): el rótulo solo va donde sobra alto; en los más bajos (Safari con sus
     barras, 390 × 664) los documentos se compactan para caber entre la barra y la franja del botón flotante. */
  @media (max-width: 859px) and (max-height: 760px) {
    :global(.movimiento) .duelo-rotulo {
      display: none;
    }
  }

  @media (max-width: 859px) and (max-height: 700px) {
    :global(.movimiento) .duelo-rejilla {
      gap: 10px;
    }

    :global(.movimiento) .duelo .lado-titulo {
      margin-bottom: 5px;
    }

    :global(.movimiento) .duelo .doc {
      line-height: 1.4;
    }

    :global(.movimiento) .duelo .doc-cuerpo {
      gap: 2px;
      padding: 8px 14px 6px;
    }

    :global(.movimiento) .duelo .doc-barra,
    :global(.movimiento) .duelo .sellada-cabecera,
    :global(.movimiento) .duelo .doc-pie {
      padding-block: 6px;
    }

    :global(.movimiento) .duelo .doc-duda {
      padding-block: 5px 6px;
    }
  }

  /* Celular acostado: no caben apilados en el alto de la pantalla; lado a lado y más compactos. */
  @media (orientation: landscape) and (max-height: 560px) and (min-width: 600px) and (max-width: 859px) {
    .duelo-rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      max-width: none;
    }

    .doc {
      font-size: 0.875rem;
    }

    .lado-titulo {
      margin-bottom: 6px;
      font-size: 0.875rem;
    }

    :global(.movimiento) .duelo-escenario {
      padding-top: 60px;
      padding-bottom: 64px;
    }
  }

  .lado {
    display: grid;
    grid-template-rows: auto 1fr auto;
    margin: 0;
    min-width: 0;
  }

  /* Entrada desde lados opuestos al asomar (data-animar="aparecer", por tiempo): llegan girados en perspectiva y se
     aplanan. Antes iba ligada a --e, pero eso obligaba a recalcular todo el documento en cada cuadro. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .lado-editable:not(.es-visible) {
      transform: perspective(1400px) translate3d(-56px, 0, 0) rotateY(16deg);
    }

    :global(.js) .lado-sellado:not(.es-visible) {
      transform: perspective(1400px) translate3d(56px, 0, 0) rotateY(-16deg);
    }

  }

  .lado-titulo {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-bottom: 10px;
    color: var(--tinta-tenue);
    font-size: 1rem;
    font-weight: 600;
  }

  .lado-titulo :global(.icono) {
    width: 1.15em;
    height: 1.15em;
  }

  .lado-sellado .lado-titulo {
    color: var(--esmeralda);
  }

  .lado-nota {
    display: none;
    margin-top: 12px;
    color: var(--tinta-tenue);
    font-size: 1rem;
  }

  @media (min-width: 860px) {
    .lado-nota {
      display: block;
    }
  }

  /* ── Documentos ── */
  .doc {
    position: relative;
    border: 1px solid var(--linea-clara);
    border-radius: var(--radio);
    background: #fff;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.8) inset,
      0 24px 48px -28px rgb(13 27 53 / 0.45);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (min-width: 860px) {
    .doc {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 1280px) {
    .doc {
      font-size: 1.25rem;
    }

    .lado-titulo {
      font-size: 1.0625rem;
    }
  }

  .doc {
    display: flex;
    flex-direction: column;
  }

  .doc-cuerpo {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 12px 16px 10px;
  }

  @media (min-width: 860px) {
    .doc-cuerpo {
      padding: 16px 20px 14px;
    }
  }

  /* Etiqueta y valor en columnas: si el valor no cabe, se parte dentro de su columna. */
  .doc-linea {
    display: grid;
    grid-template-columns: 5.2em minmax(0, 1fr);
    align-items: baseline;
    margin: 0;
  }

  .doc-campo {
    color: var(--tinta-tenue);
    font-size: 0.85em;
    font-weight: 600;
  }

  .doc-pie {
    display: grid;
    margin: 0;
    padding: 9px 16px;
    border-top: 1px solid var(--linea-clara);
    font-size: 0.85em;
  }

  /* Editable: barra de ventana con el nombre del archivo. */
  .doc-barra {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--linea-clara);
    border-radius: var(--radio) var(--radio) 0 0;
    background: #f3f6fa;
  }

  .doc-puntos {
    display: inline-flex;
    gap: 5px;
  }

  .doc-puntos i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(13 27 53 / 0.16);
  }

  .doc-archivo {
    overflow: hidden;
    font-family: var(--mono);
    font-size: 0.8em;
    color: var(--tinta-tenue);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* La línea que se modifica: selección → tachado → reescritura (todo con transform, opacity y clip-path). */
  .tx {
    --t-sel: clamp(0, (var(--p, 1) - 0.05) / 0.07, 1);
    --t-tacha: clamp(0, (var(--p, 1) - 0.12) / 0.06, 1);
    --t-escribe: clamp(0, (var(--p, 1) - 0.18) / 0.12, 1);
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 0.5em;
  }

  .tx-viejo,
  .tx-nuevo,
  .intento {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  /* En la celda de la rejilla, del ancho de su texto (el cursor recorre ese ancho). */
  .tx,
  .intento {
    justify-self: start;
  }

  .tx-seleccion,
  .intento-seleccion {
    position: absolute;
    inset: 0.05em -0.15em;
    border-radius: 3px;
    background: rgb(1 120 176 / 0.22);
    transform-origin: 0 50%;
  }

  .tx-seleccion {
    transform: scaleX(var(--t-sel));
    opacity: calc(var(--t-sel) - var(--t-tacha));
  }

  .tx-texto {
    position: relative;
    opacity: calc(1 - var(--t-tacha) * 0.5);
  }

  .tx-tacha {
    position: absolute;
    left: -0.1em;
    right: -0.1em;
    top: 55%;
    height: 2px;
    border-radius: 1px;
    background: var(--tinta);
    transform-origin: 0 50%;
    transform: scaleX(var(--t-tacha));
  }

  .tx-nuevo-texto {
    display: block;
    color: var(--ambar);
    font-weight: 600;
    clip-path: inset(0 calc((1 - var(--t-escribe)) * 100%) 0 0);
  }

  /* Cursor de escritura: recorre el ancho del texto con transform y solo se ve a media escritura. */
  .tx-cursor,
  .intento-cursor {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .tx-cursor {
    transform: translate3d(calc(var(--t-escribe) * 100%), 0, 0);
    opacity: calc(min(var(--t-escribe), 1 - var(--t-escribe)) * 30);
  }

  .tx-cursor::before,
  .intento-cursor::before {
    content: '';
    position: absolute;
    left: 1px;
    top: 10%;
    bottom: 10%;
    width: 2px;
    border-radius: 1px;
    background: var(--tinta);
  }

  .doc-pie-editable {
    --t-pie: clamp(0, (var(--p, 1) - 0.3) / 0.04, 1);
  }

  .doc-pie > span {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .pie-antes {
    color: var(--tinta-tenue);
    opacity: calc(1 - var(--t-pie));
  }

  .pie-despues {
    color: var(--ambar);
    font-weight: 600;
    opacity: var(--t-pie);
    transform: translate3d(0, calc((1 - var(--t-pie)) * 6px), 0);
  }

  .doc-pie :global(.icono) {
    width: 1.15em;
    height: 1.15em;
  }

  /* Sellada: cabecera con el candado, huella y el rechazo del intento de edición. */
  .doc-sellada {
    border-color: rgb(10 139 105 / 0.35);
    box-shadow:
      0 0 0 4px rgb(10 139 105 / 0.07),
      0 24px 48px -28px rgb(13 27 53 / 0.45);
  }

  .sellada-cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
    padding: 9px 14px 9px 18px;
    border-bottom: 1px solid rgb(10 139 105 / 0.18);
    border-radius: var(--radio) var(--radio) 0 0;
    background: rgb(10 139 105 / 0.06);
  }

  .sellada-cabecera strong {
    font-family: var(--fuente-titulo);
    font-size: 0.95em;
    font-weight: 600;
  }

  .sellada-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.15em 0.65em;
    border-radius: 999px;
    background: var(--esmeralda);
    color: #fff;
    font-size: 0.8em;
    font-weight: 600;
    white-space: nowrap;
  }

  .sellada-chip :global(.icono) {
    width: 1.05em;
    height: 1.05em;
  }

  /* Pulso del sello cuando rechaza el intento. */
  .sellada-chip::after {
    content: '';
    position: absolute;
    inset: -2px;
    border: 2px solid var(--esmeralda);
    border-radius: inherit;
    opacity: 0;
  }

  .intento {
    --t-intento: clamp(0, (var(--p, 1) - 0.36) / 0.1, 1);
  }

  .intento-seleccion {
    transform: scaleX(var(--t-intento));
    opacity: var(--t-intento);
    transition: opacity 0.25s var(--ease);
  }

  .intento-cursor {
    transform: translate3d(100%, 0, 0);
    opacity: calc(var(--t-intento) * 4);
  }

  .doc-pie-sello {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
  }

  .doc-pie-sello > span {
