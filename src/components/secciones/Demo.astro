  }

  :global(.movimiento) .pantalla-reflejo,
  :global(.movimiento) .pantalla-escaner {
    position: absolute;
    left: 0;
    right: 0;
  }

  /* Reflejo del vidrio: una banda diagonal que cruza mientras la ventana se endereza. */
  :global(.movimiento) .pantalla-reflejo {
    top: -50%;
    height: 200%;
    background: linear-gradient(115deg, transparent 38%, rgb(255 255 255 / 0.1) 48%, rgb(255 255 255 / 0.02) 56%, transparent 64%);
    transform: translate3d(calc(-55% + var(--t) * 110%), 0, 0);
  }

  /* Escáner: recorre la pantalla de arriba abajo mientras se enciende. */
  :global(.movimiento) .pantalla-escaner {
    top: 0;
    height: 100%;
    transform: translate3d(0, calc(var(--luz) * 100%), 0);
  }

  :global(.movimiento) .pantalla-escaner::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--azul-vivo) 20%, #bfe6ff 50%, var(--azul-vivo) 80%, transparent);
    box-shadow: 0 0 18px 2px rgb(46 159 224 / 0.6);
    opacity: clamp(0, min(var(--luz), 1 - var(--luz)) * 8, 1);
  }

