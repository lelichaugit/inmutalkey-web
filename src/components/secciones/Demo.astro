  }

  /* Pantalla apagada + reflejo + escáner, encima de la ventana y sin atrapar clics. */
  .pantalla-luz {
    display: none;
  }

  :global(.movimiento) .pantalla-luz {
    position: absolute;
    inset: 34px 0 0;
    z-index: 40;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    pointer-events: none;
    background: #02060f;
