---
// Simulador de InmutalKey: réplica de la interfaz real (clinica-nom004: tema "Claro Estándar", barra superior compacta,
// lista de pacientes, agenda lateral, semáforo de 3 luces, toasts). Sin JS se ve la consulta terminada; con JS
// (src/scripts/demo.ts) se reproduce sola por capítulos y los campos de la nota responden a lo que escriba el médico.
import { enlaceWhatsApp } from '../../lib/whatsapp';
import { sitio } from '../../site.config';
import Icono from '../Icono.astro';
import Logo from '../Logo.astro';

const prueba = enlaceWhatsApp(sitio.contacto.whatsapp, sitio.contacto.mensajes.prueba);

const CAPITULOS = [
  { id: 'agenda', titulo: 'Tu día de un vistazo', sub: 'Agenda e inicio de consulta' },
  { id: 'consulta', titulo: 'Escribe con el semáforo', sub: 'Signos, IMC y CIE-10' },
  { id: 'firma', titulo: 'Firma y queda sellada', sub: 'La llave sella la nota' },
  { id: 'receta', titulo: 'Receta lista', sub: 'Carta o media carta' },
  { id: 'correccion', titulo: 'Corrige sin borrar', sub: 'Addendum con motivo' },
  { id: 'auditoria', titulo: 'Verifica tu archivo', sub: 'Auditoría de integridad' },
  { id: 'respaldo', titulo: 'Respalda con un clic', sub: 'Copia comprobada' },
] as const;

const PACIENTES = [
  { nombre: 'María Fernanda López', datos: 'F · 34 años', ultima: 'Hoy', activa: true },
  { nombre: 'José Luis Ramírez', datos: 'M · 58 años', ultima: 'Hoy', alergia: 'Penicilina' },
  { nombre: 'Ana Sofía Torres', datos: 'F · 7 años', ultima: 'Hace 12 días' },
  { nombre: 'Roberto Méndez', datos: 'M · 45 años', ultima: 'Hace 1 mes' },
  { nombre: 'Guadalupe Cruz', datos: 'F · 67 años', ultima: 'Hace 3 meses', alergia: 'Sulfas' },
] as const;

const CITAS = [
  { hora: '09:00', nombre: 'José Luis Ramírez', motivo: 'Control de hipertensión', estado: 'atendida' },
  { hora: '10:00', nombre: 'María Fernanda López', motivo: 'Dolor de garganta y fiebre', estado: 'actual' },
  { hora: '11:30', nombre: 'Carlos Pérez', motivo: 'Valoración general', estado: 'primera' },
  { hora: '12:30', nombre: 'Guadalupe Cruz', motivo: 'Revisión de laboratorios', estado: 'programada' },
  { hora: '13:15', nombre: 'Ana Sofía Torres', motivo: 'Control de niño sano', estado: 'programada' },
] as const;

const TEMAS = [
  { id: 'claro-estandar', etiqueta: 'Claro estándar' },
  { id: 'claro-medico', etiqueta: 'Claro clínico' },
  { id: 'lectura-calida', etiqueta: 'Lectura antifatiga' },
  { id: 'oscuro-azul', etiqueta: 'Oscuro pizarra' },
  { id: 'oscuro-titanio', etiqueta: 'Gris titanio' },
  { id: 'oscuro-neutro', etiqueta: 'Oscuro grafito' },
] as const;

const MOTIVOS_ADDENDUM = [
  'Corrección de error de captura',
  'Aclaración',
  'Información adicional',
  'Resultado tardío de estudio',
  'Cambio de diagnóstico',
] as const;
---

<section class="seccion fondo-navy fondo-cuadricula demo" id="demo" data-demo data-sin-flotante aria-labelledby="demo-titulo">
  <div class="contenedor demo-cabecera">
    <p class="demo-etiqueta" data-animar="aparecer"><span aria-hidden="true"></span>Simulador · datos de ejemplo</p>
    <h2 id="demo-titulo" data-animar="titulo">Pruébalo aquí mismo: una consulta completa en un minuto</h2>
    <p class="texto-grande tenue" data-animar="subir" data-retraso="2">
      Es una simulación con datos de ejemplo. Deja que corra sola o toca cualquier paso. En la consulta puedes escribir de
      verdad: el semáforo, el IMC y la búsqueda de diagnósticos responden como en el programa.
    </p>
  </div>

  <div class="contenedor demo-rejilla">
    <!-- En celular y tableta es una tira con scroll horizontal propio (Lenis deja pasar los gestos horizontales). -->
    <ol class="demo-capitulos" aria-label="Pasos de la simulación" data-capitulos data-lenis-prevent-horizontal data-escalonar>
      {
        CAPITULOS.map((c, i) => (
          <li data-animar="subir">
            <button type="button" class="capitulo" data-capitulo={c.id} aria-pressed={c.id === 'consulta' ? 'true' : 'false'}>
              <span class="capitulo-num" aria-hidden="true">{i + 1}</span>
              <span class="capitulo-texto">
                <strong>{c.titulo}</strong>
                <small>{c.sub}</small>
              </span>
              <span class="capitulo-avance" aria-hidden="true"><span></span></span>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="demo-escenario">
      <!-- Presentación del "dispositivo": al acercarse, la ventana pasa de inclinada y pequeña a plana y a tamaño
           completo, y su pantalla se enciende. Ligada al --p de este envoltorio (scroll.ts); el simulador no se fija
           porque es interactivo. Sin JS o con movimiento reducido se ve plano y encendido desde el principio.
           data-progreso-hasta: la presentación termina en --p 0.45 (--t y --luz ya valen 1); pasado ese punto no se
           escribe más. Destinos [data-p] (scroll.ts escribe --p solo en ellos): el halo y el dispositivo; dentro de
           .app la variable se corta (ver CSS), así que los ~360 elementos del simulador no se recalculan por cuadro. -->
      <div class="presentacion" data-progreso-scroll data-progreso-hasta="0.45">
        <span class="presentacion-halo" aria-hidden="true" data-p></span>
        <div class="dispositivo" data-p>
          <span class="visor" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <p class="hud" aria-hidden="true">
            <span class="hud-estado" data-hud-estado="ejemplo"><i></i><span data-hud-texto>Consulta de ejemplo</span></span>
            <span class="hud-paso" data-hud-paso>Paso 2 de 7</span>
          </p>
          <div class="app" data-app data-tema="claro-estandar" data-pantalla="consulta" role="region" aria-label="Simulación de InmutalKey con datos de ejemplo">
            <!-- Ventana de Windows (la app es para Windows): título a la izquierda, controles a la derecha. -->
            <div class="ventana-barra">
              <span class="ventana-titulo">InmutalKey · Datos de ejemplo</span>
              <span class="ventana-offline"><Icono nombre="sin-wifi" /><span>Sin internet<span class="ventana-offline-mas">: todo funciona</span></span></span>
              <span class="ventana-controles" aria-hidden="true">
                <svg viewBox="0 0 10 10"><path d="M1 5h8"></path></svg>
                <svg viewBox="0 0 10 10"><rect x="1.5" y="1.5" width="7" height="7" rx="1"></rect></svg>
                <svg viewBox="0 0 10 10"><path d="M1.5 1.5l7 7M8.5 1.5l-7 7"></path></svg>
              </span>
            </div>

            <header class="app-topbar">
              <span class="topbar-marca"><Logo titulo={null} class="topbar-logo" /><strong>InmutalKey</strong></span>
              <span class="topbar-punto" title="Base cifrada"></span>
              <button type="button" class="topbar-auditar" data-accion="auditar" tabindex="-1">Auditar</button>
              <p class="topbar-saludo">Buenos días, Dra. Ejemplo. Tienes 5 citas hoy.</p>
              <span class="topbar-medico"><strong>Dra. Ejemplo</strong><span class="topbar-cedula">Céd. 0000000</span></span>
              <span class="topbar-herramientas" aria-hidden="true">
                <span class="topbar-btn" data-accion="buscar"><Icono nombre="lupa" /></span>
                <span class="topbar-btn" data-accion="agenda"><Icono nombre="calendario" /></span>
                <span class="topbar-btn" data-accion="respaldar"><Icono nombre="respaldo" /></span>
                <span class="topbar-btn"><Icono nombre="candado" /></span>
              </span>
            </header>

            <div class="app-cuerpo">
              <aside class="app-lista" aria-label="Pacientes">
                <p class="app-seccion">Pacientes</p>
                <ul>
                  {
                    PACIENTES.map((p) => (
                      <li class:list={['paciente', { 'es-activa': 'activa' in p }]}>
                        <strong>{p.nombre}</strong>
                        <span>{p.datos} · {p.ultima}</span>
                        {'alergia' in p && <em class="pildora-alergia">Alergia: {p.alergia}</em>}
                      </li>
                    ))
                  }
                </ul>
              </aside>

              <div class="app-principal" data-principal data-lenis-prevent>
                <!-- ── Agenda ── -->
                <div class="pantalla" data-pantalla-id="agenda">
                  <div class="pantalla-cabecera">
                    <h3 tabindex="-1">Citas de hoy</h3>
                    <span class="tenue-app">Jueves 15 de octubre</span>
                  </div>
                  <ul class="citas">
                    {
                      CITAS.map((c) => (
                        <li class:list={['cita', `cita-${c.estado}`]} data-cita={c.hora}>
                          <time>{c.hora}</time>
                          <span class="cita-datos">
                            <strong>{c.nombre}</strong>
                            <small>{c.motivo}</small>
                          </span>
                          {c.estado === 'atendida' && <span class="badge badge-exito">Atendida</span>}
                          {c.estado === 'primera' && <span class="badge badge-info">Primera vez</span>}
                          {c.estado === 'actual' && (
                            <>
                              <span class="badge badge-exito" data-estado-cita>Ahora</span>
                              <button type="button" class="app-boton app-boton-primario" data-accion="iniciar" tabindex="-1">
                                Iniciar consulta
                              </button>
                            </>
                          )}
                        </li>
                      ))
                    }
                  </ul>
                </div>

                <!-- ── Consulta (nota de evolución) ── -->
                <form class="pantalla nota-form" data-pantalla-id="consulta" data-nota novalidate>
                  <div class="pantalla-cabecera">
                    <h3 tabindex="-1">Nota de evolución · María Fernanda López</h3>
                    <span class="borrador" data-borrador><Icono nombre="reloj" /> Borrador guardado</span>
                  </div>

                  <div class="semaforo" data-semaforo="verde" role="status" aria-live="polite">
                    <span class="semaforo-luces" aria-hidden="true"><i class="rojo"></i><i class="amarillo"></i><i class="verde"></i></span>
                    <span class="semaforo-texto" data-semaforo-texto>Lista para firmar: los 7 requisitos están completos</span>
                    <span class="semaforo-conteo" data-semaforo-conteo>7 de 7</span>
                  </div>

                  <label class="campo-app">
                    <span>Motivo de consulta</span>
                    <input name="motivo" value="Dolor de garganta y fiebre de 2 días." autocomplete="off" />
                  </label>
                  <label class="campo-app">
                    <span>Evolución del cuadro clínico</span>
                    <textarea name="evolucion" rows="2">Inicia hace 48 h con odinofagia y fiebre no cuantificada. Sin tos ni dificultad respiratoria.</textarea>
                  </label>

                  <fieldset class="signos">
                    <legend>Signos vitales</legend>
                    <label><span>TA sist.</span><input name="taSistolica" value="118" inputmode="numeric" /></label>
                    <label><span>TA diast.</span><input name="taDiastolica" value="76" inputmode="numeric" /></label>
                    <label><span>FC</span><input name="fc" value="92" inputmode="numeric" /></label>
                    <label><span>FR</span><input name="fr" value="18" inputmode="numeric" /></label>
                    <label><span>Temp °C</span><input name="temperatura" value="38.2" inputmode="decimal" /></label>
                    <label><span>SpO₂ %</span><input name="spo2" value="97" inputmode="numeric" /></label>
                    <label><span>Peso kg</span><input name="peso" value="64" inputmode="decimal" /></label>
                    <label><span>Talla cm</span><input name="talla" value="162" inputmode="decimal" /></label>
                    <span class="imc"><span>IMC</span><output name="imc" data-imc>24.4</output><small data-imc-clase>Peso normal</small></span>
                    <p class="signos-error" data-spo2-error hidden></p>
                  </fieldset>

                  <label class="campo-app">
                    <span>Exploración física</span>
                    <textarea name="exploracion" rows="2">Faringe hiperémica sin exudado, amígdalas sin hipertrofia. Sin adenopatías cervicales.</textarea>
                  </label>

                  <div class="campo-app cie10">
                    <label for="demo-cie10"><span>Diagnóstico (CIE-10)</span></label>
                    <input id="demo-cie10" name="buscarCie10" value="J02.9 · Faringitis aguda no especificada" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="demo-cie10-lista" />
                    <input type="hidden" name="cie10" value="J02.9" />
                    <input type="hidden" name="diagnostico" value="Faringitis aguda no especificada" />
                    <ul class="cie10-lista" id="demo-cie10-lista" role="listbox" data-cie10-lista hidden></ul>
                  </div>

                  <label class="campo-app">
                    <span>Pronóstico</span>
                    <input name="pronostico" value="Bueno para la vida y para la función." autocomplete="off" />
                  </label>
                  <label class="campo-app">
                    <span>Plan e indicaciones</span>
                    <textarea name="plan" rows="2">Paracetamol 500 mg VO cada 8 h por 3 días. Abundantes líquidos. Revaloración si hay dificultad para respirar o fiebre persistente.</textarea>
                  </label>

                  <div class="nota-acciones">
                    <button type="button" class="app-boton app-boton-primario" data-accion="firmar">
                      <Icono nombre="firma" /> Firmar nota
                    </button>
                  </div>
                </form>

                <!-- ── Expediente: nota sellada y addendum ── -->
                <div class="pantalla" data-pantalla-id="expediente">
                  <div class="pantalla-cabecera">
                    <h3 tabindex="-1">Expediente · María Fernanda López</h3>
                    <span class="badge badge-info" data-con-addendums hidden>Con addendums (1)</span>
                  </div>
                  <article class="nota-sellada" data-nota-sellada>
                    <header>
                      <strong>Nota de evolución n.º 12</strong>
                      <span>Hoy 10:14 · Dra. Ejemplo</span>
                    </header>
                    <dl>
                      <div><dt>Motivo</dt><dd>Dolor de garganta y fiebre de 2 días.</dd></div>
                      <div><dt>Signos</dt><dd>TA 118/76 · FC 92 · FR 18 · T 38.2 °C · SpO₂ 97 % · IMC 24.4</dd></div>
                      <div><dt>Diagnóstico</dt><dd>J02.9 · Faringitis aguda no especificada</dd></div>
                      <div><dt>Plan</dt><dd>Paracetamol 500 mg VO cada 8 h por 3 días.</dd></div>
                    </dl>
                    <p class="sello-app"><span class="sello-app-aro"><Icono nombre="check" /></span> Sellada · huella 9f2c41e8…b07a</p>
                    <div class="nota-sellada-acciones">
                      <button type="button" class="app-boton" data-accion="editar" tabindex="-1"><Icono nombre="editar" /> Editar</button>
                      <button type="button" class="app-boton" data-accion="addendum" tabindex="-1"><Icono nombre="mas" /> Agregar addendum</button>
                      <button type="button" class="app-boton" data-accion="receta" tabindex="-1"><Icono nombre="receta" /> Receta</button>
                    </div>
                    <span class="llave-sello" aria-hidden="true"><Logo titulo={null} /></span>
                    <span class="onda-sello" aria-hidden="true"></span>
                  </article>

                  <div class="addendum-form" data-addendum-form hidden>
                    <label class="campo-app">
                      <span>Motivo del addendum</span>
                      <select name="motivoAddendum" tabindex="-1">
                        {MOTIVOS_ADDENDUM.map((m) => <option>{m}</option>)}
                      </select>
                    </label>
                    <label class="campo-app">
                      <span>Contenido</span>
                      <input name="contenidoAddendum" value="" tabindex="-1" autocomplete="off" />
                    </label>
                    <button type="button" class="app-boton app-boton-primario" data-accion="firmar-addendum" tabindex="-1">
                      <Icono nombre="firma" /> Firmar addendum
                    </button>
                  </div>

                  <article class="addendum-app" data-addendum hidden>
                    <strong>Addendum 1 · Corrección de error de captura</strong>
                    <span>Temperatura correcta: 38.4 °C.</span>
                    <span class="sello-app sello-app-chico"><span class="sello-app-aro"><Icono nombre="check" /></span> Sellado · la nota original no cambia</span>
                  </article>
                </div>

                <!-- ── Receta ── -->
                <div class="pantalla pantalla-receta" data-pantalla-id="receta">
                  <div class="pantalla-cabecera">
                    <h3 tabindex="-1">Receta médica</h3>
                    <span class="formato" role="group" aria-label="Formato">
                      <button type="button" class="formato-btn" data-formato="carta" aria-pressed="false" tabindex="-1">Carta</button>
                      <button type="button" class="formato-btn" data-formato="media" aria-pressed="true" tabindex="-1">Media carta</button>
                    </span>
                  </div>
                  <div class="hoja" data-hoja="media">
                    <header class="hoja-membrete">
                      <Logo titulo={null} class="hoja-logo" />
                      <span>
                        <strong>Dra. Ejemplo</strong>
                        <small>Medicina general · Céd. prof. 0000000</small>
                        <small>Consultorio de ejemplo · Tel. 000 000 0000</small>
                      </span>
                    </header>
                    <p class="hoja-paciente"><strong>Paciente:</strong> María Fernanda López · 34 años · 64 kg · <strong>Fecha:</strong> 15/10/2026</p>
                    <p class="hoja-alergias"><strong>Alergias:</strong> Negadas</p>
                    <div class="hoja-rp">
                      <strong>Rp.</strong>
                      <p>Paracetamol tabletas 500 mg. Tomar 1 tableta cada 8 horas por 3 días.</p>
                      <p class="tenue-app">Abundantes líquidos. Acudir a revaloración si hay dificultad para respirar o fiebre persistente.</p>
                    </div>
                    <footer class="hoja-pie">
                      <span>Folio: nota 12 · Expediente EXP-2026-000128</span>
                      <span>Sello SHA-256: 9f2c41e8…b07a</span>
                      <span class="hoja-firma">Firma</span>
                    </footer>
                  </div>
                  <div class="receta-acciones">
                    <button type="button" class="app-boton app-boton-primario" data-accion="imprimir" tabindex="-1"><Icono nombre="impresora" /> Imprimir</button>
                  </div>
                </div>
              </div>

              <aside class="app-agenda" aria-label="Agenda">
                <p class="app-seccion">Citas de hoy</p>
                <ul>
                  {
                    CITAS.slice(0, 4).map((c) => (
                      <li class:list={['agenda-mini', `cita-${c.estado}`]} data-agenda-mini={c.hora}>
                        <time>{c.hora}</time>
                        <strong>{c.nombre}</strong>
                        <small data-agenda-estado>
                          {c.estado === 'atendida' ? 'Atendida' : c.estado === 'actual' ? 'En atención' : c.estado === 'primera' ? 'Primera vez' : 'Programada'}
                        </small>
                      </li>
                    ))
                  }
                </ul>
              </aside>
            </div>

            <!-- ── Diálogos ── -->
            <div class="modal" data-modal="firma" hidden>
              <div class="modal-caja">
                <h4>Firmar nota de evolución</h4>
                <p>Al firmar, la nota queda sellada y ya no se puede modificar.</p>
                <label class="campo-app">
                  <span>Tu contraseña</span>
                  <input type="text" class="clave" data-clave value="" tabindex="-1" autocomplete="off" aria-label="Contraseña de ejemplo" />
                </label>
                <div class="modal-acciones">
                  <button type="button" class="app-boton" tabindex="-1">Cancelar</button>
                  <button type="button" class="app-boton app-boton-primario" data-accion="confirmar-firma" tabindex="-1">Firmar y sellar</button>
                </div>
              </div>
            </div>

            <div class="modal" data-modal="auditoria" hidden>
              <div class="modal-caja">
                <h4>Auditoría de integridad</h4>
                <ul class="auditoria">
                  <li data-auditoria><span>Notas de evolución</span><span class="auditoria-estado">12 de 12</span></li>
                  <li data-auditoria><span>Addendums</span><span class="auditoria-estado">3 de 3</span></li>
                  <li data-auditoria><span>Antecedentes</span><span class="auditoria-estado">2 de 2</span></li>
                  <li data-auditoria><span>Bitácora de accesos</span><span class="auditoria-estado">486 eventos</span></li>
                </ul>
                <p class="auditoria-resultado" data-auditoria-resultado hidden>
                  <span class="sello-app-aro"><Icono nombre="check" /></span> Íntegro: todas las huellas y firmas coinciden.
                </p>
              </div>
            </div>

            <div class="modal" data-modal="respaldo" hidden>
              <div class="modal-caja">
                <h4>Respaldar base de datos cifrada</h4>
                <ul class="destinos">
                  <li><Icono nombre="carpeta" /> Documentos › Respaldos</li>
                  <li class="destino-usb" data-destino-usb><Icono nombre="usb" /> <span data-destino-texto>Unidad alterna: sin elegir</span>
                    <button type="button" class="app-boton" data-accion="examinar" tabindex="-1">Examinar…</button></li>
                </ul>
                <div class="progreso" data-progreso><span></span></div>
                <p class="progreso-texto" data-progreso-texto>clinica-2026-10-15T10-21.db</p>
                <p class="auditoria-resultado" data-respaldo-resultado hidden>
                  <span class="sello-app-aro"><Icono nombre="check" /></span> Copia verificada: idéntica al original.
                </p>
              </div>
            </div>

            <div class="toasts" data-toasts aria-live="polite"></div>
            <span class="cursor" data-cursor aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22"><path d="M5 3l14 8.5-6.2 1.3L9.6 19z" fill="#0f172a" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path></svg>
            </span>
          </div>
          <!-- Pantalla "apagada" que se enciende con el scroll, reflejo del vidrio y línea de escáner. -->
          <span class="pantalla-luz" aria-hidden="true"><span class="pantalla-reflejo"></span><span class="pantalla-escaner"></span></span>
        </div>
      </div>

      <div class="demo-controles">
        <button type="button" class="boton boton-secundario boton-chico" data-control="pausa" hidden>
          <Icono nombre="pausa" class="si-reproduce" /><Icono nombre="play" class="si-pausa" />
          <span data-control-texto>Pausar</span>
        </button>
        <button type="button" class="boton boton-secundario boton-chico" data-control="reiniciar" hidden>
          <Icono nombre="reiniciar" /> Reiniciar
        </button>
        <label class="demo-tema">
          <Icono nombre="paleta" />
          <span>Tema</span>
          <select data-control="tema">
            {TEMAS.map((t) => <option value={t.id}>{t.etiqueta}</option>)}
          </select>
        </label>
      </div>
      <p class="demo-narracion tenue" data-narracion aria-live="polite">
        Así se ve una nota completa: el semáforo en verde indica que cumple los 7 requisitos y ya se puede firmar.
      </p>
      <dl class="demo-datos" data-escalonar>
        <div data-animar="subir"><dt>Semáforo</dt><dd>7 requisitos <span class="sin-corte">NOM-004</span></dd></div>
