  .app[data-tema='oscuro-azul'] {
    --fondo: #0f172a;
    --superficie: #1e293b;
    --borde: #334155;
    --borde-campo: #475569;
    --texto: #f8fafc;
    --texto-suave: #94a3b8;
    --primario: #38bdf8;
    --primario-hover: #7dd3fc;
    --primario-suave: rgb(56 189 248 / 0.14);
    --sobre-primario: #0f172a;
  }

  .app[data-tema='oscuro-titanio'] {
    --fondo: #1b1f26;
    --superficie: #242a33;
    --borde: #353d4a;
    --borde-campo: #4a5465;
    --texto: #eceff4;
    --texto-suave: #a7b1c2;
    --primario: #8fbcd4;
    --primario-hover: #b3d3e3;
    --primario-suave: rgb(143 188 212 / 0.14);
    --sobre-primario: #1b1f26;
    --exito: #a3be8c;
  }

  .app[data-tema='oscuro-neutro'] {
    --fondo: #18181b;
    --superficie: #27272a;
    --borde: #3f3f46;
    --borde-campo: #52525b;
    --texto: #fafafa;
    --texto-suave: #a1a1aa;
    --primario: #60a5fa;
    --primario-hover: #93c5fd;
    --primario-suave: rgb(96 165 250 / 0.14);
    --sobre-primario: #18181b;
  }

  .app :global(.icono) {
    width: 15px;
    height: 15px;
  }

  .ventana-barra {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 34px;
    padding: 0 0 0 12px;
    background: color-mix(in srgb, var(--texto) 6%, var(--superficie));
    border-bottom: 1px solid var(--borde);
    color: var(--texto-suave);
    font-size: 12px;
    flex: none;
  }

  .ventana-titulo {
    font-weight: 600;
    white-space: nowrap;
  }

  .ventana-offline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px solid var(--exito-borde);
    background: var(--exito-suave);
    color: var(--exito);
    font-weight: 600;
    white-space: nowrap;
  }

  /* Minimizar, maximizar y cerrar, como en Windows. */
  .ventana-controles {
    display: inline-flex;
    align-self: stretch;
  }

  .ventana-controles svg {
    width: 40px;
    height: 100%;
    padding: 0 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  .app-topbar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 14px;
    background: var(--superficie);
    border-bottom: 1px solid var(--borde);
    flex: none;
  }

  .topbar-marca {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .topbar-marca :global(.topbar-logo) {
    height: 24px;
    color: var(--navy);
  }

  .app[data-tema^='oscuro'] .topbar-marca :global(.topbar-logo) {
    color: #fff;
  }

  .topbar-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px color-mix(in srgb, #10b981 22%, transparent);
  }

  .topbar-auditar {
    padding: 2px 4px;
    border: 0;
    background: none;
    color: var(--texto-suave);
    font-size: 12px;
    cursor: pointer;
  }

  .topbar-auditar.es-presionado {
    color: var(--primario);
    text-decoration: underline;
  }

  .topbar-saludo {
    flex: 1;
    min-width: 0;
    margin: 0;
    color: var(--texto-suave);
    font-size: 12px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .topbar-medico {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
  }

  .topbar-cedula {
    padding: 0 6px;
    line-height: 18px;
    border-radius: 999px;
    border: 1px solid var(--borde);
    background: var(--campo-inactivo);
    color: var(--texto-suave);
    font-size: 11px;
  }

  .topbar-herramientas {
    display: inline-flex;
    gap: 2px;
  }

  .topbar-btn {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: var(--texto-suave);
  }

  .topbar-btn.es-presionado {
    background: var(--campo-inactivo);
    color: var(--texto);
  }

  .app-cuerpo {
    display: flex;
    flex: 1;
    min-height: 0;
  }

  .app-seccion {
    margin: 10px 4px 6px;
    color: var(--texto-suave);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .app-lista,
  .app-agenda {
    display: none;
    flex: none;
    padding: 4px 10px;
    background: color-mix(in srgb, var(--fondo) 60%, var(--superficie));
    overflow: hidden;
  }

  .app-lista {
    width: 220px;
    border-right: 1px solid var(--borde);
  }

  .app-agenda {
    width: 210px;
    border-left: 1px solid var(--borde);
  }

  .app-lista ul,
  .app-agenda ul,
  .citas,
  .auditoria,
  .destinos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paciente {
    display: grid;
    gap: 1px;
    padding: 8px 10px;
    margin-bottom: 6px;
    border: 0.5px solid var(--borde);
    border-radius: 10px;
    background: var(--superficie);
  }

  .paciente strong {
    font-size: 12.5px;
  }

  .paciente span {
    color: var(--texto-suave);
    font-size: 11.5px;
  }

  .paciente.es-activa {
    border-color: color-mix(in srgb, var(--primario) 45%, var(--borde));
    box-shadow: 0 0 0 2px var(--primario-suave);
  }

  .pildora-alergia {
    justify-self: start;
    padding: 0 7px;
    border-radius: 999px;
    border: 0.5px solid var(--peligro-borde);
    background: var(--peligro-suave);
    color: var(--peligro);
    font-size: 10.5px;
    font-style: normal;
    font-weight: 600;
  }

  .agenda-mini {
    display: grid;
    gap: 1px;
    padding: 8px 10px;
    margin-bottom: 6px;
    border: 0.5px solid var(--borde);
    border-radius: 10px;
    background: var(--superficie);
    transition:
      background-color 0.4s,
      border-color 0.4s,
      opacity 0.4s;
  }

  .agenda-mini time {
    color: var(--texto-suave);
    font-size: 11px;
    font-weight: 600;
  }

  .agenda-mini strong {
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .agenda-mini small {
    color: var(--texto-suave);
    font-size: 11px;
  }

  .agenda-mini.cita-actual {
    background: var(--exito-suave);
    border-color: var(--exito-borde);
  }

  .agenda-mini.cita-atendida {
    opacity: 0.65;
  }

  /* Scroll propio (data-lenis-prevent: en escritorio la rueda lo mueve a él, no a la página). Al llegar al final,
     el siguiente gesto sigue con la página (sin `contain`): en celular la ventana ocupa casi toda la pantalla y no
     debe atrapar el dedo. `.app` sube la especificidad sobre la regla de Lenis de global.css. */
  .app .app-principal {
    position: relative;
    flex: 1;
    min-width: 0;
    padding: 14px 16px 18px;
    overflow-y: auto;
    overscroll-behavior: auto;
    scrollbar-width: thin;
  }

  .pantalla {
    display: none;
  }

  .app[data-pantalla='agenda'] [data-pantalla-id='agenda'],
  .app[data-pantalla='consulta'] [data-pantalla-id='consulta'],
  .app[data-pantalla='expediente'] [data-pantalla-id='expediente'],
  .app[data-pantalla='receta'] [data-pantalla-id='receta'] {
    display: block;
    animation: pantalla-entra 0.35s var(--curva);
  }

  @keyframes pantalla-entra {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .pantalla-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  .pantalla-cabecera h3 {
    font-family: var(--fuente-texto);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .tenue-app {
    color: var(--texto-suave);
  }

  .app-boton {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    border: 1px solid var(--borde-campo);
    border-radius: 8px;
    background: var(--superficie);
    color: var(--texto);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      transform 0.15s,
      background-color 0.2s,
      opacity 0.2s;
  }

  .app-boton-primario {
    border-color: var(--primario);
    background: var(--primario);
    color: var(--sobre-primario);
  }

  .app-boton-primario:hover {
    background: var(--primario-hover);
  }

  .app-boton:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .app-boton.es-presionado {
    transform: scale(0.95);
  }

  .badge {
    flex: none;
    padding: 0 8px;
    line-height: 18px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .badge-exito {
    border: 0.5px solid var(--exito-borde);
    background: var(--exito-suave);
    color: var(--exito);
  }

  .badge-info {
    border: 0.5px solid var(--info-borde);
    background: var(--info-suave);
    color: var(--info);
  }

  .badge[hidden] {
    display: none;
  }

  /* Agenda */
  .cita {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    margin-bottom: 8px;
    border: 0.5px solid var(--borde);
    border-radius: 10px;
    background: var(--superficie);
    transition:
      background-color 0.4s,
      border-color 0.4s;
  }

  .cita time {
    width: 40px;
    flex: none;
    color: var(--texto-suave);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .cita-datos {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .cita-datos small {
    color: var(--texto-suave);
  }

  .cita-actual {
    background: var(--exito-suave);
    border-color: var(--exito-borde);
  }

  .cita-atendida {
    opacity: 0.65;
  }

  /* Nota */
  .borrador {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--info-borde);
    background: var(--info-suave);
    color: var(--info);
    font-size: 11.5px;
    white-space: nowrap;
    transition: opacity 0.3s;
  }

  .borrador.es-guardando {
    opacity: 0.55;
  }

  .semaforo {
    position: sticky;
    top: -14px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 -16px 12px;
    padding: 8px 16px;
    background: color-mix(in srgb, var(--fondo) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--borde);
  }

  .semaforo-luces {
    display: inline-flex;
    gap: 4px;
    padding: 4px 6px;
    border-radius: 999px;
    background: #1f2937;
    flex: none;
  }

  .semaforo-luces i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    opacity: 0.25;
    transition:
      opacity 0.3s,
      box-shadow 0.3s;
  }

  .semaforo-luces .rojo {
    background: #ef4444;
    color: #ef4444;
  }
  .semaforo-luces .amarillo {
    background: #f59e0b;
    color: #f59e0b;
  }
  .semaforo-luces .verde {
    background: #22c55e;
    color: #22c55e;
  }

  .semaforo[data-semaforo='rojo'] .rojo,
  .semaforo[data-semaforo='amarillo'] .amarillo,
  .semaforo[data-semaforo='verde'] .verde {
    opacity: 1;
    box-shadow: 0 0 7px currentColor;
  }

  .semaforo-texto {
    flex: 1;
    min-width: 0;
    font-weight: 600;
    font-size: 12px;
  }

  .semaforo[data-semaforo='rojo'] .semaforo-texto {
    color: var(--peligro);
  }
  .semaforo[data-semaforo='amarillo'] .semaforo-texto {
    color: var(--alerta);
  }
  .semaforo[data-semaforo='verde'] .semaforo-texto {
    color: var(--exito);
  }

  .semaforo-conteo {
    color: var(--texto-suave);
    font-size: 12px;
    white-space: nowrap;
  }

  .campo-app {
    display: grid;
    gap: 4px;
    margin-bottom: 10px;
  }

  .campo-app > span,
  .campo-app label span,
  .signos legend,
  .signos label span,
  .imc > span {
    color: var(--texto-suave);
    font-size: 11.5px;
    font-weight: 600;
  }

  .app input,
  .app textarea,
  .app select {
    width: 100%;
    padding: 6px 9px;
    border: 1px solid var(--borde-campo);
    border-radius: 7px;
    background: var(--superficie);
    color: var(--texto);
    font: inherit;
    font-size: 13px;
    resize: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .app input:focus,
  .app textarea:focus,
  .app select:focus {
    outline: none;
    border-color: var(--primario);
    box-shadow: 0 0 0 3px var(--primario-suave);
  }

  .app .es-escribiendo {
    border-color: var(--primario);
    box-shadow: 0 0 0 3px var(--primario-suave);
  }

  .signos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin: 0 0 10px;
    padding: 10px;
    border: 1px solid var(--borde);
    border-radius: 10px;
    background: color-mix(in srgb, var(--superficie) 70%, var(--fondo));
  }

  .signos legend {
    padding: 0 4px;
  }

  .signos label {
    display: grid;
    gap: 3px;
  }

  .imc {
    display: grid;
    gap: 1px;
    align-content: start;
    padding: 4px 8px;
    border-radius: 7px;
    background: var(--primario-suave);
  }

  .imc output {
    font-size: 15px;
    font-weight: 700;
    color: var(--texto);
  }

  .imc small {
    color: var(--texto-suave);
    font-size: 11px;
  }

  .signos-error {
    grid-column: 1 / -1;
    margin: 0;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--peligro-suave);
    color: var(--peligro);
    font-weight: 600;
    font-size: 12px;
  }

  .app input.es-invalido {
    border-color: var(--peligro);
    box-shadow: 0 0 0 3px var(--peligro-suave);
  }

  .cie10 {
    position: relative;
  }

  .cie10-lista {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 5;
    margin: 4px 0 0;
    padding: 4px;
    list-style: none;
    border: 1px solid var(--borde);
    border-radius: 9px;
    background: var(--superficie);
    box-shadow: 0 14px 34px -10px rgb(15 23 42 / 0.3);
  }

  .cie10-lista[hidden] {
    display: none;
  }

  /* Las opciones las crea demo.ts: sin el atributo de alcance de Astro, se seleccionan con :global. */
  .cie10-lista :global(button) {
    display: flex;
    gap: 10px;
    width: 100%;
    padding: 6px 8px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--texto);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .cie10-lista :global(button:hover),
  .cie10-lista :global(button.es-resaltado) {
    background: var(--primario-suave);
  }

  .cie10-lista :global(b) {
    flex: none;
    width: 46px;
    color: var(--primario);
  }

  .nota-acciones,
  .receta-acciones {
    display: flex;
    justify-content: flex-end;
    padding-top: 4px;
  }

  /* Expediente: nota sellada */
  .nota-sellada {
    position: relative;
    padding: 14px 16px 16px;
    border: 1px solid var(--borde);
    border-radius: 12px;
    background: var(--superficie);
    transition:
      border-color 0.5s,
      box-shadow 0.5s;
  }

  .nota-sellada.es-sellada {
    border-color: var(--exito-borde);
    box-shadow: 0 0 0 3px var(--exito-suave);
  }

  .nota-sellada header {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--borde);
  }

  .nota-sellada header span {
    color: var(--texto-suave);
  }

  .nota-sellada dl {
    display: grid;
    gap: 6px;
    margin: 0;
  }

  .nota-sellada dt {
    color: var(--texto-suave);
    font-size: 11px;
    font-weight: 600;
  }

  .nota-sellada dd {
    margin: 0;
  }

  .sello-app {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 12px 0 0;
    padding: 4px 10px 4px 4px;
    border-radius: 999px;
    border: 1px solid var(--exito-borde);
    background: var(--exito-suave);
    color: var(--exito);
    font-weight: 700;
    font-size: 12px;
  }

  .sello-app-aro {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--exito);
    color: var(--superficie);
  }

  .sello-app-aro :global(.icono) {
    width: 12px;
    height: 12px;
    stroke-width: 2.6;
  }

  .nota-sellada-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .llave-sello {
    position: absolute;
    left: 40px;
    bottom: 34px;
    height: 70px;
    color: var(--navy);
    opacity: 0;
    pointer-events: none;
  }

  .app[data-tema^='oscuro'] .llave-sello {
    color: #fff;
  }

  .llave-sello :global(.logo) {
    height: 100%;
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.35));
  }

  .onda-sello {
    position: absolute;
    left: 6px;
    bottom: 12px;
    width: 46px;
    height: 46px;
    border: 2px solid var(--exito);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  .nota-sellada.es-sellando .llave-sello {
    animation: llave-baja 1.3s var(--curva) forwards;
  }

  .nota-sellada.es-sellando .onda-sello {
    animation: onda-app 0.9s 0.75s var(--curva);
  }

  .nota-sellada.es-sellando .sello-app {
    animation: sello-aparece 0.6s 0.8s var(--curva) backwards;
  }

  @keyframes llave-baja {
    0% {
      opacity: 0;
      transform: translate(140px, -160px) rotate(-30deg) scale(1.3);
    }
    55% {
      opacity: 1;
      transform: translate(-20px, 0) rotate(0) scale(1);
    }
    65% {
      transform: translate(-20px, 0) rotate(0) scale(0.88);
    }
    80% {
      opacity: 1;
      transform: translate(-20px, 0) rotate(0) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(-20px, -30px) rotate(8deg) scale(0.9);
    }
  }

  @keyframes onda-app {
    from {
      opacity: 0.9;
      transform: scale(0.5);
    }
    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  @keyframes sello-aparece {
    from {
      opacity: 0;
      transform: scale(0.7);
    }
  }

  .addendum-form {
    display: grid;
    gap: 2px;
    margin-top: 12px;
    padding: 12px;
    border: 1px dashed var(--borde-campo);
    border-radius: 10px;
    animation: pantalla-entra 0.35s var(--curva);
  }

  .addendum-form[hidden],
  .addendum-app[hidden] {
    display: none;
  }

  .addendum-form .app-boton {
    justify-self: end;
  }

  .addendum-app {
    display: grid;
    gap: 3px;
    margin-top: 10px;
    padding: 10px 14px;
    border: 1px solid var(--exito-borde);
    border-left: 4px solid var(--exito);
    border-radius: 10px;
    background: var(--exito-suave);
    animation: pantalla-entra 0.5s var(--curva);
  }

  .sello-app-chico {
    margin-top: 4px;
    justify-self: start;
