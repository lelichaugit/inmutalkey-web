  /* ═════════════ Presentación del dispositivo ═════════════
     --p (scroll.ts) de .presentacion: 0 cuando asoma por abajo, 0.5 centrada, 1 cuando sale por arriba. Se escribe
     solo en sus destinos [data-p] (.presentacion-halo y .dispositivo), que declaran ahí sus tramos: --t (inclinada →
     plana, 0.05–0.45) y --luz (pantalla apagada → encendida, 0.15–0.42). Solo con .movimiento: con movimiento
     reducido scroll.ts también escribe --p, pero aquí no se usa. */
  .presentacion-halo,
  .dispositivo {
    --t: clamp(0, (var(--p, 1) - 0.05) / 0.4, 1);
    --luz: clamp(0, (var(--p, 1) - 0.15) / 0.27, 1);
  }

  .presentacion {
    --giro: 14deg;
    --escala-min: 0.88;
    --bajada: 56px;
    --radio-extra: 22px;
    --visor-fuera: 14px;
    --visor-viaje: 18px;
    position: relative;
    perspective: 1800px;
    perspective-origin: 50% 0%;
  }

  /* Celular: el mismo gesto, más corto y más plano. */
  @media (max-width: 759px) {
    .presentacion-halo,
    .dispositivo {
      --t: clamp(0, (var(--p, 1) - 0.03) / 0.35, 1);
      --luz: clamp(0, (var(--p, 1) - 0.1) / 0.26, 1);
    }

    .presentacion {
      --giro: 8deg;
      --escala-min: 0.94;
      --bajada: 24px;
      --radio-extra: 12px;
      --visor-fuera: 8px;
      --visor-viaje: 6px;
      perspective: 1200px;
    }
  }

  .dispositivo {
    position: relative;
    transform-origin: 50% 100%;
  }

  /* Sombra de la ventana en su propia capa: el clip-path de .app no la recorta. */
  .dispositivo::before {
    content: '';
    position: absolute;
    inset: 34px 0 0;
    z-index: -1;
    border-radius: 14px;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.4),
      0 40px 80px -30px rgb(0 0 0 / 0.75),
      0 0 120px -40px rgb(46 159 224 / 0.45);
    pointer-events: none;
  }

  :global(.movimiento) .dispositivo {
    transform: translate3d(0, calc((1 - var(--t)) * var(--bajada)), 0) rotateX(calc((1 - var(--t)) * var(--giro)))
      scale(calc(var(--escala-min) + var(--t) * (1 - var(--escala-min))));
  }

  /* Esquinas más redondeadas mientras llega (clip-path: la sombra vive en el halo y en .app, no se recorta). */
  :global(.movimiento) .app,
  :global(.movimiento) .pantalla-luz {
    clip-path: inset(0 round calc(14px + (1 - var(--t)) * var(--radio-extra)));
  }

  /* Corte de la herencia: .app usa --t (sus esquinas), pero nada de adentro usa --p, --t ni --luz. Sin esto, cada
     escritura de --p en .dispositivo recalcularía el estilo de los ~360 elementos del simulador; así el recálculo se
     detiene en los hijos directos de .app (su valor no cambia). */
  .app > * {
    --p: initial;
    --t: initial;
    --luz: initial;
  }

  /* Luz azul bajo la ventana: crece al encenderse. */
  .presentacion-halo {
    position: absolute;
    inset: 12% 6% -6%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(46 159 224 / 0.34), rgb(1 120 176 / 0.12) 55%, transparent);
    filter: blur(28px);
    opacity: 0.8;
    pointer-events: none;
  }

  :global(.movimiento) .presentacion-halo {
    opacity: calc(0.15 + var(--luz) * 0.65);
    transform: scale(calc(0.8 + var(--luz) * 0.2));
  }

  /* Esquinas de visor: llegan abiertas y "fijan" la ventana. */
  .visor {
    position: absolute;
    inset: calc(-1 * var(--visor-fuera));
    top: calc(34px - var(--visor-fuera));
    pointer-events: none;
  }

  .visor i {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 0 solid rgb(46 159 224 / 0.75);
    opacity: 0.7;
  }

  .visor i:nth-child(1) {
    top: 0;
    left: 0;
    border-width: 1px 0 0 1px;
    --x: -1;
    --y: -1;
  }
  .visor i:nth-child(2) {
    top: 0;
    right: 0;
    border-width: 1px 1px 0 0;
    --x: 1;
    --y: -1;
  }
  .visor i:nth-child(3) {
    bottom: 0;
    left: 0;
    border-width: 0 0 1px 1px;
    --x: -1;
    --y: 1;
  }
  .visor i:nth-child(4) {
    right: 0;
    bottom: 0;
    border-width: 0 1px 1px 0;
    --x: 1;
    --y: 1;
  }

  :global(.movimiento) .visor i {
    opacity: calc(0.25 + var(--t) * 0.45);
    transform: translate3d(
      calc(var(--x) * (1 - var(--t)) * var(--visor-viaje)),
      calc(var(--y) * (1 - var(--t)) * var(--visor-viaje)),
      0
    );
  }

