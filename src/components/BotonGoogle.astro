---
// "Continuar con Google". Es un enlace normal (sin JS ni scripts de Google en la página: la CSP sigue cerrada):
// el Worker arma la redirección con PKCE y regresa al médico ya verificado.
//
// Marca: las reglas de Google para el botón piden su logotipo "G" oficial. No se dibuja aquí; descárgalo de la página
// de marca de Google Identity ("Sign in with Google branding guidelines") y guárdalo como
// public/brand/terceros/google-g.svg. Si el archivo existe, el build lo muestra; si no, el botón sale solo con texto.
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const logo = existsSync(join(process.cwd(), 'public/brand/terceros/google-g.svg')) ? '/brand/terceros/google-g.svg' : null;
---

<a class="boton-google" href="/api/auth/google/inicio" data-boton-google>
  {logo && <img src={logo} alt="" width="20" height="20" />}
  <span>Continuar con Google</span>
</a>

<style>
  /* Colores de los lineamientos de Google: claro (#FFF, borde #747775, texto #1F1F1F) u oscuro (#131314, borde
     #8E918F, texto #E3E3E3) según el tema. La forma sigue a la marca (radio 9 px, foco doble). */
  .boton-google {
    --g-fondo: #fff;
    --g-borde: #747775;
    --g-texto: #1f1f1f;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 1px solid var(--g-borde);
    border-radius: var(--radio-sm);
    background: var(--g-fondo);
    color: var(--g-texto);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--elev-1);
    transition:
      box-shadow 200ms ease,
      transform 160ms var(--curva-cristal);
  }

  :global(:root[data-theme='oscuro']) .boton-google,
  :global(:root[data-theme='aurora']) .boton-google {
    --g-fondo: #131314;
    --g-borde: #8e918f;
    --g-texto: #e3e3e3;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .boton-google {
      --g-fondo: #131314;
      --g-borde: #8e918f;
      --g-texto: #e3e3e3;
    }
  }

  .boton-google:hover {
    color: var(--g-texto);
    box-shadow: var(--elev-2), var(--halo-acento);
  }

  .boton-google:active {
    transform: scale(0.98);
  }

  .boton-google:focus-visible {
    box-shadow: var(--anillo-foco);
  }

  .boton-google[aria-disabled='true'] {
    opacity: 0.6;
    pointer-events: none;
  }

  .boton-google img {
    flex: none;
  }
</style>
