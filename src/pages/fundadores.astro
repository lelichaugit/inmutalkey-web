---
// Registro al programa Fundadores (lead) y puerta a la prueba de 30 días. Dos caminos:
//   · Continuar con Google → el correo ya viene verificado: completa sus datos y descarga en ese momento.
//   · Formulario con correo → recibe un enlace para confirmar (doble opt-in) que lo lleva a su descarga guiada.
// En ambos casos el aviso a Alan llega cuando el correo queda probado. Sin JS no pasa Turnstile: se invita a WhatsApp.
import '../styles/formularios.css';

import BotonGoogle from '../components/BotonGoogle.astro';
import Icono from '../components/Icono.astro';
import PasosRegistro from '../components/PasosRegistro.astro';
import {
  COMO_SE_ENTERO,
  ESTADOS_MX,
  RANGOS_PACIENTES,
  SISTEMAS_OPERATIVOS,
  TIPOS_PRACTICA,
  USA_HOY,
  VERSION_AVISO_VIGENTE,
} from '../compartido/leads';
import PaginaTexto from '../layouts/PaginaTexto.astro';
import { detectarEntorno, siteKeyTurnstile } from '../lib/entorno';
import { enlaceWhatsApp } from '../lib/whatsapp';
import { estaDefinido, sitio } from '../site.config';

const entorno = detectarEntorno(process.env, { servidorDev: import.meta.env.DEV });
const sitekey = siteKeyTurnstile(entorno, estaDefinido(sitio.turnstile.siteKey) ? sitio.turnstile.siteKey : null);
const whatsapp = enlaceWhatsApp(sitio.contacto.whatsapp, sitio.contacto.mensajes.fundadores);
const conGoogle = sitio.google.habilitado || entorno !== 'produccion';

const selecciona = (opciones: readonly (readonly [string, string])[]) => opciones;
---

<PaginaTexto
  titulo="Solicite su acceso Fundador"
  descripcion="Regístrese en un minuto y descargue la beta con todas sus funciones. Solo pedimos datos de su consultorio, nunca de sus pacientes."
  antetitulo="Programa Fundadores"
  estrecho
>
  <PasosRegistro actual={1} />
  <p class="pildora cupo-vivo" data-cupo hidden></p>
  <div class="tarjeta panel-formulario">
  <p class="aviso-paso" data-aviso-google role="status" hidden></p>

  {
    conGoogle && (
      <div class="registro-rapido" data-registro-rapido>
        <BotonGoogle />
        <p class="registro-nota">
          Usamos solo su nombre y su correo verificado; nunca su contraseña ni sus contactos.
        </p>
        <p class="separador" aria-hidden="true"><span>o con su correo</span></p>
      </div>
    )
  }

  <div class="aviso-paso exito conectado" data-conectado hidden>
    <p>
      <Icono nombre="check" /> Conectado con Google como <strong data-conectado-correo></strong>. Complete los datos de su consultorio y descargue.
    </p>
    <button type="button" class="enlace-boton" data-usar-otro>Usar otro correo</button>
  </div>

  {
    !sitekey && (
      <div class="aviso-paso">
        <p>
          El registro con correo se habilita muy pronto.
          {whatsapp ? <a href={whatsapp} target="_blank" rel="noopener noreferrer"> Mientras tanto, escríbanos por WhatsApp</a> : ' Mientras tanto, escríbanos'}
          y le apartamos su lugar.
        </p>
      </div>
    )
  }

  <form
    class="formulario"
    data-formulario="fundadores"
    data-sitekey={sitekey ?? undefined}
    data-version-aviso={VERSION_AVISO_VIGENTE}
  >
    <div class="formulario-rejilla">
      <label class="campo">
        <span>Nombre completo</span>
        <input name="nombre" required minlength="3" maxlength="120" autocomplete="name" placeholder="Dra. Ana López Ruiz" />
      </label>
      <label class="campo">
        <span>Correo</span>
        <input name="correo" type="email" required maxlength="160" autocomplete="email" inputmode="email" />
        <small data-nota-correo>Le enviaremos un enlace para confirmarlo.</small>
      </label>
      <label class="campo">
        <span>Teléfono <span class="opcional">(opcional)</span></span>
        <input name="telefono" type="tel" maxlength="20" autocomplete="tel" inputmode="tel" placeholder="229 000 0000" />
      </label>
      <label class="campo">
        <span>Especialidad</span>
        <input name="especialidad" required minlength="3" maxlength="80" placeholder="Medicina general" />
      </label>
      <label class="campo">
        <span>Estado</span>
        <select name="estado" required>
          <option value="">Elija…</option>
          {ESTADOS_MX.map((e) => <option value={e}>{e}</option>)}
        </select>
      </label>
      <label class="campo">
        <span>Ciudad</span>
        <input name="ciudad" required minlength="2" maxlength="80" autocomplete="address-level2" />
      </label>
      <label class="campo">
        <span>¿Dónde da consulta?</span>
        <select name="tipo_practica" required>
          <option value="">Elija…</option>
          {selecciona(TIPOS_PRACTICA).map(([v, t]) => <option value={v}>{t}</option>)}
        </select>
      </label>
      <label class="campo">
        <span>Pacientes por semana</span>
        <select name="pacientes_semana_rango" required>
          <option value="">Elija…</option>
          {selecciona(RANGOS_PACIENTES).map(([v, t]) => <option value={v}>{t}</option>)}
        </select>
      </label>
      <label class="campo">
        <span>¿Qué usa hoy para sus expedientes?</span>
        <select name="usa_hoy" required>
          <option value="">Elija…</option>
          {selecciona(USA_HOY).map(([v, t]) => <option value={v}>{t}</option>)}
        </select>
      </label>
      <label class="campo">
        <span>¿Cómo se enteró?</span>
        <select name="como_se_entero" required>
          <option value="">Elija…</option>
          {selecciona(COMO_SE_ENTERO).map(([v, t]) => <option value={v}>{t}</option>)}
        </select>
      </label>
    </div>

    <fieldset class="campo">
      <legend>La computadora de su consultorio</legend>
      <div class="opciones">
        {
          selecciona(SISTEMAS_OPERATIVOS).map(([v, t]) => (
            <label>
              <input type="radio" name="so" value={v} required />
              <span>{t}</span>
            </label>
          ))
        }
      </div>
      <small>InmutalKey funciona hoy en Windows; la versión para Mac está en evaluación.</small>
    </fieldset>

    <div class="trampa" aria-hidden="true">
      <label>No llene este campo <input name="sitio_web" tabindex="-1" autocomplete="off" /></label>
    </div>

    <label class="casilla">
      <input type="checkbox" name="consentimiento" required />
      <span>
        Autorizo que InmutalKey use estos datos para contactarme sobre el programa Fundadores y mi prueba, conforme al
        <a href="/privacidad">aviso de privacidad</a>. Puedo pedir que los borren en cualquier momento.
      </span>
    </label>

    <div class="turnstile" data-turnstile></div>

    <button type="submit" class="boton boton-primario" disabled={!sitekey} data-enviar>
      <span data-enviar-texto>Solicitar acceso Fundador</span>
    </button>
    <p class="formulario-estado" data-estado role="status" aria-live="polite"></p>
    <noscript><p>Para enviar este formulario necesita JavaScript activado. También puede escribirnos por WhatsApp.</p></noscript>
  </form>

  <div class="aviso-paso exito" data-enviado tabindex="-1" hidden>
    <h2>Revise su correo</h2>
    <p>
      Le enviamos un enlace (vence en 72 horas). Ábralo de preferencia en la computadora de su consultorio: al confirmar, pasa directo a su instalación guiada. Si no lo ve en unos minutos, busque en correo no deseado o promociones.
    </p>
    <p>¿Ya se había registrado? Entonces lo que le llegó es su enlace de descarga.</p>
  </div>
  </div>
</PaginaTexto>

<style>
  .panel-formulario {
    display: grid;
    gap: 1.25rem;
  }

  .cupo-vivo {
    margin-bottom: 1rem;
  }

  .registro-rapido[hidden] {
    display: none;
  }

  .registro-rapido {
    display: grid;
    gap: 0.75rem;
  }

  .registro-nota {
    margin: 0;
    color: var(--texto-2);
    font-size: 0.875rem;
    text-align: center;
  }

  .separador {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.5rem 0 0;
    color: var(--texto-2);
    font-size: 0.875rem;
  }

  .separador::before,
  .separador::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--linea);
  }

  .conectado {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .conectado[hidden] {
    display: none;
  }

  .conectado :global(.icono) {
    display: inline-block;
    width: 1.25rem;
    height: 1.25rem;
    vertical-align: -0.25rem;
    color: var(--exito);
  }
</style>
