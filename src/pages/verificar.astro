---
// Verificar el instalador: versión vigente y huellas SHA-256 oficiales (únicas en site.config.ts → version.paquetes),
// cómo comprobarlas en PowerShell y qué hacer con el aviso de SmartScreen. Las versiones registradas en el panel
// (/api/versiones) se muestran debajo si hay conexión.
import Icono from '../components/Icono.astro';
import PaginaTexto from '../layouts/PaginaTexto.astro';
import { enlaceWhatsApp } from '../lib/whatsapp';
import { paquete, sitio } from '../site.config';

const { version } = sitio;
const instalador = paquete('instalador');
const comando = (archivo: string) => `Get-FileHash "$env:USERPROFILE\\Downloads\\${archivo}" -Algorithm SHA256`;
const ayuda = enlaceWhatsApp(sitio.contacto.whatsapp, 'Hola, tengo una duda sobre la huella del instalador de InmutalKey.');
---

<PaginaTexto
  titulo="Verifique su instalador"
  descripcion="Antes de instalar, compruebe en un minuto que el archivo es exactamente el que publicamos."
  antetitulo="Seguridad"
  amplio
>
  <div class="verificar">
    <section class="tarjeta vigente" aria-labelledby="vigente-titulo">
      <div class="vigente-cabecera">
        <span class="sello"><Icono nombre="sello" /></span>
        <div>
          <h2 id="vigente-titulo">InmutalKey <span class="cifras">{version.numero}</span></h2>
          <p class="tenue">{version.nombre} · Windows 10 y 11 (64 bits)</p>
        </div>
        <span class="pildora vigente-pildora"><Icono nombre="check" /> Versión vigente</span>
      </div>

      <ul class="paquetes">
        {
          version.paquetes.map((p) => (
            <li class="paquete">
              <div class="paquete-titulo">
                <Icono nombre={p.id === 'zip' ? 'carpeta' : 'descarga'} />
                <div>
                  <h3>{p.titulo}</h3>
                  <p class="tenue">{p.descripcion}</p>
                </div>
              </div>
              <dl class="paquete-datos">
                <div>
                  <dt>Archivo</dt>
                  <dd><code>{p.archivo}</code></dd>
                </div>
                <div>
                  <dt>Huella SHA-256</dt>
                  <dd class="codigo-copiable">
                    <pre><code id={`huella-${p.id}`} class="huella">{p.sha256}</code></pre>
                    <button type="button" class="copiar" data-copiar={`huella-${p.id}`} hidden>
                      <Icono nombre="nota" /> <span data-copiar-texto>Copiar huella</span>
                    </button>
                  </dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ul>
      <p class="vigente-pie tenue">
        Las huellas son las mismas que van en su correo de descarga y en el archivo <code>SHA256.txt</code> del paquete.
      </p>
    </section>

    <div class="aviso" data-versiones-vivas hidden>
      <p><strong>Versiones registradas</strong></p>
      <ul data-lista></ul>
    </div>

    <div class="verificar-pasos">
      <section class="tarjeta paso-bloque" aria-labelledby="como-titulo">
        <h2 id="como-titulo">Cómo comprobarla en Windows</h2>
        <ol class="lista-pasos">
          <li>Guarde el archivo en su carpeta <strong>Descargas</strong>.</li>
          <li>Abra el menú Inicio, escriba <strong>PowerShell</strong> y ábralo.</li>
          <li>Pegue este comando y presione Enter:</li>
        </ol>
        <div class="codigo-copiable">
          <pre><code id="comando-huella">{comando(instalador.archivo)}</code></pre>
          <button type="button" class="copiar" data-copiar="comando-huella" hidden>
            <Icono nombre="nota" /> <span data-copiar-texto>Copiar comando</span>
          </button>
        </div>
        <p>
          Compare el valor de <strong>Hash</strong> con la huella oficial. Si coinciden todos los caracteres, el archivo es
          el original. Para el ZIP, cambie el nombre del archivo en el comando.
        </p>
        <p class="aviso alerta">
          <span><Icono nombre="alerta" /> Si no coinciden, no lo instale y escríbanos. Le enviamos un enlace nuevo.</span>
        </p>
      </section>

      <section class="tarjeta paso-bloque" aria-labelledby="smartscreen-titulo">
        <h2 id="smartscreen-titulo">«Windows protegió su PC»</h2>
        <p>
          Windows SmartScreen puede mostrar este aviso porque el instalador está firmado con un certificado propio y aún
          no con uno comercial de firma de código. Con la huella ya comprobada:
        </p>
        <ol class="lista-pasos">
          <li>Haga clic en <strong>Más información</strong>.</li>
          <li>Elija <strong>Ejecutar de todas formas</strong>.</li>
        </ol>
        <p class="tenue">El instalador es por usuario: no pide contraseña de administrador.</p>
        <h2 class="paso-subtitulo">¿Dudas?</h2>
        <p>Le acompañamos en la instalación.</p>
        <div class="acciones">
          {ayuda && <a class="boton" href={ayuda} target="_blank" rel="noopener noreferrer"><Icono nombre="chat" /> WhatsApp</a>}
          <a class="boton" href="/descarga"><Icono nombre="descarga" /> Guía de instalación</a>
        </div>
      </section>
    </div>
    <p class="visualmente-oculto" role="status" aria-live="polite" data-copiar-aviso></p>
  </div>
</PaginaTexto>

<script>
  // Botones «Copiar» (comando y huellas): solo aparecen si el navegador deja escribir en el portapapeles.
  const aviso = document.querySelector<HTMLElement>('[data-copiar-aviso]');
  document.querySelectorAll<HTMLButtonElement>('button[data-copiar]').forEach((boton) => {
    const origen = document.getElementById(boton.dataset['copiar'] ?? '');
    const etiqueta = boton.querySelector<HTMLElement>('[data-copiar-texto]');
    if (!origen || !etiqueta || typeof navigator.clipboard?.writeText !== 'function') return;
    const original = etiqueta.textContent ?? '';
    let espera = 0;
    boton.hidden = false;
    boton.addEventListener('click', () => {
      navigator.clipboard
        .writeText((origen.textContent ?? '').trim())
        .then(() => {
          etiqueta.textContent = 'Copiado';
          if (aviso) aviso.textContent = 'Copiado al portapapeles.';
          window.clearTimeout(espera);
          espera = window.setTimeout(() => {
            etiqueta.textContent = original;
            if (aviso) aviso.textContent = '';
          }, 2200);
        })
        .catch(() => {
          /* sin permiso: el texto sigue ahí para seleccionarlo a mano */
        });
    });
  });
</script>

<style>
  .verificar {
    display: grid;
    gap: 1.25rem;
  }

  .vigente {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3.5vw, 2.5rem);
  }

  .vigente-cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .vigente-cabecera h2 {
    font-size: 1.625rem;
  }

  .vigente-pildora {
    margin-left: auto;
    border-color: var(--exito-borde);
    background: var(--exito-suave);
    color: var(--exito);
  }

  .paquetes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paquete {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: color-mix(in srgb, var(--superficie) 60%, transparent);
  }

  .paquete-titulo {
    display: flex;
    gap: 0.75rem;
  }

  .paquete-titulo > :global(.icono) {
    margin-top: 0.15rem;
    color: var(--primario);
  }

  .paquete-titulo p {
    font-size: 0.9375rem;
  }

  .paquete-datos {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .paquete-datos dt {
    margin-bottom: 0.25rem;
    color: var(--texto-2);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .paquete-datos dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .huella {
    letter-spacing: 0.02em;
  }

  .vigente-pie {
    font-size: 0.875rem;
  }

  .verificar-pasos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  .paso-bloque {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
  }

  .paso-bloque h2 {
    font-size: 1.375rem;
  }

  .paso-subtitulo {
    margin-top: 0.75rem;
  }

  .lista-pasos {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }

  .lista-pasos li::marker {
    color: var(--primario);
    font-weight: 650;
  }

  [data-versiones-vivas] ul {
    display: grid;
    gap: 0.375rem;
    padding-left: 1.25rem;
    overflow-wrap: anywhere;
    font-size: 0.9375rem;
  }
</style>
