---
import Icono from '../components/Icono.astro';
import PaginaTexto from '../layouts/PaginaTexto.astro';
import { enlaceWhatsApp } from '../lib/whatsapp';
import { estaDefinido, sitio } from '../site.config';

const { instalador } = sitio;
const archivo = estaDefinido(instalador.archivo) ? instalador.archivo : null;
const version = estaDefinido(instalador.version) ? instalador.version : null;
const huella = estaDefinido(instalador.sha256) ? instalador.sha256.toUpperCase() : null;
const nombreArchivo = archivo ?? 'InmutalKey_Setup.exe';
const pedir = enlaceWhatsApp(sitio.contacto.whatsapp, 'Hola, ¿me compartes la huella SHA-256 del instalador de InmutalKey?');
---

<PaginaTexto
  titulo="Verifica tu instalador"
  descripcion="Antes de instalar, comprueba en un minuto que el archivo es exactamente el que publicamos."
  antetitulo="Seguridad"
>
  <h2>La huella oficial</h2>
  {
    huella ? (
      <div class="aviso">
        <p>
          <strong>Archivo:</strong> {nombreArchivo}
          {version && <> · <strong>Versión:</strong> {version}</>}
        </p>
        <p>
          <strong>SHA-256:</strong> <code class="huella" id="huella-oficial">{huella}</code>
        </p>
        <button type="button" class="copiar" data-copiar="huella-oficial" hidden>
          <svg class="icono" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="8.75" y="8.75" width="11.5" height="11.5" rx="2.25" /><path d="M15.25 8.75v-2.5a2.5 2.5 0 0 0-2.5-2.5h-6.5a2.5 2.5 0 0 0-2.5 2.5v6.5a2.5 2.5 0 0 0 2.5 2.5h2.5" /></svg> <span data-copiar-texto>Copiar huella</span>
        </button>
      </div>
    ) : (
      <div class="aviso">
        <p>
          La huella del instalador vigente te la enviamos junto con el archivo. Si no la tienes,
          {pedir ? <a href={pedir} target="_blank" rel="noopener noreferrer"> pídenosla por WhatsApp</a> : ' pídenosla'}.
        </p>
      </div>
    )
  }

  <h2>Cómo comprobarla en Windows</h2>
  <ol>
    <li>Guarda el instalador en tu carpeta de Descargas.</li>
    <li>Abre el menú Inicio, escribe <strong>PowerShell</strong> y ábrelo.</li>
    <li>Copia y pega este comando y presiona Enter:</li>
  </ol>
  <div class="comando">
    <span class="comando-etiqueta" aria-hidden="true">PowerShell</span>
    <pre><code id="comando-huella">Get-FileHash "$env:USERPROFILE\Downloads\{nombreArchivo}" -Algorithm SHA256</code></pre>
    <button type="button" class="copiar" data-copiar="comando-huella" hidden>
      <svg class="icono" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="8.75" y="8.75" width="11.5" height="11.5" rx="2.25" /><path d="M15.25 8.75v-2.5a2.5 2.5 0 0 0-2.5-2.5h-6.5a2.5 2.5 0 0 0-2.5 2.5v6.5a2.5 2.5 0 0 0 2.5 2.5h2.5" /></svg> <span data-copiar-texto>Copiar comando</span>
    </button>
  </div>
  <p>
    Compara el valor que aparece en <strong>Hash</strong> con la huella oficial. Si coinciden todos los caracteres,
    el archivo es el original. Si no coinciden, no lo instales y escríbenos.
  </p>

  <h2>"Windows protegió su PC"</h2>
  <p>
    Es posible que Windows SmartScreen muestre este aviso. Aparece porque el instalador está firmado con un certificado
    propio y todavía no con un certificado comercial de firma de código. No significa que el archivo tenga un problema.
  </p>
  <p>Si la huella coincide:</p>
  <ol>
    <li>Haz clic en <strong>Más información</strong>.</li>
    <li>Elige <strong>Ejecutar de todas formas</strong>.</li>
  </ol>

  <h2>¿Dudas?</h2>
  <p>
    Te acompañamos en la instalación por WhatsApp.
    {
      pedir && (
        <a class="enlace-boton" href={pedir} target="_blank" rel="noopener noreferrer">
          <Icono nombre="chat" /> Escríbenos
        </a>
      )
    }
  </p>
  <p class="visualmente-oculto" role="status" aria-live="polite" data-copiar-aviso></p>
</PaginaTexto>

<script>
  // Botones "Copiar" (comando y huella): solo aparecen si el navegador deja escribir en el portapapeles.
  const aviso = document.querySelector<HTMLElement>('[data-copiar-aviso]');
  document.querySelectorAll<HTMLButtonElement>('button[data-copiar]').forEach((boton) => {
    const origen = document.getElementById(boton.dataset['copiar'] ?? '');
    const etiqueta = boton.querySelector<HTMLElement>('[data-copiar-texto]');
    if (!origen || !etiqueta || typeof navigator.clipboard?.writeText !== 'function') return;
    const original = etiqueta.textContent ?? '';
    let espera = 0;
    boton.hidden = false;
    boton.addEventListener('click', () => {
      navigator.clipboard
        .writeText((origen.textContent ?? '').trim())
        .then(() => {
          etiqueta.textContent = 'Copiado';
          boton.dataset['estado'] = 'copiado';
          if (aviso) aviso.textContent = 'Copiado al portapapeles.';
          window.clearTimeout(espera);
          espera = window.setTimeout(() => {
            etiqueta.textContent = original;
            delete boton.dataset['estado'];
            if (aviso) aviso.textContent = '';
          }, 2200);
        })
        .catch(() => {
          /* sin permiso: el texto sigue ahí para seleccionarlo a mano */
        });
    });
  });
</script>

<style>
  .huella {
    word-break: break-all;
  }

  /* Comando en una "terminal" con su etiqueta y el botón para copiarlo. */
  .comando {
    position: relative;
    margin: 1em 0;
  }

  .comando-etiqueta {
    position: absolute;
    top: 0;
    left: 16px;
    z-index: 1;
    padding: 0 8px;
    background: #03060c;
    color: var(--azul-vivo);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1;
    transform: translateY(-50%);
  }

  .comando pre {
    margin: 0;
    padding-top: 18px;
  }

  .copiar {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    margin-top: 10px;
    padding: 0 16px;
    border: 1px solid var(--linea-oscura-fuerte);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    color: var(--texto);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease),
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .copiar[hidden] {
    display: none;
  }

  .copiar :global(.icono) {
    width: 18px;
    height: 18px;
    color: var(--azul-vivo);
  }

  @media (hover: hover) {
    .copiar:hover {
      border-color: var(--azul-vivo);
    }
  }

  /* Confirmación: esmeralda solo aquí, porque el texto quedó copiado tal cual (verificado). */
  .copiar[data-estado='copiado'] {
    border-color: rgb(47 209 154 / 0.5);
    background: rgb(10 139 105 / 0.14);
    color: var(--esmeralda-vivo);
  }

  .copiar[data-estado='copiado'] :global(.icono) {
    color: var(--esmeralda-vivo);
  }

  .enlace-boton {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-left: 0.3em;
  }

  .enlace-boton :global(.icono) {
    width: 1.1em;
    height: 1.1em;
  }
</style>
