---
// Portada (IDENTIDAD_MARCA §9): Hero → Pilares → Cómo funciona → Recetas → Fundadores → Seguridad →
// Testimonios (solo si hay aprobados) → Preguntas → Contacto.
import Cierre from '../components/secciones/Cierre.astro';
import ComoFunciona from '../components/secciones/ComoFunciona.astro';
import Faq from '../components/secciones/Faq.astro';
import Fundadores from '../components/secciones/Fundadores.astro';
import Hero from '../components/secciones/Hero.astro';
import Pilares from '../components/secciones/Pilares.astro';
import Recetas from '../components/secciones/Recetas.astro';
import Seguridad from '../components/secciones/Seguridad.astro';
import TestimoniosVivos from '../components/secciones/TestimoniosVivos.astro';
import Base from '../layouts/Base.astro';
import { sitio } from '../site.config';
---

<Base titulo={sitio.titulo} tituloCompleto>
  <Hero />
  <Pilares />
  <ComoFunciona />
  <Recetas />
  <Fundadores />
  <Seguridad />
  <TestimoniosVivos />
  <Faq />
  <Cierre />
</Base>
