---
// Portada (orden confirmado por Alan el 15-nov-2026): Hero → Problema → Integridad → Simulador → Signos →
// Un día en su consultorio → Recetas → Bóveda → Bento «Todo lo que incluye» → Fundadores → Seguridad →
// Testimonios (solo si hay aprobados) → Preguntas → Contacto.
import Bento from '../components/secciones/Bento.astro';
import Boveda from '../components/secciones/Boveda.astro';
import Cierre from '../components/secciones/Cierre.astro';
import Dia from '../components/secciones/Dia.astro';
import Faq from '../components/secciones/Faq.astro';
import Fundadores from '../components/secciones/Fundadores.astro';
import Hero from '../components/secciones/Hero.astro';
import Integridad from '../components/secciones/Integridad.astro';
import Problema from '../components/secciones/Problema.astro';
import Recetas from '../components/secciones/Recetas.astro';
import Seguridad from '../components/secciones/Seguridad.astro';
import Signos from '../components/secciones/Signos.astro';
import Simulador from '../components/secciones/Simulador.astro';
import TestimoniosVivos from '../components/secciones/TestimoniosVivos.astro';
import Base from '../layouts/Base.astro';
import { sitio } from '../site.config';
---

<Base titulo={sitio.titulo} tituloCompleto>
  <Hero />
  <Problema />
  <Integridad />
  <Simulador />
  <Signos />
  <Dia />
  <Recetas />
  <Boveda />
  <Bento />
  <Fundadores />
  <Seguridad />
  <TestimoniosVivos />
  <Faq />
  <Cierre />
</Base>
