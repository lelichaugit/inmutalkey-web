---
// Después de confirmar cuando no hay descarga inmediata: aún no hay versión publicada (?estado=pronto), pidió
// demasiados enlaces hoy (?estado=limite) o vuelve a un enlace ya usado. formularios.ts muestra el texto que toca.
import '../../styles/formularios.css';

import PasosRegistro from '../../components/PasosRegistro.astro';
import PaginaTexto from '../../layouts/PaginaTexto.astro';
import { enlaceWhatsApp } from '../../lib/whatsapp';
import { sitio } from '../../site.config';

const whatsapp = enlaceWhatsApp(sitio.contacto.whatsapp, sitio.contacto.mensajes.fundadores);
---

<PaginaTexto titulo="Listo: su correo quedó confirmado" descripcion="Ya forma parte del programa Fundadores." antetitulo="Programa Fundadores" indexar={false} estrecho>
  <PasosRegistro actual={3} />
  <div class="aviso-paso exito" data-gracias>
    <p data-estado-gracias="normal">
      Si su descarga no se abrió, pida un enlace nuevo en <a href="/descarga">inmutalkey.com/descarga</a> con el mismo
      correo: le llega en un minuto.
    </p>
    <p data-estado-gracias="pronto" hidden>
      Estamos publicando la versión más reciente del instalador. En cuanto esté lista le enviamos su enlace personal por
      correo; no tiene que hacer nada más.
    </p>
    <p data-estado-gracias="limite" hidden>
      Por seguridad, cada registro puede pedir pocos enlaces al día y hoy ya se alcanzó ese límite. Use el que le llegó
      por correo o vuelva a intentarlo mañana.
    </p>
    {
      whatsapp && (
        <p>
          ¿Necesita ayuda? <a href={whatsapp} target="_blank" rel="noopener noreferrer">Escríbanos por WhatsApp</a>.
        </p>
      )
    }
    <p><a href="/">Volver a inmutalkey.com</a></p>
  </div>
</PaginaTexto>
