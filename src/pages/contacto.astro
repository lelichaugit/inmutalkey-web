---
// Contacto: el correo es el canal principal (y WhatsApp si está activo); después, las redes y el QR de Instagram.
// Todo son enlaces estáticos: ni widgets, ni iframes, ni píxeles de redes sociales (promesa de privacidad).
import Icono from '../components/Icono.astro';
import IconoMarca from '../components/IconoMarca.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { AVISO_PESTANA, correoContacto, redPorId, REL_EXTERNO } from '../data/socials';
import PaginaTexto from '../layouts/PaginaTexto.astro';
import { buscarQrInstagram } from '../lib/qr';
import { enlaceWhatsApp, numeroVisible } from '../lib/whatsapp';
import { sitio } from '../site.config';

const correo = correoContacto();
const whatsapp = enlaceWhatsApp(sitio.contacto.whatsapp, sitio.contacto.mensajeWhatsApp);
const telefono = numeroVisible(sitio.contacto.whatsapp);
const instagram = redPorId('instagram');
const qr = buscarQrInstagram();
---

<PaginaTexto
  titulo="Contacto"
  descripcion="Escríbanos para resolver dudas, pedir una demostración o recibir ayuda con la instalación. También puede seguir el avance de InmutalKey en redes."
  antetitulo="Hablemos"
  amplio
>
  <section class="contacto-bloque" aria-labelledby="contacto-directo">
    <h2 id="contacto-directo" class="contacto-titulo">Contacto directo</h2>
    <p class="contacto-intro">El correo es nuestro canal principal: ahí respondemos dudas, demostraciones y soporte.</p>

    <ul class:list={['canales', { 'canales-dos': whatsapp && telefono }]}>
      {
        correo && (
          <li>
            <a class="canal canal-principal" href={`mailto:${correo}`} aria-label={`Escribir correo a ${correo}`}>
              <span class="canal-sello">
                <Icono nombre="correo" />
              </span>
              <span class="canal-tipo">Correo</span>
              <span class="canal-valor">{correo.split('@')[0]}@<wbr />{correo.split('@')[1]}</span>
              <span class="canal-accion" aria-hidden="true">Escribir correo</span>
            </a>
          </li>
        )
      }
      {
        whatsapp && telefono && (
          <li>
            <a
              class="canal canal-whatsapp"
              href={whatsapp}
              target="_blank"
              rel={REL_EXTERNO}
              aria-label={`Abrir WhatsApp Business, ${telefono}, ${AVISO_PESTANA}`}
            >
              <span class="canal-sello">
                <IconoMarca nombre="whatsapp" />
              </span>
              <span class="canal-tipo">WhatsApp Business</span>
              <span class="canal-valor sin-corte">{telefono}</span>
              <span class="canal-accion" aria-hidden="true">Abrir WhatsApp</span>
            </a>
          </li>
        )
      }
    </ul>
  </section>

  <section class="contacto-bloque" aria-labelledby="contacto-redes">
    <h2 id="contacto-redes" class="contacto-titulo">Síganos</h2>
    <p class="contacto-intro">Novedades del producto, noticias y el perfil profesional de quien lo construye.</p>

    <SocialLinks variant="cards" />

    <div class="contacto-extra">
      <figure class="tarjeta qr">
        <img
          class="qr-imagen"
          src={qr.src}
          width="180"
          height={qr.oficial ? undefined : '180'}
          alt="Código QR para abrir el perfil @inmutalkey en Instagram"
          decoding="async"
          loading="lazy"
        />
        <figcaption>
          <span class="qr-titulo">Escanee para seguirnos en Instagram</span>
          <span class="qr-handle">{instagram.handle}</span>
        </figcaption>
      </figure>

      <div class="tarjeta privacidad">
        <Icono nombre="escudo" class="privacidad-icono" />
        <h3>Enlaces directos, sin rastreadores</h3>
        <p>
          No incrustamos publicaciones, botones ni píxeles de redes sociales. Navegar por inmutalkey.com no le avisa a
          ninguna red que usted estuvo aquí; solo al abrir un perfil sale a su sitio, con sus propias reglas de privacidad.
        </p>
      </div>
    </div>
  </section>
</PaginaTexto>

<style>
  .contacto-bloque + .contacto-bloque {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .contacto-titulo {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .contacto-intro {
    max-width: 40rem;
    margin: 0.5rem 0 1.5rem;
    color: var(--texto-2);
  }

  .canales {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .canales-dos {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .canales li {
    display: flex;
  }

  .canal {
    display: grid;
    flex: 1;
    gap: 0.25rem;
    align-content: start;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--cristal-borde);
    border-radius: var(--radio-lg);
    background: var(--grad-tarjeta);
    color: var(--texto);
    text-decoration: none;
    box-shadow: var(--cristal-brillo), var(--elev-1);
    transition:
      transform 240ms var(--curva-cristal),
      box-shadow 240ms var(--curva-cristal),
      border-color 200ms ease;
  }

  .canal:hover,
  .canal:focus-visible {
    color: var(--texto);
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--acento) 42%, var(--borde));
    box-shadow: var(--cristal-brillo), var(--elev-2), var(--halo-acento);
  }

  .canal:active {
    transform: scale(0.99);
  }

  .canal-sello {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.75rem;
    border-radius: var(--radio);
    background: var(--grad-primario);
    color: var(--sobre-primario);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35), 0 6px 14px -6px color-mix(in srgb, var(--primario) 60%, transparent);
  }

  .canal-sello :global(.icono),
  .canal-sello :global(.icono-marca) {
    width: 1.375rem;
    height: 1.375rem;
  }

  .canal-tipo {
    color: var(--texto-2);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .canal-valor {
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.625rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }

  .canal-accion {
    margin-top: 0.75rem;
    color: var(--primario);
    font-weight: 600;
  }

  .sin-corte {
    white-space: nowrap;
  }

  .contacto-extra {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  .qr {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 1.5rem;
    text-align: center;
  }

  .qr-imagen {
    width: 11.25rem;
    height: auto;
    padding: 0.5rem;
    border-radius: var(--radio);
    background: #fff;
  }

  .qr figcaption {
    display: grid;
    gap: 0.125rem;
  }

  .qr-titulo {
    font-weight: 600;
  }

  .qr-handle {
    color: var(--primario);
    font-weight: 560;
  }

  .privacidad {
    display: grid;
    align-content: center;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .privacidad :global(.privacidad-icono) {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--primario);
  }

  .privacidad p {
    color: var(--texto-2);
  }

  @media (max-width: 40rem) {
    .contacto-extra {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
