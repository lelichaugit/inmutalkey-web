---
// 404: el logo plata en una lámina Marino, una frase serena y el camino de vuelta.
import Icono from '../components/Icono.astro';
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" descripcion="Esta página no existe. Vuelva al inicio de InmutalKey." indexar={false}>
  <section class="no-encontrada">
    <div class="contenedor">
      <div class="no-encontrada-panel lamina tema-marino cuadricula">
        <img class="no-encontrada-logo" src="/brand/logo-plata-280.webp" alt="" width="100" height="280" decoding="async" />
        <p class="antetitulo">Error 404</p>
        <h1>Esta llave no abre ninguna puerta.</h1>
        <p class="texto-grande">La página que busca no existe o cambió de lugar.</p>
        <div class="acciones">
          <a class="boton boton-primario boton-grande" href="/">Ir al inicio</a>
          <a class="boton boton-grande" href="/#preguntas"><Icono nombre="lupa" /> Preguntas frecuentes</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .no-encontrada {
    padding: calc(var(--altura-nav) + clamp(2.5rem, 6vw, 5rem)) 0 var(--seccion);
  }

  .no-encontrada-panel {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: clamp(2.5rem, 8vw, 6rem) clamp(1.25rem, 5vw, 4rem);
    border-radius: var(--radio-xl);
    text-align: center;
    box-shadow: var(--elev-3);
  }

  .no-encontrada-logo {
    width: 2.75rem;
    height: auto;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 0.75rem 1.25rem rgb(0 4 12 / 0.6));
  }

  .no-encontrada-panel .acciones {
    justify-content: center;
    margin-top: 1rem;
  }
</style>
